From f12800031c537c0c0855dd6b03f272ac195391b5 Mon Sep 17 00:00:00 2001
From: ios-flame <ios-flame@localhost>
Date: Mon, 26 Oct 2026 16:29:35 +0000
Subject: [PATCH] ios26: Sandbox ops 5/6/0x1c/0x43/0x4d write their outputs,
 AMFI 0x5b, flush the log before a critical-exit panic

---
 bsd/dev/sweet_ufs.c   | 16 ++++++++++--
 bsd/kern/kern_exit.c  | 10 ++++++++
 bsd/kern/sweet_amfi.c | 59 ++++++++++++++++++++++++++++++++++++++-----
 3 files changed, 76 insertions(+), 9 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index a142adb..e198b30 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -845,8 +845,10 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
-	for (;;) {
-		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+	for (bool first = true;; first = false) {
+		if (!first) {
+			(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
+		}
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
 		if (total == flushed) {
 			continue;
@@ -886,6 +888,16 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+/* Wake the log thread and give it time to write the ring (exit path, before a panic). */
+void sweet_log_flush_now(void);
+
+void
+sweet_log_flush_now(void)
+{
+	wakeup(&sweet_log_chan);
+	delay(500 * 1000);
+}
+
 static void
 sweet_log_start(void)
 {
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index 9b6d828..9519bb5 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1960,6 +1960,10 @@ proc_crash_coredump(proc_t p)
 #endif /* (DEVELOPMENT || DEBUG) && CONFIG_COREDUMP */
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern void sweet_log_flush_now(void);
+#endif
+
 static void
 proc_handle_critical_exit(proc_t p, int rv)
 {
@@ -2008,6 +2012,12 @@ proc_handle_critical_exit(proc_t p, int rv)
 	proc_crash_coredump(p);
 
 	sync(p, (void *)NULL, (int *)NULL);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	{
+		printf("SWEET: critical exit: %s (signal %d, exit status %d)\n", prefix_str, WTERMSIG(rv), WEXITSTATUS(rv));
+		sweet_log_flush_now();
+	}
+#endif
 	const uint64_t panic_options_mask = DEBUGGER_OPTION_INITPROC_PANIC | DEBUGGER_OPTION_USERSPACE_INITIATED_PANIC;
 
 	if (p->p_exit_reason == OS_REASON_NULL) {
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 69bc14f..e1444bb 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -314,23 +314,67 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  * data (container paths, extension tokens) fail with ENOENT. The first
  * use of each operation number is logged.
  */
-static uint64_t sweet_sandbox_seen;
+static uint64_t sweet_sandbox_seen[5];
 
+/*
+ * iOS 26 libsystem_sandbox reads results back from user memory, so some
+ * operations must write outputs instead of only returning a status:
+ *   0x05 extension issue: args[4] is a 0x3ff0-byte token buffer. Write the
+ *        token "invalid", which sandbox_extension_consume() accepts without
+ *        a syscall. containermanagerd issues a token with every container
+ *        path, and ENOENT here failed every container lookup.
+ *   0x06 extension consume: args[2] -> int64 handle 0.
+ *   0x1c: args[2] -> int64 0 (the caller returns it, -1 on error).
+ *   0x43 container expected: args[0], args[1] -> uint64 0 (not expected).
+ *        An error aborts every process in _container_init().
+ *   0x4d: args[1] -> uint8 0 (the caller does not initialise it).
+ */
 static int
-sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+sweet_sandbox_put(user_addr_t arg, unsigned idx, const void *val, size_t len)
 {
-	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
-		sweet_sandbox_seen |= 1ULL << call;
+	uint64_t ptr = 0;
+	if (arg == USER_ADDR_NULL) {
+		return EINVAL;
+	}
+	int error = copyin(arg + idx * sizeof(uint64_t), &ptr, sizeof(ptr));
+	if (error || ptr == 0) {
+		return error;
+	}
+	return copyout(val, (user_addr_t)ptr, len);
+}
+
+static int
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 320 && !(sweet_sandbox_seen[call / 64] & (1ULL << (call % 64)))) {
+		sweet_sandbox_seen[call / 64] |= 1ULL << (call % 64);
 		char name[32];
 		proc_name(proc_pid(p), name, sizeof(name));
 		printf("SWEET Sandbox: %s op %d\n", name, call);
 	}
+	static const char invalid_token[] = "invalid";
+	const uint64_t zero64 = 0;
+	const uint8_t zero8 = 0;
+	int error;
+
 	switch (call) {
-	case 4:         /* container path (audit token / pid) */
+	case 4:         /* container path (audit token / pid): none */
+		return ENOENT;
 	case 5:         /* extension issue */
+		return sweet_sandbox_put(arg, 4, invalid_token, sizeof(invalid_token));
 	case 6:         /* extension consume */
+		(void)sweet_sandbox_put(arg, 2, &zero64, sizeof(zero64));
+		return 0;
+	case 0x1c:
+		return sweet_sandbox_put(arg, 2, &zero64, sizeof(zero64));
 	case 0x43:      /* container expected */
-		return ENOENT;
+		error = sweet_sandbox_put(arg, 0, &zero64, sizeof(zero64));
+		if (!error) {
+			error = sweet_sandbox_put(arg, 1, &zero64, sizeof(zero64));
+		}
+		return error;
+	case 0x4d:
+		return sweet_sandbox_put(arg, 1, &zero8, sizeof(zero8));
 	default:
 		return 0;
 	}
@@ -348,6 +392,7 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
  * Other calls fail with ENOPOLICY as before the policy had this name.
  */
 #define SWEET_AMFI_DYLD_POLICY_SELF     0x5a
+#define SWEET_AMFI_DYLD_POLICY_PID      0x5b    /* same {input, output} head, then a pid */
 #define SWEET_AMFI_DYLD_IN_RESTRICTED   (1ULL << 1)
 #define SWEET_AMFI_DYLD_IN_ENCRYPTED    (1ULL << 2)
 #define SWEET_AMFI_DYLD_AT_PATH         (1ULL << 0)
@@ -364,7 +409,7 @@ sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
 		proc_name(proc_pid(p), name, sizeof(name));
 		printf("SWEET AMFI: %s syscall %d\n", name, call);
 	}
-	if (call != SWEET_AMFI_DYLD_POLICY_SELF) {
+	if (call != SWEET_AMFI_DYLD_POLICY_SELF && call != SWEET_AMFI_DYLD_POLICY_PID) {
 		return ENOPOLICY;
 	}
 	struct {
-- 
2.43.0

