diff --git a/bsd/dev/flame_sta.c b/bsd/dev/flame_sta.c
index 8abc042..b664e9c 100644
--- a/bsd/dev/flame_sta.c
+++ b/bsd/dev/flame_sta.c
@@ -174,8 +174,15 @@ sta_channels(struct redwood_sta_channel *channels, unsigned most)
 {
 	unsigned n = 0;
 	for (; n < most && n < sizeof(sta_freqs) / sizeof(sta_freqs[0]); n++) {
-		channels[n].frequency = sta_freqs[n];
-		channels[n].flags = REDWOOD_STA_CHANNEL_PASSIVE;
+		uint16_t f = sta_freqs[n];
+		uint16_t flags = 0;
+		if (f >= 5260 && f <= 5700) {
+			flags = REDWOOD_STA_CHANNEL_PASSIVE | REDWOOD_STA_CHANNEL_RADAR;
+		} else if (f >= 2467 && f <= 2484) {
+			flags = REDWOOD_STA_CHANNEL_PASSIVE;
+		}
+		channels[n].frequency = f;
+		channels[n].flags = flags;
 	}
 	return n;
 }
