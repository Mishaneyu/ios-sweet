diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index dec8764..1d5cc18 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -6,36 +6,68 @@
  * Boot-arg flamecpufreq:
  *   0       leave ABL boot clocks untouched
  *   1       all-core max turbo (1785 / 2419 / 2956 MHz; high voltage/heat)
- *   2       (default) Kryo 485 voltage-knee sweet spot (1632 / 1804 / 2016 MHz;
- *           -47% package power, runs cool continuously)
- *   N > 2   highest entry at or below N MHz across all clusters
+ *   2       static voltage-knee sweet spot (1632 / 1805 / 2016 MHz)
+ *   3       (default) dynamic touch + frame-rate OSM governor:
+ *             - Active / Touch / Boot (<45s): 1785 / 2131 / 2419 MHz
+ *             - Screen-On Idle:                941 / 1056 / 1056 MHz
+ *             - Screen-Off Sleep:              576 /  710 /  825 MHz
+ *   N > 3   static highest entry at or below N MHz across all clusters
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 #include <sweet_diag.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern bool sweet_fb_is_blanked(void);
 void sweet_cpufreq_init(void);
 
-#define OSM_FREQ_REG    0x110u          /* + 32 * index */
-#define OSM_ROW         32u
-#define OSM_ROWS        40u
-#define OSM_DESIRED     0x920u          /* + 4 * core in cluster; core 0 drives the policy */
-#define OSM_XO_KHZ      19200u
+#define OSM_FREQ_REG            0x110u          /* + 32 * index */
+#define OSM_ROW                 32u
+#define OSM_ROWS                40u
+#define OSM_DESIRED             0x920u          /* + 4 * core in cluster; core 0 drives the policy */
+#define OSM_XO_KHZ              19200u
+#define OSM_CLUSTERS            3u
+#define OSM_GOV_TICK_MS         250u
+#define OSM_BOOT_BOOST_NS       (45ULL * NSEC_PER_SEC)
+#define OSM_TOUCH_BOOST_NS      (1200ULL * NSEC_PER_MSEC)
+
+enum {
+	OSM_TIER_SLEEP  = 0,
+	OSM_TIER_IDLE   = 1,
+	OSM_TIER_ACTIVE = 2,
+	OSM_TIERS       = 3,
+};
 
 static const struct {
 	const char *name;
 	uint32_t pa;
 	unsigned sweet_mhz;
-} osm_clusters[] = {
-	{"pwrcl (A55 x4)",    0x18323000u, 1632u},
-	{"perfcl (A76 x3)",   0x18325800u, 1805u},
-	{"perfpcl (A76 prime)", 0x18327800u, 2016u},
+	unsigned tier_cap_mhz[OSM_TIERS];       /* SLEEP, IDLE, ACTIVE */
+} osm_clusters[OSM_CLUSTERS] = {
+	{"pwrcl (A55 x4)",     0x18323000u, 1632u, { 576u,  941u, 1786u}},
+	{"perfcl (A76 x3)",    0x18325800u, 1805u, { 711u, 1056u, 2132u}},
+	{"perfpcl (A76 prime)",0x18327800u, 2016u, { 826u, 1056u, 2420u}},
 };
 
+static vm_offset_t osm_base[OSM_CLUSTERS];
+static unsigned osm_tier_idx[OSM_CLUSTERS][OSM_TIERS];
+static unsigned osm_tier_mhz[OSM_CLUSTERS][OSM_TIERS];
+static volatile int osm_cur_tier = OSM_TIER_ACTIVE;
+static volatile bool osm_dyn_ready = false;
+static uint64_t osm_boot_abs;
+static _Atomic uint64_t osm_boost_abs;
+static _Atomic uint64_t osm_swaps;
+static uint64_t osm_last_swaps;
+static thread_call_t osm_gov_call;
+static LCK_GRP_DECLARE(osm_lock_grp, "sweet-cpufreq");
+static LCK_SPIN_DECLARE(osm_lock, &osm_lock_grp);
+
 static uint32_t
 osm_rd(vm_offset_t base, uint32_t off)
 {
@@ -44,21 +76,119 @@ osm_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+static inline void
+osm_wr_desired(unsigned c, unsigned idx, unsigned mhz)
+{
+	vm_offset_t base = osm_base[c];
+	if (!base) {
+		return;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + OSM_DESIRED) = idx;
+	__asm__ volatile("dsb osh" ::: "memory");
+	sweet_cpufreq_record(c, mhz);
+}
+
+static void
+osm_apply_tier(int tier)
+{
+	if (tier < 0 || tier >= OSM_TIERS) {
+		return;
+	}
+	lck_spin_lock(&osm_lock);
+	if (tier < OSM_TIER_ACTIVE) {
+		uint64_t boost = __c11_atomic_load(&osm_boost_abs, __ATOMIC_RELAXED);
+		uint64_t now = mach_absolute_time(), age_ns = UINT64_MAX;
+		if (boost != 0 && now >= boost) {
+			absolutetime_to_nanoseconds(now - boost, &age_ns);
+		}
+		if (age_ns < OSM_TOUCH_BOOST_NS) {
