 #include <sys/uio.h>
 #include <sys/vnode.h>
 #include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
 #include <kern/locks.h>
 #include <pexpert/pexpert.h>
 #include <libkern/libkern.h>
@@ -64,6 +65,7 @@ static bool fw_link_bss_heard;
 #define FW_BSS_MAX      64
 static struct flame_wlan_bss fw_bss[FW_BSS_MAX];
 static unsigned fw_nbss;
+static uint64_t fw_last_scan_abs;
 static int32_t fw_scan_status = FW_PENDING, fw_join_status = FW_PENDING, fw_left_status = FW_PENDING;
 
 /* with fw_lock */
@@ -130,6 +132,19 @@ flame_wlan_ready(void)
 int
 flame_wlan_scan(void)
 {
+	lck_mtx_lock(&fw_lock);
+	if (fw_nbss > 0 && fw_last_scan_abs != 0) {
+		uint64_t now = mach_absolute_time();
+		if (now >= fw_last_scan_abs) {
+			uint64_t age_ns = 0;
+			absolutetime_to_nanoseconds(now - fw_last_scan_abs, &age_ns);
+			if (age_ns < 4ULL * NSEC_PER_SEC) {
+				lck_mtx_unlock(&fw_lock);
+				return 0;
+			}
+		}
+	}
+	lck_mtx_unlock(&fw_lock);
 	return fw_request(FW_SCAN, NULL, 0, &fw_scan_status, 20);
 }
 
@@ -373,9 +388,21 @@ fw_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
 		lck_mtx_unlock(&fw_lock);
 		break;
 	}
-	case FW_SCAN_DONE:
+	case FW_SCAN_DONE: {
+		int32_t st = EIO;
+		if (h.len >= sizeof(st)) {
+			memcpy(&st, p, sizeof(st));
+		}
+		if (st == 0) {
+			lck_mtx_lock(&fw_lock);
+			if (fw_nbss > 0) {
+				fw_last_scan_abs = mach_absolute_time();
+			}
+			lck_mtx_unlock(&fw_lock);
+		}
 		fw_wake_status(&fw_scan_status, p, h.len);
 		break;
+	}
 	case FW_JOIN_DONE:
 		fw_wake_status(&fw_join_status, p, h.len);
 		break;
