From 8f1485bb02a51b34f040a73a3dbce772fa60a978 Mon Sep 17 00:00:00 2001
From: Nithin Amaraboina <48430674+nithinpain@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:16:03 +0530
Subject: [PATCH] Use compiler board define for existing SWEET allocator RNG
 fallback

---
 libkern/crypto/corecrypto_rand.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/libkern/crypto/corecrypto_rand.c b/libkern/crypto/corecrypto_rand.c
index b4ddac1..3006ec6 100644
--- a/libkern/crypto/corecrypto_rand.c
+++ b/libkern/crypto/corecrypto_rand.c
@@ -29,7 +29,7 @@
 #include <libkern/crypto/crypto_internal.h>
 #include <corecrypto/ccrng.h>
 #include <libkern/crypto/rand.h>
-#if defined(SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <kern/assert.h>
 #include <prng/random.h>
 #include <string.h>
@@ -67,7 +67,7 @@ sweet_kmem_uniform(struct sweet_kmem_rng *rng, uint64_t bound)
 	} while (value < threshold);
 	return value % bound;
 }
-#endif /* SWEET */
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 
 int
 cc_rand_generate(void *out, size_t outlen)
@@ -97,7 +97,7 @@ crypto_random_generate(
 	void *random,
 	size_t random_size)
 {
-#if defined(SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
 	if (g_crypto_funcs == NULL) {
 		uint8_t *dst = (uint8_t *)random;
 		while (random_size > 0) {
@@ -119,7 +119,7 @@ crypto_random_uniform(
 	uint64_t bound,
 	uint64_t *random)
 {
-#if defined(SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
 	if (g_crypto_funcs == NULL) {
 		*random = sweet_kmem_uniform((struct sweet_kmem_rng *)ctx, bound);
 		return;
@@ -131,7 +131,7 @@ crypto_random_uniform(
 size_t
 crypto_random_kmem_ctx_size(void)
 {
-#if defined(SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
 	if (g_crypto_funcs == NULL) {
 		return sizeof(struct sweet_kmem_rng);
 	}
@@ -143,7 +143,7 @@ void
 crypto_random_kmem_init(
 	crypto_random_ctx_t ctx)
 {
-#if defined(SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
 	if (g_crypto_funcs == NULL) {
 		((struct sweet_kmem_rng *)ctx)->state = early_random();
 		return;
-- 
2.53.0.windows.1

