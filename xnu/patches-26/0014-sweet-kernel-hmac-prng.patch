 // The number of samples we can hold in an entropy buffer.
 #define ENTROPY_MAX_SAMPLE_COUNT (2048)
@@ -93,7 +97,11 @@ typedef struct entropy_data {
 	// State for a SHA512 computation. This is used to accumulate
 	// entropy samples from across all CPUs. It is finalized when
 	// entropy is provided to the consumer of this module.
+#if defined(SWEET)
+	ccdigest_ctx_decl(CCSHA512_STATE_SIZE, CCSHA512_BLOCK_SIZE, sha512_ctx);
+#else
 	SHA512_CTX sha512_ctx;
+#endif
 
 	// A buffer to hold a bitmap with one bit per sample of an entropy
 	// buffer. We are able to reuse this instance across all the
@@ -195,12 +203,44 @@ entropy_analysis_store(entropy_sample_t sample)
 
 #endif  // ENTROPY_ANALYSIS_SUPPORTED
 
+/* SWEET uses the same built-in SHA512 digest as bootseed_init, without a kext. */
+static void
+entropy_hash_init(void)
+{
+#if defined(SWEET)
+	ccdigest_init(&ccsha512_ltc_di, entropy_data.sha512_ctx);
+#else
+	SHA512_Init(&entropy_data.sha512_ctx);
+#endif
+}
+
+static void
+entropy_hash_update(const void *data, size_t nbytes)
+{
+#if defined(SWEET)
+	ccdigest_update(&ccsha512_ltc_di, entropy_data.sha512_ctx, nbytes, data);
+#else
+	SHA512_Update(&entropy_data.sha512_ctx, data, nbytes);
+#endif
+}
+
+static void
+entropy_hash_final(void *out)
+{
+#if defined(SWEET)
+	ccdigest_final(&ccsha512_ltc_di, entropy_data.sha512_ctx, out);
+	ccdigest_ctx_clear(CCSHA512_STATE_SIZE, CCSHA512_BLOCK_SIZE, entropy_data.sha512_ctx);
+#else
+	SHA512_Final(out, &entropy_data.sha512_ctx);
+#endif
+}
