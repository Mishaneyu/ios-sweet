+/*
+ * Deferred BO retirement ring: BoFree detaches the BO from the client immediately without spinning on
+ * the GPU ring, keeps its SMMU PTEs and wired/pool pages alive until sweet_gpu_last_fence() completes,
+ * and reaps completed entries in batches (one TLB flush per batch).
+ */
+#define SWEET_V2_RETIRE_CAP     256
+#define SWEET_V2_REAP_BATCH     16
+
+struct sweet_v2_retired {
+	IOMemoryDescriptor *md;
+	uint64_t bytes;
+	uint64_t iova;
+	uint64_t pool_pa;
+	uint32_t fence;
+	bool imported;
+};
+
+static IOLock *sweet_retire_lock;
+static struct sweet_v2_retired sweet_retire_ring[SWEET_V2_RETIRE_CAP];
+static uint32_t sweet_retire_head;
+static volatile uint32_t sweet_retire_count;
+
+static void
+sweet_retire_init_lock(void)
+{
+	if (sweet_retire_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, &sweet_retire_lock)) {
+			IOLockFree(l);
+		}
+	}
+}
+
+static void
+sweet_v2_finish_retired_batch(const struct sweet_v2_retired *batch, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		if (batch[i].md == NULL) {
+			continue;
+		}
+		if (batch[i].imported) {
+			batch[i].md->complete();
+			batch[i].md->release();
+		} else {
+			sweet_pool_release(batch[i].md, batch[i].pool_pa);
+		}
+	}
+}
+
+static uint32_t
+sweet_v2_reap_retired(void)
+{
+	if (sweet_retire_lock == NULL || __atomic_load_n(&sweet_retire_count, __ATOMIC_ACQUIRE) == 0) {
+		return 0;
+	}
+	uint32_t total = 0;
+	for (;;) {
+		struct sweet_v2_retired batch[SWEET_V2_REAP_BATCH];
+		uint64_t iovas[SWEET_V2_REAP_BATCH];
+		uint64_t lens[SWEET_V2_REAP_BATCH];
+		uint32_t n = 0, unmaps = 0;
+
+		IOLockLock(sweet_retire_lock);
+		while (sweet_retire_count > 0 && n < SWEET_V2_REAP_BATCH) {
+			struct sweet_v2_retired *e = &sweet_retire_ring[sweet_retire_head];
+			if (e->fence != 0 && !sweet_gpu_fence_done(e->fence)) {
+				break;
+			}
+			batch[n] = *e;
+			if (e->iova != 0) {
+				iovas[unmaps] = e->iova;
+				lens[unmaps] = e->bytes;
+				unmaps++;
+			}
+			bzero(e, sizeof(*e));
+			sweet_retire_head = (sweet_retire_head + 1) % SWEET_V2_RETIRE_CAP;
+			__atomic_store_n(&sweet_retire_count, sweet_retire_count - 1, __ATOMIC_RELEASE);
+			n++;
+		}
+		if (unmaps > 0) {
+			sweet_gpu_unmap_at_batch(iovas, lens, unmaps);
+		}
+		IOLockUnlock(sweet_retire_lock);
+
+		if (n == 0) {
+			break;
+		}
+		sweet_v2_finish_retired_batch(batch, n);
+		total += n;
+		if (n < SWEET_V2_REAP_BATCH) {
+			break;
+		}
+	}
+	return total;
+}
+
+static bool
+sweet_v2_wait_oldest_retired(void)
+{
+	if (sweet_retire_lock == NULL) {
+		return false;
+	}
+	IOLockLock(sweet_retire_lock);
+	if (sweet_retire_count == 0) {
+		IOLockUnlock(sweet_retire_lock);
+		return false;
+	}
+	uint32_t fence = sweet_retire_ring[sweet_retire_head].fence;
+	IOLockUnlock(sweet_retire_lock);
+
+	if (fence != 0) {
+		(void)sweet_gpu_wait_fence_ns(fence, 2000000000ULL);
+	}
+	uint32_t reaped = sweet_v2_reap_retired();
+	sweet_zombie_sweep();
+	return reaped > 0;
+}
+
+static void
+sweet_v2_reap_for_iova(uint64_t iova, uint64_t bytes)
+{
+	(void)sweet_v2_reap_retired();
+	if (sweet_retire_lock == NULL || __atomic_load_n(&sweet_retire_count, __ATOMIC_ACQUIRE) == 0) {
+		return;
+	}
+	uint64_t end = iova + bytes;
+	for (;;) {
+		uint32_t wait_fence = 0;
+		bool overlap = false;
+		IOLockLock(sweet_retire_lock);
+		for (uint32_t i = 0; i < sweet_retire_count; i++) {
+			const struct sweet_v2_retired *e =
+			    &sweet_retire_ring[(sweet_retire_head + i) % SWEET_V2_RETIRE_CAP];
+			if (e->iova != 0 && e->iova < end && iova < e->iova + e->bytes) {
+				wait_fence = e->fence;
+				overlap = true;
+			}
+		}
+		IOLockUnlock(sweet_retire_lock);
+		if (!overlap) {
+			break;
+		}
+		if (wait_fence != 0) {
+			(void)sweet_gpu_wait_fence_ns(wait_fence, 2000000000ULL);
+		}
+		if (sweet_v2_reap_retired() == 0) {
+			break;
+		}
+	}
+}
+
+static void
+sweet_v2_reap_window(uint64_t win_base, uint64_t win_size)
+{
+	if (sweet_retire_lock == NULL || __atomic_load_n(&sweet_retire_count, __ATOMIC_ACQUIRE) == 0) {
+		return;
+	}
+	uint64_t win_end = win_base + win_size;
+	for (;;) {
+		struct sweet_v2_retired batch[SWEET_V2_REAP_BATCH];
+		uint64_t iovas[SWEET_V2_REAP_BATCH];
+		uint64_t lens[SWEET_V2_REAP_BATCH];
+		uint32_t n = 0, unmaps = 0;
+
+		IOLockLock(sweet_retire_lock);
+		uint32_t rem = 0, old_count = sweet_retire_count;
+		for (uint32_t i = 0; i < old_count; i++) {
+			struct sweet_v2_retired cur =
+			    sweet_retire_ring[(sweet_retire_head + i) % SWEET_V2_RETIRE_CAP];
+			if (n < SWEET_V2_REAP_BATCH && cur.iova >= win_base && cur.iova < win_end) {
+				batch[n++] = cur;
+				iovas[unmaps] = cur.iova;
+				lens[unmaps] = cur.bytes;
+				unmaps++;
+			} else {
+				sweet_retire_ring[(sweet_retire_head + rem) % SWEET_V2_RETIRE_CAP] = cur;
+				rem++;
+			}
+		}
+		for (uint32_t i = rem; i < old_count; i++) {
+			bzero(&sweet_retire_ring[(sweet_retire_head + i) % SWEET_V2_RETIRE_CAP],
+			    sizeof(sweet_retire_ring[0]));
+		}
+		__atomic_store_n(&sweet_retire_count, rem, __ATOMIC_RELEASE);
+		if (unmaps > 0) {
+			sweet_gpu_unmap_at_batch(iovas, lens, unmaps);
+		}
+		IOLockUnlock(sweet_retire_lock);
+
+		if (n == 0) {
+			break;
+		}
+		sweet_v2_finish_retired_batch(batch, n);
+	}
+}
+
+static void
+sweet_v2_retire_bo(const SweetV2BO *dead)
+{
+	if (dead->md == NULL) {
+		return;
+	}
+	sweet_retire_init_lock();
+	for (;;) {
+		IOLockLock(sweet_retire_lock);
+		if (sweet_retire_count < SWEET_V2_RETIRE_CAP) {
+			uint32_t tail = (sweet_retire_head + sweet_retire_count) % SWEET_V2_RETIRE_CAP;
+			sweet_retire_ring[tail].md = dead->md;
+			sweet_retire_ring[tail].bytes = dead->bytes;
+			sweet_retire_ring[tail].iova = dead->iova;
+			sweet_retire_ring[tail].pool_pa = dead->pool_pa;
+			sweet_retire_ring[tail].imported = dead->imported;
+			sweet_retire_ring[tail].fence = dead->iova != 0 ? sweet_gpu_last_fence() : 0;
+			__atomic_store_n(&sweet_retire_count, sweet_retire_count + 1, __ATOMIC_RELEASE);
+			IOLockUnlock(sweet_retire_lock);
+			return;
+		}
+		IOLockUnlock(sweet_retire_lock);
+		if (!sweet_v2_wait_oldest_retired()) {
+			if (dead->iova != 0) {
+				sweet_gpu_unmap_at(dead->iova, dead->bytes);
+			}
+			struct sweet_v2_retired one = {
+				dead->md, dead->bytes, dead->iova, dead->pool_pa, 0, dead->imported
+			};
+			sweet_v2_finish_retired_batch(&one, 1);
+			return;
+		}
+	}
+}
