+static bool
+valid_scan_uuid(const char uuid[64])
+{
+	if ((uint8_t)uuid[0] <= 0x20 || (uint8_t)uuid[0] >= 0x7f) {
+		return false;
+	}
+	for (unsigned i = 1; i < 64; i++) {
+		uint8_t c = (uint8_t)uuid[i];
