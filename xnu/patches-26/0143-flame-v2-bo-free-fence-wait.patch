From d5a5725b23aa3b254b83aac38323b05fa11b9a90 Mon Sep 17 00:00:00 2001
From: XNU 26 Rebase <rebase@local>
Date: Tue, 27 Oct 2026 19:13:32 +0000
Subject: [PATCH] flame: wait for queued GPU work before v2 BoFree unmaps or
 recycles pool pages

---
 bsd/dev/sweet_gpu.c                   | 10 ++++++++++
 iokit/Kernel/arm/SweetAccelerator.cpp | 20 +++++++++++++++++---
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 0f17f42..9fc3fd5 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1187,6 +1187,16 @@ sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bo
 	return fence;
 }
 
+uint32_t sweet_gpu_last_fence(void);
+uint32_t
+sweet_gpu_last_fence(void)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	uint32_t fence = gpu_ready ? gpu.fence : 0;
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return fence;
+}
+
 bool
 sweet_gpu_fence_done(uint32_t fence)
 {
diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index 3332c15..54faed2 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -60,6 +60,7 @@ void sweet_gpu_window_free(uint64_t base);
 int sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages);
 void sweet_gpu_unmap_at(uint64_t iova, uint64_t len);
 uint32_t sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy);
+uint32_t sweet_gpu_last_fence(void);
 int sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns);
 bool sweet_gpu_lost(uint64_t *epoch, uint32_t last_fence);
 uint64_t sweet_gpu_recoveries(void);
@@ -264,8 +265,9 @@ SweetAcceleratorUserClient::free(void)
 	 * memory under the GPU would fault, or hand the VAs and pages to someone else while the GPU still
 	 * writes them: wait for its last fence first.
 	 */
-	if (fLastFence != 0 && (fV2 ? sweet_gpu_wait_fence_ns(fLastFence, 2000000000ULL) : sweet_gpu_wait_fence(fLastFence, 2000))) {
-		IOLog("SWEET MTL: client freed with fence %u still pending\n", fLastFence);
+	uint32_t closeFence = fV2 ? sweet_gpu_last_fence() : fLastFence;
+	if (closeFence != 0 && (fV2 ? sweet_gpu_wait_fence_ns(closeFence, 2000000000ULL) : sweet_gpu_wait_fence(closeFence, 2000))) {
+		IOLog("SWEET MTL: client freed with fence %u still pending\n", closeFence);
 	}
 	if (fBO != NULL) {
 		IOLog("SWEET MTL: v2 %s closed (GPU pool: %llu MB held, peak %llu MB)\n", fName, fPoolBytes >> 20, fPoolPeak >> 20);
@@ -817,6 +819,14 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 	}
 	case NativeAdrenoMethodBoFree: {
 		V2_IN(NativeAdrenoAbiBoFree);
+		/*
+		 * Submits are asynchronous: drain any queued GPU work before unmapping SMMU PTEs or returning
+		 * physical pool pages to gpool (where the next BoAlloc immediately zeroes them).
+		 */
+		uint32_t fence = sweet_gpu_last_fence();
+		if (fence != 0) {
+			(void)sweet_gpu_wait_fence_ns(fence, 2000000000ULL);
+		}
 		IOLockLock(fLock);
 		SweetV2BO *bo = v2Find(rq->handle);
 		if (bo != NULL) {
@@ -865,8 +875,12 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 		if (fence == 0) {
 			return busy ? kIOReturnBusy : kIOReturnNotReady;
 		}
-		fLastFence = fence;
+		IOLockLock(fLock);
+		if (fLastFence == 0 || (int32_t)(fence - fLastFence) > 0) {
+			fLastFence = fence;
+		}
 		fSubmits++;
+		IOLockUnlock(fLock);
 		rp->fence = fence;
 		return kIOReturnSuccess;
 	}
-- 
2.43.0

