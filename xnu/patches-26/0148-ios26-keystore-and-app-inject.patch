 static uint64_t exec_inject_hits;
 SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED,
     exec_inject_conf, sizeof(exec_inject_conf),
@@ -6806,19 +6807,18 @@ sweet_exec_inject_init(void)
 	}
 	ctx = vfs_context_kernel();
 	if (vnode_open("/private/var/local/inject.conf", FREAD, 0, 0, &vp, ctx) == 0) {
-		char raw[1024];
 		int resid = 0;
-		bzero(raw, sizeof(raw));
-		if (vn_rdwr(UIO_READ, vp, raw, (int)(sizeof(raw) - 1), 0, UIO_SYSSPACE,
+		bzero(exec_inject_raw, sizeof(exec_inject_raw));
+		if (vn_rdwr(UIO_READ, vp, exec_inject_raw, (int)(sizeof(exec_inject_raw) - 1), 0, UIO_SYSSPACE,
 		    IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) == 0) {
-			size_t n = (sizeof(raw) - 1) - (size_t)resid;
+			size_t n = (sizeof(exec_inject_raw) - 1) - (size_t)resid;
 			size_t out = 0;
 			bool in_space = true, need_sep = false, has_tok = false;
-			raw[n] = '\0';
+			exec_inject_raw[n] = '\0';
 			for (size_t i = 0; i < n && out + 4 < sizeof(exec_inject_conf); i++) {
-				char c = raw[i];
+				char c = exec_inject_raw[i];
 				if (c == '#') {
-					while (i < n && raw[i] != '\n') {
+					while (i < n && exec_inject_raw[i] != '\n') {
 						i++;
 					}
 					c = '\n';
@@ -6872,11 +6872,51 @@ sweet_exec_inject_init(void)
 	}
 }
 
+static bool
+sweet_is_userapp(struct image_params *imgp)
+{
+	const char *exec_path, *slash;
+	char marker[256];
+	size_t keylen = strlen(EXECUTABLE_KEY);
+	size_t prefix_len;
+
+	if (imgp->ip_strings == NULL ||
+	    strncmp(imgp->ip_strings, EXECUTABLE_KEY, keylen) != 0) {
+		return false;
+	}
+	exec_path = imgp->ip_strings + keylen;
+	if (strncmp(exec_path, "/private/var/containers/Bundle/Application/", 43) == 0 ||
+	    strncmp(exec_path, "/var/containers/Bundle/Application/", 35) == 0) {
+		return true;
+	}
+	if (strncmp(exec_path, "/Applications/", 14) == 0) {
+		slash = strchr(exec_path + 14, '/');
+		if (slash != NULL && slash >= exec_path + 18 &&
+		    strncmp(slash - 4, ".app", 4) == 0) {
+			prefix_len = (size_t)(slash - exec_path);
+			if ((prefix_len == strlen("/Applications/SweetStore.app") &&
+			    strncmp(exec_path, "/Applications/SweetStore.app", prefix_len) == 0) ||
+			    (prefix_len == strlen("/Applications/SweetAuth.app") &&
+			    strncmp(exec_path, "/Applications/SweetAuth.app", prefix_len) == 0)) {
+				return false;
+			}
+			if (prefix_len + sizeof("/.sweetstore_installed") <= sizeof(marker)) {
+				memcpy(marker, exec_path, prefix_len);
+				memcpy(marker + prefix_len, "/.sweetstore_installed",
+				    sizeof("/.sweetstore_installed"));
+				return sweet_file_exists(marker, vfs_context_kernel());
+			}
+		}
+	}
+	return false;
+}
+
 static bool
 exec_inject_env(struct image_params *imgp, char *env, size_t size)
 {
 	const char *name, *p = exec_inject_conf;
 	size_t namelen, used;
+	int is_userapp = -1;
 	bool any = false;
 
 	if (*p == '\0' || imgp->ip_ndp == NULL) {
@@ -6900,12 +6940,23 @@ exec_inject_env(struct image_params *imgp, char *env, size_t size)
 		liblen = (size_t)(p - library);
 		while (*p == ' ') {
 			const char *word = ++p;
+			size_t wlen;
 			while (*p != '\0' && *p != ' ' && *p != ';') {
 				p++;
 			}
-			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
-			    strncmp(word, name, namelen) == 0) {
-				matched = true;
+			wlen = (size_t)(p - word);
+			if (!matched && liblen != 0) {
+				if (wlen == 9 && strncmp(word, "@userapps", 9) == 0) {
+					if (is_userapp < 0) {
+						is_userapp = sweet_is_userapp(imgp) ? 1 : 0;
+					}
+					if (is_userapp == 1) {
+						matched = true;
+					}
+				} else if (wlen == namelen && namelen != 0 &&
+				    strncmp(word, name, namelen) == 0) {
+					matched = true;
+				}
 			}
 		}
 		if (matched && liblen != 0 && used + 1 + liblen < size) {
diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index 670fa89..9797cdd 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -48,8 +48,12 @@ enum {
 	kAKSNotifyStateSet   = 102,
 	kAKSNotifyStateIsSet = 103,
 	kAKSAssertConsume    = 101,     /* aks_assert_consume */
+	kAKSSESupportIsSet   = 107,     /* aks_se_support_in_rm_is_set (iOS 26) */
+	kAKSGetState142      = 142,     /* extended state query (iOS 26 ReportCrash) */
 };
 
+#define SWEET_AKS_MAX_KEY_BYTES 1024
+
 /* The system (device) bag handle. */
 #define SWEET_AKS_SYSTEM_HANDLE 0
 
@@ -99,6 +103,30 @@ AppleKeyStoreUserClient::clientClose(void)
 	return kIOReturnSuccess;
 }
 
+/* Copy input structure (inband or descriptor) into dst (1..max_len bytes). */
+static IOReturn
+sweet_aks_struct_in(IOExternalMethodArguments *args, void *dst, size_t max_len, size_t *out_len)
+{
+	if (args->structureInputDescriptor != NULL) {
+		IOByteCount dlen = args->structureInputDescriptor->getLength();
+		if (dlen == 0 || dlen > max_len) {
+			return kIOReturnBadArgument;
+		}
+		if (args->structureInputDescriptor->readBytes(0, dst, dlen) != dlen) {
+			return kIOReturnVMError;
+		}
+		*out_len = (size_t)dlen;
+		return kIOReturnSuccess;
+	}
+	if (args->structureInput == NULL || args->structureInputSize == 0 ||
+	    args->structureInputSize > max_len) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(dst, args->structureInput, args->structureInputSize);
+	*out_len = (size_t)args->structureInputSize;
+	return kIOReturnSuccess;
+}
+
 /* Copy len bytes to the caller's output structure (inband or descriptor). */
 static IOReturn
 sweet_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
@@ -197,6 +225,24 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 	case kAKSNotifyStateSet:
 		args->scalarOutputCount = 0;
 		break;
+	case kAKSCreateBag:
+	case kAKSLoadBag:
+		if (out_scalars >= 1) {
+			args->scalarOutput[0] = SWEET_AKS_SYSTEM_HANDLE;
+			args->scalarOutputCount = 1;
+		} else {
+			args->scalarOutputCount = 0;
+		}
+		break;
+	case kAKSSaveBag: {
+		static const uint8_t dummy_bag[16] = "SWEETBAG";
+		args->scalarOutputCount = 0;
+		if (out_struct > 0) {
+			ret = sweet_aks_struct_out(args, dummy_bag,
+			    out_struct < sizeof(dummy_bag) ? out_struct : (uint32_t)sizeof(dummy_bag));
+		}
+		break;
+	}
 	case kAKSGetSystem:
 		if (out_scalars < 1) {
 			ret = kIOReturnBadArgument;
@@ -214,7 +260,8 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		args->scalarOutputCount = 1;
 		break;
 	case kAKSNotifyStateIsSet:
-		/* Nothing was ever set: answer "not set". */
+	case kAKSSESupportIsSet:
+		/* Nothing was ever set / no SEP RM support: answer 0. */
 		if (out_scalars < 1) {
 			ret = kIOReturnBadArgument;
 			break;
@@ -224,50 +271,63 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	case kAKSGetDeviceState:
 	case kAKSGetExtDeviceState:
+	case kAKSGetState142:
 		args->scalarOutputCount = 0;
 		ret = sweet_aks_device_state(args);
 		break;
 	/*
-	 * (from HackiOS) kAKSWrapKey / kAKSUnwrapKey: securityd wraps each keychain item's key with
-	 * its protection class before storing it. No SEP, no secret: a mark, the class and the key
-	 * mixed with a fixed pattern, 8 bytes longer like AES key wrap. Without them no keychain item
-	 * (wifid's network passwords among them) could be stored.
+	 * (from HackiOS, widened to 1024 B + IOMemoryDescriptor) kAKSWrapKey / kAKSUnwrapKey:
+	 * securityd wraps each keychain item's key with its protection class before storing it.
+	 * No SEP, no secret: a mark, the class and the key mixed with a fixed pattern, 8 bytes
+	 * longer like AES key wrap. Preserves scalarOutput[0] (keyclass) on both wrap and unwrap.
 	 */
 	case kAKSWrapKey: {
-		uint8_t wrapped[8 + 64];
-		size_t len = args->structureInputSize;
-		if (args->structureInput == NULL || len == 0 || len > 64 || in_scalars < 2) {
+		uint8_t wrapped[8 + SWEET_AKS_MAX_KEY_BYTES];
+		size_t len = 0;
+		if (in_scalars < 2) {
 			ret = kIOReturnBadArgument;
 			break;
 		}
+		ret = sweet_aks_struct_in(args, wrapped + 8, SWEET_AKS_MAX_KEY_BYTES, &len);
+		if (ret != kIOReturnSuccess) {
+			break;
+		}
 		memcpy(wrapped, "HKwr", 4);
 		wrapped[4] = (uint8_t)args->scalarInput[1];
 		wrapped[5] = wrapped[6] = wrapped[7] = 0;
-		memcpy(wrapped + 8, args->structureInput, len);
 		for (size_t i = 0; i < len; i++) {
 			wrapped[8 + i] ^= (uint8_t)(0x5a + 37 * i);
 		}
 		if (out_scalars >= 1) {
 			args->scalarOutput[0] = args->scalarInput[1];
 			args->scalarOutputCount = 1;
+		} else {
+			args->scalarOutputCount = 0;
 		}
 		ret = sweet_aks_struct_out(args, wrapped, (uint32_t)(8 + len));
 		break;
 	}
 	case kAKSUnwrapKey: {
-		uint8_t key[64];
-		const uint8_t *w = (const uint8_t *)args->structureInput;
-		size_t len = args->structureInputSize;
-		if (w == NULL || len <= 8 || len > 8 + sizeof(key) || memcmp(w, "HKwr", 4) != 0) {
+		uint8_t kbuf[8 + SWEET_AKS_MAX_KEY_BYTES];
+		size_t len = 0;
+		ret = sweet_aks_struct_in(args, kbuf, sizeof(kbuf), &len);
+		if (ret != kIOReturnSuccess) {
+			break;
+		}
+		if (len <= 8 || memcmp(kbuf, "HKwr", 4) != 0) {
 			ret = kIOReturnBadArgument;
 			break;
 		}
-		memcpy(key, w + 8, len - 8);
 		for (size_t i = 0; i < len - 8; i++) {
-			key[i] ^= (uint8_t)(0x5a + 37 * i);
+			kbuf[8 + i] ^= (uint8_t)(0x5a + 37 * i);
 		}
-		args->scalarOutputCount = 0;
-		ret = sweet_aks_struct_out(args, key, (uint32_t)(len - 8));
+		if (out_scalars >= 1) {
+			args->scalarOutput[0] = kbuf[4];
+			args->scalarOutputCount = 1;
+		} else {
+			args->scalarOutputCount = 0;
+		}
+		ret = sweet_aks_struct_out(args, kbuf + 8, (uint32_t)(len - 8));
 		break;
 	}
 	default:
