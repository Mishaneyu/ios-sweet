+	sweet_init_diag("/sbin/launchd");
+	sweet_init_diag("/usr/lib/dyld");
+	sweet_init_diag("/bin/sh");
+#endif
 	panic("Process 1 exec of %s failed, errno %d", ((i == 0) ? "<null>" : init_programs[i - 1]), error);
 }
 
