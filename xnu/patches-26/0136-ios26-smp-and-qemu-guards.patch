From 4fd993ace4adf0e70bd529561672ea5c6cb8b316 Mon Sep 17 00:00:00 2001
From: XNU 26 Rebase <rebase@local>
Date: Mon, 26 Oct 2026 10:10:51 +0000
Subject: [PATCH] ios26: sequential SweetCPU ml_processor_register, QEMU
 /sweet-ufs guards, default unentitled_ios_sim_launch

---
 bsd/dev/sweet_keys.c                     |  5 +++
 bsd/dev/sweet_spmi.c                     |  5 +++
 bsd/kern/kern_exec.c                     |  4 +++
 iokit/Kernel/arm/SweetCPU.cpp            | 42 +++++++++++-------------
 iokit/Kernel/arm/SweetPlatformExpert.cpp | 17 ++++++++--
 5 files changed, 47 insertions(+), 26 deletions(-)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index ff39e04..2615242 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -12,6 +12,7 @@
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
+#include <pexpert/device_tree.h>
 #include <pexpert/pexpert.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
@@ -133,6 +134,10 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_started = true;
+	DTEntry ufs_node;
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &ufs_node) != kSuccess) {
+		return;
+	}
 	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
 	if (!enabled) {
 		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 6a121c5..5a84018 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -10,6 +10,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
+#include <pexpert/device_tree.h>
 #include <IOKit/IOLocks.h>
 #include "sweet_spmi.h"
 
@@ -59,6 +60,10 @@ sweet_spmi_init(void)
 		return sp_ready ? 0 : -1;
 	}
 	sp_attempted = true;
+	DTEntry ufs_node;
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &ufs_node) != kSuccess) {
+		return -1;
+	}
 	sp_lock = IOLockAlloc();
 	if (!sp_lock) {
 		return -1;
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 183f960..069c605 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -202,7 +202,11 @@ static TUNABLE(bool, bootarg_execfailurereports, "execfailurecrashes", false);
 
 #if XNU_TARGET_OS_OSX
 #if DEBUG || DEVELOPMENT
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static TUNABLE(bool, unentitled_ios_sim_launch, "unentitled_ios_sim_launch", true);
+#else
 static TUNABLE(bool, unentitled_ios_sim_launch, "unentitled_ios_sim_launch", false);
+#endif
 #endif /* DEBUG || DEVELOPMENT */
 #endif /* XNU_TARGET_OS_OSX */
 
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 2545cf9..92c344f 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -88,31 +88,12 @@ SweetCPU::start(IOService *provider)
 	}
 	setCPUNumber(cpu->cpu_id);
 
-	ml_processor_info_t info = {};
-	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
-	info.phys_id = cpu->phys_id;
-	info.log_id = cpu->cpu_id;
-	info.cluster_id = cpu->cluster_id;
-	info.cluster_type = cpu->cluster_type;
-	info.l2_cache_id = cpu->l2_cache_id;
-	info.l2_cache_size = cpu->l2_cache_size;
-	info.l3_cache_id = cpu->l3_cache_id;
-	info.l3_cache_size = cpu->l3_cache_size;
-	perfmon_interrupt_handler_func pmi_handler = NULL;
-	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
-	if (result != KERN_SUCCESS) {
-		panic("SWEET CPU: ml_processor_register failed: %d", result);
-	}
-	if (pmi_handler != NULL) {
-		panic("SWEET CPU: PMI routing is not implemented");
-	}
-
 	registerService();
 	__atomic_store_n(&sweet_cpus[cpu->cpu_id], this, __ATOMIC_RELEASE);
 	__atomic_add_fetch(&sweet_cpus_registered, 1, __ATOMIC_ACQ_REL);
 	if (cpu == topology->boot_cpu) {
 		thread_t thread;
-		result = kernel_thread_start(&SweetCPU::startAll, NULL, &thread);
+		kern_return_t result = kernel_thread_start(&SweetCPU::startAll, NULL, &thread);
 		if (result != KERN_SUCCESS) {
 			panic("SWEET CPU: cannot create startup thread: %d", result);
 		}
@@ -150,11 +131,26 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
-		kern_return_t kr = processor_start(cpu->machProcessor);
+		const ml_topology_cpu_t *tcpu = &topology->cpus[i];
+		ml_processor_info_t info = {};
+		info.cpu_id = reinterpret_cast<cpu_id_t>(cpu);
+		info.phys_id = tcpu->phys_id;
+		info.log_id = tcpu->cpu_id;
+		info.cluster_id = tcpu->cluster_id;
+		info.cluster_type = tcpu->cluster_type;
+		info.l2_cache_id = tcpu->l2_cache_id;
+		info.l2_cache_size = tcpu->l2_cache_size;
+		info.l3_cache_id = tcpu->l3_cache_id;
+		info.l3_cache_size = tcpu->l3_cache_size;
+		perfmon_interrupt_handler_func pmi_handler = NULL;
+		/* In xnu-12377 (!USE_APPLEARMSMP), ml_processor_register calls processor_boot directly. */
+		kern_return_t kr = ml_processor_register(&info, &cpu->machProcessor, &cpu->ipi_handler, &pmi_handler);
 		if (kr != KERN_SUCCESS) {
-			panic("SWEET CPU: cpu=%u processor_start failed: %d", i, kr);
+			panic("SWEET CPU: cpu=%u ml_processor_register failed: %d", i, kr);
+		}
+		if (pmi_handler != NULL) {
+			panic("SWEET CPU: PMI routing is not implemented");
 		}
-		/* processor_start() is asynchronous for secondaries in this XNU. */
 		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
 		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
 		    !sweet_cpu_signal_is_enabled(i)) {
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 2514af3..5b8c054 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -86,6 +86,7 @@ flame_wdt_start(void)
  * RTC is published as the IORTC resource: IOKitInitializeTime waits up to
  * 30 s for it (every boot did) before reading the calendar.
  */
+#include <pexpert/device_tree.h>
 #include "../../../bsd/dev/sweet_spmi.h"
 
 #define PM8150_RTC_CTRL         0x6046
@@ -151,18 +152,28 @@ extern "C" void sweet_poke_start(void);
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
-	sweet_log_mirror_start();       /* crash rescue: bsd/dev/sweet_ufs.c */
+	DTEntry ufs_node;
+	bool has_ufs = (SecureDTLookupEntry(NULL, "/sweet-ufs", &ufs_node) == kSuccess);
+
+	if (has_ufs) {
+		sweet_log_mirror_start();       /* crash rescue: bsd/dev/sweet_ufs.c */
+	}
 	IOLog("SWEET: starting device-tree platform expert\n");
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
-	flame_wdt_start();
+	if (has_ufs) {
+		flame_wdt_start();
+	}
 	sweet_poke_start();             /* register scripts: bsd/dev/sweet_poke.c */
 	uint32_t rtc = 0;
 	uint8_t ctrl = 0;
-	if (sweet_rtc_read(&rtc) == 0 && sweet_spmi_read(0, PM8150_RTC_CTRL, &ctrl) == 0) {
+	if (has_ufs && sweet_rtc_read(&rtc) == 0 && sweet_spmi_read(0, PM8150_RTC_CTRL, &ctrl) == 0) {
 		IOLog("SWEET RTC: PM8150 RTC %u s (ctrl %02x), time of day %ld\n", rtc, ctrl, getGMTTimeOfDay());
 		publishResource("IORTC", this);
+	} else if (!has_ufs) {
+		IOLog("SWEET RTC: virtual platform (no /sweet-ufs); publishing synthetic IORTC\n");
+		publishResource("IORTC", this);
 	} else {
 		IOLog("SWEET RTC: PM8150 RTC not readable; no time of day\n");
 	}
-- 
2.43.0

