 	rmx_wait(10);
 	rmx_gpio(RMX_PIN_RESET, 0, 0, 3, true, true);
 	rmx_wait(100);
+	if (rt.bitbang) {
+		rmx_bb_init();
+	}
 
 	if (!rmx_rmi_init()) {
 		goto out;
