+	out->v2 = fV2;
+	out->system = fSystem;
+	out->cap_refused = fCapLogged;
+	out->pool_bytes = fPoolBytes;
+	out->pool_peak = fPoolPeak;
+	out->submits = fSubmits;
+	out->faults = fFaults;
+}
+
+extern "C" void
+sweet_accel_diag_snapshot(struct sweet_diag_gpu *out)
+{
+	if (out == NULL || gAccelClientsLock == NULL) {
+		return;
+	}
+	IOLockLock(gAccelClientsLock);
+	uint32_t n = 0;
+	for (unsigned i = 0; i < SWEET_DIAG_MAX_CLIENTS && n < SWEET_DIAG_MAX_CLIENTS; i++) {
+		if (gAccelClients[i] != NULL) {
+			gAccelClients[i]->fillClientDiag(&out->clients[n++]);
+		}
+	}
+	out->client_count = n;
+	IOLockUnlock(gAccelClientsLock);
+}
