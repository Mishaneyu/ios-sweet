+#define PANEL_W		1080
+#define PANEL_H		2400
+#define DISPLAY_DIM_OFF		0x410000ULL	/* 256 x 16x16 (64B pitch) black alpha tiles for backlight dimming */
+#define DISPLAY_DIM_TILE	16u
+#define DISPLAY_DIM_PITCH	(DISPLAY_DIM_TILE * 4)
