+
+static void
+display_dim_build(void)
+{
+	for (uint32_t a = 0; a < 256; a++) {
+		uint32_t *tile = (uint32_t *)(pool_kva + DISPLAY_DIM_OFF + (size_t)a * DISPLAY_DIM_STRIDE);
+		uint32_t px = a << 24;
+		for (uint32_t i = 0; i < DISPLAY_DIM_TILE * DISPLAY_DIM_TILE; i++) {
+			tile[i] = px;
+		}
+	}
+	flush_dcache64((addr64_t)(pool_kva + DISPLAY_DIM_OFF), 256u * DISPLAY_DIM_STRIDE, FALSE);
+	display_dim_built = true;
+}
 
 static uint64_t stat_frames, stat_clean_abs, stat_gpu_abs;
 
@@ -622,10 +643,63 @@ sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h,
 	if (ext > DISPLAY_MASK_SIDE || 2 * ext >= frame.dw || 2 * ext >= frame.dh) {
 		ext = 0;
 	}
-	static uint32_t ib[10 * A6_BLIT_MAX_DW];
+	static uint32_t ib[16 * A6_BLIT_MAX_DW];
 	lck_mtx_lock(&sweet_gpu_lock);
+	uint32_t dim = sweet_backlight_alpha;
+	if (dim > 240) {
+		dim = 240;
+	}
 	uint32_t n = 0;
-	if (ext) {
+	if (dim > 0) {
+		/*
+		 * Tear-free AMOLED software dimming: scale into DISPLAY_STAGE_OFF, blend the
