+/*
+ * AppleARMBacklight matching IODeviceTree:/backlight for CoreBrightness / BacklightServices.
+ * Converts linear Q16.16 brightness-nits (D22AP user max = 625 nits = 40960000) into an sRGB
+ * gamma-2.0 perceptual scale via integer square root, driving tear-free Adreno 640 2D dimming.
+ */
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+	IOLock  *fLock;
+	uint32_t fMillinits;
+	uint32_t fRawLevel;
+	uint32_t fLogCount;
+
+	static OSDictionary *makeRange(uint32_t mn, uint32_t mx, uint32_t val);
+	void publishDisplayParams(void);
+	void applyNitsQ16(uint32_t rawQ16);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void fillDiag(struct sweet_diag_display *out);
+	void setPercent(uint32_t pct);
+};
+
+static AppleARMBacklight *gMainBacklight;
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static uint32_t
+sweet_isqrt32(uint32_t n)
+{
+	uint32_t res = 0;
+	uint32_t bit = 1u << 30;
+	while (bit > n) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (n >= res + bit) {
+			n -= res + bit;
+			res = (res >> 1) + bit;
+		} else {
+			res >>= 1;
+		}
+		bit >>= 2;
+	}
+	return res;
+}
+
+OSDictionary *
+AppleARMBacklight::makeRange(uint32_t mn, uint32_t mx, uint32_t val)
+{
+	OSDictionary *d = OSDictionary::withCapacity(3);
+	if (d == NULL) {
+		return NULL;
+	}
+	OSNumber *nMin = OSNumber::withNumber((uint64_t)mn, 32);
+	OSNumber *nMax = OSNumber::withNumber((uint64_t)mx, 32);
+	OSNumber *nVal = OSNumber::withNumber((uint64_t)val, 32);
+	if (nMin != NULL) {
+		d->setObject("min", nMin);
+		nMin->release();
+	}
+	if (nMax != NULL) {
+		d->setObject("max", nMax);
+		nMax->release();
+	}
+	if (nVal != NULL) {
+		d->setObject("value", nVal);
+		nVal->release();
+	}
+	return d;
+}
+
+void
+AppleARMBacklight::publishDisplayParams(void)
+{
+	OSDictionary *params = OSDictionary::withCapacity(3);
+	if (params == NULL) {
+		return;
+	}
+	OSDictionary *dBri = makeRange(6, 2047, fRawLevel);
+	OSDictionary *dNits = makeRange(2000, 625000, fMillinits);
+	OSDictionary *dAmps = makeRange(0, 100000, 25000);
+	if (dBri != NULL) {
+		params->setObject("brightness", dBri);
+		dBri->release();
+	}
+	if (dNits != NULL) {
+		params->setObject("BrightnessMilliNits", dNits);
+		dNits->release();
+	}
+	if (dAmps != NULL) {
+		params->setObject("BrightnessMicroAmps", dAmps);
+		dAmps->release();
+	}
+	setProperty("IODisplayParameters", params);
+	params->release();
+}
+
+void
+AppleARMBacklight::applyNitsQ16(uint32_t rawQ16)
+{
+	const uint64_t maxQ16 = 625ULL * 65536ULL;
+	uint64_t clamped = rawQ16 > maxQ16 ? maxQ16 : (uint64_t)rawQ16;
+	uint32_t ratioQ16 = (uint32_t)((clamped * 65536ULL) / maxQ16);
+	uint32_t scale256 = sweet_isqrt32(ratioQ16);	/* 0..256 perceptual sRGB scale */
+	if (rawQ16 > 0 && scale256 < 20) {
+		scale256 = 20;				/* ~8% minimum readable floor */
+	}
+	uint32_t alpha;
+	if (rawQ16 == 0) {
+		alpha = 255;	/* True AMOLED 0-nit black (0xff000000) on lock/sleep */
+		fMillinits = 0;
+		fRawLevel = 0;
+	} else {
+		alpha = scale256 >= 256 ? 0 : (256u - scale256);
+		if (alpha > 236) {
+			alpha = 236;
+		}
+		fMillinits = (uint32_t)((clamped * 1000ULL) >> 16);
+		if (fMillinits < 2000) {
+			fMillinits = 2000;
+		}
+		fRawLevel = (uint32_t)(6u + ((uint64_t)scale256 * 2041ULL) / 256ULL);
+		if (fRawLevel > 2047) {
+			fRawLevel = 2047;
+		}
+	}
+	uint32_t prev = sweet_backlight_alpha;
+	sweet_backlight_alpha = alpha;
+	setProperty("brightness-nits", (uint64_t)rawQ16, 32);
+	publishDisplayParams();
+	if (fLogCount < 8) {
+		fLogCount++;
+		IOLog("SWEET BL: nits_q16=%u (%u mNits) -> sRGB %u/256 dim_alpha=%u\n",
+		    rawQ16, fMillinits, scale256, alpha);
+	}
+	if (alpha != prev && gMainFB != NULL) {
+		gMainFB->refreshBrightness();
+	}
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	if (fLock == NULL) {
+		return false;
+	}
+	fMillinits = 625000;
+	fRawLevel = 2047;
+	fLogCount = 0;
+	sweet_backlight_alpha = 0;
+	setProperty("backlight-control", kOSBooleanTrue);
+	setProperty("BuiltIn", kOSBooleanTrue);
+	setProperty("brightness-nits", (uint64_t)(625ULL * 65536ULL), 32);
+	publishDisplayParams();
+	gMainBacklight = this;
+	registerService();
+	IOLog("SWEET BL: AppleARMBacklight registered on /backlight (max 625 nits)\n");
+	return true;
+}
+
+static bool
+sweet_extract_u32(OSObject *obj, uint32_t *out)
+{
+	OSNumber *num = OSDynamicCast(OSNumber, obj);
+	if (num != NULL) {
+		*out = num->unsigned32BitValue();
+		return true;
+	}
+	OSDictionary *d = OSDynamicCast(OSDictionary, obj);
+	if (d != NULL) {
+		OSNumber *v = OSDynamicCast(OSNumber, d->getObject("value"));
+		if (v != NULL) {
+			*out = v->unsigned32BitValue();
+			return true;
+		}
+	}
+	return false;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	uint32_t v = 0;
+	if (sweet_extract_u32(dict->getObject("brightness-nits"), &v)) {
+		applyNitsQ16(v);
+	} else if (sweet_extract_u32(dict->getObject("BrightnessMilliNits"), &v)) {
+		applyNitsQ16((uint32_t)(((uint64_t)v << 16) / 1000ULL));
+	} else if (sweet_extract_u32(dict->getObject("brightness"), &v)) {
+		uint32_t lvl = v > 2047 ? 2047 : v;
+		uint64_t lin = ((uint64_t)lvl * (uint64_t)lvl * 625ULL * 65536ULL) / (2047ULL * 2047ULL);
+		applyNitsQ16((uint32_t)lin);
+	} else {
+		OSDictionary *dp = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+		if (dp != NULL) {
+			if (sweet_extract_u32(dp->getObject("BrightnessMilliNits"), &v)) {
+				applyNitsQ16((uint32_t)(((uint64_t)v << 16) / 1000ULL));
+			} else if (sweet_extract_u32(dp->getObject("brightness"), &v)) {
+				uint32_t lvl = v > 2047 ? 2047 : v;
+				uint64_t lin = ((uint64_t)lvl * (uint64_t)lvl * 625ULL * 65536ULL) / (2047ULL * 2047ULL);
+				applyNitsQ16((uint32_t)lin);
+			}
+		}
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+void
+AppleARMBacklight::fillDiag(struct sweet_diag_display *out)
+{
+	IOLockLock(fLock);
+	out->backlight_registered = true;
+	out->millinits = fMillinits;
+	out->raw_level = fRawLevel;
+	out->dim_alpha = sweet_backlight_alpha;
+	IOLockUnlock(fLock);
+}
+
+void
+AppleARMBacklight::setPercent(uint32_t pct)
+{
+	if (pct > 100) {
+		pct = 100;
+	}
+	uint64_t lin = ((uint64_t)pct * (uint64_t)pct * 625ULL * 65536ULL) / 10000ULL;
+	IOLockLock(fLock);
+	applyNitsQ16((uint32_t)lin);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::fillDiag(struct sweet_diag_display *out)
+{
+	uint64_t now = mach_absolute_time();
+	uint64_t one_sec_abs = 0;
+	nanoseconds_to_absolutetime(1000000000ULL, &one_sec_abs);
+
+	IOLockLock(fLock);
+	out->registered = true;
+	out->power_on = !fPowerOff;
+	out->direct_present = fDirectPresent;
+	out->force_cpu = fForceCPU;
+	out->gpu_ever = fGPU;
+	out->last_present_gpu = fLastPresentGPU;
+	out->panel_pa = fPhys;
+	out->panel_w = fWidth;
+	out->panel_h = fHeight;
+	out->panel_stride = fRowBytes;
+	out->logical_w = fLogicalW;
+	out->logical_h = fLogicalH;
+	out->fit_x = sweet_display_fit_x;
+	out->fit_y = sweet_display_fit_y;
+	out->fit_w = sweet_display_fit_w;
+	out->fit_h = sweet_display_fit_h;
+	out->corner_radius = fCornerRadius;
+	out->corner_ext = fCornerExt;
+	out->vsync_hz = fFlushTicks ? (uint32_t)(60u / fFlushTicks) : 60u;
+	out->vsync_count = fVsyncCount;
+	out->swaps_total = sweet_fb_swap_count;
+	out->presents_total = fTotalPresents;
+	out->gpu_presents = fGpuPresents;
+	out->cpu_presents = fCpuPresents;
+	out->fps_5s_x10 = fLast5sFpsX10;
+	out->last_5s_swaps = fLast5sSwaps;
+	out->last_5s_presents = fLast5sPresents;
+	out->avg_present_us = fLast5sAvgUs;
+	out->clients_count = fClients != NULL ? fClients->getCount() : 0;
+	out->last_surf_id = fLastSurfId;
+	out->last_surf_w = fLastSurfW;
+	out->last_surf_h = fLastSurfH;
+	out->last_surf_bpr = fLastSurfBpr;
+	out->last_surf_fmt = fLastSurfFmt;
+	out->last_layer_mask = fLastLayerMask;
+	if (fHasSwap && now >= fLastSwapAbs) {
+		uint64_t age_ns = 0;
+		absolutetime_to_nanoseconds(now - fLastSwapAbs, &age_ns);
+		out->last_swap_age_ms = age_ns / 1000000ULL;
+	}
+	uint32_t count_1s = 0;
+	uint32_t lim = fSwapRingIdx < 128u ? fSwapRingIdx : 128u;
+	for (uint32_t i = 0; i < lim; i++) {
+		uint64_t ts = fSwapRingAbs[i];
+		if (ts != 0 && now >= ts && (now - ts) <= one_sec_abs) {
+			count_1s++;
+		}
+	}
+	out->fps_1s_x10 = count_1s * 10u;
+	out->gpu_fallback_mask = sweet_fb_gpu_why_logged;
+	out->gpu_fallback_count = sweet_fb_gpu_fallback_count;
+	strlcpy(out->last_fallback_reason, sweet_fb_last_fallback, sizeof(out->last_fallback_reason));
+	out->dim_alpha = sweet_backlight_alpha;
+	IOLockUnlock(fLock);
+}
+
+int
+AppleCLCD::setPresentMode(const char *mode)
+{
+	if (mode == NULL) {
+		return -1;
+	}
+	IOLockLock(fLock);
+	if (!strncmp(mode, "direct", 6)) {
+		fDirectPresent = true;
+		fForceCPU = false;
+	} else if (!strncmp(mode, "vsync", 5)) {
+		fDirectPresent = false;
+		fForceCPU = false;
+	} else if (!strncmp(mode, "cpu", 3)) {
+		fForceCPU = true;
+	} else if (!strncmp(mode, "gpu", 3)) {
+		fForceCPU = false;
+	} else {
+		IOLockUnlock(fLock);
+		return -1;
+	}
+	if (fHasSwap && !fPowerOff) {
+		memcpy(fPending, fLastRec, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = true;
+	}
+	IOLockUnlock(fLock);
+	return 0;
+}
+
+extern "C" void
+sweet_fb_diag_snapshot(struct sweet_diag_display *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	if (gMainFB != NULL) {
+		gMainFB->fillDiag(out);
+	}
+	if (gMainBacklight != NULL) {
+		gMainBacklight->fillDiag(out);
+	}
+}
+
+extern "C" int
+sweet_fb_set_mode(const char *mode)
+{
+	return gMainFB != NULL ? gMainFB->setPresentMode(mode) : -1;
+}
+
+extern "C" int
+sweet_backlight_set_pct(uint32_t pct)
+{
+	if (gMainBacklight == NULL) {
+		return -1;
+	}
+	gMainBacklight->setPercent(pct);
+	return 0;
+}
+
+extern "C" bool
+sweet_fb_is_blanked(void)
+{
+	return (gMainFB != NULL && gMainFB->fPowerOff) || sweet_backlight_alpha >= 255u;
+}
 #endif /* SWEET */
