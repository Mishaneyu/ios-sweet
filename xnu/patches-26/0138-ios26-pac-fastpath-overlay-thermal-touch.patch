+/*
+ * Sandbox user-state store for libsandbox.1.dylib (used by containermanagerd
+ * & containermanagerd_system on iOS 26 for container class sentinels):
+ *   op 15 (_sandbox_user_state_item_buffer_send): arg = { u64 buf, u64 len }
+ *   op 16 (_sandbox_user_state_iterate_items):    arg = { u64 mode, u64 uid, u64 buf, u64 cap, u64 out_len_ptr }
+ */
+#define SWEET_SB_USER_STATE_SLOTS       16
+#define SWEET_SB_USER_STATE_MAX_BYTES   (256 * 1024)
+
+struct sweet_sb_user_state_slot {
+	bool     used;
+	uid_t    uid;
+	uint8_t *data;
+	size_t   len;
+	size_t   cap;
+};
+
+static LCK_GRP_DECLARE(sweet_sb_state_grp, "sweet_sb_state");
+static LCK_MTX_DECLARE(sweet_sb_state_mtx, &sweet_sb_state_grp);
+static struct sweet_sb_user_state_slot sweet_sb_slots[SWEET_SB_USER_STATE_SLOTS];
+
+static int
+sweet_sandbox_user_state_send(struct proc *p, user_addr_t arg)
+{
+	struct {
+		uint64_t buf_ptr;
+		uint64_t buf_len;
+	} in;
+	int error = copyin(arg, &in, sizeof(in));
+	if (error) {
+		return error;
+	}
+	if (in.buf_ptr == 0 || in.buf_len < 8 || (in.buf_len & 7) != 0 ||
+	    in.buf_len > SWEET_SB_USER_STATE_MAX_BYTES) {
+		return EINVAL;
+	}
+	size_t klen = (size_t)in.buf_len;
+	uint8_t *kbuf = kalloc_data(klen, Z_WAITOK | Z_ZERO);
+	if (kbuf == NULL) {
+		return ENOMEM;
+	}
+	error = copyin((user_addr_t)in.buf_ptr, kbuf, klen);
+	if (error) {
+		kfree_data(kbuf, klen);
+		return error;
+	}
+	size_t payload = klen;
+	while (payload >= 8) {
+		uint64_t tail = 0;
+		memcpy(&tail, kbuf + payload - 8, 8);
+		if (tail != 0) {
+			break;
+		}
+		payload -= 8;
+	}
+	if (payload == 0) {
+		kfree_data(kbuf, klen);
+		return 0;
+	}
+	uid_t uid = kauth_cred_getuid(kauth_cred_get());
+	(void)p;
+	uint16_t wtype = 0, wtag = 0;
+	memcpy(&wtype, kbuf, 2);
+	memcpy(&wtag, kbuf + 2, 2);
+	if (wtype == 1 && wtag == 0) {
+		memcpy(&uid, kbuf + 4, 4);
+	}
+
+	lck_mtx_lock(&sweet_sb_state_mtx);
+	struct sweet_sb_user_state_slot *slot = NULL;
+	for (int i = 0; i < SWEET_SB_USER_STATE_SLOTS; i++) {
+		if (sweet_sb_slots[i].used && sweet_sb_slots[i].uid == uid) {
+			slot = &sweet_sb_slots[i];
+			break;
+		}
+	}
+	if (slot == NULL) {
+		for (int i = 0; i < SWEET_SB_USER_STATE_SLOTS; i++) {
+			if (!sweet_sb_slots[i].used) {
+				slot = &sweet_sb_slots[i];
+				slot->used = true;
+				slot->uid = uid;
+				break;
+			}
+		}
+	}
+	if (slot == NULL || slot->len + payload > SWEET_SB_USER_STATE_MAX_BYTES) {
+		lck_mtx_unlock(&sweet_sb_state_mtx);
+		kfree_data(kbuf, klen);
+		return ENOMEM;
+	}
+	if (slot->len + payload > slot->cap) {
+		size_t new_cap = slot->cap ? slot->cap * 2 : 4096;
+		while (new_cap < slot->len + payload) {
+			new_cap *= 2;
+		}
+		uint8_t *new_data = kalloc_data(new_cap, Z_WAITOK | Z_ZERO);
+		if (new_data == NULL) {
+			lck_mtx_unlock(&sweet_sb_state_mtx);
+			kfree_data(kbuf, klen);
+			return ENOMEM;
+		}
+		if (slot->data != NULL) {
+			memcpy(new_data, slot->data, slot->len);
+			kfree_data(slot->data, slot->cap);
+		}
+		slot->data = new_data;
+		slot->cap = new_cap;
+	}
+	memcpy(slot->data + slot->len, kbuf, payload);
+	slot->len += payload;
+	lck_mtx_unlock(&sweet_sb_state_mtx);
+	kfree_data(kbuf, klen);
+	return 0;
+}
+
+static int
+sweet_sandbox_user_state_iterate(user_addr_t arg)
+{
+	struct {
+		uint64_t mode;
+		uint64_t uid;
+		uint64_t buf_ptr;
+		uint64_t buf_cap;
+		uint64_t out_len_ptr;
+	} in;
+	int error = copyin(arg, &in, sizeof(in));
+	if (error) {
+		return error;
+	}
+
+	lck_mtx_lock(&sweet_sb_state_mtx);
+	size_t payload = 0;
+	for (int i = 0; i < SWEET_SB_USER_STATE_SLOTS; i++) {
+		if (!sweet_sb_slots[i].used) {
+			continue;
+		}
+		if (in.mode != 2 || sweet_sb_slots[i].uid == (uid_t)in.uid) {
+			payload += sweet_sb_slots[i].len;
+		}
+	}
+	size_t total_out = payload + 8;
+	uint8_t *snap = NULL;
+	if (in.buf_ptr != 0 && in.buf_cap >= total_out) {
+		snap = kalloc_data(total_out, Z_WAITOK | Z_ZERO);
+		if (snap == NULL) {
+			lck_mtx_unlock(&sweet_sb_state_mtx);
+			return ENOMEM;
+		}
+		size_t off = 0;
+		for (int i = 0; i < SWEET_SB_USER_STATE_SLOTS; i++) {
+			if (!sweet_sb_slots[i].used) {
+				continue;
+			}
+			if (in.mode != 2 || sweet_sb_slots[i].uid == (uid_t)in.uid) {
+				memcpy(snap + off, sweet_sb_slots[i].data, sweet_sb_slots[i].len);
+				off += sweet_sb_slots[i].len;
+			}
+		}
+	}
+	lck_mtx_unlock(&sweet_sb_state_mtx);
+
+	uint64_t out_u64 = (uint64_t)total_out;
+	if (in.out_len_ptr != 0) {
+		error = copyout(&out_u64, (user_addr_t)in.out_len_ptr, sizeof(out_u64));
+		if (error) {
+			if (snap != NULL) {
+				kfree_data(snap, total_out);
+			}
+			return error;
+		}
+	}
+	if (snap == NULL) {
+		return ENAMETOOLONG;
+	}
+	error = copyout(snap, (user_addr_t)in.buf_ptr, total_out);
+	kfree_data(snap, total_out);
+	return error;
+}
