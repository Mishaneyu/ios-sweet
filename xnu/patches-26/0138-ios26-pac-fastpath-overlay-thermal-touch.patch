+
+static void
+sweet_accel_client_add(SweetAcceleratorUserClient *c)
+{
+	if (gAccelClientsLock == NULL) {
+		return;
+	}
+	IOLockLock(gAccelClientsLock);
+	for (unsigned i = 0; i < SWEET_DIAG_MAX_CLIENTS; i++) {
+		if (gAccelClients[i] == NULL) {
+			gAccelClients[i] = c;
+			break;
+		}
+	}
+	IOLockUnlock(gAccelClientsLock);
+}
+
+static void
+sweet_accel_client_remove(SweetAcceleratorUserClient *c)
+{
+	if (gAccelClientsLock == NULL) {
+		return;
+	}
+	IOLockLock(gAccelClientsLock);
+	for (unsigned i = 0; i < SWEET_DIAG_MAX_CLIENTS; i++) {
+		if (gAccelClients[i] == c) {
+			gAccelClients[i] = NULL;
+			break;
+		}
+	}
+	IOLockUnlock(gAccelClientsLock);
+}
