+void
+sweet_wlan_diag_snapshot(struct sweet_diag_net *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	lck_mtx_lock(&fw_lock);
+	out->wland_open = fw_opened;
+	out->wlan_ready = fw_ready;
+	out->wlan_link_up = fw_link_up;
+	memcpy(out->wlan_mac, fw_addr, 6);
+	out->wlan_bss_count = fw_nbss;
+	out->wlan_tx_dropped = fw_tx_dropped;
+	if (fw_link_up) {
+		size_t slen = fw_link.ssid_len < 32 ? fw_link.ssid_len : 32;
+		memcpy(out->wlan_ssid, fw_link.ssid, slen);
+		out->wlan_ssid[slen] = '\0';
+		memcpy(out->wlan_bssid, fw_link.bssid, 6);
+		if (fw_link_bss_heard) {
+			out->wlan_freq_mhz = fw_link_bss.frequency;
+			out->wlan_rssi_dbm = fw_link_bss.rssi;
+		}
+	}
+	lck_mtx_unlock(&fw_lock);
+}
