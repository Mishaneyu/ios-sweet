 			return true;
 		}
 		delay(1);
 	}
+	sweet_spmi_bus_release(intrs);
 	return false;
 }
 
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 5a84018..f616888 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -28,6 +28,25 @@ static bool sp_attempted, sp_ready;
 /* A timed-out command may complete late: never reuse that lane this boot. */
 static bool sp_poisoned[512];
 
+static uint32_t sp_bus_busy;
+
+bool
+sweet_spmi_bus_acquire(void)
+{
+	boolean_t intrs = ml_set_interrupts_enabled(FALSE);
+	while (__atomic_exchange_n(&sp_bus_busy, 1u, __ATOMIC_ACQUIRE) != 0u) {
+		__asm__ volatile("yield");
+	}
+	return (bool)intrs;
+}
+
+void
+sweet_spmi_bus_release(bool intrs)
+{
+	__atomic_store_n(&sp_bus_busy, 0u, __ATOMIC_RELEASE);
+	(void)ml_set_interrupts_enabled((boolean_t)intrs);
+}
+
 static uint32_t
 sp_rd(vm_offset_t base, unsigned off)
 {
@@ -107,6 +126,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	}
 	unsigned off = 0x80u * apid;
 	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	bool intrs = sweet_spmi_bus_acquire();
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
 	__asm__ volatile("dsb osh" ::: "memory");
@@ -114,15 +134,18 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		uint32_t status = sp_rd(sp_obs, off + 0x08u);
