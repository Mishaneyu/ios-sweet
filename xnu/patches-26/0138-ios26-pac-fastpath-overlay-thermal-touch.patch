diff --git a/bsd/dev/rmx1931_haptic.c b/bsd/dev/rmx1931_haptic.c
new file mode 100644
index 0000000..917b496
--- /dev/null
+++ b/bsd/dev/rmx1931_haptic.c
@@ -0,0 +1,700 @@
+/*
+ * Realme X2 Pro (RMX1931 / samurai, SM8150-AC) linear resonant actuator (LRA)
+ * haptic driver: Awinic AW8697 (/dev/hakios-haptic for Taptic Engine waveforms
+ * via HakiosAudio.driver).
+ *
+ * Hardware facts (from RMX1931 live FDT /soc/i2c@0088c000/aw8697_haptic@5A
+ * and aw8697.{c,h} / aw8697_reg.h):
+ *   - IC:         Awinic AW8697 (REG_ID 0x00 == 0x97) at 7-bit I2C addr 0x5a
+ *   - Pins:       SM8150 TLMM SOUTH tile (PA 0x03d00000, size 0x80000):
+ *                   GPIO 98  = SDA (open-drain TLMM GPIO I2C)
+ *                   GPIO 99  = SCL (open-drain TLMM GPIO I2C)
+ *                   GPIO 116 = reset-gpio (active-high enable, low = reset)
+ *                 Powered directly from VPH_PWR/VBAT + always-on 1.8V.
+ *   - Actuator:   LRA_0619 (f0_pre = 170 Hz -> F_PRE = 2262 = 0x08d6),
+ *                 driven in closed-loop CONT mode with automatic zero-crossing
+ *                 BEMF braking (zero external firmware blobs required!).
+ *
+ * Safety limits:
+ *   - Drive level capped strictly at Android's CONT ceiling (97 = 0x61).
+ *   - Continuous activation capped at 1000 ms followed by 1000 ms cooldown.
+ *   - Fault monitor on SYSINT (0x02 & 0x1e: UVL, OCD, OTS, BSTERR) puts AW8697
+ *     into hardware reset (GPIO 116 low) on any fault.
+ *
+ * Boot-args:
+ *   rmxhaptic=0   disable driver (default 1)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <sweet_diag.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void rmx1931_haptic_init(void);
+
+#define AW_SOUTH_PA     0x03d00000u
+#define AW_SOUTH_SIZE   0x00080000u
+#define AW_PIN_SDA      98u
+#define AW_PIN_SCL      99u
+#define AW_PIN_RST      116u
+#define AW_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define AW_GPIO_IO(n)   (AW_GPIO_CFG(n) + 4u)
+#define AW_OD_HIGH_CFG  (0x003u | (2u << 6))
+#define AW_OD_LOW_CFG   (0x203u | (2u << 6))
+#define AW_RST_OUT_CFG  (0x200u | (2u << 6))
+
+#define AW_I2C_ADDR     0x5au
+#define AW_CHIP_ID      0x97u
+
+/* AW8697 registers (aw8697_reg.h) */
+#define AW_REG_ID               0x00u
+#define AW_REG_SYSST            0x01u
+#define AW_REG_SYSINT           0x02u
+#define AW_REG_SYSINTM          0x03u
+#define AW_REG_SYSCTRL          0x04u   /* [3:2] play_mode (2=CONT), [0]bst_mode/work_mode (1=standby, 0=active) */
+#define AW_REG_GO               0x05u   /* [0] go */
+#define AW_REG_DATCTRL          0x2bu
+#define AW_REG_DBGCTRL          0x2eu
+#define AW_REG_BSTDBG1          0x31u
+#define AW_REG_BSTDBG2          0x32u
+#define AW_REG_BSTDBG3          0x33u
+#define AW_REG_BSTCFG           0x34u
+#define AW_REG_BST_AUTO         0x47u
+#define AW_REG_CONT_CTRL        0x48u
+#define AW_REG_F_PRE_H          0x49u
+#define AW_REG_F_PRE_L          0x4au
+#define AW_REG_TD_H             0x4bu
+#define AW_REG_TD_L             0x4cu
+#define AW_REG_TSET             0x4du
+#define AW_REG_R_SPARE          0x5du
+#define AW_REG_ZC_THRSH_H       0x72u
+#define AW_REG_ZC_THRSH_L       0x73u
+#define AW_REG_BEMF_VTHH_H      0x74u
+#define AW_REG_BEMF_VTHH_L      0x75u
+#define AW_REG_BEMF_VTHL_H      0x76u
+#define AW_REG_BEMF_VTHL_L      0x77u
+#define AW_REG_BEMF_NUM         0x78u
+#define AW_REG_TIME_NZC         0x7au
+#define AW_REG_DRV_LVL          0x7bu
+#define AW_REG_DRV_LVL_OV       0x7cu
+
+#define AW_SYSINT_FAULTS        0x1eu   /* UVLI | OCDI | OTSI | BSTERRI */
+#define AW_DRV_MAX              97u     /* Android LRA_0619 CONT max */
+#define AW_DRV_MIN              60u     /* 5/8 of max so soft UIKit ticks are crisp */
+#define AW_SILENT_PEAK          64u
+#define AW_ACTIVE_US            28000ull
+#define AW_TAP_US               18000ull
+#define AW_MAX_PLAY_US          1000000ull
+
+static vm_offset_t aw_gpio;
+static bool aw_started, aw_broken;
+static int aw_sleep_chan;
+
+static volatile uint64_t aw_heard_us, aw_quiet_us, aw_onset_us;
+static volatile uint32_t aw_heard_peak;
+static int sys_haptic_events = 0;
+
+SYSCTL_DECL(_kern_rmx1931);
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, haptic_events, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_haptic_events, 0, "Total haptic taps/vibrations played on AW8697");
+
+static uint32_t
+aw_rd32(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(aw_gpio + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+aw_wr32(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(aw_gpio + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+aw_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&aw_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t
+aw_now_us(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+static void
+aw_rst_set(bool high)
+{
+	aw_wr32(AW_GPIO_IO(AW_PIN_RST), high ? 2u : 0u);
+	aw_wr32(AW_GPIO_CFG(AW_PIN_RST), AW_RST_OUT_CFG);
+}
+
+static void
+aw_sda(bool high)
+{
+	aw_wr32(AW_GPIO_CFG(AW_PIN_SDA), high ? AW_OD_HIGH_CFG : AW_OD_LOW_CFG);
+}
+
+static bool
+aw_sda_in(void)
+{
+	return (aw_rd32(AW_GPIO_IO(AW_PIN_SDA)) & 1u) != 0;
+}
+
+static bool
+aw_scl_high(void)
+{
+	aw_wr32(AW_GPIO_CFG(AW_PIN_SCL), AW_OD_HIGH_CFG);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (aw_rd32(AW_GPIO_IO(AW_PIN_SCL)) & 1u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+aw_scl_low(void)
+{
+	aw_wr32(AW_GPIO_CFG(AW_PIN_SCL), AW_OD_LOW_CFG);
+}
+
+static void
+aw_bus_init(void)
+{
+	aw_wr32(AW_GPIO_IO(AW_PIN_SDA), 0);
+	aw_wr32(AW_GPIO_IO(AW_PIN_SCL), 0);
+	aw_sda(true);
+	(void)aw_scl_high();
+	delay(10);
+}
+
+static bool
+aw_i2c_start(void)
+{
+	aw_sda(true);
+	if (!aw_scl_high()) {
+		return false;
+	}
+	delay(4);
+	aw_sda(false);
+	delay(4);
+	aw_scl_low();
+	delay(4);
+	return true;
+}
+
+static void
+aw_i2c_stop(void)
+{
+	aw_sda(false);
+	delay(4);
+	(void)aw_scl_high();
+	delay(4);
+	aw_sda(true);
+	delay(4);
+}
+
+static bool
+aw_i2c_tx(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; --bit) {
+		aw_sda(((byte >> bit) & 1u) != 0);
+		delay(3);
+		if (!aw_scl_high()) {
+			return false;
+		}
+		delay(4);
+		aw_scl_low();
+		delay(2);
+	}
+	aw_sda(true);
+	delay(3);
+	if (!aw_scl_high()) {
+		return false;
+	}
+	delay(4);
+	bool ack = !aw_sda_in();
+	aw_scl_low();
+	delay(3);
+	return ack;
+}
+
+static bool
+aw_i2c_rx(uint8_t *out, bool ack)
+{
+	uint8_t val = 0;
+	aw_sda(true);
+	for (int bit = 7; bit >= 0; --bit) {
+		delay(3);
+		if (!aw_scl_high()) {
+			return false;
+		}
+		delay(4);
+		if (aw_sda_in()) {
+			val |= (uint8_t)(1u << bit);
+		}
+		aw_scl_low();
+		delay(2);
+	}
+	aw_sda(!ack);
+	delay(3);
+	if (!aw_scl_high()) {
+		aw_sda(true);
+		return false;
+	}
+	delay(4);
+	aw_scl_low();
+	aw_sda(true);
+	delay(3);
+	*out = val;
+	return true;
+}
+
+static bool
+aw_reg_read(uint8_t reg, uint8_t *out)
+{
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint8_t val = 0;
+		bool ok = aw_i2c_start() &&
+		          aw_i2c_tx((uint8_t)(AW_I2C_ADDR << 1)) &&
+		          aw_i2c_tx(reg) &&
+		          aw_i2c_start() &&
+		          aw_i2c_tx((uint8_t)((AW_I2C_ADDR << 1) | 1u)) &&
+		          aw_i2c_rx(&val, false);
+		aw_i2c_stop();
+		delay(10);
+		if (ok) {
+			*out = val;
+			return true;
+		}
+		aw_bus_init();
+	}
+	return false;
+}
+
+static bool
+aw_reg_write(uint8_t reg, uint8_t val)
+{
+	if (aw_broken) {
+		return false;
+	}
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		bool ok = aw_i2c_start() &&
+		          aw_i2c_tx((uint8_t)(AW_I2C_ADDR << 1)) &&
+		          aw_i2c_tx(reg) &&
+		          aw_i2c_tx(val);
+		aw_i2c_stop();
+		delay(10);
+		if (ok) {
+			return true;
+		}
+		aw_bus_init();
+	}
+	return false;
+}
+
+static bool
+aw_reg_bits(uint8_t reg, uint8_t clear_mask, uint8_t set_bits)
+{
+	uint8_t cur = 0;
+	if (!aw_reg_read(reg, &cur)) {
+		return false;
+	}
+	return aw_reg_write(reg, (uint8_t)((cur & ~clear_mask) | set_bits));
+}
+
+static void
+aw_give_up(const char *why)
+{
+	if (!aw_broken) {
+		aw_broken = true;
+		if (aw_gpio) {
+			aw_rst_set(false);
+		}
+		printf("RMX HAPTIC: %s -> AW8697 held in reset\n", why);
+	}
+}
+
+static bool
+aw_standby(void)
+{
+	(void)aw_reg_write(AW_REG_GO, 0x00u);
+	return aw_reg_bits(AW_REG_SYSCTRL, 0x01u, 0x01u);
+}
+
+/* Configure AW8697 for closed-loop 170 Hz CONT mode (from aw8697.c LRA_0619). */
+static bool
+aw_configure(void)
+{
+	uint8_t dummy = 0;
+	if (!aw_reg_write(AW_REG_ID, 0xaau)) { /* soft reset */
+		return false;
+	}
+	aw_wait_ms(3);
+
+	if (!aw_standby()) {
+		return false;
+	}
+	/* 24 kHz PWM, LRA_0619 analog trim, boost bypass (safe VPH drive). */
+	if (!aw_reg_bits(AW_REG_DBGCTRL, (uint8_t)(3u << 5), (uint8_t)(1u << 5)) ||
+	    !aw_reg_write(AW_REG_BSTDBG1, 0x30u) ||
+	    !aw_reg_write(AW_REG_BSTDBG2, 0xebu) ||
+	    !aw_reg_write(AW_REG_BSTDBG3, 0xd4u) ||
+	    !aw_reg_write(AW_REG_TSET, 0x12u) ||
+	    !aw_reg_write(AW_REG_R_SPARE, 0x68u) ||
+	    !aw_reg_bits(AW_REG_BSTCFG, 0x07u, 0x07u) ||
+	    !aw_reg_bits(AW_REG_BST_AUTO, 0x04u, 0x00u)) {
+		return false;
+	}
+	/* Closed-loop 170 Hz CONT parameters (f0_pre = 170 Hz -> 2262 = 0x08d6). */
+	if (!aw_reg_write(AW_REG_F_PRE_H, 0x08u) ||
+	    !aw_reg_write(AW_REG_F_PRE_L, 0xd6u) ||
+	    !aw_reg_bits(AW_REG_DATCTRL, 0x3fu, 0x08u) ||
+	    !aw_reg_write(AW_REG_CONT_CTRL, 0x89u) || /* ZC_DETEC | CLOSE_PLAYBACK | AUTO_BRK */
+	    !aw_reg_write(AW_REG_TD_H, 0x00u) ||
+	    !aw_reg_write(AW_REG_TD_L, 0x9au) ||
+	    !aw_reg_write(AW_REG_ZC_THRSH_H, 0x0fu) ||
+	    !aw_reg_write(AW_REG_ZC_THRSH_L, 0xf1u) ||
+	    !aw_reg_write(AW_REG_BEMF_VTHH_H, 0x10u) ||
+	    !aw_reg_write(AW_REG_BEMF_VTHH_L, 0x08u) ||
+	    !aw_reg_write(AW_REG_BEMF_VTHL_H, 0x03u) ||
+	    !aw_reg_write(AW_REG_BEMF_VTHL_L, 0xf8u) ||
+	    !aw_reg_bits(AW_REG_BEMF_NUM, 0x0fu, 0x03u) ||
+	    !aw_reg_write(AW_REG_TIME_NZC, 0x23u) ||
+	    !aw_reg_write(AW_REG_SYSINTM, 0xe1u)) {
+		return false;
+	}
+	(void)aw_reg_read(AW_REG_SYSINT, &dummy); /* clear power-on UVLI */
+	return true;
+}
+
+static uint8_t
+aw_drv_for_peak(uint32_t peak)
+{
+	const uint32_t third = 32767u / 3u;
+	if (peak >= third) {
+		return AW_DRV_MAX;
+	}
+	return (uint8_t)(AW_DRV_MIN + (AW_DRV_MAX - AW_DRV_MIN) * peak / third);
+}
+
+static bool
+aw_start_cont(uint8_t drv)
+{
+	if (drv > AW_DRV_MAX) {
+		drv = AW_DRV_MAX;
+	}
+	/* CONT mode ([3:2]=2), active ([0]=0), set DRV_LVL & DRV_LVL_OV, GO=1. */
+	if (!aw_reg_write(AW_REG_DRV_LVL, drv) ||
+	    !aw_reg_write(AW_REG_DRV_LVL_OV, drv) ||
+	    !aw_reg_bits(AW_REG_SYSCTRL, 0x0du, 0x08u) ||
+	    !aw_reg_write(AW_REG_GO, 0x01u)) {
+		aw_give_up("failed to start CONT vibration");
+		return false;
+	}
+	return true;
+}
+
+static bool
+aw_stop_cont(void)
+{
+	/* Clearing GO triggers AW8697's closed-loop AUTO_BRK zero-crossing brake. */
+	if (!aw_reg_write(AW_REG_GO, 0x00u)) {
+		aw_give_up("failed to clear GO");
+		return false;
+	}
+	delay(2000);
+	if (!aw_standby()) {
+		aw_give_up("failed to enter standby");
+		return false;
+	}
+	return true;
+}
+
+static bool
+aw_check_health(void)
+{
+	uint8_t sysint = 0;
+	if (!aw_reg_read(AW_REG_SYSINT, &sysint)) {
+		aw_give_up("SYSINT read failed");
+		return false;
+	}
+	if (sysint & AW_SYSINT_FAULTS) {
+		printf("RMX HAPTIC: fault SYSINT=%#x\n", sysint);
+		aw_give_up("AW8697 hardware fault flag");
+		return false;
+	}
+	return true;
+}
+
+static void
+aw_record_peak(uint32_t peak)
+{
+	uint64_t now = aw_now_us();
+	if (peak <= AW_SILENT_PEAK) {
+		aw_quiet_us = now;
+		return;
+	}
+	if (aw_heard_us == 0 || aw_quiet_us > aw_heard_us || now - aw_heard_us >= AW_ACTIVE_US) {
+		aw_onset_us = now;
+		aw_heard_peak = 0;
+	}
+	aw_heard_us = now;
+	if (peak > aw_heard_peak) {
+		aw_heard_peak = peak;
+	}
+	wakeup(&aw_sleep_chan);
+}
+
+static int
+haptic_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[1024];
+	int err = 0;
+
+	/* Support short ASCII test strings ("tap\n") from SSH as well as int16 PCM. */
+	if (uio_resid(uio) > 0 && uio_resid(uio) <= 8) {
+		char cmd[8];
+		int len = (int)uio_resid(uio);
+		err = uiomove(cmd, len, uio);
+		if (!err && (cmd[0] == 't' || (cmd[0] >= '1' && cmd[0] <= '9'))) {
+			aw_record_peak(24000u);
+			return 0;
+		}
+		if (!err && len >= 2) {
+			int16_t s0 = 0;
+			memcpy(&s0, cmd, sizeof(s0));
+			uint32_t v = s0 < 0 ? (uint32_t)(-(int32_t)s0) : (uint32_t)s0;
+			aw_record_peak(v);
+		}
+		return err;
+	}
+
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = (user_ssize_t)sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		err = uiomove((caddr_t)samples, (int)bytes, uio);
+		if (err) {
+			break;
+		}
+		uint32_t n = (uint32_t)(bytes / 2);
+		uint32_t peak = 0;
+		for (uint32_t i = 0; i < n; ++i) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)(-(int32_t)samples[i]) : (uint32_t)samples[i];
+			if (v > peak) {
+				peak = v;
+			}
+		}
+		aw_record_peak(peak);
+	}
+	if (!err && uio_resid(uio) > 0) {
+		uio_setresid(uio, 0);
+	}
+	return err;
+}
+
+static const struct cdevsw rmx_haptic_cdevsw = {
+	.d_open       = haptic_open,
+	.d_close      = haptic_open,
+	.d_read       = eno_rdwrt,
+	.d_write      = haptic_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+static void
+aw_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	aw_wait_ms(1000);
+	aw_gpio = ml_io_map(AW_SOUTH_PA, AW_SOUTH_SIZE);
+	if (!aw_gpio) {
+		printf("RMX HAPTIC: SOUTH TLMM map failed\n");
+		goto out;
+	}
+
+	uint32_t orig_sda_cfg = aw_rd32(AW_GPIO_CFG(AW_PIN_SDA));
+	uint32_t orig_scl_cfg = aw_rd32(AW_GPIO_CFG(AW_PIN_SCL));
+	uint32_t orig_rst_cfg = aw_rd32(AW_GPIO_CFG(AW_PIN_RST));
+	uint32_t orig_sda_io = aw_rd32(AW_GPIO_IO(AW_PIN_SDA));
+	uint32_t orig_scl_io = aw_rd32(AW_GPIO_IO(AW_PIN_SCL));
+	uint32_t orig_rst_io = aw_rd32(AW_GPIO_IO(AW_PIN_RST));
+
+	aw_bus_init();
+	aw_rst_set(false);
+	aw_wait_ms(3);
+	aw_rst_set(true);
+	aw_wait_ms(5);
+
+	uint8_t chip_id = 0;
+	if (!aw_reg_read(AW_REG_ID, &chip_id) || chip_id != AW_CHIP_ID) {
+		/* Restore firmware pin state on non-RMX1931 boards (e.g. Pixel 4). */
+		aw_wr32(AW_GPIO_IO(AW_PIN_SDA), orig_sda_io);
+		aw_wr32(AW_GPIO_IO(AW_PIN_SCL), orig_scl_io);
+		aw_wr32(AW_GPIO_IO(AW_PIN_RST), orig_rst_io);
+		aw_wr32(AW_GPIO_CFG(AW_PIN_SDA), orig_sda_cfg);
+		aw_wr32(AW_GPIO_CFG(AW_PIN_SCL), orig_scl_cfg);
+		aw_wr32(AW_GPIO_CFG(AW_PIN_RST), orig_rst_cfg);
+		printf("RMX HAPTIC: no AW8697 at 0x5a (id=%#x); pins restored\n", chip_id);
+		goto out;
+	}
+
+	if (!aw_configure()) {
+		aw_give_up("AW8697 init failed");
+		goto out;
+	}
+
+	int major = cdevsw_add(-1, &rmx_haptic_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		aw_give_up("failed to create /dev/hakios-haptic");
+		goto out;
+	}
+	printf("RMX HAPTIC: AW8697 ready at 0x5a (GPIO98/99 rst=GPIO116, 170 Hz closed-loop)\n");
+
+	enum { H_IDLE, H_PLAYING, H_COOLDOWN } state = H_IDLE;
+	uint64_t play_since = 0, cooldown_until = 0, last_health = 0, played_onset = 0;
+	uint8_t cur_drv = 0;
+
+	while (!aw_broken) {
+		uint64_t now = aw_now_us();
+		uint64_t heard = aw_heard_us, quiet = aw_quiet_us, onset = aw_onset_us;
+		uint32_t peak = aw_heard_peak;
+		bool active = heard != 0 && quiet <= heard && (now - heard) < AW_ACTIVE_US;
+
+		switch (state) {
+		case H_IDLE:
+			if ((active || (onset > played_onset && (now - onset) < 100000ull)) && peak > AW_SILENT_PEAK) {
+				uint8_t drv = aw_drv_for_peak(peak);
+				if (aw_start_cont(drv)) {
+					state = H_PLAYING;
+					play_since = now;
+					played_onset = onset;
+					cur_drv = drv;
+					sys_haptic_events++;
+					if (sys_haptic_events <= 16) {
+						printf("RMX HAPTIC: event #%d start peak=%u drv=%u\n",
+						    sys_haptic_events, peak, drv);
+					}
+				}
+			}
+			break;
+
+		case H_PLAYING: {
+			uint64_t elapsed = now - play_since;
+			if (elapsed >= AW_MAX_PLAY_US) {
+				(void)aw_stop_cont();
+				cooldown_until = now + AW_MAX_PLAY_US;
+				state = H_COOLDOWN;
+				printf("RMX HAPTIC: capped at 1000 ms; cooling down\n");
+				break;
+			}
+			/* Ensure short taps run for at least AW_TAP_US (18 ms) before braking. */
+			if (!active && elapsed >= AW_TAP_US) {
+				(void)aw_stop_cont();
+				state = H_IDLE;
+				break;
+			}
+			if (active && peak > AW_SILENT_PEAK) {
+				uint8_t drv = aw_drv_for_peak(peak);
+				if (drv > cur_drv + 6u || drv + 6u < cur_drv) {
+					(void)aw_reg_write(AW_REG_DRV_LVL, drv);
+					cur_drv = drv;
+				}
+			}
+			if (now - last_health >= 50000ull) {
+				last_health = now;
+				if (!aw_check_health()) {
+					break;
+				}
+			}
+			break;
+		}
+
+		case H_COOLDOWN:
+			if (now >= cooldown_until) {
+				state = H_IDLE;
+			}
+			break;
+		}
+		aw_wait_ms(state == H_PLAYING ? 4u : 12u);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+rmx1931_haptic_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (aw_started) {
+		return;
+	}
+	aw_started = true;
+	(void)PE_parse_boot_argn("rmxhaptic", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("RMX HAPTIC: disabled (rmxhaptic=0)\n");
+		return;
+	}
+	if (kernel_thread_start(aw_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("RMX HAPTIC: kernel_thread_start failed\n");
+	}
+}
+
+void
+rmx1931_haptic_diag_snapshot(struct sweet_diag_peripherals *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	out->haptic_ready = (aw_gpio != 0 && !aw_broken);
+	out->haptic_events = (uint32_t)sys_haptic_events;
+	out->haptic_faults = aw_broken ? 1u : 0u;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/rmx1931_torch.c b/bsd/dev/rmx1931_torch.c
new file mode 100644
index 0000000..07c4578
--- /dev/null
+++ b/bsd/dev/rmx1931_torch.c
@@ -0,0 +1,518 @@
+/*
+ * Realme X2 Pro (RMX1931 / samurai, SM8150-AC) rear flashlight driver
+ * (/dev/hakios-torch for Control Center & AVFlashlight via libsweet_media.dylib).
+ *
+ * Hardware facts (from RMX1931 live FDT /soc/qcom,spmi@c440000/qcom,pm8150l@5/
+ * qcom,leds@d300 and leds-qpnp-flash-v2.c):
+ *   - Peripheral: PM8150L SID 5, base 0xd300 (PPID 0x5d3), qpnp-flash-led-v2
+ *   - Channel 0:  led:torch_0 (qcom,id=0, ires-ua=12500, max-current=200 mA)
+ *                 + led:switch_0 (led-mask=0x1). Capped here at 125 mA and
+ *                 at most 30 s continuous on-time per activation.
+ *   - Thermal:    PM8150L temp-alarm (SID 4, 0x2400) + RMX1931 battery temp
+ *                 cutoff (>= 45.0 C) + VPH droop / fault status checks every 100 ms.
+ *
+ * Strictly whitelisted SPMI writes ONLY to PPID 0x5d3 regs:
+ *   0x40 SAFETY_TMR(0), 0x43 TGR_CURRENT(0), 0x46 MOD_CTRL,
+ *   0x47 IRES, 0x49 STROBE_CTRL(0), 0x4c EN_LED_CTRL.
+ *
+ * Boot-args:
+ *   rmxtorch=0       disable driver
+ *   rmxtorch=3       serve /dev/hakios-torch (default)
+ *   rmxtorch_max_s=N max continuous seconds (default 30, 1..120)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <sweet_diag.h>
+#include "sweet_spmi.h"
+#include "rmx1931_battery.h"
+
+#include "sweet_spmi.h"
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void rmx1931_torch_init(void);
+
+#define TORCH_SPMI_CORE   0x0c440000u
+#define TORCH_SPMI_CHNLS  0x0c600000u
+#define TORCH_SPMI_OBS    0x0e600000u
+#define TORCH_SPMI_CNFG   0x0c40a000u
+
+#define TORCH_SID         5u
+#define TORCH_BASE        0xd300u
+#define TORCH_PPID        ((TORCH_SID << 8) | (TORCH_BASE >> 8)) /* 0x5d3 */
+
+#define FLASH_REG_TYPE          0x04u   /* 0x18 */
+#define FLASH_REG_SUBTYPE       0x05u   /* >= 0x04 on flash-led-v2 */
+#define FLASH_REG_STATUS1       0x08u
+#define FLASH_REG_STATUS2       0x09u   /* bit 4 VPH droop, [2:0] thermal */
+#define FLASH_REG_INT_RT_STS    0x10u   /* bit 0 fault */
+#define FLASH_REG_SAFETY_TMR0   0x40u   /* 0x13 = safety timer disabled (torch) */
+#define FLASH_REG_TGR_CURRENT0  0x43u   /* [6:0] current code */
+#define FLASH_REG_MOD_CTRL      0x46u   /* bit 7 module enable */
+#define FLASH_REG_IRES          0x47u   /* [1:0] LED1 resolution: 0=12.5mA, 3=5.0mA */
+#define FLASH_REG_STROBE_CTRL0  0x49u   /* [2:0] 0 = SW strobe */
+#define FLASH_REG_EN_LED_CTRL   0x4cu   /* bit 0 LED1 enable */
+
+#define TORCH_MAX_MA            125u    /* conservative continuous torch cap */
+#define TORCH_DEFAULT_MAX_SECS  30u
+
+static LCK_GRP_DECLARE(rmx_torch_grp, "rmx-torch");
+static LCK_MTX_DECLARE(rmx_torch_lock, &rmx_torch_grp);
+
+static vm_offset_t tr_core, tr_cnfg, tr_obs, tr_ch;
+static uint16_t tr_apid = 0xffffu;
+static bool tr_started, tr_broken;
+static volatile uint32_t tr_wanted;     /* 0..1000 */
+static uint32_t tr_shown;
+static uint32_t tr_max_secs = TORCH_DEFAULT_MAX_SECS;
+static int tr_sleep_chan;
+static int sys_torch_level = 0;
+
+SYSCTL_DECL(_kern_rmx1931);
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, torch_level, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_torch_level, 0, "Current RMX1931 flashlight level (0..1000)");
+
+static uint32_t
+tr_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+tr_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+tr_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&tr_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t
+tr_now_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static bool
+tr_reg_read(uint8_t reg, uint8_t *out)
+{
+	if (tr_apid == 0xffffu || !tr_obs) {
+		return false;
+	}
+	uint32_t off = 0x80u * (uint32_t)tr_apid;
+	bool intrs = sweet_spmi_bus_acquire();
+	tr_wr32(tr_obs, off, (1u << 27) | ((uint32_t)reg << 4));
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = tr_rd32(tr_obs, off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				sweet_spmi_bus_release(intrs);
+				return false;
+			}
+			*out = (uint8_t)tr_rd32(tr_obs, off + 0x18u);
+			sweet_spmi_bus_release(intrs);
+			return true;
+		}
+		delay(1);
+	}
+	sweet_spmi_bus_release(intrs);
+	return false;
+}
+
+static bool
+tr_reg_writable(uint8_t reg)
+{
+	return reg == FLASH_REG_SAFETY_TMR0 || reg == FLASH_REG_TGR_CURRENT0 ||
+	       reg == FLASH_REG_MOD_CTRL || reg == FLASH_REG_IRES ||
+	       reg == FLASH_REG_STROBE_CTRL0 || reg == FLASH_REG_EN_LED_CTRL;
+}
+
+static bool
+tr_reg_write(uint8_t reg, uint8_t val)
+{
+	if (tr_broken || !tr_ch || tr_apid == 0xffffu || !tr_reg_writable(reg)) {
+		tr_broken = true;
+		return false;
+	}
+	/* Re-verify APID still maps to PPID 0x5d3 before every write. */
+	if (((tr_rd32(tr_core, 0x900u + 4u * (uint32_t)tr_apid) >> 8) & 0xfffu) != TORCH_PPID) {
+		tr_broken = true;
+		return false;
+	}
+	bool ok = false;
+	lck_mtx_lock(&rmx_torch_lock);
+	bool intrs = sweet_spmi_bus_acquire();
+	tr_wr32(tr_ch, 0x10u, val);
+	tr_wr32(tr_ch, 0x00u, (0u << 27) | ((uint32_t)reg << 4));
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = tr_rd32(tr_ch, 0x08u);
+		if (st & 1u) {
+			ok = (st & 0x0eu) == 0;
+			break;
+		}
+		delay(1);
+	}
+	sweet_spmi_bus_release(intrs);
+	lck_mtx_unlock(&rmx_torch_lock);
+	if (!ok) {
+		tr_broken = true;
+		return false;
+	}
+	uint8_t rb = 0xff;
+	if (!tr_reg_read(reg, &rb) || rb != val) {
+		printf("RMX TORCH: verify mismatch reg=%#x wrote=%#x read=%#x\n", reg, val, rb);
+		tr_broken = true;
+		return false;
+	}
+	return true;
+}
+
+static bool
+tr_reg_mask(uint8_t reg, uint8_t mask, uint8_t val)
+{
+	uint8_t cur = 0;
+	if (!tr_reg_read(reg, &cur)) {
+		return false;
+	}
+	uint8_t next = (uint8_t)((cur & ~mask) | (val & mask));
+	return next == cur ? true : tr_reg_write(reg, next);
+}
+
+static bool
+tr_hw_off(void)
+{
+	bool a = tr_reg_mask(FLASH_REG_EN_LED_CTRL, 0x01u, 0x00u);
+	bool b = tr_reg_mask(FLASH_REG_TGR_CURRENT0, 0x7fu, 0x00u);
+	bool c = tr_reg_write(FLASH_REG_SAFETY_TMR0, 0x13u);
+	bool d = tr_reg_write(FLASH_REG_MOD_CTRL, 0x00u);
+	return a && b && c && d;
+}
+
+static bool
+tr_hw_on(uint32_t level_1000)
+{
+	if (level_1000 == 0) {
+		return tr_hw_off();
+	}
+	if (level_1000 > 1000u) {
+		level_1000 = 1000u;
+	}
+	/* Scale 1..1000 -> 13..125 mA; apply PM8150L_IRES_WA (5 mA step) for <= 20 mA. */
+	uint32_t ma = (TORCH_MAX_MA * level_1000 + 999u) / 1000u;
+	if (ma < 10u) {
+		ma = 10u;
+	}
+	uint8_t ires_bits = 0x00u;      /* 12.5 mA */
+	uint8_t code = 0u;
+	if (ma <= 20u) {
+		ires_bits = 0x03u;      /* 5.0 mA per PM8150L_IRES_WA */
+		code = (uint8_t)((ma * 1000u / 5000u) - 1u);
+	} else {
+		uint32_t steps = (ma * 1000u) / 12500u;
+		code = (uint8_t)((steps > 0 ? steps - 1u : 0u));
+		if (code > 9u) {
+			code = 9u;      /* 125 mA hard ceiling */
+		}
+	}
+	if (!tr_reg_mask(FLASH_REG_STROBE_CTRL0, 0x07u, 0x00u) ||
+	    !tr_reg_mask(FLASH_REG_IRES, 0x03u, ires_bits) ||
+	    !tr_reg_mask(FLASH_REG_TGR_CURRENT0, 0x7fu, code) ||
+	    !tr_reg_write(FLASH_REG_SAFETY_TMR0, 0x13u) ||
+	    !tr_reg_write(FLASH_REG_MOD_CTRL, 0x80u) ||
+	    !tr_reg_mask(FLASH_REG_EN_LED_CTRL, 0x01u, 0x01u)) {
+		(void)tr_hw_off();
+		return false;
+	}
+	return true;
+}
+
+static const char *
+tr_check_trouble(void)
+{
+	uint8_t rt = 0, s2 = 0;
+	if (!tr_reg_read(FLASH_REG_INT_RT_STS, &rt) || !tr_reg_read(FLASH_REG_STATUS2, &s2)) {
+		return "flash status unreadable";
+	}
+	if (rt & 0x01u) {
+		return "flash fault interrupt";
+	}
+	if (s2 & 0x17u) {
+		return "VPH droop or LED thermal derate";
+	}
+	/* PM8150L temp-alarm (SID 4, 0x2405 subtype / 0x2408 status). */
+	uint8_t t_sub = 0, t_st = 0;
+	if (sweet_spmi_read(4, 0x2405u, &t_sub) == 0 &&
+	    sweet_spmi_read(4, 0x2408u, &t_st) == 0) {
+		unsigned stage = (t_sub == 0x08u) ? (t_st & 0x03u) : ((t_st >> 4) & 0x07u);
+		if (stage > 0) {
+			return "PM8150L thermal alarm stage > 0";
+		}
+	}
+	int bat_deci_c = 250;
+	if (rmx1931_battery_temperature(&bat_deci_c) && bat_deci_c >= 450) {
+		return "battery temperature >= 45 C";
+	}
+	return NULL;
+}
+
+static int
+torch_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+torch_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (uio_offset(uio) > 0) {
+		return 0;
+	}
+	char line[16];
+	int len = snprintf(line, sizeof(line), "%u\n", tr_shown);
+	return uiomove(line, len, uio);
+}
+
+static int
+torch_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	char buf[16];
+	user_ssize_t resid = uio_resid(uio);
+	if (resid <= 0 || resid > (user_ssize_t)sizeof(buf)) {
+		return EINVAL;
+	}
+	int len = (int)resid;
+	bzero(buf, sizeof(buf));
+	int err = uiomove(buf, len, uio);
+	if (err) {
+		return err;
+	}
+	uint32_t level = 0;
+	/* Accept both binary uint32_t (libsweet_media.dylib) and ASCII ("0".."1000\n"). */
+	bool ascii = true;
+	for (int i = 0; i < len; ++i) {
+		char c = buf[i];
+		if (!((c >= '0' && c <= '9') || c == ' ' || c == '\n' || c == '\r')) {
+			ascii = false;
+			break;
+		}
+	}
+	if (len == 4 && !ascii) {
+		memcpy(&level, buf, sizeof(level));
+	} else if (ascii) {
+		const char *p = buf;
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			return EINVAL;
+		}
+		while (*p >= '0' && *p <= '9') {
+			level = level * 10u + (uint32_t)(*p++ - '0');
+			if (level > 1000u) {
+				level = 1000u;
+			}
+		}
+	} else if (len == 4) {
+		memcpy(&level, buf, sizeof(level));
+	} else {
+		return EINVAL;
+	}
+	if (level > 1000u) {
+		level = 1000u;
+	}
+	tr_wanted = level;
+	wakeup(&tr_sleep_chan);
+	return 0;
+}
+
+static const struct cdevsw rmx_torch_cdevsw = {
+	.d_open       = torch_open,
+	.d_close      = torch_open,
+	.d_read       = torch_read,
+	.d_write      = torch_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+static void
+tr_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t applied = 0;
+	uint64_t since = 0, last_check = 0;
+	bool wait_zero = false;
+
+	while (!tr_broken) {
+		uint32_t want = tr_wanted;
+		uint64_t now = tr_now_ms();
+
+		if (want == 0) {
+			wait_zero = false;
+		}
+		if (wait_zero) {
+			want = 0;
+		}
+		if (want != applied) {
+			if (tr_hw_on(want)) {
+				if (applied == 0 && want != 0) {
+					since = now;
+				}
+				applied = want;
+				tr_shown = want;
+				sys_torch_level = (int)want;
+				printf("RMX TORCH: level %u/1000\n", want);
+			} else {
+				printf("RMX TORCH: hardware write failed; disabling torch\n");
+				break;
+			}
+		}
+		if (applied != 0 && now - since >= (uint64_t)tr_max_secs * 1000ull) {
+			printf("RMX TORCH: %u s safety limit reached; turning off\n", tr_max_secs);
+			wait_zero = true;
+			(void)tr_hw_off();
+			applied = 0;
+			tr_shown = 0;
+			sys_torch_level = 0;
+			continue;
+		}
+		if (applied != 0 && now - last_check >= 100ull) {
+			last_check = now;
+			const char *why = tr_check_trouble();
+			if (why != NULL) {
+				printf("RMX TORCH: emergency off (%s)\n", why);
+				wait_zero = true;
+				(void)tr_hw_off();
+				applied = 0;
+				tr_shown = 0;
+				sys_torch_level = 0;
+			}
+		}
+		tr_wait_ms(applied != 0 ? 25u : 100u);
+	}
+	(void)tr_hw_off();
+	sys_torch_level = 0;
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+rmx1931_torch_init(void)
+{
+	uint32_t mode = 3;
+	thread_t thread;
+
+	if (tr_started) {
+		return;
+	}
+	tr_started = true;
+	(void)PE_parse_boot_argn("rmxtorch", &mode, sizeof(mode));
+	if (mode == 0) {
+		printf("RMX TORCH: disabled (rmxtorch=0)\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("rmxtorch_max_s", &tr_max_secs, sizeof(tr_max_secs));
+	if (tr_max_secs < 1u || tr_max_secs > 120u) {
+		tr_max_secs = TORCH_DEFAULT_MAX_SECS;
+	}
+
+	(void)sweet_spmi_init();
+	tr_core = ml_io_map(TORCH_SPMI_CORE, 0x2000);
+	tr_cnfg = ml_io_map(TORCH_SPMI_CNFG, 0x1000);
+	tr_obs = ml_io_map(TORCH_SPMI_OBS, 0x10000);
+	if (!tr_core || !tr_cnfg || !tr_obs) {
+		printf("RMX TORCH: SPMI map failed\n");
+		return;
+	}
+	uint32_t ver = tr_rd32(tr_core, 0);
+	uint32_t napids = tr_rd32(tr_core, 4u) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || napids == 0 || napids > 512u) {
+		return;
+	}
+	uint16_t found = 0xffffu;
+	uint32_t owner = 7u;
+	for (uint32_t i = 0; i < napids; ++i) {
+		uint32_t apid_map = tr_rd32(tr_core, 0x900u + 4u * i);
+		if (!apid_map || ((apid_map >> 8) & 0xfffu) != TORCH_PPID) {
+			continue;
+		}
+		uint32_t own = tr_rd32(tr_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == 0xffffu || own == 0) {
+			found = (uint16_t)i;
+			owner = own;
+		}
+	}
+	if (found == 0xffffu || owner != 0) {
+		printf("RMX TORCH: PM8150L flash (ppid=%#x) unavailable apid=%#x owner=%u\n",
+		    TORCH_PPID, found, owner);
+		return;
+	}
+	tr_apid = found;
+	uint8_t type = 0, subtype = 0;
+	if (!tr_reg_read(FLASH_REG_TYPE, &type) ||
+	    !tr_reg_read(FLASH_REG_SUBTYPE, &subtype) ||
+	    type != 0x18u || subtype < 0x04u) {
+		printf("RMX TORCH: unexpected peripheral type=%#x subtype=%#x\n", type, subtype);
+		tr_apid = 0xffffu;
+		return;
+	}
+	tr_ch = ml_io_map((vm_offset_t)(TORCH_SPMI_CHNLS + 0x10000ul * (uintptr_t)found), 0x1000);
+	if (!tr_ch) {
+		printf("RMX TORCH: SPMI channel map failed\n");
+		return;
+	}
+	int major = cdevsw_add(-1, &rmx_torch_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, "hakios-torch") == NULL) {
+		printf("RMX TORCH: failed to create /dev/hakios-torch\n");
+		return;
+	}
+	printf("RMX TORCH: /dev/hakios-torch ready (PM8150L ppid=%#x apid=%u type=%#x sub=%#x max=%umA/%us)\n",
+	    TORCH_PPID, found, type, subtype, TORCH_MAX_MA, tr_max_secs);
+	if (kernel_thread_start(tr_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+void
+rmx1931_torch_diag_snapshot(struct sweet_diag_peripherals *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	out->torch_ready = (tr_ch != 0 && !tr_broken);
+	out->torch_fault = tr_broken;
+	out->torch_level = (uint32_t)sys_torch_level;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
