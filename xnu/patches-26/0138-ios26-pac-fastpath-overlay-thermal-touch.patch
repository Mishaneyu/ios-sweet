+/* ---- sysctl kern.sweet.* ---- */
+
+SYSCTL_NODE(_kern, OID_AUTO, sweet, CTLFLAG_RW | CTLFLAG_LOCKED, 0,
+    "Live SWEET/iOS bring-up telemetry");
+
+static int
+sysctl_sweet_log_pos SYSCTL_HANDLER_ARGS
+{
+	#pragma unused(oidp, arg1, arg2)
+	uint64_t v = sweet_log_position();
+	return SYSCTL_OUT(req, &v, sizeof(v));
+}
+SYSCTL_PROC(_kern_sweet, OID_AUTO, log_pos, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_log_pos, "Q", "Total console bytes written to sweet_log_ring");
+
+static int
+sysctl_sweet_fps_1s SYSCTL_HANDLER_ARGS
+{
+	#pragma unused(oidp, arg1, arg2)
+	struct sweet_diag_display d;
+	bzero(&d, sizeof(d));
+	sweet_fb_diag_snapshot(&d);
+	int v = (int)d.fps_1s_x10;
+	return SYSCTL_OUT(req, &v, sizeof(v));
+}
+SYSCTL_PROC(_kern_sweet, OID_AUTO, fps_1s_x10, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_fps_1s, "I", "Rolling 1-second display swap FPS * 10");
+
+static int
+sysctl_sweet_gpu_busy SYSCTL_HANDLER_ARGS
+{
+	#pragma unused(oidp, arg1, arg2)
+	struct sweet_diag_gpu *g = kalloc_data(sizeof(*g), Z_WAITOK | Z_ZERO);
+	int v = 0;
+	if (g != NULL) {
+		sweet_gpu_diag_snapshot(g);
+		v = g->win_age_ms <= 6000ULL ? (int)g->win_busy_pct : 0;
+		kfree_data(g, sizeof(*g));
+	}
+	return SYSCTL_OUT(req, &v, sizeof(v));
+}
+SYSCTL_PROC(_kern_sweet, OID_AUTO, gpu_busy_pct, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_gpu_busy, "I", "Adreno 640 GPU busy percentage");
+
+static int
+sysctl_sweet_crashes SYSCTL_HANDLER_ARGS
+{
+	#pragma unused(oidp, arg1, arg2)
+	uint64_t v = 0;
+	lck_spin_lock(&sweet_crash_lock);
+	v = g_crash_seq;
+	lck_spin_unlock(&sweet_crash_lock);
+	return SYSCTL_OUT(req, &v, sizeof(v));
+}
+SYSCTL_PROC(_kern_sweet, OID_AUTO, crashes, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_crashes, "Q", "Total userland fatal signal crashes since boot");
+
+void
+sweet_diag_init(void)
+{
+	static int started = 0;
+	if (!os_atomic_cmpxchg(&started, 0, 1, relaxed)) {
+		return;
+	}
+	int maj_d = cdevsw_add(-1, &sweet_diag_cdevsw);
+	if (maj_d >= 0) {
+		(void)devfs_make_node(makedev(maj_d, 0), DEVFS_CHAR, UID_ROOT,
+		    GID_WHEEL, 0444, "sweet-diag");
+	}
+	int maj_l = cdevsw_add(-1, &sweet_log_cdevsw);
+	if (maj_l >= 0) {
+		(void)devfs_make_node(makedev(maj_l, 0), DEVFS_CHAR, UID_ROOT,
+		    GID_WHEEL, 0444, "sweet-log");
+	}
+	printf("SWEET DIAG: /dev/sweet-diag and /dev/sweet-log ready (majors %d, %d)\n", maj_d, maj_l);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
