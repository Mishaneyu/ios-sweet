+		 * then copy the finished rectangle to A6_GVA_FB in a single pass.
+		 */
+		if (!display_dim_built) {
+			display_dim_build();
+		}
+		if (ext && display_mask_radius != corner_radius) {
+			display_mask_build(corner_radius, ext);
+			display_mask_radius = corner_radius;
+		}
+		struct a6_blit sframe = frame;
+		sframe.dst_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF;
+		n += a6_blit_ib(&gpu, &sframe, ib + n);
+		struct a6_blit dim_blit = {
+			.src_iova = A6_GVA_POOL + DISPLAY_DIM_OFF + (uint64_t)dim * DISPLAY_DIM_STRIDE,
+			.src_w = DISPLAY_DIM_TILE, .src_h = DISPLAY_DIM_TILE, .src_pitch = DISPLAY_DIM_PITCH,
+			.sw = DISPLAY_DIM_TILE, .sh = DISPLAY_DIM_TILE,
+			.dst_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF, .dst_pitch = fb_pitch,
+			.dx = frame.dx, .dy = frame.dy, .dw = frame.dw, .dh = frame.dh,
+			.blend = true,
+		};
+		n += a6_blit_ib(&gpu, &dim_blit, ib + n);
+		if (ext) {
+			uint32_t top = frame.dy, bottom = frame.dy + frame.dh - ext;
+			for (uint32_t corner = 0; corner < 4; corner++) {
+				struct a6_blit matte = {
+					.src_iova = A6_GVA_POOL + DISPLAY_MASK_OFF,
+					.src_w = DISPLAY_MASK_DIM, .src_h = DISPLAY_MASK_DIM, .src_pitch = DISPLAY_MASK_PITCH,
+					.sx = (corner & 1) * DISPLAY_MASK_SIDE, .sy = (corner >> 1) * DISPLAY_MASK_SIDE,
+					.sw = ext, .sh = ext,
+					.dst_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF, .dst_pitch = fb_pitch,
+					.dx = (corner & 1) ? frame.dx + frame.dw - ext : frame.dx,
+					.dy = (corner & 2) ? bottom : top,
+					.dw = ext, .dh = ext, .blend = true,
+				};
+				n += a6_blit_ib(&gpu, &matte, ib + n);
+			}
+		}
+		struct a6_blit copy_all = {
+			.src_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF,
+			.src_w = PANEL_W, .src_h = PANEL_H, .src_pitch = fb_pitch,
+			.sx = frame.dx, .sy = frame.dy, .sw = frame.dw, .sh = frame.dh,
+			.dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch,
+			.dx = frame.dx, .dy = frame.dy, .dw = frame.dw, .dh = frame.dh,
+		};
+		n += a6_blit_ib(&gpu, &copy_all, ib + n);
+	} else if (ext) {
 		if (display_mask_radius != corner_radius) {
 			display_mask_build(corner_radius, ext);
 			display_mask_radius = corner_radius;
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 2615242..c9a037b 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -14,6 +14,7 @@
 #include <machine/machine_routines.h>
 #include <pexpert/device_tree.h>
 #include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
@@ -67,6 +68,7 @@ keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
 	}
 	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
 	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	bool intrs = sweet_spmi_bus_acquire();
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
 	__asm__ volatile("dsb osh" ::: "memory");
@@ -74,13 +76,16 @@ keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
 		keys_last_status = keys_rd(keys_obs, off + 0x08u);
 		if (keys_last_status & 1u) {
 			if (keys_last_status & 0x0eu) {
