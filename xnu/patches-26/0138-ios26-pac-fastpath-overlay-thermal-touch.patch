index 0000000..86b8b23
--- /dev/null
+++ b/bsd/dev/sweet_diag.c
@@ -0,0 +1,757 @@
+/*
+ * Live OS & hardware diagnostic hub for booted iOS bring-up:
+ *   - /dev/sweet-diag (0444): live JSON snapshot of display/FPS/present path,
+ *     Adreno 640 GPU + pool + per-process Metal/Turnip clients, touch/keys,
+ *     Wi-Fi/USB + interface IPs, battery/audio/torch/haptics, exec_inject,
+ *     denied sandbox privileges, and the last 16 userland crash backtraces.
+ *   - /dev/sweet-log  (0444): lossless read/tail access to XNU's 1 MiB
+ *     sweet_log_ring console buffer from userland or SSH.
+ *   - sysctl kern.sweet.*: lightweight live telemetry counters.
+ *   - sweet_diag_format_json(): shared with TCP 2223 "DIAG" in sweet_files.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
+#include <sys/time.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <os/atomic_private.h>
+#include <net/if.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <stdarg.h>
+#include <sweet_diag.h>
+
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+#define SWEET_DIAG_JSON_CAP     32768u
+#define SWEET_LOG_CHUNK_CAP     16384u
+
+static LCK_GRP_DECLARE(sweet_diag_grp, "sweet-diag");
+static LCK_SPIN_DECLARE(sweet_crash_lock, &sweet_diag_grp);
+
+static uint32_t g_cpufreq_mhz[3];
+static bool     g_wdt_enabled;
+static int32_t  g_wdt_reboot_s;
+static int32_t  g_wdt_elapsed_s;
+
+static char     g_touch_driver[32] = "none";
+static bool     g_touch_ready;
+static uint32_t g_touch_poll_ms;
+static uint64_t g_touch_errors;
+
+static uint64_t g_crash_seq;
+static struct sweet_diag_crash g_crashes[SWEET_DIAG_MAX_CRASHES];
+
+static uint64_t
+sd_uptime_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ULL;
+}
+
+void
+sweet_cpufreq_record(unsigned cluster, unsigned mhz)
+{
+	if (cluster < 3) {
+		g_cpufreq_mhz[cluster] = (uint32_t)mhz;
+	}
+}
+
+void
+sweet_wdt_record(bool enabled, int reboot_s, int elapsed_s)
+{
+	g_wdt_enabled = enabled;
+	g_wdt_reboot_s = (int32_t)reboot_s;
+	g_wdt_elapsed_s = (int32_t)elapsed_s;
+}
+
+void
+sweet_touch_driver_record(const char *driver, bool ready, uint32_t poll_ms, uint64_t errors)
+{
+	if (driver != NULL) {
+		strlcpy(g_touch_driver, driver, sizeof(g_touch_driver));
+	}
+	g_touch_ready = ready;
+	g_touch_poll_ms = poll_ms;
+	g_touch_errors = errors;
+}
+
+void
+sweet_crash_record(const char *name, int pid, int sig, uint64_t code, uint64_t subcode,
+    uint64_t pc, uint64_t lr, uint64_t sp, uint64_t fp, uint64_t far,
+    uint64_t slide, uint64_t mh, const uint64_t *bt, uint32_t bt_count)
+{
+	uint64_t up_ms = sd_uptime_ms();
+
+	lck_spin_lock(&sweet_crash_lock);
+	uint64_t seq = ++g_crash_seq;
+	struct sweet_diag_crash *c = &g_crashes[(seq - 1) % SWEET_DIAG_MAX_CRASHES];
+	bzero(c, sizeof(*c));
+	c->seq = seq;
+	c->uptime_ms = up_ms;
+	c->pid = (int32_t)pid;
+	c->sig = (int32_t)sig;
+	if (name != NULL) {
+		strlcpy(c->name, name, sizeof(c->name));
+	}
+	c->code = code;
+	c->subcode = subcode;
+	c->pc = pc;
+	c->lr = lr;
+	c->sp = sp;
+	c->fp = fp;
+	c->far = far;
+	c->slide = slide;
+	c->mh = mh;
+	if (bt_count > SWEET_DIAG_MAX_BT) {
+		bt_count = SWEET_DIAG_MAX_BT;
+	}
+	c->bt_count = bt_count;
+	for (uint32_t i = 0; i < bt_count; i++) {
+		c->bt[i] = bt[i];
+	}
+	lck_spin_unlock(&sweet_crash_lock);
+}
+
+/* ---- Safe bounded JSON builder ---- */
+
+struct sd_buf {
+	char  *p;
+	size_t len;
+	size_t cap;
+};
+
+static void sd_putf(struct sd_buf *b, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+
+static void
+sd_putf(struct sd_buf *b, const char *fmt, ...)
+{
+	if (b->len + 1 >= b->cap) {
+		return;
+	}
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(b->p + b->len, b->cap - b->len, fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		size_t adv = (size_t)n;
+		if (b->len + adv >= b->cap) {
+			b->len = b->cap - 1;
+			b->p[b->len] = '\0';
+		} else {
+			b->len += adv;
+		}
+	}
+}
+
+static void
+sd_put_json_str(struct sd_buf *b, const char *s)
+{
+	sd_putf(b, "\"");
+	if (s != NULL) {
+		for (const unsigned char *c = (const unsigned char *)s; *c != 0; c++) {
+			if (*c == '"' || *c == '\\') {
+				sd_putf(b, "\\%c", (int)*c);
+			} else if (*c == '\n') {
+				sd_putf(b, "\\n");
+			} else if (*c == '\r') {
+				sd_putf(b, "\\r");
+			} else if (*c == '\t') {
+				sd_putf(b, "\\t");
+			} else if (*c >= 0x20 && *c < 0x7f) {
+				sd_putf(b, "%c", (int)*c);
+			} else {
+				sd_putf(b, "\\u%04x", (unsigned)*c);
+			}
+		}
+	}
+	sd_putf(b, "\"");
+}
+
+static void
+sd_fourcc_str(uint32_t fmt, char out[12])
+{
+	if (fmt == 0) {
+		strlcpy(out, "none", 12);
+		return;
+	}
+	unsigned char c0 = (unsigned char)((fmt >> 24) & 0xff);
+	unsigned char c1 = (unsigned char)((fmt >> 16) & 0xff);
+	unsigned char c2 = (unsigned char)((fmt >> 8) & 0xff);
+	unsigned char c3 = (unsigned char)(fmt & 0xff);
+	if (c0 >= 0x20 && c0 < 0x7f && c1 >= 0x20 && c1 < 0x7f &&
+	    c2 >= 0x20 && c2 < 0x7f && c3 >= 0x20 && c3 < 0x7f) {
+		out[0] = (char)c0;
+		out[1] = (char)c1;
+		out[2] = (char)c2;
+		out[3] = (char)c3;
+		out[4] = '\0';
+	} else {
+		snprintf(out, 12, "0x%08x", fmt);
+	}
+}
+
+static void
+sd_if_info(const char *ifname, char ip_out[20], bool *up_out, uint64_t *rx_pkts, uint64_t *tx_pkts)
+{
+	ip_out[0] = '\0';
+	*up_out = false;
+	*rx_pkts = 0;
+	*tx_pkts = 0;
+
+	ifnet_t ifp = NULL;
+	if (ifnet_find_by_name(ifname, &ifp) != 0 || ifp == NULL) {
+		return;
+	}
+	u_int16_t flags = ifnet_flags(ifp);
+	*up_out = (flags & IFF_UP) != 0 && (flags & IFF_RUNNING) != 0;
+
+	struct ifnet_stats_param st;
+	bzero(&st, sizeof(st));
+	if (ifnet_stat(ifp, &st) == 0) {
+		*rx_pkts = st.packets_in;
+		*tx_pkts = st.packets_out;
+	}
+
+	ifaddr_t *addrs = NULL;
+	if (ifnet_get_address_list_family(ifp, &addrs, AF_INET) == 0 && addrs != NULL) {
+		for (unsigned i = 0; addrs[i] != NULL; i++) {
+			struct sockaddr_in sin;
+			bzero(&sin, sizeof(sin));
+			if (ifaddr_address(addrs[i], (struct sockaddr *)&sin, sizeof(sin)) == 0 &&
+			    sin.sin_addr.s_addr != 0) {
+				uint32_t a = ntohl(sin.sin_addr.s_addr);
+				snprintf(ip_out, 20, "%u.%u.%u.%u",
+				    (a >> 24) & 0xffu, (a >> 16) & 0xffu,
+				    (a >> 8) & 0xffu, a & 0xffu);
+				break;
+			}
+		}
+		ifnet_free_address_list(addrs);
+	}
+	ifnet_release(ifp);
+}
+
+size_t
+sweet_diag_format_json(char *buf, size_t cap)
+{
+	if (buf == NULL || cap < 64) {
+		return 0;
+	}
+	buf[0] = '\0';
+	struct sd_buf b = { .p = buf, .len = 0, .cap = cap };
+
+	struct sweet_diag_display disp;
+	struct sweet_diag_gpu *gpu = kalloc_data(sizeof(*gpu), Z_WAITOK | Z_ZERO);
+	struct sweet_diag_input inp;
+	struct sweet_diag_net net;
+	struct sweet_diag_peripherals per;
+	struct sweet_diag_priv privs[SWEET_DIAG_MAX_PRIVS];
+	struct sweet_diag_crash *crashes = kalloc_data(sizeof(*crashes) * SWEET_DIAG_MAX_CRASHES, Z_WAITOK | Z_ZERO);
+	char inject_conf[512];
+
+	if (gpu == NULL || crashes == NULL) {
+		if (gpu != NULL) {
+			kfree_data(gpu, sizeof(*gpu));
+		}
+		if (crashes != NULL) {
+			kfree_data(crashes, sizeof(*crashes) * SWEET_DIAG_MAX_CRASHES);
+		}
+		return 0;
+	}
+
+	bzero(&disp, sizeof(disp));
+	bzero(&inp, sizeof(inp));
+	bzero(&net, sizeof(net));
+	bzero(&per, sizeof(per));
+	bzero(privs, sizeof(privs));
+	inject_conf[0] = '\0';
+
+	sweet_fb_diag_snapshot(&disp);
+	sweet_gpu_diag_snapshot(gpu);
+	sweet_accel_diag_snapshot(gpu);
+	sweet_hid_diag_snapshot(&inp);
+	strlcpy(inp.driver, g_touch_driver, sizeof(inp.driver));
+	inp.touch_ready = g_touch_ready;
+	inp.poll_ms = g_touch_poll_ms;
+	inp.touch_errors = g_touch_errors;
+
+	sweet_wlan_diag_snapshot(&net);
+	sweet_usb_diag_snapshot(&net);
+
+	rmx1931_battery_diag_snapshot(&per);
+	rmx1931_audio_diag_snapshot(&per);
+	rmx1931_torch_diag_snapshot(&per);
+	rmx1931_haptic_diag_snapshot(&per);
+
+	uint64_t inject_hits = 0;
+	sweet_exec_inject_diag(inject_conf, sizeof(inject_conf), &inject_hits);
+
+	uint32_t priv_total = 0;
+	uint32_t priv_n = sweet_amfi_priv_diag(privs, SWEET_DIAG_MAX_PRIVS, &priv_total);
+
+	uint64_t crash_total = 0;
+	uint32_t crash_n = 0;
+	lck_spin_lock(&sweet_crash_lock);
+	crash_total = g_crash_seq;
+	uint64_t start_seq = crash_total > SWEET_DIAG_MAX_CRASHES ? crash_total - SWEET_DIAG_MAX_CRASHES + 1 : 1;
+	for (uint64_t s = start_seq; crash_total > 0 && s <= crash_total && crash_n < SWEET_DIAG_MAX_CRASHES; s++) {
+		crashes[crash_n++] = g_crashes[(s - 1) % SWEET_DIAG_MAX_CRASHES];
+	}
+	lck_spin_unlock(&sweet_crash_lock);
+
+	char en0_ip[20], ue0_ip[20];
+	bool en0_up = false, ue0_up = false;
+	uint64_t en0_rx = 0, en0_tx = 0, ue0_rx = 0, ue0_tx = 0;
+	sd_if_info("en0", en0_ip, &en0_up, &en0_rx, &en0_tx);
+	sd_if_info("ue0", ue0_ip, &ue0_up, &ue0_rx, &ue0_tx);
+
+	struct timeval tv;
+	microtime(&tv);
+	uint64_t up_ms = sd_uptime_ms();
+	int32_t rem_s = (g_wdt_enabled && g_wdt_reboot_s > 0) ?
+	    (g_wdt_reboot_s > g_wdt_elapsed_s ? g_wdt_reboot_s - g_wdt_elapsed_s : 0) : -1;
+
+	const char *present_mode = "no_swaps";
+	if (!disp.power_on) {
+		present_mode = "power_off";
+	} else if (disp.presents_total > 0) {
+		if (disp.last_present_gpu) {
+			present_mode = disp.direct_present ? "gpu_direct" : "gpu_vsync";
+		} else {
+			present_mode = "cpu_fallback";
+		}
+	}
+
+	char fourcc[12];
+	sd_fourcc_str(disp.last_surf_fmt, fourcc);
+
+	sd_putf(&b, "{\n");
+	sd_putf(&b, "  \"schema\": 1,\n");
+	sd_putf(&b, "  \"system\": {\n");
+	sd_putf(&b, "    \"uptime_ms\": %llu,\n", (unsigned long long)up_ms);
+	sd_putf(&b, "    \"wall_time_sec\": %lld,\n", (long long)tv.tv_sec);
+	sd_putf(&b, "    \"boottime_sec\": %lld,\n", (long long)boottime_sec());
+	sd_putf(&b, "    \"cpus_online\": %u,\n", ml_get_cpu_count());
+	sd_putf(&b, "    \"cpufreq_mhz\": [%u, %u, %u],\n",
+	    g_cpufreq_mhz[0], g_cpufreq_mhz[1], g_cpufreq_mhz[2]);
+	sd_putf(&b, "    \"wdt_enabled\": %s,\n", g_wdt_enabled ? "true" : "false");
+	sd_putf(&b, "    \"flamereboot_s\": %d,\n", g_wdt_reboot_s);
+	sd_putf(&b, "    \"reboot_remaining_s\": %d,\n", rem_s);
+	sd_putf(&b, "    \"klog_bytes_total\": %llu,\n", (unsigned long long)sweet_log_position());
+	sd_putf(&b, "    \"boot_args\": ");
+	sd_put_json_str(&b, PE_boot_args());
+	sd_putf(&b, "\n  },\n");
+
+	/* Display & Framebuffer */
+	uint32_t bri_pct = disp.backlight_registered ? (disp.raw_level * 100u + 1023u) / 2047u : 100u;
+	sd_putf(&b, "  \"display\": {\n");
+	sd_putf(&b, "    \"registered\": %s,\n", disp.registered ? "true" : "false");
+	sd_putf(&b, "    \"power_on\": %s,\n", disp.power_on ? "true" : "false");
+	sd_putf(&b, "    \"present_mode\": \"%s\",\n", present_mode);
+	sd_putf(&b, "    \"direct_present\": %s,\n", disp.direct_present ? "true" : "false");
+	sd_putf(&b, "    \"force_cpu\": %s,\n", disp.force_cpu ? "true" : "false");
+	sd_putf(&b, "    \"gpu_present_active\": %s,\n", disp.last_present_gpu ? "true" : "false");
+	sd_putf(&b, "    \"panel_pa\": \"0x%llx\",\n", (unsigned long long)disp.panel_pa);
+	sd_putf(&b, "    \"panel_w\": %u, \"panel_h\": %u, \"panel_stride\": %u,\n",
+	    disp.panel_w, disp.panel_h, disp.panel_stride);
+	sd_putf(&b, "    \"logical_w\": %u, \"logical_h\": %u,\n", disp.logical_w, disp.logical_h);
+	sd_putf(&b, "    \"fit_rect\": [%d, %d, %d, %d],\n",
+	    disp.fit_x, disp.fit_y, disp.fit_w, disp.fit_h);
+	sd_putf(&b, "    \"corner_radius\": %u, \"corner_ext\": %u,\n",
+	    disp.corner_radius, disp.corner_ext);
+	sd_putf(&b, "    \"vsync_hz\": %u, \"vsync_count\": %llu,\n",
+	    disp.vsync_hz, (unsigned long long)disp.vsync_count);
+	sd_putf(&b, "    \"fps_1s\": %u.%u, \"fps_5s\": %u.%u,\n",
+	    disp.fps_1s_x10 / 10u, disp.fps_1s_x10 % 10u,
+	    disp.fps_5s_x10 / 10u, disp.fps_5s_x10 % 10u);
+	sd_putf(&b, "    \"swaps_total\": %llu, \"presents_total\": %llu,\n",
+	    (unsigned long long)disp.swaps_total, (unsigned long long)disp.presents_total);
+	sd_putf(&b, "    \"gpu_presents\": %llu, \"cpu_presents\": %llu,\n",
+	    (unsigned long long)disp.gpu_presents, (unsigned long long)disp.cpu_presents);
+	sd_putf(&b, "    \"avg_present_us\": %llu,\n", (unsigned long long)disp.avg_present_us);
+	sd_putf(&b, "    \"clients_count\": %u,\n", disp.clients_count);
+	sd_putf(&b, "    \"last_swap\": {\n");
+	sd_putf(&b, "      \"surface_id\": %u, \"w\": %u, \"h\": %u, \"bpr\": %u,\n",
+	    disp.last_surf_id, disp.last_surf_w, disp.last_surf_h, disp.last_surf_bpr);
+	sd_putf(&b, "      \"fourcc\": ");
+	sd_put_json_str(&b, fourcc);
+	sd_putf(&b, ", \"layer_mask\": %u, \"age_ms\": %llu\n",
+	    disp.last_layer_mask, (unsigned long long)disp.last_swap_age_ms);
+	sd_putf(&b, "    },\n");
+	sd_putf(&b, "    \"gpu_fallback_mask\": %u, \"gpu_fallback_count\": %llu, \"last_fallback_reason\": ",
+	    disp.gpu_fallback_mask, (unsigned long long)disp.gpu_fallback_count);
+	sd_put_json_str(&b, disp.last_fallback_reason);
+	sd_putf(&b, ",\n");
+	sd_putf(&b, "    \"backlight\": {\n");
+	sd_putf(&b, "      \"registered\": %s, \"millinits\": %u, \"raw_level\": %u, \"brightness_pct\": %u, \"dim_alpha\": %u\n",
+	    disp.backlight_registered ? "true" : "false", disp.millinits,
+	    disp.raw_level, bri_pct, disp.dim_alpha);
+	sd_putf(&b, "    }\n");
+	sd_putf(&b, "  },\n");
+
+	/* GPU & Metal Clients */
+	uint64_t pool_free = gpu->pool_total_bytes > gpu->pool_used_bytes ?
+	    gpu->pool_total_bytes - gpu->pool_used_bytes : 0;
+	uint32_t live_busy_pct = gpu->win_age_ms <= 6000ULL ? gpu->win_busy_pct : 0;
+	sd_putf(&b, "  \"gpu\": {\n");
+	sd_putf(&b, "    \"enabled\": %s, \"ready\": %s, \"ddr_boost\": %s,\n",
+	    gpu->enabled ? "true" : "false", gpu->ready ? "true" : "false",
+	    gpu->ddr_boost ? "true" : "false");
+	sd_putf(&b, "    \"perf_level\": %u, \"clock_mhz\": %u, \"recoveries\": %llu,\n",
+	    gpu->perf_level, gpu->clock_mhz, (unsigned long long)gpu->recoveries);
+	sd_putf(&b, "    \"fence_submitted\": %u, \"fence_done\": %u,\n",
+	    gpu->fence_submitted, gpu->fence_done);
+	sd_putf(&b, "    \"present_frames\": %llu, \"clean_us\": %llu, \"blit_us\": %llu,\n",
+	    (unsigned long long)gpu->present_frames, (unsigned long long)gpu->clean_us,
+	    (unsigned long long)gpu->blit_us);
+	sd_putf(&b, "    \"pool_total_mb\": %llu, \"pool_used_mb\": %llu, \"pool_free_mb\": %llu, \"pool_peak_mb\": %llu,\n",
+	    (unsigned long long)(gpu->pool_total_bytes >> 20),
+	    (unsigned long long)(gpu->pool_used_bytes >> 20),
+	    (unsigned long long)(pool_free >> 20),
+	    (unsigned long long)(gpu->pool_peak_bytes >> 20));
+	sd_putf(&b, "    \"pool_cap_mb\": %u, \"pool_reserve_mb\": %u, \"pool_alloc_failures\": %llu,\n",
+	    gpu->cap_mb, gpu->reserve_mb, (unsigned long long)gpu->pool_alloc_failures);
+	sd_putf(&b, "    \"busy_pct_live\": %u, \"window_age_ms\": %llu,\n",
+	    live_busy_pct, (unsigned long long)gpu->win_age_ms);
+	sd_putf(&b, "    \"window_5s\": {\n");
+	sd_putf(&b, "      \"submits\": %u, \"missed\": %u, \"busy_ms\": %llu, \"busy_pct\": %u,\n",
+	    gpu->win_submits, gpu->win_missed, (unsigned long long)gpu->win_busy_ms, gpu->win_busy_pct);
+	sd_putf(&b, "      \"mean_us\": %llu, \"longest_us\": %llu\n",
+	    (unsigned long long)gpu->win_mean_us, (unsigned long long)gpu->win_longest_us);
+	sd_putf(&b, "    },\n");
+	sd_putf(&b, "    \"owners_5s\": [");
+	for (uint32_t i = 0; i < gpu->owner_count; i++) {
+		const struct sweet_diag_gpu_owner *o = &gpu->owners[i];
+		sd_putf(&b, "%s{\"pid\": %d, \"name\": ", i ? ", " : "", o->pid);
+		sd_put_json_str(&b, o->name);
+		sd_putf(&b, ", \"submits\": %u, \"busy_ms\": %llu}",
+		    o->submits, (unsigned long long)o->busy_ms);
+	}
+	sd_putf(&b, "],\n");
+	sd_putf(&b, "    \"clients\": [");
+	for (uint32_t i = 0; i < gpu->client_count; i++) {
+		const struct sweet_diag_gpu_client *c = &gpu->clients[i];
+		sd_putf(&b, "%s\n      {\"pid\": %d, \"name\": ", i ? "," : "", c->pid);
+		sd_put_json_str(&b, c->name);
+		sd_putf(&b, ", \"abi\": \"%s\", \"system\": %s, \"cap_refused\": %s, "
+		    "\"pool_kb\": %llu, \"pool_peak_kb\": %llu, \"submits\": %llu, \"faults\": %llu}",
+		    c->v2 ? "v2_turnip" : "v1",
+		    c->system ? "true" : "false",
+		    c->cap_refused ? "true" : "false",
+		    (unsigned long long)(c->pool_bytes >> 10),
+		    (unsigned long long)(c->pool_peak >> 10),
+		    (unsigned long long)c->submits,
+		    (unsigned long long)c->faults);
+	}
+	sd_putf(&b, "%s]\n  },\n", gpu->client_count ? "\n    " : "");
+
+	/* Input */
+	sd_putf(&b, "  \"input\": {\n");
+	sd_putf(&b, "    \"touch_driver\": ");
+	sd_put_json_str(&b, inp.driver);
+	sd_putf(&b, ",\n    \"touch_ready\": %s, \"poll_ms\": %u, \"touch_errors\": %llu,\n",
+	    inp.touch_ready ? "true" : "false", inp.poll_ms, (unsigned long long)inp.touch_errors);
+	sd_putf(&b, "    \"touch_events\": %llu, \"fingers_mask\": %u, \"last_x\": %d, \"last_y\": %d, \"last_touch_age_ms\": %llu,\n",
+	    (unsigned long long)inp.touch_events, inp.fingers_mask, inp.last_x, inp.last_y,
+	    (unsigned long long)inp.last_touch_age_ms);
+	sd_putf(&b, "    \"button_events\": %llu, \"buttons_mask\": %u\n",
+	    (unsigned long long)inp.button_events, inp.buttons_mask);
+	sd_putf(&b, "  },\n");
+
+	/* Network & USB */
+	char mac_s[20], bssid_s[20];
+	snprintf(mac_s, sizeof(mac_s), "%02x:%02x:%02x:%02x:%02x:%02x",
+	    net.wlan_mac[0], net.wlan_mac[1], net.wlan_mac[2],
+	    net.wlan_mac[3], net.wlan_mac[4], net.wlan_mac[5]);
+	snprintf(bssid_s, sizeof(bssid_s), "%02x:%02x:%02x:%02x:%02x:%02x",
+	    net.wlan_bssid[0], net.wlan_bssid[1], net.wlan_bssid[2],
+	    net.wlan_bssid[3], net.wlan_bssid[4], net.wlan_bssid[5]);
+	sd_putf(&b, "  \"network\": {\n");
+	sd_putf(&b, "    \"wifi\": {\n");
+	sd_putf(&b, "      \"wland_open\": %s, \"radio_ready\": %s, \"link_up\": %s,\n",
+	    net.wland_open ? "true" : "false", net.wlan_ready ? "true" : "false",
+	    net.wlan_link_up ? "true" : "false");
+	sd_putf(&b, "      \"en0_up\": %s, \"en0_ip\": ", en0_up ? "true" : "false");
+	sd_put_json_str(&b, en0_ip);
+	sd_putf(&b, ", \"en0_rx_pkts\": %llu, \"en0_tx_pkts\": %llu,\n",
+	    (unsigned long long)en0_rx, (unsigned long long)en0_tx);
+	sd_putf(&b, "      \"mac\": \"%s\", \"ssid\": ", mac_s);
+	sd_put_json_str(&b, net.wlan_ssid);
+	sd_putf(&b, ", \"bssid\": \"%s\",\n", bssid_s);
+	sd_putf(&b, "      \"freq_mhz\": %u, \"rssi_dbm\": %d, \"bss_heard\": %u, \"tx_dropped\": %llu\n",
+	    (unsigned)net.wlan_freq_mhz, (int)net.wlan_rssi_dbm, net.wlan_bss_count,
+	    (unsigned long long)net.wlan_tx_dropped);
+	sd_putf(&b, "    },\n");
+	sd_putf(&b, "    \"usb\": {\n");
+	sd_putf(&b, "      \"ready\": %s, \"configured\": %s, \"ue0_up\": %s, \"ue0_ip\": ",
+	    net.usb_ready ? "true" : "false", net.usb_configured ? "true" : "false",
+	    ue0_up ? "true" : "false");
+	sd_put_json_str(&b, ue0_ip);
+	sd_putf(&b, ",\n      \"rx_frames\": %llu, \"tx_frames\": %llu, \"files_port\": 2223, \"cmd_port\": 5141\n",
+	    (unsigned long long)net.usb_rx_frames, (unsigned long long)net.usb_tx_frames);
+	sd_putf(&b, "    }\n");
+	sd_putf(&b, "  },\n");
+
+	/* Peripherals */
