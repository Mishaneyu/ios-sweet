+void sweet_apply_overlay(void);
+void
+sweet_apply_overlay(void)
+{
+	static char rel[300], path[320], linktarget[128];
+	DTEntry chosen;
+	void const *blob = NULL;
+	unsigned size = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-overlay", &blob, &size) != kSuccess ||
+	    blob == NULL || size < 512) {
+		return;
+	}
+	const uint8_t *bytes = (const uint8_t *)blob;
+	uint64_t h = 14695981039346656037ULL;
+	for (unsigned i = 0; i < size; i++) {
+		h = (h ^ bytes[i]) * 1099511628211ULL;
+	}
+	char want[20], have[20];
+	snprintf(want, sizeof(want), "%016llx\n", (unsigned long long)h);
+
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t svp = NULLVP;
+	if (vnode_open("/private/var/local/.overlay-stamp", FREAD, 0, 0, &svp, ctx) == 0) {
+		int resid = 0;
+		bzero(have, sizeof(have));
+		int rerr = vn_rdwr(UIO_READ, svp, (caddr_t)have, 17, 0, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		(void)vnode_close(svp, FREAD, ctx);
+		if (rerr == 0 && resid == 0 && memcmp(have, want, 17) == 0) {
+			printf("SWEET OVERLAY: stamp %016llx up to date\n", (unsigned long long)h);
+			return;
+		}
+	}
+
+	unsigned files = 0, dirs = 0, links = 0, removed = 0, errs = 0;
+	uint64_t pos = 0;
+	while (pos + 512 <= (uint64_t)size) {
+		const uint8_t *hdr = bytes + pos;
+		bool all_zero = true;
+		for (unsigned i = 0; i < 512; i++) {
+			if (hdr[i] != 0) {
+				all_zero = false;
+				break;
+			}
+		}
+		if (all_zero) {
+			break;
+		}
+		uint64_t fsize = sweet_ov_octal(hdr + 124, 12);
+		int mode = (int)sweet_ov_octal(hdr + 100, 8);
+		uid_t uid = (uid_t)sweet_ov_octal(hdr + 108, 8);
+		gid_t gid = (gid_t)sweet_ov_octal(hdr + 116, 8);
+		char typeflag = (char)hdr[156];
+
+		size_t plen = 0, nlen = 0;
+		while (plen < 155 && hdr[345 + plen] != 0) {
+			plen++;
+		}
+		while (nlen < 100 && hdr[nlen] != 0) {
+			nlen++;
+		}
+		if (plen > 0) {
+			snprintf(rel, sizeof(rel), "%.*s/%.*s", (int)plen, (const char *)(hdr + 345),
+			    (int)nlen, (const char *)hdr);
+		} else {
+			snprintf(rel, sizeof(rel), "%.*s", (int)nlen, (const char *)hdr);
+		}
+
+		pos += 512;
+		uint64_t data_pos = pos;
+		uint64_t padded = (fsize + 511ULL) & ~511ULL;
+		if (data_pos + padded > (uint64_t)size) {
+			break;
+		}
+		pos += padded;
+
+		if (typeflag == 'x' || typeflag == 'g') {
+			continue;
+		}
+		char *rp = rel;
+		while (rp[0] == '.' && rp[1] == '/') {
+			rp += 2;
+		}
+		while (*rp == '/') {
+			rp++;
+		}
+		size_t rlen = strlen(rp);
+		while (rlen > 0 && rp[rlen - 1] == '/') {
+			rp[--rlen] = 0;
+		}
+		if (rlen == 0 || strcmp(rp, ".") == 0) {
+			continue;
+		}
+
+		if (strcmp(rp, ".sweet-rm") == 0) {
+			const char *s = (const char *)(bytes + data_pos);
+			const char *end = s + fsize;
+			while (s < end) {
+				const char *e = s;
+				while (e < end && *e != '\n' && *e != '\r') {
+					e++;
+				}
+				size_t ll = (size_t)(e - s);
+				while (ll > 0 && (s[0] == ' ' || s[0] == '/')) {
+					s++;
+					ll--;
+				}
+				if (ll > 0 && s[0] != '#' && ll < sizeof(path) - 2) {
+					snprintf(path, sizeof(path), "/%.*s", (int)ll, s);
+					if (sweet_vfs_unlink(path) == 0) {
+						removed++;
+					}
+				}
+				s = e;
+				while (s < end && (*s == '\n' || *s == '\r')) {
+					s++;
+				}
+			}
+			continue;
+		}
+
+		snprintf(path, sizeof(path), "/%s", rp);
+		sweet_ov_mkdirs_parent(path);
+		if (typeflag == '5') {
+			vnode_t dvp = NULLVP;
+			if (vnode_lookup(path, 0, &dvp, ctx) == 0) {
+				vnode_put(dvp);
+			} else {
+				(void)sweet_vfs_mkdir(path, mode ? mode : 0755);
+			}
+			sweet_ov_setattr(path, mode ? mode : 0755, uid, gid);
+			dirs++;
+		} else if (typeflag == '2') {
+			size_t llen = 0;
+			while (llen < 100 && hdr[157 + llen] != 0) {
+				llen++;
+			}
+			snprintf(linktarget, sizeof(linktarget), "%.*s", (int)llen, (const char *)(hdr + 157));
+			(void)sweet_vfs_unlink(path);
+			if (sweet_vfs_symlink(linktarget, path) == 0) {
+				links++;
+			} else {
+				errs++;
+			}
+		} else if (typeflag == '0' || typeflag == 0) {
+			int werr = sweet_ov_write_file(path, bytes + data_pos, fsize, mode ? mode : 0644, uid, gid);
+			if (werr == 0) {
+				files++;
+			} else {
+				printf("SWEET OVERLAY: write %s failed (%d)\n", path, werr);
+				errs++;
+			}
+		}
+	}
+
+	if (errs == 0) {
+		(void)sweet_ov_write_file("/private/var/local/.overlay-stamp", (const uint8_t *)want, 17, 0644, 0, 0);
+	}
+	printf("SWEET OVERLAY: applied %016llx (%u files, %u dirs, %u symlinks, %u unlinked, %u errs)\n",
+	    (unsigned long long)h, files, dirs, links, removed, errs);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
