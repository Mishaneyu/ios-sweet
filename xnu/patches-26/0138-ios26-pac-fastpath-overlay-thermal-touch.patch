+/* ---- /dev/sweet-diag and /dev/sweet-log character devices ---- */
+
+static int
+sd_dev_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sd_diag_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	off_t off = uio_offset(uio);
+	if (off < 0 || (size_t)off >= SWEET_DIAG_JSON_CAP || uio_resid(uio) <= 0) {
+		return 0;
+	}
+	char *buf = kalloc_data(SWEET_DIAG_JSON_CAP, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	size_t len = sweet_diag_format_json(buf, SWEET_DIAG_JSON_CAP);
+	int err = 0;
+	if ((size_t)off < len) {
+		size_t avail = len - (size_t)off;
+		user_ssize_t want = uio_resid(uio);
+		size_t n = (size_t)want < avail ? (size_t)want : avail;
+		err = uiomove(buf + off, (int)n, uio);
+	}
+	kfree_data(buf, SWEET_DIAG_JSON_CAP);
+	return err;
+}
+
+static int
+sd_log_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	off_t raw_off = uio_offset(uio);
+	if (raw_off < 0 || uio_resid(uio) <= 0) {
+		return 0;
+	}
+	uint64_t log_total = sweet_log_position();
+	uint64_t pos = (uint64_t)raw_off;
+	if (pos >= log_total) {
+		return 0;
+	}
+	char *chunk = kalloc_data(SWEET_LOG_CHUNK_CAP, Z_WAITOK);
+	if (chunk == NULL) {
+		return ENOMEM;
+	}
+	int err = 0;
+	while (uio_resid(uio) > 0 && pos < log_total) {
+		user_ssize_t resid = uio_resid(uio);
+		uint32_t ask = (uint32_t)(resid < (user_ssize_t)SWEET_LOG_CHUNK_CAP ? resid : (user_ssize_t)SWEET_LOG_CHUNK_CAP);
+		uint64_t p = pos;
+		uint32_t got = sweet_log_copy(&p, chunk, ask);
+		if (got == 0) {
+			break;
+		}
+		/* If the ring wrapped ahead of raw_off, sync uio_offset before uiomove advances it. */
+		uio_setoffset(uio, (off_t)(p - got));
+		err = uiomove(chunk, (int)got, uio);
+		pos = p;
+		if (err != 0) {
+			break;
+		}
+	}
+	kfree_data(chunk, SWEET_LOG_CHUNK_CAP);
+	return err;
+}
