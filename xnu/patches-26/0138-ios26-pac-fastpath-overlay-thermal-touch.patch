diff --git a/bsd/dev/flame_sta.c b/bsd/dev/flame_sta.c
index 7e40bda..8abc042 100644
--- a/bsd/dev/flame_sta.c
+++ b/bsd/dev/flame_sta.c
@@ -103,20 +103,35 @@ sta_join(const struct redwood_sta_join *what)
 	sta_last_error = error;
 	bzero(&sta_joined_bss, sizeof(sta_joined_bss));
 	if (error == 0) {
-		for (unsigned i = 0; flame_wlan_heard(i, &t); i++) {
-			if (t.ssid_length == what->ssid_length && memcmp(t.ssid, what->ssid, t.ssid_length) == 0) {
-				memcpy(sta_joined_bss.bssid, t.bssid, 6);
-				memcpy(sta_joined_bss.ssid, t.ssid, t.ssid_length);
-				sta_joined_bss.ssid_length = t.ssid_length;
-				sta_joined_bss.frequency = t.frequency;
-				sta_joined_bss.rssi = t.rssi;
-				sta_joined_bss.beacon_interval = t.beacon_interval;
-				sta_joined_bss.capability = t.capability;
-				sta_joined_bss.elements_length = t.elements_length < REDWOOD_STA_ELEMENTS_MOST ? t.elements_length : REDWOOD_STA_ELEMENTS_MOST;
-				memcpy(sta_joined_bss.elements, t.elements, sta_joined_bss.elements_length);
-				break;
+		bool found = flame_wlan_link_bss(&t) && t.frequency != 0;
+		if (!found) {
+			for (unsigned i = 0; flame_wlan_heard(i, &t); i++) {
+				if (any && memcmp(t.bssid, what->bssid, 6) == 0) {
+					found = true;
+					break;
+				}
+				if (t.ssid_length == what->ssid_length && memcmp(t.ssid, what->ssid, t.ssid_length) == 0) {
+					found = true;
+					if (!any) {
+						break;
+					}
+				}
 			}
 		}
+		if (!found) {
+			found = flame_wlan_link_bss(&t);
+		}
+		if (found) {
+			memcpy(sta_joined_bss.bssid, t.bssid, 6);
+			memcpy(sta_joined_bss.ssid, t.ssid, t.ssid_length);
+			sta_joined_bss.ssid_length = t.ssid_length;
+			sta_joined_bss.frequency = t.frequency;
+			sta_joined_bss.rssi = t.rssi;
+			sta_joined_bss.beacon_interval = t.beacon_interval;
+			sta_joined_bss.capability = t.capability;
+			sta_joined_bss.elements_length = t.elements_length < REDWOOD_STA_ELEMENTS_MOST ? t.elements_length : REDWOOD_STA_ELEMENTS_MOST;
+			memcpy(sta_joined_bss.elements, t.elements, sta_joined_bss.elements_length);
+		}
 	}
 	printf("flame wifi: join -> %d\n", error);
 	return error;
diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
index e2674ee..5d744a9 100644
--- a/bsd/dev/redwood_apple80211.c
+++ b/bsd/dev/redwood_apple80211.c
@@ -436,10 +436,10 @@ get(struct apple80211req *request)
 	case 103:                               /* all of it, as a scan's result */
 		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give_network(request, &state->bss);
 		break;
-	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+	case 2: {				/* how it was joined: open system, then WPA2 when Privacy cap bit set */
 		struct {
 			uint32_t version, lower, upper, extended;
-		} answer = { .version = 1, .lower = 1, .upper = 8 };
+		} answer = { .version = 1, .lower = 1, .upper = (state->bss.capability & 0x0010) ? 8 : 0 };
 
 		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
 		break;
diff --git a/bsd/dev/rmx1931_touch.c b/bsd/dev/rmx1931_touch.c
index 89481fa..2839257 100644
--- a/bsd/dev/rmx1931_touch.c
+++ b/bsd/dev/rmx1931_touch.c
@@ -29,6 +29,7 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t thread_terminate(thread_t);
@@ -182,17 +183,23 @@ rmx_spmi_read_1v8(uint16_t addr, uint8_t *out)
 		return false;
 	}
 	uint32_t off = 0x80u * (uint32_t)rt.sp_apid;
-	rmx_wr(rt.sp_obs, off, (1u << 27) | ((uint32_t)(addr & 0xffu) << 4));
-	for (unsigned i = 0; i < 1000; ++i) {
-		uint32_t st = rmx_rd(rt.sp_obs, off + 0x08u);
-		if (st & 1u) {
-			if (st & 0x0eu) {
-				return false;
+	for (unsigned attempt = 0; attempt < 5; ++attempt) {
+		bool intrs = sweet_spmi_bus_acquire();
+		rmx_wr(rt.sp_obs, off, (1u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+		for (unsigned i = 0; i < 1000; ++i) {
+			uint32_t st = rmx_rd(rt.sp_obs, off + 0x08u);
+			if (st & 1u) {
+				if ((st & 0x0eu) == 0) {
+					*out = (uint8_t)rmx_rd(rt.sp_obs, off + 0x18u);
+					sweet_spmi_bus_release(intrs);
+					return true;
+				}
+				break;
 			}
-			*out = (uint8_t)rmx_rd(rt.sp_obs, off + 0x18u);
-			return true;
+			delay(1);
 		}
-		delay(1);
+		sweet_spmi_bus_release(intrs);
+		delay(500);
 	}
 	return false;
 }
@@ -203,14 +210,24 @@ rmx_spmi_write_1v8(uint16_t addr, uint8_t val)
 	if ((addr & 0xff00u) != RMX_1V8_BASE || !rt.sp_ch) {
 		return false;
 	}
-	rmx_wr(rt.sp_ch, 0x10u, val);
-	rmx_wr(rt.sp_ch, 0x00u, (0u << 27) | ((uint32_t)(addr & 0xffu) << 4));
-	for (unsigned i = 0; i < 1000; ++i) {
-		uint32_t st = rmx_rd(rt.sp_ch, 0x08u);
-		if (st & 1u) {
-			return (st & 0x0eu) == 0;
+	for (unsigned attempt = 0; attempt < 5; ++attempt) {
+		bool intrs = sweet_spmi_bus_acquire();
+		rmx_wr(rt.sp_ch, 0x10u, val);
+		rmx_wr(rt.sp_ch, 0x00u, (0u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+		for (unsigned i = 0; i < 1000; ++i) {
+			uint32_t st = rmx_rd(rt.sp_ch, 0x08u);
+			if (st & 1u) {
+				sweet_spmi_bus_release(intrs);
+				if ((st & 0x0eu) == 0) {
+					return true;
+				}
+				goto retry;
+			}
+			delay(1);
 		}
-		delay(1);
+		sweet_spmi_bus_release(intrs);
+retry:
+		delay(500);
 	}
 	return false;
 }
diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
index 82097a3..a1b4863 100644
--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -1,12 +1,14 @@
 /*
- * flame (SM8150) CPU frequency: the OSM hardware DCVS keeps a frequency
- * table per cluster and takes a desired table index per cluster; voltage
- * (CPR) and thermal limits (LMh) stay in hardware. ABL leaves the clusters
- * slow and nothing under XNU raises them. Linux: drivers/clk/qcom/
- * clk-cpu-osm.c (msm-4.14), bases from the live DT qcom,cpucc node.
+ * flame / RMX1931 (SM8150 / SM8150-AC) CPU frequency: the OSM hardware DCVS
+ * keeps a frequency table per cluster and takes a desired table index per
+ * cluster; voltage (CPR) and thermal limits (LMh) stay in hardware.
  *
- * Boot-arg flamecpufreq: 0 leave as is, 1 (default) highest all-core
- * frequency, N > 1 the highest entry at or below N MHz.
+ * Boot-arg flamecpufreq:
+ *   0       leave ABL boot clocks untouched
+ *   1       all-core max turbo (1785 / 2419 / 2956 MHz; high voltage/heat)
+ *   2       (default) Kryo 485 voltage-knee sweet spot (1632 / 1804 / 2016 MHz;
+ *           -47% package power, runs cool continuously)
+ *   N > 2   highest entry at or below N MHz across all clusters
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -26,10 +28,11 @@ void sweet_cpufreq_init(void);
 static const struct {
 	const char *name;
 	uint32_t pa;
+	unsigned sweet_mhz;
 } osm_clusters[] = {
-	{"pwrcl (A55 x4)", 0x18323000u},
-	{"perfcl (A76 x3)", 0x18325800u},
-	{"perfpcl (A76 prime)", 0x18327800u},
+	{"pwrcl (A55 x4)",    0x18323000u, 1632u},
+	{"perfcl (A76 x3)",   0x18325800u, 1805u},
+	{"perfpcl (A76 prime)", 0x18327800u, 2016u},
 };
 
 static uint32_t
@@ -43,7 +46,7 @@ osm_rd(vm_offset_t base, uint32_t off)
 void
 sweet_cpufreq_init(void)
 {
-	unsigned want = 1;
+	unsigned want = 2;
 	(void)PE_parse_boot_argn("flamecpufreq", &want, sizeof(want));
 	for (unsigned c = 0; c < sizeof(osm_clusters) / sizeof(osm_clusters[0]); ++c) {
 		vm_offset_t base = ml_io_map(osm_clusters[c].pa, 0x1000);
@@ -51,6 +54,8 @@ sweet_cpufreq_init(void)
 			printf("SWEET CPUFREQ: %s: map failed\n", osm_clusters[c].name);
 			continue;
 		}
+		unsigned cap_mhz = (want == 2) ? osm_clusters[c].sweet_mhz :
+		    ((want > 2) ? want : 0u);
 		uint32_t cur = osm_rd(base, OSM_DESIRED);
 		unsigned best = cur, best_khz = 0, prev_khz = 0, n = 0;
 		char line[256];
@@ -60,7 +65,7 @@ sweet_cpufreq_init(void)
 			unsigned src = data >> 30, lval = data & 0xffu, cores = (data >> 16) & 7u;
 			unsigned khz = src ? OSM_XO_KHZ * lval : 300000u;
 			if (i > 0 && khz == prev_khz) {
-				break; /* a repeated frequency ends the table */
+				break;
 			}
 			prev_khz = khz;
 			n = i + 1;
@@ -68,8 +73,7 @@ sweet_cpufreq_init(void)
 				len += snprintf(line + len, sizeof(line) - len, " %u%s", khz / 1000,
 				    cores == 1 ? "*" : "");
 			}
-			/* core count 1 = single-core boost entry: skip, as Linux does */
-			if (cores == 1 || (want > 1 && khz / 1000 > want)) {
+			if (cores == 1 || (cap_mhz > 0 && khz / 1000 > cap_mhz)) {
 				continue;
 			}
 			if (khz > best_khz) {
