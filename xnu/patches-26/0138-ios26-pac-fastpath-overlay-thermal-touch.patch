+	bool present;
+	bool external_connected;
+	bool charge_capable;
+	bool charging;
+	bool full;
+	unsigned soc;             /* 0..100 % */
+	unsigned voltage_mv;      /* single-cell normalized mV for IOPMPowerSource */
+	unsigned pack_voltage_mv; /* raw gauge mV (2S ~7400..8800 mV on RMX1931) */
+	int current_ma;           /* signed mA (+charging, -discharging) */
+	unsigned rem_mah;         /* remaining capacity (4000 mAh eq.) */
