diff --git a/bsd/dev/rmx1931_audio.c b/bsd/dev/rmx1931_audio.c
new file mode 100644
index 0000000..687cf61
--- /dev/null
+++ b/bsd/dev/rmx1931_audio.c
@@ -0,0 +1,221 @@
+/*
+ * /dev/hakios-audio: non-blocking 48 kHz 16-bit stereo PCM audio sink and
+ * volume ioctl endpoint for HakiosAudio.driver (CoreAudio HAL plug-in).
+ *
+ * Accepts real-time mixed audio writes from mediaserverd without blocking so
+ * CoreAudio, AVFoundation, and AVPlayer run with a steady 48 kHz clock even
+ * before ADSP/speaker amplifier playback is wired up, and logs non-silent
+ * playback stretches for bring-up verification.
+ *
+ * Boot-args:
+ *   rmxaudio=0   disable /dev/hakios-audio (default 1)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <sweet_diag.h>
+
+void rmx1931_audio_init(void);
+
+#define HAKIOS_AUDIO_RATE       48000u
+#define HAKIOS_AUDIO_CHANNELS   2u
+#define HAKIOS_AUDIO_FRAME      4u      /* bytes: 2x int16_t */
+#define AUDIO_CHUNK_FRAMES      1024u
+#define AUDIO_QUIET_MS          500u
+#define AUDIO_SILENCE           8u
+
+struct hakios_audio_volume {
+	uint32_t below;         /* eighths of a dB below max */
+	uint32_t muted;
+};
+#define HAKIOS_AUDIO_SET_VOLUME _IOW('r', 1, struct hakios_audio_volume)
+
+static LCK_GRP_DECLARE(rmx_audio_grp, "rmx-audio");
+static LCK_MTX_DECLARE(rmx_audio_lock, &rmx_audio_grp);
+
+static uint64_t stretch_last;
+static uint64_t stretch_frames, stretch_sound;
+static uint64_t total_frames_ever, total_sound_ever;
+static uint32_t stretch_peak, last_peak_pct;
+static bool     audio_dev_ready;
+static thread_call_t audio_report_call;
+static bool audio_report_armed;
+static int sys_audio_vol_below = 0;
+static int sys_audio_muted = 0;
+
+SYSCTL_DECL(_kern_rmx1931);
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, audio_volume_below_eighth_db, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_audio_vol_below, 0, "Speaker volume attenuation in 1/8 dB steps");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, audio_muted, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_audio_muted, 0, "Speaker muted flag from CoreAudio HAL");
+
+static void
+rmx_audio_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t frames, sound, deadline, since = 0;
+	uint32_t peak;
+
+	lck_mtx_lock(&rmx_audio_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - stretch_last, &since);
+	if (since < (uint64_t)AUDIO_QUIET_MS * NSEC_PER_MSEC) {
+		clock_interval_to_deadline(2u * AUDIO_QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(audio_report_call, deadline);
+		lck_mtx_unlock(&rmx_audio_lock);
+		return;
+	}
+	frames = stretch_frames;
+	sound = stretch_sound;
+	peak = stretch_peak;
+	stretch_frames = stretch_sound = 0;
+	stretch_peak = 0;
+	audio_report_armed = false;
+	lck_mtx_unlock(&rmx_audio_lock);
+
+	printf("RMX AUDIO: %llu.%02llus written, %llu.%02llus non-silent, peak %u%% (vol -%d.%ddB mute=%d)\n",
+	    (unsigned long long)(frames / HAKIOS_AUDIO_RATE),
+	    (unsigned long long)((frames % HAKIOS_AUDIO_RATE) * 100u / HAKIOS_AUDIO_RATE),
+	    (unsigned long long)(sound / HAKIOS_AUDIO_RATE),
+	    (unsigned long long)((sound % HAKIOS_AUDIO_RATE) * 100u / HAKIOS_AUDIO_RATE),
+	    peak * 100u / 32768u, sys_audio_vol_below / 8, (sys_audio_vol_below % 8) * 10 / 8,
+	    sys_audio_muted);
+}
+
+static int
+rmx_audio_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+rmx_audio_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t buf[AUDIO_CHUNK_FRAMES * HAKIOS_AUDIO_CHANNELS];
+	int err = 0;
+
+	while (uio_resid(uio) >= (user_ssize_t)HAKIOS_AUDIO_FRAME) {
+		user_ssize_t bytes = uio_resid(uio);
+		if (bytes > (user_ssize_t)sizeof(buf)) {
+			bytes = (user_ssize_t)sizeof(buf);
+		}
+		bytes -= bytes % (user_ssize_t)HAKIOS_AUDIO_FRAME;
+		err = uiomove((caddr_t)buf, (int)bytes, uio);
+		if (err) {
+			break;
+		}
+		uint32_t count = (uint32_t)(bytes / (user_ssize_t)HAKIOS_AUDIO_FRAME);
+		uint32_t peak = 0;
+		for (uint32_t i = 0; i < count * HAKIOS_AUDIO_CHANNELS; ++i) {
+			uint32_t v = buf[i] < 0 ? (uint32_t)(-(int32_t)buf[i]) : (uint32_t)buf[i];
+			if (v > peak) {
+				peak = v;
+			}
+		}
+		uint64_t deadline;
+		lck_mtx_lock(&rmx_audio_lock);
+		stretch_last = mach_absolute_time();
+		stretch_frames += count;
+		total_frames_ever += count;
+		if (peak > AUDIO_SILENCE) {
+			stretch_sound += count;
+			total_sound_ever += count;
+		}
+		if (peak > stretch_peak) {
+			stretch_peak = peak;
+		}
+		last_peak_pct = (peak * 100u) / 32768u;
+		if (!audio_report_armed && audio_report_call != NULL) {
+			audio_report_armed = true;
+			clock_interval_to_deadline(2u * AUDIO_QUIET_MS, NSEC_PER_MSEC, &deadline);
+			thread_call_enter_delayed(audio_report_call, deadline);
+		}
+		lck_mtx_unlock(&rmx_audio_lock);
+	}
+	if (!err && uio_resid(uio) > 0) {
+		uio_setresid(uio, 0);
+	}
+	return err;
+}
+
+static int
+rmx_audio_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	if (cmd == HAKIOS_AUDIO_SET_VOLUME) {
+		struct hakios_audio_volume v;
+		memcpy(&v, data, sizeof(v));
+		sys_audio_vol_below = (int)v.below;
+		sys_audio_muted = v.muted ? 1 : 0;
+		return 0;
+	}
+	return ENOTTY;
+}
+
+static const struct cdevsw rmx_audio_cdevsw = {
+	.d_open       = rmx_audio_open,
+	.d_close      = rmx_audio_open,
+	.d_read       = eno_rdwrt,
+	.d_write      = rmx_audio_write,
+	.d_ioctl      = rmx_audio_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+rmx1931_audio_init(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("rmxaudio", &on, sizeof(on));
+	if (!on) {
+		printf("RMX AUDIO: disabled (rmxaudio=0)\n");
+		return;
+	}
+	int major = cdevsw_add(-1, &rmx_audio_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, "hakios-audio") == NULL) {
+		printf("RMX AUDIO: failed to create /dev/hakios-audio\n");
+		return;
+	}
+	audio_report_call = thread_call_allocate(rmx_audio_report, NULL);
+	audio_dev_ready = true;
+	printf("RMX AUDIO: /dev/hakios-audio ready (48 kHz stereo sink)\n");
+}
+
+void
+rmx1931_audio_diag_snapshot(struct sweet_diag_peripherals *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	uint64_t since_ns = 0;
+	lck_mtx_lock(&rmx_audio_lock);
+	if (stretch_last != 0) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - stretch_last, &since_ns);
+	}
+	out->audio_ready = audio_dev_ready;
+	out->audio_active = (stretch_last != 0 && since_ns < (uint64_t)AUDIO_QUIET_MS * NSEC_PER_MSEC);
+	out->audio_muted = (sys_audio_muted != 0);
+	out->audio_frames_total = total_frames_ever;
+	out->audio_frames_sound = total_sound_ever;
+	out->audio_peak_pct = last_peak_pct;
+	out->audio_vol_eighth_db = sys_audio_vol_below;
+	lck_mtx_unlock(&rmx_audio_lock);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/rmx1931_battery.c b/bsd/dev/rmx1931_battery.c
new file mode 100644
index 0000000..7ed8ccc
--- /dev/null
+++ b/bsd/dev/rmx1931_battery.c
@@ -0,0 +1,492 @@
+/*
+ * Realme X2 Pro (RMX1931 / samurai, SM8150-AC) read-only fuel-gauge & charger
+ * telemetry driver.
+ *
+ * Hardware facts (from RMX1931 live FDT /soc/i2c@0a84000/bq27541-battery@55
+ * and OPLUS oplus_bq27541.{c,h}):
+ *   - Fuel gauge: TI BQ28Z610 / BQ27541 at 7-bit I2C address 0x55 (2S SuperVOOC
+ *                 4000 mAh-eq pack on RMX1931).
+ *   - Pins:       GPIO 27 (SDA) & GPIO 28 (SCL) on SM8150 TLMM EAST tile
+ *                 (PA 0x03500000, offset 0x1000 * pin). No external vdd-supply
+ *                 regulator (powered directly from battery pack + always-on 1.8V).
+ *   - Charger:    PM8150B (SPMI SID 2) SMB5 observer reads only (0x1310 USB,
+ *                 0x1006 CHGR status) via sweet_spmi_read().
+ *
+ * Strictly READ-ONLY: issues only standard SMBus Read Word commands (0x06 TEMP,
+ * 0x08 VOLT, 0x0a FLAGS, 0x10 RM, 0x12 FCC, 0x14 AI, 0x2a CC, 0x2c SOC) and
+ * SPMI observer EXT_READL. Zero writes to gauge control/flash or PMIC registers.
+ *
+ * Boot-args:
+ *   rmxbattery=0   disable driver (default 1)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+#include "rmx1931_battery.h"
+#include <sweet_diag.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+
+#define BQ_TLMM_EAST_PA 0x03500000u
+#define BQ_TLMM_SIZE    0x00020000u
+#define BQ_PIN_SDA      27u
+#define BQ_PIN_SCL      28u
+#define BQ_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define BQ_GPIO_IO(n)   (BQ_GPIO_CFG(n) + 4u)
+/* mux=0 (GPIO), pull=3 (pull-up), drive=2 (6 mA); bit 9 = OE */
+#define BQ_OD_HIGH_CFG  (0x003u | (2u << 6))
+#define BQ_OD_LOW_CFG   (0x203u | (2u << 6))
+
+#define BQ_I2C_ADDR     0x55u
+#define BQ_REG_TEMP     0x06u   /* 0.1 K */
+#define BQ_REG_VOLT     0x08u   /* mV */
+#define BQ_REG_FLAGS    0x0au   /* bit 0 DSC, bit 9 FC */
+#define BQ_REG_RM       0x10u   /* mAh */
+#define BQ_REG_FCC      0x12u   /* mAh */
+#define BQ_REG_AI       0x14u   /* signed mA (+chg, -dsg) */
+#define BQ_REG_CC       0x2au   /* cycle count */
+#define BQ_REG_SOC      0x2cu   /* 0..100 % */
+
+#define BQ_DESIGN_MAH   4000u
+
+static vm_offset_t bq_gpio;
+static bool bq_started;
+static volatile bool bq_temp_valid;
+static volatile int bq_temp_cached_deci_c = 250;
+static int bq_sleep_chan;
+
+static int sys_bat_soc = -1;
+static int sys_bat_mv = -1;
+static int sys_bat_pack_mv = -1;
+static int sys_bat_ma = 0;
+static int sys_bat_temp_deci_c = -2730;
+static int sys_bat_charging = 0;
+static int sys_bat_external = 0;
+static int sys_bat_fcc_mah = -1;
+static int sys_bat_cycles = -1;
+static struct rmx1931_battery_state bq_last_state;
+static uint32_t bq_total_errors;
+
+SYSCTL_NODE(_kern, OID_AUTO, rmx1931, CTLFLAG_RW | CTLFLAG_LOCKED, 0,
+    "Realme X2 Pro (RMX1931) hardware telemetry");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_soc, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_soc, 0, "RMX1931 fuel-gauge SOC (0..100%)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_mv, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_mv, 0, "RMX1931 cell-normalized battery voltage (mV)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_pack_mv, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_pack_mv, 0, "RMX1931 raw pack voltage from gauge (mV)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_ma, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_ma, 0, "RMX1931 signed battery current (mA, +charging)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_temp_deci_c, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_temp_deci_c, 0, "RMX1931 battery temperature (0.1 deg C)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_charging, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_charging, 0, "RMX1931 charging flag");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_external, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_external, 0, "RMX1931 external power connected flag");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_fcc_mah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_fcc_mah, 0, "RMX1931 full-charge capacity (mAh eq.)");
+SYSCTL_INT(_kern_rmx1931, OID_AUTO, battery_cycles, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sys_bat_cycles, 0, "RMX1931 battery cycle count");
+
+bool
+rmx1931_battery_temperature(int *deci_c)
+{
+	if (!bq_temp_valid || !deci_c) {
+		return false;
+	}
+	*deci_c = bq_temp_cached_deci_c;
+	return true;
+}
+
+static uint32_t
+bq_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(bq_gpio + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+bq_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(bq_gpio + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+bq_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bq_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+bq_sda(bool high)
+{
+	bq_wr(BQ_GPIO_CFG(BQ_PIN_SDA), high ? BQ_OD_HIGH_CFG : BQ_OD_LOW_CFG);
+}
+
+static bool
+bq_sda_in(void)
+{
+	return (bq_rd(BQ_GPIO_IO(BQ_PIN_SDA)) & 1u) != 0;
+}
+
+static bool
+bq_scl_in(void)
+{
+	return (bq_rd(BQ_GPIO_IO(BQ_PIN_SCL)) & 1u) != 0;
+}
+
+/* TI BQ gauges may clock-stretch SCL up to ~1 ms while preparing SMBus words. */
+static bool
+bq_scl_high(void)
+{
+	bq_wr(BQ_GPIO_CFG(BQ_PIN_SCL), BQ_OD_HIGH_CFG);
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (bq_scl_in()) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+bq_scl_low(void)
+{
+	bq_wr(BQ_GPIO_CFG(BQ_PIN_SCL), BQ_OD_LOW_CFG);
+}
+
+static void
+bq_bus_init(void)
+{
+	bq_wr(BQ_GPIO_IO(BQ_PIN_SDA), 0);
+	bq_wr(BQ_GPIO_IO(BQ_PIN_SCL), 0);
+	bq_sda(true);
+	(void)bq_scl_high();
+	delay(20);
+	if (!bq_sda_in()) {
+		for (unsigned i = 0; i < 9 && !bq_sda_in(); ++i) {
+			bq_scl_low();
+			delay(8);
+			(void)bq_scl_high();
+			delay(8);
+		}
+		bq_sda(false);
+		delay(8);
+		(void)bq_scl_high();
+		delay(8);
+		bq_sda(true);
+		delay(20);
+	}
+}
+
+static bool
+bq_start(void)
+{
+	bq_sda(true);
+	if (!bq_scl_high()) {
+		return false;
+	}
+	delay(8);
+	bq_sda(false);
+	delay(8);
+	bq_scl_low();
+	delay(8);
+	return true;
+}
+
+static void
+bq_stop(void)
+{
+	bq_sda(false);
+	delay(8);
+	(void)bq_scl_high();
+	delay(8);
+	bq_sda(true);
+	delay(8);
+}
+
+static bool
+bq_tx_byte(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; --bit) {
+		bq_sda(((byte >> bit) & 1u) != 0);
+		delay(6);
+		if (!bq_scl_high()) {
+			return false;
+		}
+		delay(8);
+		bq_scl_low();
+		delay(4);
+	}
+	bq_sda(true);
+	delay(6);
+	if (!bq_scl_high()) {
+		return false;
+	}
+	delay(6);
+	bool ack = !bq_sda_in();
+	bq_scl_low();
+	delay(6);
+	return ack;
+}
+
+static bool
+bq_rx_byte(uint8_t *out, bool ack)
+{
+	uint8_t val = 0;
+	bq_sda(true);
+	for (int bit = 7; bit >= 0; --bit) {
+		delay(6);
+		if (!bq_scl_high()) {
+			return false;
+		}
+		delay(6);
+		if (bq_sda_in()) {
+			val |= (uint8_t)(1u << bit);
+		}
+		bq_scl_low();
+		delay(4);
+	}
+	bq_sda(!ack);
+	delay(6);
+	if (!bq_scl_high()) {
+		bq_sda(true);
+		return false;
+	}
+	delay(8);
+	bq_scl_low();
+	bq_sda(true);
+	delay(6);
+	*out = val;
+	return true;
+}
+
+/* Pure SMBus Read Word (S | addr+W | cmd | Sr | addr+R | lo | hi | P). */
+static bool
+bq_read_word(uint8_t cmd, uint16_t *out)
+{
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint8_t lo = 0, hi = 0;
+		bool ok = bq_start() &&
+		          bq_tx_byte((uint8_t)(BQ_I2C_ADDR << 1)) &&
+		          bq_tx_byte(cmd) &&
+		          bq_start() &&
+		          bq_tx_byte((uint8_t)((BQ_I2C_ADDR << 1) | 1u)) &&
+		          bq_rx_byte(&lo, true) &&
+		          bq_rx_byte(&hi, false);
+		bq_stop();
+		delay(150); /* TI BQ t_BUF >= 66 us between SMBus packets */
+		if (ok) {
+			*out = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+			return true;
+		}
+		bq_bus_init();
+	}
+	return false;
+}
+
+static bool
+bq_poll_once(struct rmx1931_battery_state *st)
+{
+	uint16_t raw_soc = 0, raw_volt = 0, raw_temp = 0, raw_flags = 0;
+	uint16_t raw_ai = 0, raw_rm = 0, raw_fcc = 0, raw_cc = 0;
+
+	if (!bq_read_word(BQ_REG_VOLT, &raw_volt) ||
+	    !bq_read_word(BQ_REG_SOC, &raw_soc) ||
+	    !bq_read_word(BQ_REG_TEMP, &raw_temp) ||
+	    !bq_read_word(BQ_REG_FLAGS, &raw_flags) ||
+	    !bq_read_word(BQ_REG_AI, &raw_ai)) {
+		return false;
+	}
+	/* Plausibility guard: 1S (2800..4600 mV) or 2S SuperVOOC (5600..9200 mV). */
+	bool dual_cell = raw_volt > 5200u;
+	unsigned cell_mv = dual_cell ? ((unsigned)raw_volt / 2u) : (unsigned)raw_volt;
+	if (cell_mv < 2800u || cell_mv > 4600u || raw_soc > 100u) {
+		return false;
+	}
+
+	(void)bq_read_word(BQ_REG_RM, &raw_rm);
+	(void)bq_read_word(BQ_REG_FCC, &raw_fcc);
+	(void)bq_read_word(BQ_REG_CC, &raw_cc);
+
+	int ma = (raw_ai & 0x8000u) ? ((int)raw_ai - 65536) : (int)raw_ai;
+	/* On 2S pack, scale pack current/mAh to single-cell 4000 mAh equivalent if needed. */
+	unsigned scale = (dual_cell && raw_fcc > 0 && raw_fcc <= 2600u) ? 2u : 1u;
+	unsigned fcc_mah = (raw_fcc > 100u && raw_fcc < 10000u) ? ((unsigned)raw_fcc * scale) : BQ_DESIGN_MAH;
+	unsigned rem_mah = (raw_rm <= raw_fcc && raw_fcc > 0) ? ((unsigned)raw_rm * scale) :
+	    ((fcc_mah * (unsigned)raw_soc + 50u) / 100u);
+
+	int temp_deci_c = 250;
+	if (raw_temp >= 2331u && raw_temp <= 3631u) {
+		temp_deci_c = (int)raw_temp - 2731;
+		bq_temp_cached_deci_c = temp_deci_c;
+		bq_temp_valid = true;
+	}
+
+	/* Read-only PM8150B (SID 2) USB/charger status, with gauge fallback for VOOC. */
+	uint8_t usb_rt = 0, chg_stat = 0;
+	bool spmi_usb = sweet_spmi_read(2, 0x1310u, &usb_rt) == 0;
+	bool spmi_chg = sweet_spmi_read(2, 0x1006u, &chg_stat) == 0;
+	unsigned chg_state = spmi_chg ? (chg_stat & 7u) : 0u;
+
+	bool external = (spmi_usb && ((usb_rt & 0x10u) != 0 || (usb_rt & 0x04u) != 0)) || (ma > 60);
+	bool charging = (external && spmi_chg && chg_state >= 1u && chg_state <= 4u) || (ma > 40);
+	bool full = external && !charging &&
+	    ((spmi_chg && chg_state == 5u) || (raw_flags & (1u << 9)) != 0 || raw_soc == 100u);
+	if (full) {
+		raw_soc = 100u;
+	}
+
+	bzero(st, sizeof(*st));
+	st->valid = true;
+	st->present = true;
+	st->external_connected = external;
+	st->charge_capable = external;
+	st->charging = charging;
+	st->full = full;
+	st->soc = (unsigned)raw_soc;
+	st->voltage_mv = cell_mv;
+	st->pack_voltage_mv = (unsigned)raw_volt;
+	st->current_ma = ma * (int)scale;
+	st->rem_mah = rem_mah;
+	st->fcc_mah = fcc_mah;
+	st->design_mah = BQ_DESIGN_MAH;
+	st->temp_deci_c = temp_deci_c;
+	st->cycle_count = (raw_cc < 10000u) ? (unsigned)raw_cc : 0u;
+	return true;
+}
+
+static void
+bq_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	bq_wait_ms(1500);
+	(void)sweet_spmi_init();
+
+	bq_gpio = ml_io_map(BQ_TLMM_EAST_PA, BQ_TLMM_SIZE);
+	if (!bq_gpio) {
+		printf("RMX BATTERY: EAST TLMM map failed\n");
+		goto out;
+	}
+
+	uint32_t orig_sda_cfg = bq_rd(BQ_GPIO_CFG(BQ_PIN_SDA));
+	uint32_t orig_scl_cfg = bq_rd(BQ_GPIO_CFG(BQ_PIN_SCL));
+	uint32_t orig_sda_io = bq_rd(BQ_GPIO_IO(BQ_PIN_SDA));
+	uint32_t orig_scl_io = bq_rd(BQ_GPIO_IO(BQ_PIN_SCL));
+
+	bq_bus_init();
+
+	uint16_t probe_volt = 0;
+	if (!bq_read_word(BQ_REG_VOLT, &probe_volt) || probe_volt < 2500u || probe_volt > 9500u) {
+		/* Restore firmware pin state on non-RMX1931 boards (e.g. Pixel 4). */
+		bq_wr(BQ_GPIO_IO(BQ_PIN_SDA), orig_sda_io);
+		bq_wr(BQ_GPIO_IO(BQ_PIN_SCL), orig_scl_io);
+		bq_wr(BQ_GPIO_CFG(BQ_PIN_SDA), orig_sda_cfg);
+		bq_wr(BQ_GPIO_CFG(BQ_PIN_SCL), orig_scl_cfg);
+		printf("RMX BATTERY: no BQ27541/BQ28Z610 at 0x55 (volt=%u); pins restored\n",
+		    probe_volt);
+		goto out;
+	}
+
+	printf("RMX BATTERY: TI fuel gauge detected at 0x55 (GPIO27/28, pack=%umV)\n", probe_volt);
+
+	unsigned logged = 0, errors = 0;
+	for (;;) {
+		struct rmx1931_battery_state st;
+		if (bq_poll_once(&st)) {
+			errors = 0;
+			bq_last_state = st;
+			sys_bat_soc = (int)st.soc;
+			sys_bat_mv = (int)st.voltage_mv;
+			sys_bat_pack_mv = (int)st.pack_voltage_mv;
+			sys_bat_ma = st.current_ma;
+			sys_bat_temp_deci_c = st.temp_deci_c;
+			sys_bat_charging = st.charging ? 1 : 0;
+			sys_bat_external = st.external_connected ? 1 : 0;
+			sys_bat_fcc_mah = (int)st.fcc_mah;
+			sys_bat_cycles = (int)st.cycle_count;
+
+			SweetBatteryReport(&st);
+
+			if (logged < 4 || (logged % 20u) == 0) {
+				printf("RMX BATTERY: soc=%u%% pack=%umV cell=%umV cur=%dmA temp=%d.%dC "
+				    "fcc=%umAh cyc=%u ext=%d chg=%d full=%d\n",
+				    st.soc, st.pack_voltage_mv, st.voltage_mv, st.current_ma,
+				    st.temp_deci_c / 10,
+				    (st.temp_deci_c < 0 ? -st.temp_deci_c : st.temp_deci_c) % 10,
+				    st.fcc_mah, st.cycle_count, st.external_connected,
+				    st.charging, st.full);
+			}
+			logged++;
+		} else {
+			bq_total_errors++;
+			if ((errors++ % 10u) == 0) {
+				printf("RMX BATTERY: poll read error (%u)\n", errors);
+			}
+		}
+		bq_wait_ms(15000);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+rmx1931_battery_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (bq_started) {
+		return;
+	}
+	bq_started = true;
+	(void)PE_parse_boot_argn("rmxbattery", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("RMX BATTERY: disabled (rmxbattery=0)\n");
+		return;
+	}
+	if (kernel_thread_start(bq_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("RMX BATTERY: kernel_thread_start failed\n");
+	}
+}
+
+void
+rmx1931_battery_diag_snapshot(struct sweet_diag_peripherals *out)
+{
+	if (out == NULL) {
+		return;
+	}
+	struct rmx1931_battery_state st = bq_last_state;
+	out->bat_online = st.valid;
+	out->bat_ext = st.external_connected;
+	out->bat_charging = st.charging;
+	out->bat_full = st.full;
+	out->bat_soc = st.soc;
+	out->bat_mv = st.voltage_mv;
+	out->bat_pack_mv = st.pack_voltage_mv;
+	out->bat_ma = st.current_ma;
+	out->bat_temp_deci_c = st.temp_deci_c;
+	out->bat_rem_mah = st.rem_mah;
+	out->bat_fcc_mah = st.fcc_mah;
+	out->bat_cycles = st.cycle_count;
+	out->bat_errors = bq_total_errors;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
