+int
+sweet_gpu_map_at_noflush(uint64_t iova, const uint64_t *pages, uint32_t npages)
+{
+	if (!gpu_ready || npages == 0 || iova < WIN_BASE) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_map_pages(&gpu, iova, pages, npages, 0x1000);
+	if (rc) {
+		a6_unmap(&gpu, iova, (uint64_t)npages << 12);
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
+
+void sweet_gpu_tlb_flush(void);
+void
+sweet_gpu_tlb_flush(void)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (gpu_ready) {
+		a6_tlb_flush(&gpu);
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+int sweet_gpu_map_pa_range(uint64_t iova, uint64_t pa, uint64_t bytes);
+int
+sweet_gpu_map_pa_range(uint64_t iova, uint64_t pa, uint64_t bytes)
+{
+	if (!gpu_ready || bytes == 0 || ((iova | pa | bytes) & 0xfffULL) || iova < WIN_BASE) {
+		return -1;
+	}
+	uint64_t pages[256];
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = 0;
+	for (uint64_t off = 0; off < bytes; ) {
+		uint32_t n = 0;
+		uint64_t start = off;
+		for (; n < 256u && off < bytes; n++, off += 0x1000ULL) {
+			pages[n] = pa + off;
+		}
+		rc = a6_map_pages(&gpu, iova + start, pages, n, 0x1000);
+		if (rc) {
+			a6_unmap(&gpu, iova, start + ((uint64_t)n << 12));
+			break;
+		}
+	}
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
