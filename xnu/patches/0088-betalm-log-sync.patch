diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6446452..6926969 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -739,11 +739,35 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
+static uint64_t sweet_log_flushed;
+static bool sweet_log_running;
+
+/*
+ * Write the log out now and wait for it (at most 2 s): for code about to
+ * touch hardware that may reset the SoC without a panic, so the line
+ * before the reset is on disk. Thread context only.
+ */
+void sweet_log_sync(void);
+
+void
+sweet_log_sync(void)
+{
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+	if (!sweet_log_running) {
+		return;
+	}
+	for (unsigned i = 0; i < 200 && os_atomic_load(&sweet_log_flushed, relaxed) < want; ++i) {
+		wakeup(&sweet_log_chan);
+		delay(10000);
+	}
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	uint64_t flushed = 0, seq = 0;
+	sweet_log_running = true;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
@@ -782,10 +806,12 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 		}
 		lck_mtx_unlock(&sweet_ufs_lock);
 		if (error) {
+			sweet_log_running = false;
 			printf("SWEET LOG: write failed (%d), stopping\n", error);
 			return;
 		}
 		flushed = total;
+		os_atomic_store(&sweet_log_flushed, flushed, relaxed);
 	}
 }
 
