+/*
+ * Adreno 640 core (see sweet_a6xx.h). The bring-up follows shim/gpuprobe.c,
+ * which first worked on the phone; that file has the reasoning behind each
+ * register value (offsets from mainline a6xx_gmu.c/a6xx_gpu.c, a6xx.xml,
+ * gpucc-sm8150.c, sm8150.dtsi).
+ */
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_SWEET)
+#ifdef KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#else
+#include <string.h>
+#endif
+#include "sweet_a6xx.h"
+
+#define rd32		a6_rd
+#define wr32		a6_wr
+
+static void wr64(uint64_t pa, uint64_t v)
+{
+	wr32(pa, (uint32_t)v);
+	wr32(pa + 4, (uint32_t)(v >> 32));
+}
+
+static int wait_bit(uint64_t pa, uint32_t mask, int set, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms; i++) {
+		if (!!(rd32(pa) & mask) == set)
+			return 0;
+		if (i < ms)
+			a6_delay_ms(1);
+	}
+	return -1;
+}
+
+static void zero_pa(uint64_t pa, uint64_t size)
+{
+	static const uint8_t z[0x4000];
+	for (uint64_t o = 0; o < size; o += sizeof(z))
+		a6_write(pa + o, z, (size_t)(size - o < sizeof(z) ? size - o : sizeof(z)));
+}
+
+/* ---- registers ---- */
+
+#define GCC		0x00100000ull
+#define GPUCC		A6_GPUCC
+#define GPU		A6_GPU_BASE
+#define GREG(o)		A6_GREG(o)
+#define GMU_REG(o)	A6_GREG(o)
+#define SMMU		A6_SMMU
+
+#define GPUCC_CX_GDSCR	0x106c
+#define GPUCC_GX_GDSCR	0x100c
+#define GPUCC_GMU_RCG	0x1120
+#define GPUCC_AHB	0x1078
+#define GPUCC_CXO	0x109c
+#define GPUCC_CX_GMU	0x1098
+
+#define GMU_ITCM	0x1b400
+#define GMU_DTCM	0x1c400
+#define GMU_FW_VERSION	0x1d3f8
+#define GMU_INIT_RESULT	0x1f81c
+#define GMU_RPMH_STATE	0x1f8ec
+#define GMU_GENERAL_7	0x1f9cc
+#define GMU_CX_BUSY	0x23b0c
+
+#define SMMU_GR1	(SMMU + 0x1000)
+#define SMMU_CB(n)	A6_SMMU_CB(n)
+#define SMR(n)		(SMMU + 0x800 + 4 * (n))
+#define S2CR(n)		(SMMU + 0xc00 + 4 * (n))
+#define CBAR(n)		(SMMU_GR1 + 4 * (n))
+#define CBA2R(n)	(SMMU_GR1 + 0x800 + 4 * (n))
+#define CB_SCTLR	0x00
+#define CB_TCR2		0x10
+#define CB_TTBR0	0x20
+#define CB_TCR		0x30
+#define CB_MAIR0	0x38
+#define CB_FSR		0x58
+#define CB_FAR		0x60
+#define CB_FSYNR0	0x68
+#define CB_TLBIALL	0x618
+#define CB_TLBSYNC	0x7f0
+#define CB_TLBSTATUS	0x7f4
+/*
+ * TCR2: 40-bit PA, SEP = 7 (upstream bus size). SEP 0 (the reset value)
+ * makes VA bit 31 select TTBR1, which is off: every GPU VA >= 2 GB faulted
+ * at level 0. Linux's arm-smmu sets SEP_UPSTREAM too.
+ */
+#define TCR2_VAL	((7u << 15) | 2u)
+
+#define GMU_SID		5
+#define GMU_SID_MASK	0x400
+#define GPU_SID		0
+#define GPU_SID_MASK	0x401
+
+#define GMEM_L1(g)	a6_pool_pa(g, 0x0000)
+#define GMEM_L2_0(g)	a6_pool_pa(g, 0x1000)
+#define GMEM_L2_1(g)	a6_pool_pa(g, 0x2000)
+#define GMEM_L3_LOW(g)	a6_pool_pa(g, 0x3000)
+#define GMEM_L3_6(g)	a6_pool_pa(g, 0x4000)
+#define GMEM_ICACHE(g)	a6_pool_pa(g, 0x10000)
+#define GMEM_DCACHE(g)	a6_pool_pa(g, 0x50000)
+#define GMEM_DUMMY(g)	a6_pool_pa(g, 0x90000)
+#define GMEM_LOG(g)	a6_pool_pa(g, A6_GMEM_LOG_OFF)
+#define GMEM_HFI(g)	a6_pool_pa(g, 0x95000)
+
+#define VA_ICACHE	0x4000u
+#define VA_DCACHE	0x44000u
+#define CACHE_SIZE	0x3c000u
+#define VA_DUMMY	0x60000000u
+#define VA_LOG		A6_GMU_LOG_VA
+#define VA_HFI		0x60005000u
+
+#define RSCC		(0x02c6a000ull + 0x23000)
+#define RSCC_REG(o)	(RSCC + 4ull * (o))
+#define PDC		0x0b290000ull
+#define PDC_REG(o)	(PDC + 4ull * (o))
+#define PDC_SEQ		0x0b490000ull
+
+#define GMU_SYSRESET	0x1f800
+#define GMU_BOOT_CFG	0x1f801
+#define GMU_CM3_CFG	0x1f82d
+#define GMU_PWRCOL_CTRL	0x1f8c0
+#define GMU_RPMH_CTRL	0x1f8e8
+#define GMU_CP_MSG	0x1f900
+#define GMU_CP_RESP	0x1f901
+#define GMU_HFI_CTRL	0x1f980
+#define GMU_SFR_ADDR	0x1f982
+#define GMU_QTBL_INFO	0x1f984
+#define GMU_QTBL_ADDR	0x1f985
+#define GMU_SYS_BUS	0x1f40f
+#define GMU_ICACHE_CFG	0x1f400
+#define GMU_DCACHE_CFG	0x1f401
+#define GMU_RSCC_REQ	0x23b07
+#define GMU_RSCC_ACK	0x23b08
+#define GMU_FENCE0	0x23b11
+#define GMU_G2H_CLR	0x1f991
+#define GMU_G2H_INFO	0x1f992
+#define GMU_H2G_SET	0x1f994
+
+#define RBBM_STATUS		0x210
+#define RBBM_INT_STATUS		0x201
+#define CP_RB_BASE		0x800
+#define CP_RB_CNTL		0x802
+#define CP_RB_RPTR		0x806
+#define CP_RB_WPTR		0x807
+#define CP_SQE_CNTL		0x808
+#define CP_HW_FAULT		0x821
+#define CP_STATUS_1		0x825
+#define CP_SQE_INSTR_BASE	0x830
+
+static bool is_on(uint64_t gdscr)
+{
+	return (rd32(gdscr) >> 31) & 1;
+}
+
+static bool clk_on(uint64_t cbcr)
+{
+	return !(rd32(cbcr) >> 31);	/* CLK_OFF */
+}
+
+bool a6_cx_up(void)
+{
+	return is_on(GPUCC + GPUCC_CX_GDSCR) && clk_on(GPUCC + GPUCC_AHB) && clk_on(GPUCC + GPUCC_CX_GMU);
+}
+
+bool a6_gx_up(void)
+{
+	return a6_cx_up() && is_on(GPUCC + GPUCC_GX_GDSCR);
+}
+
+bool a6_cp_running(const struct a6_gpu *g)
+{
+	return a6_gx_up() && rd32(GREG(CP_SQE_INSTR_BASE)) == (uint32_t)a6_pool_va(A6_OFF_SQE) && g->gpu_cb >= 0;
+}
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa)
+{
+	memset(g, 0, sizeof(*g));
+	g->pool_pa = pool_pa;
+	g->gmu_smr = g->gmu_cb = g->gpu_smr = g->gpu_cb = -1;
+}
+
+/* ---- stage 1: clocks and CX power ---- */
+
+static void branch_on(const char *name, uint64_t reg)
+{
+	wr32(reg, rd32(reg) | 1);
+	int rc = wait_bit(reg, 1u << 31, 0, 10);
+	a6_log("%s = %x%s\n", name, rd32(reg), rc ? " (still halted)" : "");
+}
+
+static int power_cx(void)
+{
+	a6_log("before: cx_gdsc %x gx_gdsc %x gmu_rcg %x/%x ahb %x cxo %x cx_gmu %x\n",
+	       rd32(GPUCC + GPUCC_CX_GDSCR), rd32(GPUCC + GPUCC_GX_GDSCR), rd32(GPUCC + GPUCC_GMU_RCG),
+	       rd32(GPUCC + GPUCC_GMU_RCG + 4), rd32(GPUCC + GPUCC_AHB), rd32(GPUCC + GPUCC_CXO),
+	       rd32(GPUCC + GPUCC_CX_GMU));
+	branch_on("gcc gpu_cfg_ahb", GCC + 0x71004);
+	branch_on("gcc ddrss_gpu_axi", GCC + 0x71154);
+	branch_on("gcc gpu_memnoc_gfx", GCC + 0x7100c);
+	branch_on("gcc gpu_snoc_dvm_gfx", GCC + 0x71018);
+
+	uint64_t gdsc = GPUCC + GPUCC_CX_GDSCR;
+	wr32(gdsc, rd32(gdsc) & ~1u);
+	int rc = wait_bit(gdsc, 1u << 31, 1, 100);
+	a6_log("cx gdsc -> %x %s\n", rd32(gdsc), rc ? "TIMEOUT" : "on");
+	if (rc)
+		return -1;
+
+	uint64_t rcg = GPUCC + GPUCC_GMU_RCG;
+	wr32(rcg + 4, (rd32(rcg + 4) & ~0x71fu) | 1u);
+	wr32(rcg, rd32(rcg) | 1u);
+	rc = wait_bit(rcg, 1, 0, 10);
+	a6_log("gmu rcg %x cfg %x %s\n", rd32(rcg), rd32(rcg + 4), rc ? "UPDATE TIMEOUT" : "");
+
+	branch_on("gpucc ahb", GPUCC + GPUCC_AHB);
+	branch_on("gpucc cxo", GPUCC + GPUCC_CXO);
+	branch_on("gpucc cx_gmu", GPUCC + GPUCC_CX_GMU);
+	if (!a6_cx_up())
+		return -1;
+	a6_log("gmu fw_version %x init_result %x rpmh_state %x; smmu idr0 %x\n",
+	       rd32(GMU_REG(GMU_FW_VERSION)), rd32(GMU_REG(GMU_INIT_RESULT)), rd32(GMU_REG(GMU_RPMH_STATE)),
+	       rd32(SMMU + 0x20));
+	return 0;
+}
+
+/* ---- SMMU ---- */
+
+/* 4K pages for the GMU windows; priv: AP=00 (GMU code), else AP=01. */
+static void map_gmu_pages(uint64_t l3, uint32_t va, uint64_t pa, uint32_t size, int priv)
+{
+	for (uint32_t o = 0; o < size; o += 0x1000) {
+		uint32_t idx = ((va + o) >> 12) & 0x1ff;
+		wr64(l3 + 8 * idx, (pa + o) | (1u << 10) | (3u << 8) | (priv ? 0 : (1u << 6)) | 3u);
+	}
+}
+
+/* T0SZ: 32 (4 GB) for the GMU, 25 (39-bit) for the GPU; walks start at level 1 either way. */
+static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
+{
+	uint32_t t0sz = sid == GPU_SID ? 25 : 32;
+	uint64_t c = SMMU_CB(cb);
+	wr32(c + CB_SCTLR, 0);
+	wr32(CBA2R(cb), 1);					/* AArch64 descriptors */
+	wr32(CBAR(cb), (1u << 16) | (0xfu << 12) | (3u << 8) | (uint32_t)(cb + 1));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	wr64(c + CB_TTBR0, ttbr0);
+	wr32(c + CB_TCR, t0sz | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_MAIR0, 0x0000ff44);
+	wr32(c + CB_FSR, 0xffffffff);
+	wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20 | 0x40);		/* M TRE AFE CFRE CFIE */
+	wr32(SMMU + 0x68, 0);					/* TLBIALLNSNH */
+	wr32(SMMU + 0x70, 0);					/* TLBGSYNC */
+	wait_bit(SMMU + 0x74, 1, 0, 10);
+	wr32(S2CR(smr), (uint32_t)cb);
+	wr32(SMR(smr), (1u << 31) | (mask << 16) | sid);
+	a6_log("smmu: smr%d %x -> cb%d cbar %x sctlr %x tcr %x tcr2 %x\n", smr, rd32(SMR(smr)), cb,
+	       rd32(CBAR(cb)), rd32(c + CB_SCTLR), rd32(c + CB_TCR), rd32(c + CB_TCR2));
+}
+
+static int smmu_pick(int32_t *smr_out, int32_t *cb_out, int cb_min)
+{
+	int smr = -1, cb = -1;
+	uint32_t used_cb = 0;
+	for (int i = 0; i < 6; i++) {
+		uint32_t m = rd32(SMR(i)), c = rd32(S2CR(i));
+		if ((m >> 31) && ((c >> 16) & 3) == 0)
+			used_cb |= 1u << (c & 0xff);
+		if (smr < 0 && !(m >> 31))
+			smr = i;
+	}
+	for (int i = cb_min; i < 5; i++)
+		if (cb < 0 && !(used_cb & (1u << i)) && !(rd32(SMMU_CB(i) + CB_SCTLR) & 1))
+			cb = i;
+	*smr_out = smr;
+	*cb_out = cb;
+	return smr < 0 || cb < 0 ? -1 : 0;
+}
+
+void a6_tlb_flush(const struct a6_gpu *g)
+{
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TLBIALL, 0);
+	wr32(c + CB_TLBSYNC, 0);
+	wait_bit(c + CB_TLBSTATUS, 1, 0, 10);
+}
+
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0)
+{
+	if (g->gpu_cb < 0)
+		return 0;
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	if (far)
+		*far = rd32(c + CB_FAR) | ((uint64_t)rd32(c + CB_FAR + 4) << 32);
+	if (fsynr0)
+		*fsynr0 = rd32(c + CB_FSYNR0);
+	return rd32(c + CB_FSR) & A6_FSR_FAULT;
+}
+
+/*
+ * A translation fault blocks the GPU's later writes (the fence never lands)
+ * until the context bank's FSR is cleared; clearing it is enough to go on.
+ */
+int a6_clear_fault(const struct a6_gpu *g)
+{
+	uint64_t far;
+	uint32_t syn, fsr = a6_fault_status(g, &far, &syn);
+	if (!fsr)
+		return 0;
+	a6_log("clearing smmu cb%d fault: fsr %x far %llx fsynr0 %x\n", g->gpu_cb, fsr,
+	       (unsigned long long)far, syn);
+	wr32(SMMU_CB(g->gpu_cb) + CB_FSR, rd32(SMMU_CB(g->gpu_cb) + CB_FSR));
+	return 1;
+}
+
+/* ---- stage 2: GMU boot ---- */
+
+static int gmu_smmu(struct a6_gpu *g)
+{
+	if (smmu_pick(&g->gmu_smr, &g->gmu_cb, 0)) {
+		a6_log("smmu: no free smr/cb\n");
+		return -1;
+	}
+	zero_pa(g->pool_pa, 0x100000);
+	wr64(GMEM_L1(g) + 0, GMEM_L2_0(g) | 3);
+	wr64(GMEM_L1(g) + 8, GMEM_L2_1(g) | 3);
+	wr64(GMEM_L2_0(g) + 0, GMEM_L3_LOW(g) | 3);
+	wr64(GMEM_L2_1(g) + 8 * ((VA_DUMMY >> 21) & 0x1ff), GMEM_L3_6(g) | 3);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_ICACHE, GMEM_ICACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_LOW(g), VA_DCACHE, GMEM_DCACHE(g), CACHE_SIZE, 1);
+	map_gmu_pages(GMEM_L3_6(g), VA_DUMMY, GMEM_DUMMY(g), 0x1000, 0);
+	map_gmu_pages(GMEM_L3_6(g), VA_LOG, GMEM_LOG(g), A6_GMU_LOG_SIZE, 0);
+	map_gmu_pages(GMEM_L3_6(g), VA_HFI, GMEM_HFI(g), 0x4000, 0);
+	smmu_bank(g->gmu_smr, g->gmu_cb, GMEM_L1(g), GMU_SID, GMU_SID_MASK);
+	return 0;
+}
+
+/* a6xx_gmu_rpmh_init for the A640 (pdc_address_offset 0x30090). */
+static void rpmh_init(void)
+{
+	static const uint32_t rscc[][2] = {
+		{ 0x0004, 1u << 24 }, { 0x000b, 1 }, { 0x000e, 0 }, { 0x000d, 0 }, { 0x0010, 0 }, { 0x000f, 0 },
+		{ 0x0012, 0x80000000 }, { 0x0011, 0 }, { 0x0100, 0 }, { 0x0008, 0x4520 }, { 0x0009, 0x4510 },
+		{ 0x000a, 0x4514 }, { 0x0180, 0xa7a506a0 }, { 0x0181, 0xa1e6a6e7 }, { 0x0182, 0xa2e081e1 },
+		{ 0x0183, 0xe9a982e2 }, { 0x0184, 0x0020e8a8 },
+	};
+	static const uint32_t seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	static const uint32_t pdc[][2] = {
+		{ 0x1573, 7 }, { 0x1574, 0 }, { 0x1572, 0 }, { 0x1575, 0x10108 }, { 0x1576, 0x30010 },
+		{ 0x1577, 1 }, { 0x1579, 0x10108 }, { 0x157a, 0x30000 }, { 0x157b, 0 }, { 0x157d, 0x10108 },
+		{ 0x157e, 0x30090 }, { 0x157f, 0 },
+		{ 0x15d7, 7 }, { 0x15d8, 0 }, { 0x15d6, 0 }, { 0x15d9, 0x10108 }, { 0x15da, 0x30010 },
+		{ 0x15db, 2 }, { 0x15dd, 0x10108 }, { 0x15de, 0x30000 }, { 0x15df, 3 }, { 0x15e1, 0x10108 },
+		{ 0x15e2, 0x30090 }, { 0x15e3, 3 },
+		{ 0x1148, 0 }, { 0x1140, 0x80000001 },
+	};
+	for (unsigned i = 0; i < sizeof(rscc) / sizeof(rscc[0]); i++)
+		wr32(RSCC_REG(rscc[i][0]), rscc[i][1]);
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++)
+		wr32(PDC_SEQ + 4 * i, seq[i]);
+	for (unsigned i = 0; i < sizeof(pdc) / sizeof(pdc[0]); i++)
+		wr32(PDC_REG(pdc[i][0]), pdc[i][1]);
+}
+
+static void hfi_table(struct a6_gpu *g)
+{
+	uint64_t t = GMEM_HFI(g);
+	wr32(t + 0, 0);
+	wr32(t + 4, 6 * 4 + 3 * 12 * 4);
+	wr32(t + 8, 6);
+	wr32(t + 12, 12);
+	wr32(t + 16, 3);
+	wr32(t + 20, 3);
+	for (uint32_t q = 0; q < 3; q++) {
+		uint64_t h = t + 24 + 48 * q;
+		wr32(h + 0, 1);
+		wr32(h + 4, VA_HFI + 0x1000 * (q + 1));
+		wr32(h + 8, (10u << 8) | q);
+		wr32(h + 12, 0x1000 >> 2);
+		wr32(h + 24, 1);
+		wr32(h + 28, 1);
+		wr32(h + 32, 1);
+	}
+}
+
+static int fw_load(struct a6_gpu *g)
+{
+	uint32_t len;
+	const uint8_t *fw = a6_firmware("a640_gmu.bin", &len);
+	if (!fw)
+		return -1;
+	const uint8_t *p = fw, *end = fw + len;
+	int n = 0;
+	while (p + 16 <= end) {
+		uint32_t addr, size;
+		memcpy(&addr, p, 4);
+		memcpy(&size, p + 4, 4);
+		const uint8_t *data = p + 16;
+		uint64_t dst = 0;
+		if (addr < 0x4000)
+			dst = GMU_REG(GMU_ITCM) + addr;
+		else if (addr >= 0x40000 && addr < 0x44000)
+			dst = GMU_REG(GMU_DTCM) + (addr - 0x40000);
+		else if (addr >= VA_ICACHE && addr + size <= VA_ICACHE + CACHE_SIZE)
+			dst = GMEM_ICACHE(g) + (addr - VA_ICACHE);
+		else if (addr >= VA_DCACHE && addr + size <= VA_DCACHE + CACHE_SIZE)
+			dst = GMEM_DCACHE(g) + (addr - VA_DCACHE);
+		if (!dst || data + size > end) {
+			a6_log("gmu fw: bad block %x size %x\n", addr, size);
+			return -1;
+		}
+		a6_write(dst, data, (size + 3) & ~3u);
+		p = data + size;
+		n++;
+	}
+	return n;
+}
+
+static int gmu_boot(struct a6_gpu *g)
+{
+	if (gmu_smmu(g))
+		return -1;
+	rpmh_init();
+	hfi_table(g);
+
+	wr32(GMU_REG(GMU_GENERAL_7), 1);
+	wr32(GMU_REG(GMU_RSCC_REQ), 1u << 1);
+	(void)wait_bit(GMU_REG(GMU_RSCC_ACK), 1u << 1, 1, 200);	/* never acks; harmless */
+	(void)wait_bit(RSCC_REG(0x0101), 0xffffffff, 0, 10);
+	wr32(GMU_REG(GMU_RSCC_REQ), 0);
+
+	int nblk = fw_load(g);
+	a6_log("gmu: %d firmware blocks loaded\n", nblk);
+	if (nblk <= 0)
+		return -1;
+
+	wr32(GMU_REG(GMU_INIT_RESULT), 0);
+	wr32(GMU_REG(GMU_BOOT_CFG), 2);
+	wr32(GMU_REG(GMU_QTBL_ADDR), VA_HFI);
+	wr32(GMU_REG(GMU_QTBL_INFO), 1);
+	wr32(GMU_REG(GMU_FENCE0), (1u << 31) | (0xau << 18) | 0xa0);
+	wr32(GMU_REG(GMU_CM3_CFG), 0x4052);
+	wr32(GMU_REG(GMU_SFR_ADDR), 0x06040100);
+	for (uint32_t i = 0; i < 4; i++)
+		wr32(GPU + 4 * (0x3c03 + i), 0x00071620);
+	wr32(GMU_REG(GMU_CP_MSG), VA_LOG | (A6_GMU_LOG_SIZE / 0x1000 - 1));
+	wr32(GMU_REG(GMU_SYS_BUS), 1);
+	wr32(GMU_REG(GMU_ICACHE_CFG), 1);
+	wr32(GMU_REG(GMU_DCACHE_CFG), 1);
+	wr32(GMU_REG(GMU_PWRCOL_CTRL), 0x9c40400);
+	wr32(GMU_REG(GMU_RPMH_CTRL), rd32(GMU_REG(GMU_RPMH_CTRL)) |
+	     1 | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+
+	uint32_t v = rd32(GMU_REG(GMU_DTCM) + 0xff8 * 4);
+	uint32_t mask = v <= 0x20010004 ? 0xffffffff : 0x1ff;
+	uint32_t want = v <= 0x20010004 ? 0xbabeface : 0x100;
+	wr32(GMU_REG(GMU_SYSRESET), 1);
+	wr32(GMU_REG(GMU_CP_RESP), 0);
+	wr32(GMU_REG(GMU_SYSRESET), 0);
+	uint32_t r = 0;
+	bool ok = false;
+	for (int i = 0; i < 2000 && !ok; i++) {
+		r = rd32(GMU_REG(GMU_INIT_RESULT));
+		ok = (r & mask) == want;
+		if (!ok)
+			a6_delay_ms(1);
+	}
+	a6_log("gmu: init result %x %s, hfi_ctrl %x\n", r, ok ? "BOOTED" : "timeout", rd32(GMU_REG(GMU_HFI_CTRL)));
+	return ok ? 0 : -1;
+}
+
+/* ---- stage 3: HFI, GX power ---- */
+
+#define HFI_Q_CMD	0
+#define HFI_Q_RESP	1
+#define QHDR(g, q)	(GMEM_HFI(g) + 24 + 48 * (q))
+#define QDATA(g, q)	(GMEM_HFI(g) + 0x1000 * ((q) + 1))
+#define QSIZE		1024
+
+#define LVL_MIN_SVS	48
+#define LVL_LOW_SVS	64
+#define LVL_SVS		128
+#define LVL_SVS_L1	192
+#define LVL_SVS_L2	224
+#define LVL_NOM		256
+
+static const uint32_t gpu_khz[] = { 0, 257000, 345000, 427000, 499200, 585000 };
+static const uint32_t gpu_lvl[] = { 0, LVL_LOW_SVS, LVL_SVS, LVL_SVS_L1, LVL_SVS_L2, LVL_NOM };
+static const uint32_t gmu_khz[] = { 0, 200000 };
+static const uint32_t gmu_lvl[] = { 0, LVL_MIN_SVS };
+
+static int cmddb_aux(const char *id, uint64_t *aux, uint32_t *len)
+{
+	uint64_t db = rd32(0x0c3f000cull);
+	if (rd32(db + 4) != 0x0c0330db)
+		return -1;
+	uint64_t data = db + 4 + 4 + 8 * 16 + 4 + 4;
+	for (uint32_t r = 0; r < 8; r++) {
+		uint64_t rh = db + 8 + 16 * r;
+		uint32_t w0 = rd32(rh), w1 = rd32(rh + 4);
+		uint32_t hoff = w0 >> 16, doff = w1 & 0xffff, cnt = w1 >> 16;
+		for (uint32_t e = 0; e < cnt; e++) {
+			uint64_t ent = data + hoff + 24 * e;
+			char name[9];
+			for (uint32_t i = 0; i < 8; i++)
+				name[i] = (char)(rd32(ent + (i & ~3u)) >> (8 * (i & 3)));
+			name[8] = 0;
+			if (strncmp(name, id, 8))
+				continue;
+			uint32_t w5 = rd32(ent + 20);
+			*len = w5 & 0xffff;
+			*aux = data + doff + (w5 >> 16);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static uint32_t aux16(uint64_t aux, uint32_t i)
+{
+	return (rd32(aux + 2 * (i & ~1u)) >> (16 * (i & 1))) & 0xffff;
+}
+
+static int arc_votes(uint32_t *votes, const uint32_t *lvl, int n, const char *pri_id, const char *sec_id)
+{
+	uint64_t pri, sec;
+	uint32_t plen, slen;
+	if (cmddb_aux(pri_id, &pri, &plen) || cmddb_aux(sec_id, &sec, &slen))
+		return -1;
+	plen /= 2;
+	slen /= 2;
+	for (int i = 0; i < n; i++) {
+		uint32_t pindex = 0, sindex = 0, j;
+		for (j = 0; j < plen; j++)
+			if (aux16(pri, j) >= lvl[i]) {
+				pindex = j;
+				break;
+			}
+		if (j == plen)
+			return -1;
+		for (j = 0; j < slen; j++) {
+			if (aux16(sec, j) >= lvl[i]) {
+				sindex = j;
+				break;
+			} else if (aux16(sec, j)) {
+				sindex = j;
+			}
+		}
+		votes[i] = (aux16(pri, pindex) << 16) | (sindex << 8) | pindex;
+	}
+	return 0;
+}
+
+static int hfi_send(struct a6_gpu *g, uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	uint32_t seq = ++g->hfi_seq;
+	msg[0] = (seq << 20) | (dwords << 8) | id;
+	uint64_t h = QHDR(g, HFI_Q_CMD);
+	uint32_t w = rd32(h + 44);
+	for (uint32_t i = 0; i < dwords; i++) {
+		wr32(QDATA(g, HFI_Q_CMD) + 4 * w, msg[i]);
+		w = (w + 1) % QSIZE;
+	}
+	for (; w % 4; w = (w + 1) % QSIZE)
+		wr32(QDATA(g, HFI_Q_CMD) + 4 * w, 0xfafafafa);
+	wr32(h + 44, w);
+	wr32(GMU_REG(GMU_H2G_SET), 1);
+
+	for (int t = 0; t < 1000; t++) {
+		if (rd32(GMU_REG(GMU_G2H_INFO)) & 1) {
+			wr32(GMU_REG(GMU_G2H_CLR), 1);
+			uint64_t rh = QHDR(g, HFI_Q_RESP);
+			while (rd32(rh + 40) != rd32(rh + 44)) {
+				uint32_t r = rd32(rh + 40), hdr = rd32(QDATA(g, HFI_Q_RESP) + 4 * r);
+				uint32_t n = (hdr >> 8) & 0xff, buf[24] = { 0 };
+				for (uint32_t i = 0; i < n && i < 24; i++) {
+					buf[i] = rd32(QDATA(g, HFI_Q_RESP) + 4 * r);
+					r = (r + 1) % QSIZE;
+				}
+				r = ((r + 3) & ~3u) % QSIZE;
+				wr32(rh + 40, r);
+				if ((hdr & 0xff) != 100 && (buf[1] >> 20) == seq)
+					return (int)buf[2];
+			}
+		}
+		a6_delay_ms(1);
+	}
+	a6_log("hfi: msg %u seq %u: no ack (info %x)\n", id, seq, rd32(GMU_REG(GMU_G2H_INFO)));
+	return -1;
+}
+
+static int gmu_hfi(struct a6_gpu *g)
+{
+	static uint32_t msg[256];
+	uint32_t gx[6], cx[2];
+	if (arc_votes(gx, gpu_lvl, 6, "gfx.lvl", "mx.lvl") || arc_votes(cx, gmu_lvl, 2, "cx.lvl", "mx.lvl")) {
+		a6_log("hfi: cmd-db levels not found\n");
+		return -1;
+	}
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 6;
+	msg[2] = 2;
+	for (int i = 0; i < 6; i++) {
+		msg[3 + 3 * i] = gx[i];
+		msg[4 + 3 * i] = 0xffffffff;
+		msg[5 + 3 * i] = gpu_khz[i];
+	}
+	for (int i = 0; i < 2; i++) {
+		msg[3 + 48 + 2 * i] = cx[i];
+		msg[4 + 48 + 2 * i] = gmu_khz[i];
+	}
+	int rc = hfi_send(g, 4, msg, 3 + 48 + 8);
+
+	memset(msg, 0, sizeof(msg));
+	static const uint32_t bw[][2] = {
+		{ 1, 1 }, { 2, 3 }, { 3, 3 }, { 4, 1 }, { 5, 1 }, { 6, 0x50034 }, { 7, 0x5007c }, { 8, 0x5004c },
+		{ 12, 0x40000000 }, { 14, 0x40000000 }, { 18, 0x60000001 }, { 19, 0x20000001 }, { 20, 0x60000001 },
+		{ 24, 0x50000 }, { 25, 0x5003c }, { 26, 0x5000c }, { 32, 0x40000000 }, { 33, 0x40000000 },
+		{ 34, 0x40000000 },
+	};
+	for (unsigned i = 0; i < sizeof(bw) / sizeof(bw[0]); i++)
+		msg[bw[i][0]] = bw[i][1];
+	rc |= hfi_send(g, 3, msg, 32 + 128);
+	msg[1] = 0;
+	rc |= hfi_send(g, 14, msg, 2);
+	rc |= hfi_send(g, 10, msg, 1);
+	uint32_t lvl = g->perf_level >= 1 && g->perf_level <= 5 ? g->perf_level : 1;
+	msg[1] = 1;
+	msg[2] = lvl;			/* index into gpu_khz */
+	msg[3] = 0;
+	rc |= hfi_send(g, 30, msg, 4);
+	a6_log("hfi: perf/bw tables, core fw start, start, perf vote %u MHz -> %d\n", gpu_khz[lvl] / 1000, rc);
+
+	wr32(GMU_REG(GMU_H2G_SET), 1u << 30);	/* OOB GPU_SET */
+	int ack = wait_bit(GMU_REG(GMU_G2H_INFO), 1u << 31, 1, 1000);
+	wr32(GMU_REG(GMU_G2H_CLR), 1u << 31);
+	a6_log("oob gpu_set %s, gx gdsc %x\n", ack ? "TIMEOUT" : "acked", rd32(GPUCC + GPUCC_GX_GDSCR));
+	if (!a6_gx_up()) {
+		a6_log("GX not powered; not touching GPU registers\n");
+		return -1;
+	}
+	return 0;
+}
+
+/* ---- zap shader through TrustZone PAS ---- */
+
+#define PAS_GPU		13
+#if defined(KERNEL)
+#include <pexpert/arm64/board_config.h>
+#endif
+#if defined(SWEET_BOARD_BETALM)
+#define ZAP_REGION	0x98715000ull	/* LG G8S reserved-memory pil_gpu_region */
+#else
+#define ZAP_REGION	0x9a915000ull	/* reserved-memory pil_gpu_region */
+#endif
+#define ZAP_SIZE	0x2000u
+#define SCM_PIL(cmd)	(0x42000000ull | (2u << 8) | (cmd))
+
+static int64_t scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t x[8] = { SCM_PIL(cmd), arginfo, a, b, c, 0, 0, 0 };
+	a6_smc(x);
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+static int zap_load(struct a6_gpu *g)
+{
+	uint64_t r1 = 0;
+	uint32_t mlen, slen;
+	const uint8_t *mdt = a6_firmware("a640_zap.mdt", &mlen), *b02 = a6_firmware("a640_zap.b02", &slen);
+	if (!mdt || !b02 || slen > ZAP_SIZE)
+		return -1;
+	a6_write(a6_pool_pa(g, A6_OFF_ZAP_META), mdt, mlen);
+	int64_t rc = scm(1, 2 | (2u << 6), PAS_GPU, a6_pool_pa(g, A6_OFF_ZAP_META), 0, &r1);
+	if (rc || r1) {
+		a6_log("zap: init image rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+		return -1;
+	}
+	rc = scm(2, 3, PAS_GPU, ZAP_REGION, ZAP_SIZE, &r1);
+	if (rc || r1) {
+		a6_log("zap: mem setup rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+		return -1;
+	}
+	static uint8_t seg[ZAP_SIZE];
+	memset(seg, 0, sizeof(seg));
+	memcpy(seg, b02, slen);
+	a6_write(ZAP_REGION, seg, ZAP_SIZE);
+	rc = scm(5, 1, PAS_GPU, 0, 0, &r1);
+	a6_log("zap: auth and reset rc %lld r1 %llx\n", (long long)rc, (unsigned long long)r1);
+	return rc || r1 ? -1 : 0;
+}
+
+/* ---- ring ---- */
+
+static uint32_t pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+				  (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms)
+{
+	if (n >= A6_RING_DW)
+		return -1;
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	/* poll: a few reads, then 20 us sleeps (1 ms ones made every submit take whole milliseconds) */
+	unsigned i;
+	for (i = 0; i < timeout_ms * 50 + 8; i++) {
+		if (rd32(GREG(CP_RB_RPTR)) == g->wptr && !(rd32(GREG(RBBM_STATUS)) & (1u << 23)))
+			break;
+		if (i >= 8)
+			a6_delay_us(20);
+	}
+	bool ok = i < timeout_ms * 50 + 8;
+	if (what || !ok)
+		a6_log("ring %s: rptr %x wptr %x status %x int %x hwfault %x cp_status1 %x %s\n",
+		       what ? what : "", rd32(GREG(CP_RB_RPTR)), g->wptr, rd32(GREG(RBBM_STATUS)),
+		       rd32(GREG(RBBM_INT_STATUS)), rd32(GREG(CP_HW_FAULT)), rd32(GREG(CP_STATUS_1)),
+		       ok ? "idle" : "TIMEOUT");
+	return ok ? 0 : -1;
+}
+
+uint32_t a6_fence_read(const struct a6_gpu *g)
+{
+	uint32_t v = 0;
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+	return v;
+}
+
+uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned nib,
+			     unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	/* GPU time of this submit: CP_ALWAYS_ON_COUNTER before the IBs and once they are idle (a6_submit_time) */
+	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * ((g->fence + 1) % A6_TS_SLOTS);
+	uint32_t dw[4 + 4 + 4 * A6_SUBMIT_MAX + 5 + 5], n = 0;
+	if (nib == 0 || nib > A6_SUBMIT_MAX)
+		return 0;
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[n++] = 0x18;				/* PC_CCU_INVALIDATE_DEPTH */
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[n++] = 0x19;				/* PC_CCU_INVALIDATE_COLOR */
+	dw[n++] = a6_pkt7(0x3e, 3);		/* CP_REG_TO_MEM CP_ALWAYS_ON_COUNTER, 2 dwords -> ts */
+	dw[n++] = 0x980 | 2u << 18;
+	dw[n++] = (uint32_t)ts;
+	dw[n++] = (uint32_t)(ts >> 32);
+	for (unsigned i = 0; i < nib; i++) {
+		dw[n++] = a6_pkt7(A6_CP_INDIRECT_BUFFER, 3);
+		dw[n++] = (uint32_t)iova[i];
+		dw[n++] = (uint32_t)(iova[i] >> 32);
+		dw[n++] = dwords[i] & 0xfffff;
+	}
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	dw[n++] = a6_pkt7(0x3e, 3);		/* ... -> ts + 8 */
+	dw[n++] = 0x980 | 2u << 18;
+	dw[n++] = (uint32_t)(ts + 8);
+	dw[n++] = (uint32_t)((ts + 8) >> 32);
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4);
+	dw[n++] = 0x04;				/* CACHE_FLUSH_TS: the fence lands once the caches are clean */
+	dw[n++] = (uint32_t)fva;
+	dw[n++] = (uint32_t)(fva >> 32);
+	dw[n++] = g->fence + 1;
+	/* room in the ring: what the CP has not read yet stays intact */
+	for (unsigned i = 0; ; i++) {
+		uint32_t r = rd32(GREG(CP_RB_RPTR)), used = (g->wptr + A6_RING_DW - r) % A6_RING_DW;
+		if (used + n + 16 < A6_RING_DW)
+			break;
+		if (i >= timeout_ms * 50)
+			return 0;
+		a6_delay_us(20);
+	}
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	return ++g->fence;
+}
+
+uint32_t a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	return a6_submit_ibs_async(g, &iova, &dwords, 1, timeout_ms);
+}
+
+void a6_fence_force(struct a6_gpu *g)
+{
+	uint32_t v = g->fence;
+	a6_write(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+}
+
+uint64_t a6_submit_time(const struct a6_gpu *g, uint32_t fence)
+{
+	uint64_t t[2] = { 0, 0 };
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * (fence % A6_TS_SLOTS), t, 16);
+	return t[1] > t[0] ? t[1] - t[0] : 0;
+}
+
+uint64_t a6_timestamp(const struct a6_gpu *g)
+{
+	(void)g;
+	uint32_t hi = rd32(GREG(0x0981)), lo = rd32(GREG(0x0980)), hi2 = rd32(GREG(0x0981));
+	if (hi2 != hi)
+		lo = rd32(GREG(0x0980));
+	return (uint64_t)hi2 << 32 | lo;
+}
+
+bool a6_fence_done(const struct a6_gpu *g, uint32_t fence)
+{
+	return (int32_t)(a6_fence_read(g) - fence) >= 0;
+}
+
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t fence = ++g->fence;
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+	};
+	int rc = a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms);
+	return rc || a6_fence_read(g) != fence ? -1 : 0;
+}
+
+/* ---- GPU page tables ---- */
+
+static void map_gpu_low(struct a6_gpu *g)
+{
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1), l2 = a6_pool_pa(g, A6_OFF_GT_L2);
+	zero_pa(l1, 0x2000);
+	wr64(l1 + 0, l2 | 3);		/* VA 0-1 GB */
+	for (uint64_t o = 0; o < A6_POOL_SIZE; o += 0x200000)	/* AP=01, NC, 2 MB blocks */
+		wr64(l2 + 8 * (((A6_GVA_POOL + o) >> 21) & 0x1ff),
+		     (g->pool_pa + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	for (uint64_t o = 0; o < A6_FB_SIZE; o += 0x200000)
+		wr64(l2 + 8 * (((A6_GVA_FB + o) >> 21) & 0x1ff),
+		     (A6_FB_PA + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+}
+
+static uint64_t pt_alloc(struct a6_gpu *g)
+{
+	const uint32_t arena = (uint32_t)((A6_OFF_SQE - A6_OFF_PT_ARENA) / 0x1000);
+	uint64_t pa = g->pt_next < arena ? a6_pool_pa(g, A6_OFF_PT_ARENA + 0x1000ull * g->pt_next) :
+	    a6_pt_extra(g->pt_next - arena);
+	if (!pa)
+		return 0;
+	g->pt_next++;
+	zero_pa(pa, 0x1000);
+	return pa;
+}
+
+static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
+{
+	uint64_t e = 0;
+	a6_read(table + 8ull * idx, &e, 8);
+	if (e & 1)
+		return (e & 3) == 3 ? e & 0xfffffff000ull : 0;	/* 0: a block */
+	uint64_t t = pt_alloc(g);
+	if (t)
+		wr64(table + 8ull * idx, t | 3);
+	return t;
+}
+
+/* 4K entries for [iova, iova + n * 4K) taking the physical address of each 4K page from pa_of. */
+static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
+		  const void *arg)
+{
+	static uint64_t pte[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	for (uint32_t i = 0; i < n4k;) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t l2 = pt_walk(g, l1, (va >> 30) & 0x1ff);
+		uint64_t l3 = l2 ? pt_walk(g, l2, (va >> 21) & 0x1ff) : 0;
+		if (!l3) {
+			a6_log("map: no page table for %llx (arena full, or a block there)\n", (unsigned long long)va);
+			return -1;
+		}
+		unsigned first = (va >> 12) & 0x1ff, k = 0;
+		while (first + k < 512 && i < n4k)
+			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		a6_write(l3 + 8ull * first, pte, 8ull * k);
+	}
+	return 0;
+}
+
+static uint64_t linear_pa(const void *arg, uint32_t i)
+{
+	return *(const uint64_t *)arg + 0x1000ull * i;
+}
+
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size)
+{
+	return map_4k(g, iova, (uint32_t)((size + 0xfff) >> 12), linear_pa, &pa);
+}
+
+struct page_list {
+	const uint64_t *pages;
+	uint32_t shift;		/* log2(page_size / 4K) */
+};
+
+static uint64_t list_pa(const void *arg, uint32_t i)
+{
+	const struct page_list *l = arg;
+	return l->pages[i >> l->shift] + 0x1000ull * (i & ((1u << l->shift) - 1));
+}
+
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	struct page_list l = { pages, 0 };
+	while ((0x1000u << l.shift) < page_size)
+		l.shift++;
+	return map_4k(g, iova, npages << l.shift, list_pa, &l);
+}
+
+/* Clear the 4K entries for [iova, iova + size) (tables stay, for the next mapping there). Then a6_tlb_flush. */
+void a6_unmap(struct a6_gpu *g, uint64_t iova, uint64_t size)
+{
+	static const uint64_t zeros[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	uint64_t end = iova + ((size + 0xfff) & ~0xfffull);
+	for (uint64_t va = iova & ~0xfffull; va < end;) {
+		uint64_t e = 0, l2, l3;
+		a6_read(l1 + 8 * ((va >> 30) & 0x1ff), &e, 8);
+		l2 = (e & 3) == 3 ? e & 0xfffffff000ull : 0;
+		e = 0;
+		if (l2)
+			a6_read(l2 + 8 * ((va >> 21) & 0x1ff), &e, 8);
+		l3 = (e & 3) == 3 ? e & 0xfffffff000ull : 0;
+		uint64_t next = (va | 0x1fffffull) + 1;
+		if (next > end)
+			next = end;
+		if (l3)
+			a6_write(l3 + 8 * ((va >> 12) & 0x1ff), zeros, (size_t)((next - va) >> 12) * 8);
+		va = next;
+	}
+}
+
+void a6_unmap_high(struct a6_gpu *g)
+{
+	static const uint64_t zeros[511];
+	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
+	g->pt_next = 0;
+	/* Banks set up before 39-bit iovas were needed had T0SZ 32 and SEP 0. */
+	uint64_t c = SMMU_CB(g->gpu_cb);
+	wr32(c + CB_TCR, 25 | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23));
+	wr32(c + CB_TCR2, TCR2_VAL);
+	a6_tlb_flush(g);
+}
+
+/* ---- stage 4: GPU SMMU bank, hw_init, SQE, CP ---- */
+
+/* The zap shader is already in TrustZone after a GPU reset: tell TZ to resume it (Linux: SCM_GPU_ZAP_SHADER_RESUME) */
+static int zap_resume(void)
+{
+	uint64_t x[8] = { 0x42000000ull | (1u << 8) | 0x0a, 2, 0 /* resume */, PAS_GPU, 0, 0, 0, 0 };
+	a6_smc(x);
+	a6_log("zap: resume rc %lld\n", (long long)x[0]);
+	return x[0] ? -1 : 0;
+}
+
+static int gpu_cp_init(struct a6_gpu *g, bool resume);
+
+static int gpu_cp(struct a6_gpu *g)
+{
+	if (smmu_pick(&g->gpu_smr, &g->gpu_cb, g->gmu_cb + 1)) {
+		a6_log("smmu: no free smr/cb for the GPU\n");
+		return -1;
+	}
+	map_gpu_low(g);
+	smmu_bank(g->gpu_smr, g->gpu_cb, a6_pool_pa(g, A6_OFF_GT_L1), GPU_SID, GPU_SID_MASK);
+	return gpu_cp_init(g, false);
+}
+
+/* After a hang or fault: soft reset of the GPU core, then the CP up again (page tables and SMMU banks kept). */
+int a6_recover(struct a6_gpu *g)
+{
+	(void)a6_clear_fault(g);
+	wr32(GREG(0x43), 1);			/* RBBM_SW_RESET_CMD */
+	(void)rd32(GREG(0x43));
+	a6_delay_us(100);
+	wr32(GREG(0x43), 0);
+	a6_delay_ms(1);
+	(void)a6_clear_fault(g);
+	int rc = gpu_cp_init(g, true);
+	a6_log("recover: soft reset + CP init -> %d\n", rc);
+	return rc;
+}
+
+static int gpu_cp_init(struct a6_gpu *g, bool resume)
+{
+	/* a6xx hw_init for the A640 (a6xx_gpu.c), minus clock gating, CP protection and interrupts */
+	wr32(GREG(0x3c45), 0);			/* GBIF_HALT */
+	(void)rd32(GREG(0x3c45));
+	wr32(GREG(0x16), 0);			/* RBBM_GBIF_HALT */
+	(void)rd32(GREG(0x16));
+	static const uint32_t init[][2] = {
+		{ 0xf803, 0 }, { 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },	/* SECVID TSB */
+		/* 64-bit addressing: CP VSC GRAS RB PC HLSQ VFD VPC UCHE SP TPL1 SECVID */
+		{ 0x0842, 1 }, { 0x0c01, 1 }, { 0x8601, 1 }, { 0x8e05, 1 }, { 0x9e01, 1 }, { 0xbe05, 1 },
+		{ 0xa601, 1 }, { 0x9601, 1 }, { 0x0e00, 1 }, { 0xae01, 1 }, { 0xb601, 1 }, { 0xf810, 1 },
+		{ 0x0011, 3 },				/* RBBM_GBIF_CLIENT_QOS_CNTL */
+		{ 0x050b, 0xffffffff },			/* RBBM_PERFCTR_GPU_BUSY_MASKED */
+		/* UCHE: write range max, trap base, write-through base (trap 0x1fffffffff000) */
+		{ 0x0e05, 0xffffffc0 }, { 0x0e06, 0x1ffff }, { 0x0e09, 0xfffff000 }, { 0x0e0a, 0x1ffff },
+		{ 0x0e07, 0xfffff000 }, { 0x0e08, 0x1ffff },
+		{ 0x0e0b, 0x100000 }, { 0x0e0c, 0 }, { 0x0e0d, 0x1fffff }, { 0x0e0e, 0 },	/* GMEM range */
+		{ 0x0e18, 0x804 }, { 0x0e17, 0x4 },	/* UCHE_FILTER_CNTL, CACHE_WAYS */
+		{ 0x08c2, 0x02000140 }, { 0x08c1, 0x8040362c }, { 0x08c3, 128 },	/* ROQ, mem pool */
+		{ 0x098d, 1 }, { 0x0500, 1 },		/* CP_AHB_CNTL, RBBM_PERFCTR_CNTL */
+		{ 0x001f, (1u << 30) | 0x1fffff },	/* RBBM_INTERFACE_HANG_INT_CNTL */
+		{ 0x0e19, (1u << 7) | 1 },		/* UCHE_CLIENT_PF */
+		{ 0x9e00, 0x00180000 },			/* PC_DBG_ECO_CNTL: prim_fifo_threshold */
+		{ 0x08d0, 0 },				/* CP_PERFCTR_CP_SEL[0]: always count */
+		/* a6xx_set_ubwc_config: highest bank bit 15 (hbb_lo 2), AMSBC, UBWC 3 */
+		{ 0x8e08, (1u << 4) | (2u << 1) }, { 0xb604, 2u << 1 }, { 0xae02, 2u << 1 },
+		{ 0x0e01, 2u << 21 }, { 0x0534, 0 },
+	};
+	for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++)
+		wr32(GREG(init[i][0]), init[i][1]);
+
+	uint32_t len;
+	const uint8_t *sqe = a6_firmware("a630_sqe.fw", &len);
+	if (!sqe || len < 8 || len > 0x10000)
+		return -1;
+	a6_write(a6_pool_pa(g, A6_OFF_SQE), sqe + 4, (len - 4 + 3) & ~3u);	/* minus the first dword */
+	wr32(GREG(CP_SQE_INSTR_BASE), (uint32_t)a6_pool_va(A6_OFF_SQE));
+	wr32(GREG(CP_SQE_INSTR_BASE + 1), 0);
+	wr32(GREG(CP_RB_BASE), (uint32_t)a6_pool_va(A6_OFF_RING));
+	wr32(GREG(CP_RB_BASE + 1), 0);
+	wr32(GREG(CP_RB_CNTL), 0x0800020c);	/* 32K ring, 32-byte blocks, no rptr update */
+	g->wptr = 0;
+	wr32(GREG(CP_SQE_CNTL), 1);
+
+	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
+	if (a6_ring(g, me_init, 9, "me_init", 1000))
+		return -1;
+	if (resume ? zap_resume() : zap_load(g))
+		return -1;
+	uint32_t secure[] = { a6_pkt7(A6_CP_SET_SECURE_MODE, 1), 0 };
+	return a6_ring(g, secure, 2, "secure mode off", 1000);
+}
+
+int a6_power_up(struct a6_gpu *g)
+{
+	if (power_cx() || gmu_boot(g) || gmu_hfi(g) || gpu_cp(g))
+		return -1;
+	return 0;
+}
+
+/* ---- 2D blit (turnip's r2d path for vkCmdBlitImage, captured on the A640) ---- */
+
+/* The A640 state turnip writes before any work (tu6_init_hw + the device's magic registers). */
+static const uint32_t blit_init[][2] = {
+	{ 0x9804, 0x1f }, { 0x9805, 1 }, { 0xa0f8, 1 }, { 0xb600, 0x8000 }, { 0x8600, 0 },
+	{ 0xae03, 0x420 }, { 0xae00, 0 }, { 0xbe04, 0 }, { 0x9600, 0x2000000 }, { 0x0e12, 1 },
+	{ 0x8e01, 1 }, { 0x8e04, 0x4100000 }, { 0xae04, 0 }, { 0xae0f, 0x3f }, { 0xb605, 0x44 },
+	{ 0xbe00, 0x80 }, { 0xbe01, 0 }, { 0xab20, 0 }, { 0xb182, 0 }, { 0xbb11, 0 }, { 0xa9a8, 0 },
+	{ 0xab00, 5 }, { 0xa009, 3 }, { 0x8811, 0x10 }, { 0x8110, 0 }, { 0x8818, 0 }, { 0x8819, 0 },
+	{ 0x881a, 0 }, { 0x881b, 0 }, { 0x881c, 0 }, { 0x881d, 0 }, { 0x881e, 0 }, { 0x88f0, 0 },
+	{ 0x9236, 0 }, { 0x9300, 0 }, { 0x9306, 1 }, { 0xb183, 0 }, { 0x80af, 0 }, { 0x8099, 0 },
+	{ 0x980a, 0 }, { 0x9210, 0 }, { 0x9211, 0 }, { 0x9602, 0 }, { 0x9e72, 0 }, { 0xb309, 0xa2 },
+	{ 0xb986, 0xfc }, { 0xa007, 0 }, { 0x8864, 0 }, { 0xb800, 0x102 },
+	{ 0x8e07, 0x10000000 },		/* RB_CCU_CNTL: sysmem, full CCU */
+};
+
+#define EV_CACHE_FLUSH_TS	0x04
+#define EV_PC_CCU_INVALIDATE_COLOR 0x19
+#define EV_PC_CCU_FLUSH_DEPTH_TS 0x1c
+#define EV_PC_CCU_FLUSH_COLOR_TS 0x1d
+#define EV_CACHE_INVALIDATE	0x31
+
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw)
+{
+	(void)g;
+	uint32_t n = 0;
+	uint64_t border = a6_pool_va(A6_OFF_SCRATCH + 0x800), ts = a6_pool_va(A6_OFF_SCRATCH + 0x900);
+#define EV(e)		do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)	do { dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4); dw[n++] = (e); dw[n++] = (uint32_t)ts; \
+			     dw[n++] = (uint32_t)(ts >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)	do { dw[n++] = a6_pkt4((r), 1); dw[n++] = (v); } while (0)
+	EV(EV_CACHE_INVALIDATE);
+	REG(0xbb08, 0xfffff);		/* SP_UPDATE_CNTL */
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	for (unsigned i = 0; i < sizeof(blit_init) / sizeof(blit_init[0]); i++)
+		REG(blit_init[i][0], blit_init[i][1]);
+	dw[n++] = a6_pkt4(0xb302, 2);	/* TPL1_GFX_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	dw[n++] = a6_pkt4(0xb180, 2);	/* TPL1_CS_BORDER_COLOR_BASE */
+	dw[n++] = (uint32_t)border;
+	dw[n++] = (uint32_t)(border >> 32);
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV(EV_PC_CCU_INVALIDATE_COLOR);
+	EV(EV_CACHE_INVALIDATE);
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+
+	/* Blend: colour src * SRC_ALPHA + dst * ONE_MINUS_SRC_ALPHA, alpha src + dst * (1 - src alpha). */
+	REG(0x8c01, b->blend ? 0x3809c181 : 0);	/* RB_A2D_PIXEL_CNTL */
+	uint32_t cntl = 0x00f03000 | (b->clip ? 1u << 16 : 0);
+	REG(0x8c00, cntl);		/* RB_A2D_BLT_CNTL: 8888 UNORM, mask f, SCISSOR */
+	REG(0x8400, cntl);		/* GRAS_A2D_BLT_CNTL */
+	if (b->clip) {
+		dw[n++] = a6_pkt4(0x840a, 2);	/* GRAS_A2D_SCISSOR_TL, _BR (inclusive) */
+		dw[n++] = b->cx0 | (b->cy0 << 16);
+		dw[n++] = b->cx1 | (b->cy1 << 16);
+	}
+	REG(0xacc0, 0xf180);		/* SP_A2D_OUTPUT_INFO */
+	dw[n++] = a6_pkt4(0x8405, 2);	/* GRAS_A2D_DEST_TL, _BR (inclusive) */
+	dw[n++] = b->dx | (b->dy << 16);
+	dw[n++] = (b->dx + b->dw - 1) | ((b->dy + b->dh - 1) << 16);
+	dw[n++] = a6_pkt4(0x8401, 4);	/* GRAS_A2D_SRC_XMIN..YMAX, 24.8 fixed, inclusive */
+	dw[n++] = b->sx << 8;
+	dw[n++] = (b->sx + b->sw - 1) << 8;
+	dw[n++] = b->sy << 8;
+	dw[n++] = (b->sy + b->sh - 1) << 8;
+	dw[n++] = a6_pkt4(0xb4c0, 5);	/* TPL1_A2D_SRC_TEXTURE_INFO, SIZE, BASE, PITCH */
+	dw[n++] = 0x00500430 | (b->filter ? 0x10000 : 0);	/* 8888, linear, WXYZ, UNK20|UNK22 */
+	dw[n++] = b->src_w | (b->src_h << 15);
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = b->src_pitch << 3;
+	dw[n++] = a6_pkt4(0xb4ca, 3);	/* TPL1_A2D_SRC_TEXTURE_FLAG_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->src_iova;
+	dw[n++] = (uint32_t)(b->src_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt4(0x8c17, 4);	/* RB_A2D_DEST_BUFFER_INFO, BASE, PITCH (64 B units) */
+	dw[n++] = 0x430;
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = b->dst_pitch >> 6;
+	dw[n++] = a6_pkt4(0x8c20, 3);	/* RB_A2D_DEST_FLAG_BUFFER_BASE, _PITCH */
+	dw[n++] = (uint32_t)b->dst_iova;
+	dw[n++] = (uint32_t)(b->dst_iova >> 32);
+	dw[n++] = 0;
+	dw[n++] = a6_pkt7(A6_CP_BLIT, 1);
+	dw[n++] = 3;			/* BLIT_OP_SCALE */
+	EV_TS(EV_PC_CCU_FLUSH_COLOR_TS);
+	EV_TS(EV_PC_CCU_FLUSH_DEPTH_TS);
+	EV_TS(EV_CACHE_FLUSH_TS);
+#undef EV
+#undef EV_TS
+#undef REG
+	return n;
+}
+#endif
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
new file mode 100644
index 0000000..d9d7860
--- /dev/null
+++ b/bsd/dev/sweet_a6xx.h
@@ -0,0 +1,170 @@
+/*
+ * Adreno 640 core shared by the kernel (bsd/dev/sweet_gpu.c) and the
+ * userland bring-up tool (phone/gpu/gpu.c, built from this same file): power
+ * and GMU boot, HFI, SMMU banks, SQE + CP + zap shader, ringbuffer
+ * submission, 4K page mappings, and the 2D blit stream.
+ *
+ * The environment supplies the a6_* hooks below (physical register and
+ * memory access, delays, logging, SMC, firmware).
+ *
+ * One 16 MB contiguous pool (2 MB aligned) holds the GPU's own memory:
+ *
+ *   pool + 0x000000  GMU page tables, icache/dcache windows, log, HFI
+ *   pool + 0x0a0000  zap shader metadata for TrustZone
+ *   pool + 0x100000  GPU page tables: L1, L2 (2 MB blocks), then an arena of 4K tables
+ *   pool + 0x200000  SQE microcode
+ *   pool + 0x210000  ringbuffer (32 KB)
+ *   pool + 0x218000  scratch: fence (+0), tests (+0x100..), border colours (+0x800), event timestamps (+0x900)
+ *   pool + 0x400000  free for the environment (userland: named buffers)
+ *
+ * GPU VA (39 bits): the pool at 0x10000000, the panel framebuffer at
+ * 0x20000000, everything else (surfaces, replayed buffers) mapped with 4K
+ * pages from 4 GB up.
+ */
+#ifndef SWEET_A6XX_H
+#define SWEET_A6XX_H
+#ifdef KERNEL
+#include <sys/types.h>
+#include <stdarg.h>
+#else
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#endif
+
+#define A6_POOL_SIZE		0x1000000ull
+#define A6_POOL_ALIGN		0x200000ull
+#define A6_OFF_ZAP_META		0x0a0000ull
+#define A6_OFF_GT_L1		0x100000ull
+#define A6_OFF_GT_L2		0x101000ull
+#define A6_OFF_PT_ARENA		0x102000ull
+#define A6_OFF_SQE		0x200000ull
+#define A6_OFF_RING		0x210000ull
+#define A6_OFF_SCRATCH		0x218000ull
+#define A6_OFF_FREE		0x400000ull
+
+#define A6_GVA_POOL		0x10000000ull
+#define A6_GVA_FB		0x20000000ull
+#define A6_RING_SIZE		0x8000u
+#define A6_RING_DW		(A6_RING_SIZE / 4)
+
+#define A6_FB_PA		0x9c400000ull
+#define A6_FB_SIZE		0xa00000ull	/* mapped for the GPU: 5 x 2 MB */
+
+#define A6_GPU_ID		640
+#define A6_CHIP_ID		0x06040001ull
+
+struct a6_gpu {
+	uint64_t pool_pa;
+	int32_t gmu_smr, gmu_cb, gpu_smr, gpu_cb;
+	uint32_t wptr;			/* ring write pointer, dwords */
+	uint32_t fence;			/* last fence value submitted */
+	uint32_t hfi_seq;
+	uint32_t pt_next;		/* next free table in the arena */
+	uint32_t perf_level;		/* GMU perf vote: 1 (257 MHz) .. 5 (585 MHz); 0 = 1 */
+};
+
+/* ---- environment ---- */
+uint32_t a6_rd(uint64_t pa);
+void a6_wr(uint64_t pa, uint32_t v);
+int a6_write(uint64_t pa, const void *buf, size_t len);	/* DRAM: any size; MMIO: words */
+int a6_read(uint64_t pa, void *buf, size_t len);
+void a6_delay_ms(unsigned ms);
+void a6_delay_us(unsigned us);
+void a6_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void a6_smc(uint64_t x[8]);				/* x0..x7 in, x0..x3 out */
+const uint8_t *a6_firmware(const char *name, uint32_t *len);	/* NULL if missing */
+uint64_t a6_pt_extra(uint32_t n);	/* PA of the nth 4K page table beyond the pool's arena; 0 = none */
+
+/* ---- core ---- */
+static inline uint64_t a6_pool_pa(const struct a6_gpu *g, uint64_t off) { return g->pool_pa + off; }
+static inline uint64_t a6_pool_va(uint64_t off) { return A6_GVA_POOL + off; }
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa);
+int a6_power_up(struct a6_gpu *g);	/* everything up to a working CP with the zap shader; 0 = ok */
+int a6_recover(struct a6_gpu *g);	/* after a hang/fault: soft reset, CP re-init (mappings kept); 0 = ok */
+bool a6_cx_up(void);
+bool a6_gx_up(void);
+bool a6_cp_running(const struct a6_gpu *g);	/* GX on and the CP runs our SQE */
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt);
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt);
+
+/* Queue dwords into the ring, move WPTR, wait for rptr == wptr and !busy. what: log label or NULL. */
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms);
+/* IB at iova, then WFI + fence write; waits for the fence. 0 = ok. */
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms);
+/* The same without waiting: returns the fence value (0 = no ring space within timeout_ms) */
+uint32_t a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms);
+/*
+ * Up to A6_SUBMIT_MAX IBs as Linux's a6xx_submit wraps them: CCU depth/colour invalidate, the IBs, then
+ * the fence written by CACHE_FLUSH_TS (so everything the IBs wrote is in memory when it lands). No wait:
+ * returns the fence, or 0 when the ring has no room within timeout_ms (0 = look once).
+ */
+#define A6_SUBMIT_MAX	16
+uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned n,
+			     unsigned timeout_ms);
+/* Has the fence (from a6_submit_ib_async) landed? (wraparound-safe) */
+bool a6_fence_done(const struct a6_gpu *g, uint32_t fence);
+uint32_t a6_fence_read(const struct a6_gpu *g);
+/* After a6_recover: the fence memory to the last fence submitted (lost work counts as done) */
+void a6_fence_force(struct a6_gpu *g);
+/* CP_ALWAYS_ON_COUNTER (19.2 MHz) */
+uint64_t a6_timestamp(const struct a6_gpu *g);
+/* GPU ticks (19.2 MHz) a landed fence's submit took (a6_submit_ibs_async stamps its start and idle end) */
+#define A6_TS_OFF	0x1000ull	/* in the scratch page: 16-byte slots by fence */
+#define A6_TS_SLOTS	256u
+uint64_t a6_submit_time(const struct a6_gpu *g, uint32_t fence);
+
+/* 4K pages (AP=01, NC) at iova -> pa; tables from the arena. Then a6_tlb_flush. */
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size);
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+void a6_unmap(struct a6_gpu *g, uint64_t iova, uint64_t size);	/* clear 4K entries; then a6_tlb_flush */
+void a6_unmap_high(struct a6_gpu *g);	/* drop all mappings above 1 GB, reset the arena */
+void a6_tlb_flush(const struct a6_gpu *g);
+int a6_clear_fault(const struct a6_gpu *g);	/* 1 if an SMMU fault was cleared */
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0);
+
+/*
+ * Scaled, filtered 2D blit (the one Mesa's turnip emits for vkCmdBlitImage
+ * on the A640, work/gpu/cap-blit): BGRA8 linear -> BGRA8 linear, pitches
+ * multiples of 64 bytes. Writes the IB into dw (A6_BLIT_MAX_DW) and returns
+ * its length.
+ */
+struct a6_blit {
+	uint64_t src_iova;
+	uint32_t src_w, src_h, src_pitch;
+	uint32_t sx, sy, sw, sh;		/* source rectangle */
+	uint64_t dst_iova;
+	uint32_t dst_pitch;
+	uint32_t dx, dy, dw, dh;		/* destination rectangle */
+	bool filter;				/* bilinear */
+	bool blend;				/* source-over alpha blend */
+	bool clip;				/* write only inside the scissor: */
+	uint32_t cx0, cy0, cx1, cy1;		/* destination, inclusive */
+};
+#define A6_BLIT_MAX_DW	256
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw);
+
+#define A6_CP_NOP		0x10
+#define A6_CP_WAIT_FOR_IDLE	0x26
+#define A6_CP_BLIT		0x2c
+#define A6_CP_MEM_WRITE		0x3d
+#define A6_CP_INDIRECT_BUFFER	0x3f
+#define A6_CP_EVENT_WRITE	0x46
+#define A6_CP_ME_INIT		0x48
+#define A6_CP_SET_SECURE_MODE	0x66
+#define A6_CP_MEMCPY		0x75
+
+/* Register/state access for status and dumps */
+#define A6_GPU_BASE		0x02c00000ull
+#define A6_GREG(o)		(A6_GPU_BASE + 4ull * (o))
+#define A6_GPUCC		0x02c90000ull
+#define A6_SMMU			0x02ca0000ull
+#define A6_SMMU_CB(n)		(A6_SMMU + 0x8000 + 0x1000ull * (n))
+#define A6_FSR_FAULT		0xc00001feu
+#define A6_GMEM_LOG_OFF		0x91000ull
+#define A6_GMU_LOG_VA		0x60001000u
+#define A6_GMU_LOG_SIZE		0x4000u
+
+#endif
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..83482a1
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,1189 @@
+/*
+ * The Adreno 640 in the kernel: the environment for the shared core
+ * (sweet_a6xx.c, also built into the userland tool phone/gpu), bring-up in
+ * a kernel thread, and the display's per-frame GPU blit
+ * (iokit/Kernel/arm/SweetFramebuffer.cpp).
+ *
+ * Boot-arg sweetgpu=1 enables it. Firmware comes in the device tree as
+ * /chosen properties "gpufw,<file>" (tools/mkpayload.py --gpufw DIR): the
+ * GMU image, the SQE microcode and the zap shader (mdt + b02).
+ *
+ * Present: iOS's swapped IOSurface (1125x2436 BGRA, 4608-byte rows) is
+ * mapped into the GPU once per surface (4 cached slots at 4 GB + n * 16 MB)
+ * and blitted, scaled to fit and bilinear, into the panel memory, whose rows
+ * the display engine then reads with a 4352-byte stride (the 2D engine's
+ * destination pitch is in 64-byte units; ABL's 4320 is not one).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <pexpert/arm64/board_config.h>  /* SWEET_BOARD_BETALM, SWEET_PANEL_* */
+#include "sweet_a6xx.h"
+#include "../../iokit/Kernel/arm/SweetDisplayMask.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int vprintf(const char *fmt, va_list ap);
+extern void sweet_smc(uint64_t x[8]);
+
+void sweet_gpu_init(void);
+bool sweet_gpu_ready(void);
+int sweet_gpu_surface_slot(uint64_t key);
+int sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+int sweet_gpu_present(int slot, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
+	uint32_t fb_pitch, uint32_t corner_radius, uint32_t *out_dx, uint32_t *out_dy,
+	uint32_t *out_dw, uint32_t *out_dh);
+void sweet_gpu_panel_stride(uint32_t stride);
+int sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size);
+int sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out);
+
+/* Panel mapping for touch (SweetHID.cpp): zero extents = CPU crop, otherwise the GPU's fitted rectangle. */
+int sweet_display_fit_x, sweet_display_fit_y, sweet_display_fit_w, sweet_display_fit_h;
+
+static struct a6_gpu gpu;
+static vm_offset_t pool_kva;
+/* More GPU page tables than the pool's arena (~250 tables = 500 MB mapped): 2048 more (4 GB) */
+#define PT_EXTRA_SIZE   0x800000ULL
+static vm_offset_t pt_kva;
+static uint64_t pt_pa;
+static volatile bool gpu_ready;
+static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
+static LCK_MTX_DECLARE(sweet_gpu_lock, &sweet_gpu_grp);
+
+/* ---- environment for sweet_a6xx.c ---- */
+
+#define GPU_WIN		0x200000ULL
+#define GPU_MAPS	24
+
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} gpu_map[GPU_MAPS];
+
+/* Device windows (2 MB, kept for good: only a handful of register blocks). */
+static volatile uint32_t *
+gpu_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(GPU_WIN - 1);
+	for (unsigned i = 0; i < GPU_MAPS; i++) {
+		if (gpu_map[i].va && gpu_map[i].win == win) {
+			return (volatile uint32_t *)(gpu_map[i].va + (pa - win));
+		}
+		if (!gpu_map[i].va) {
+			gpu_map[i].va = ml_io_map_unmappable((vm_offset_t)win, GPU_WIN, VM_WIMG_IO);
+			gpu_map[i].win = win;
+			return gpu_map[i].va ? (volatile uint32_t *)(gpu_map[i].va + (pa - win)) : NULL;
+		}
+	}
+	panic("sweet_gpu: out of device windows at 0x%llx", pa);
+}
+
+static bool
+in_pool(uint64_t pa, size_t len)
+{
+	return (pool_kva && pa >= gpu.pool_pa && pa + len <= gpu.pool_pa + A6_POOL_SIZE) ||
+	       (pt_kva && pa >= pt_pa && pa + len <= pt_pa + PT_EXTRA_SIZE);
+}
+
+/* kernel VA of pool or page-table memory (in_pool) */
+static vm_offset_t
+pool_addr(uint64_t pa)
+{
+	return pa >= gpu.pool_pa && pa < gpu.pool_pa + A6_POOL_SIZE ? pool_kva + (pa - gpu.pool_pa) : pt_kva + (pa - pt_pa);
+}
+
+uint64_t
+a6_pt_extra(uint32_t n)
+{
+	return pt_kva && (n + 1) * 0x1000ULL <= PT_EXTRA_SIZE ? pt_pa + n * 0x1000ULL : 0;
+}
+
+uint32_t
+a6_rd(uint64_t pa)
+{
+	uint32_t v;
+	if (in_pool(pa, 4)) {
+		(void)a6_read(pa, &v, 4);
+		return v;
+	}
+	v = *gpu_io(pa);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+a6_wr(uint64_t pa, uint32_t v)
+{
+	if (in_pool(pa, 4)) {
+		(void)a6_write(pa, &v, 4);
+		return;
+	}
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*gpu_io(pa) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/*
+ * Pool: through its kernel mapping, cleaned to the point of coherency (by VA:
+ * physical cache operations panic for RAM outside the physmap). Other managed
+ * RAM: through the physmap. MMIO: words.
+ */
+int
+a6_write(uint64_t pa, const void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		memcpy((void *)pool_addr(pa), buf, len);
+		flush_dcache64((addr64_t)pool_addr(pa), (unsigned)len, FALSE);
+		return 0;
+	}
+	if (pmap_valid_address(pa)) {
+		memcpy((void *)phystokv(pa), buf, len);
+		flush_dcache64((addr64_t)pa, (unsigned)len, TRUE);
+		return 0;
+	}
+	const uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++) {
+		a6_wr(pa + 4 * i, w[i]);
+	}
+	return 0;
+}
+
+int
+a6_read(uint64_t pa, void *buf, size_t len)
+{
+	if (in_pool(pa, len)) {
+		flush_dcache64((addr64_t)pool_addr(pa), (unsigned)len, FALSE);
+		memcpy(buf, (const void *)pool_addr(pa), len);
+		return 0;
+	}
+	uint32_t *w = buf;
+	for (size_t i = 0; i < len / 4; i++) {
+		w[i] = a6_rd(pa + 4 * i);
+	}
+	return 0;
+}
+
+void
+a6_delay_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
+
+void
+a6_delay_us(unsigned us)
+{
+	delay((int)us);
+}
+
+extern void sweet_log_sync(void);       /* bsd/dev/sweet_ufs.c */
+
+void
+a6_log(const char *fmt, ...)
+{
+	va_list ap;
+	printf("SWEET GPU: ");
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+#if defined(SWEET_BOARD_BETALM)
+	/*
+	 * First G8S bring-ups: a bad access in the GPU/SMMU blocks resets the
+	 * SoC without a panic. Until the GPU is up, get each step onto disk.
+	 */
+	if (!gpu_ready) {
+		sweet_log_sync();
+	}
+#endif
+}
+
+void
+a6_smc(uint64_t x[8])
+{
+	sweet_smc(x);
+}
+
+const uint8_t *
+a6_firmware(const char *name, uint32_t *len)
+{
+	DTEntry chosen;
+	void const *data;
+	unsigned size;
+	char prop[32];
+	snprintf(prop, sizeof(prop), "gpufw,%s", name);
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, prop, &data, &size) != kSuccess) {
+		a6_log("no firmware %s in the device tree (mkpayload.py --gpufw)\n", name);
+		return NULL;
+	}
+	*len = size;
+	return data;
+}
+
+/* ---- bring-up ---- */
+
+int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+/*
+ * DDR (BCM MC0) and the memory NoC (SH0) at their top levels: nothing else votes them for the GPU (mainline
+ * sm8150 has no GPU interconnect path either), and ABL's level left 8-thread CPU bandwidth at 13.7 GB/s
+ * (19.6 GB/s voted up) and the present blit 35% slower. BCM command: commit | valid | x (avg) | y (peak).
+ * Boot-arg sweetddr=0 leaves them alone.
+ */
+static void
+gpu_bus_vote(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	static const char *const bcm[] = { "MC0", "SH0" };
+	for (unsigned i = 0; i < sizeof(bcm) / sizeof(bcm[0]); i++) {
+		uint32_t off = 0, val = 1u << 30 | 1u << 29 | 0x3fffu << 14 | 0x3fffu;
+		int rc = sweet_rpmh_write(bcm[i], 1, &off, &val);
+		a6_log("bus vote %s top -> %d\n", bcm[i], rc);
+	}
+}
+
+static void
+gpu_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	gpu_bus_vote();
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_power_up(&gpu);
+	if (!rc) {
+		a6_unmap_high(&gpu);
+		gpu_ready = true;
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	a6_log("bring-up %s in %llu ms (pool 0x%llx)\n", rc ? "FAILED" : "done, GPU ready", ns / 1000000,
+	    gpu.pool_pa);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_init(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetgpu", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, A6_POOL_SIZE, PAGE_MASK, 0, (ppnum_t)(atop_64(A6_POOL_ALIGN) - 1),
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		a6_log("no contiguous pool\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	a6_init_state(&gpu, ptoa_64(pn));
+	uint32_t lvl = 4;	/* 499 MHz; boot-arg sweetgpufreq=1 (257) .. 5 (585) */
+	PE_parse_boot_argn("sweetgpufreq", &lvl, sizeof(lvl));
+	gpu.perf_level = lvl;
+	pool_kva = va;
+	vm_offset_t pva = 0;
+	if (kmem_alloc_contig(kernel_map, &pva, PT_EXTRA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
+		pt_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)pva));
+		pt_kva = pva;
+	} else {
+		a6_log("no contiguous memory for more page tables\n");
+	}
+	flush_dcache64((addr64_t)va, (unsigned)A6_POOL_SIZE, FALSE);
+	thread_t thread;
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+bool
+sweet_gpu_ready(void)
+{
+	return gpu_ready;
+}
+
+/* ---- hangs and resets (all with sweet_gpu_lock held) ---- */
+
+/*
+ * A hang is no progress: the completed fence has not moved for a while although work is queued.
+ * progress_abs restarts whenever work is queued on an idle GPU.
+ */
+static uint32_t progress_fence;
+static uint64_t progress_abs;
+/* Resets so far, and the fences each lost: (lo, hi] (the last LOST_RING of them) */
+#define LOST_RING       8
+static uint64_t recoveries;
+static struct { uint32_t lo, hi; } lost[LOST_RING];
+
+/*
+ * GPU time of the submits that landed (their CP_ALWAYS_ON stamps, 19.2 MHz), by the process that queued them
+ * (pid 0 = the kernel's presents), summed on every submit and logged every 5 s. Fences that fall out of the
+ * stamp ring (A6_TS_SLOTS) before they are summed only count as "missed".
+ */
+#define GSTAT_OWNERS    6
+static uint32_t gstat_next = 1;
+static uint64_t gstat_abs;
+static int gstat_pid[A6_TS_SLOTS];
+static struct { int pid; uint32_t n; uint64_t busy; } gstat_own[GSTAT_OWNERS + 1];     /* last: everyone else */
+static uint32_t gstat_n, gstat_missed;
+static uint64_t gstat_busy, gstat_longest;
+
+static void
+gpu_owner_locked(uint32_t fence, int pid)
+{
+	if (fence) {
+		gstat_pid[fence % A6_TS_SLOTS] = pid;
+	}
+}
+
+static void
+gpu_stats_locked(void)
+{
+	uint32_t done = a6_fence_read(&gpu);
+	if ((int32_t)(done - gstat_next) >= (int32_t)A6_TS_SLOTS) {
+		gstat_missed += done - gstat_next - A6_TS_SLOTS + 1;
+		gstat_next = done - A6_TS_SLOTS + 1;
+	}
+	for (; (int32_t)(done - gstat_next) >= 0; gstat_next++) {
+		uint64_t t = a6_submit_time(&gpu, gstat_next);
+		int pid = gstat_pid[gstat_next % A6_TS_SLOTS], o;
+		for (o = 0; o < GSTAT_OWNERS && gstat_own[o].n && gstat_own[o].pid != pid; o++) {
+		}
+		gstat_own[o].pid = o < GSTAT_OWNERS ? pid : -1;
+		gstat_own[o].n++;
+		gstat_own[o].busy += t;
+		gstat_n++;
+		gstat_busy += t;
+		if (t > gstat_longest) {
+			gstat_longest = t;
+		}
+	}
+	uint64_t now = mach_absolute_time(), ns;
+	if (gstat_abs == 0) {
+		gstat_abs = now;
+	}
+	absolutetime_to_nanoseconds(now - gstat_abs, &ns);
+	if (ns < 5000000000ULL) {
+		return;
+	}
+	if (gstat_n) {
+		char who[160] = "", name[24];
+		size_t w = 0;
+		for (int o = 0; o <= GSTAT_OWNERS && gstat_own[o].n && w < sizeof(who) - 40; o++) {
+			if (gstat_own[o].pid > 0) {
+				proc_name(gstat_own[o].pid, name, sizeof(name));
+			} else {
+				strlcpy(name, gstat_own[o].pid == 0 ? "present" : "others", sizeof(name));
+			}
+			w += snprintf(who + w, sizeof(who) - w, " %s %u/%llums", name, gstat_own[o].n,
+			    gstat_own[o].busy / 19200);
+		}
+		a6_log("5s: %u submits (%u missed), GPU busy %llu ms (%llu%%), longest %llu us, mean %llu us;%s\n",
+		    gstat_n, gstat_missed, gstat_busy / 19200, gstat_busy * 100 / 19200 / (ns / 1000000),
+		    gstat_longest * 10 / 192, gstat_busy * 10 / 192 / gstat_n, who);
+	}
+	gstat_n = gstat_missed = 0;
+	gstat_busy = gstat_longest = 0;
+	bzero(gstat_own, sizeof(gstat_own));
+	gstat_abs = now;
+}
+
+static void
+gpu_note_submit_locked(void)
+{
+	uint32_t done = a6_fence_read(&gpu);
+	if (done == gpu.fence) {
+		progress_fence = done;
+		progress_abs = mach_absolute_time();
+	}
+	gpu_stats_locked();
+}
+
+static bool
+gpu_hung_locked(uint32_t hang_ms)
+{
+	uint32_t done = a6_fence_read(&gpu);
+	uint64_t now = mach_absolute_time(), ns;
+	if (done != progress_fence || (int32_t)(gpu.fence - done) <= 0) {
+		progress_fence = done;
+		progress_abs = now;
+		return false;
+	}
+	absolutetime_to_nanoseconds(now - progress_abs, &ns);
+	return ns > hang_ms * 1000000ULL;
+}
+
+/* Soft reset + CP re-init; everything queued is lost, its fences complete at once (waiters return). */
+static void
+gpu_recover_locked(const char *why)
+{
+	uint64_t far;
+	uint32_t syn, fsr = a6_fault_status(&gpu, &far, &syn), done = a6_fence_read(&gpu);
+	a6_log("%s: GPU hang or fault (fence %u, done %u, smmu fsr %x far %llx fsynr0 %x): reset\n",
+	    why, gpu.fence, done, fsr, far, syn);
+	/* where the CP was: ring read pointer, IB1/IB2 (base + dwords left), SQE status */
+	a6_log("%s: rb rptr %x wptr %x, ib1 %08x%08x rem %x, ib2 %08x%08x rem %x, rbbm status %x, sqe stat %x\n", why,
+	    a6_rd(A6_GREG(0x806)), gpu.wptr, a6_rd(A6_GREG(0x929)), a6_rd(A6_GREG(0x928)), a6_rd(A6_GREG(0x92a)),
+	    a6_rd(A6_GREG(0x92c)), a6_rd(A6_GREG(0x92b)), a6_rd(A6_GREG(0x92d)), a6_rd(A6_GREG(0x210)),
+	    a6_rd(A6_GREG(0x908)));
+	lost[recoveries % LOST_RING].lo = done;
+	lost[recoveries % LOST_RING].hi = gpu.fence;
+	recoveries++;
+	if (a6_recover(&gpu)) {
+		a6_log("%s: GPU not recovered\n", why);
+		gpu_ready = false;
+	}
+	a6_fence_force(&gpu);
+	progress_fence = gpu.fence;
+	progress_abs = mach_absolute_time();
+}
+
+/* ---- the panel ---- */
+
+#define MDP             0x0ae00000ULL
+#define SSPP_VIG(n)     (MDP + 0x5000 + 0x2000ULL * (n))
+#define SSPP_YSTRIDE0   0x24
+#define CTL0_FLUSH      (MDP + 0x2000 + 0x18)
+
+#if defined(SWEET_BOARD_BETALM)
+/* LG ABL scans the video-mode panel out through VIG0 alone (shim: sspp0, ctl0); the flush lands at the next vsync. */
+void
+sweet_gpu_panel_stride(uint32_t stride)
+{
+	a6_wr(SSPP_VIG(0) + SSPP_YSTRIDE0, stride);
+	a6_wr(CTL0_FLUSH, 0x1);
+#else
+/* ABL scans out through VIG0 + VIG1 (540 columns each); autorefresh picks a flushed change up. */
+void
+sweet_gpu_panel_stride(uint32_t stride)
+{
+	a6_wr(SSPP_VIG(0) + SSPP_YSTRIDE0, stride);
+	a6_wr(SSPP_VIG(1) + SSPP_YSTRIDE0, stride);
+	a6_wr(CTL0_FLUSH, 0x3);
+#endif
+	a6_log("panel stride %u\n", stride);
+}
+
+/* ---- surfaces ---- */
+
+static int present_wait_locked(uint32_t k, const char *why);
+
+#define SLOTS           4
+#define SLOT_IOVA(n)    (0x100000000ULL + 0x1000000ULL * (n))
+#define SLOT_MAX        0x1000000ULL
+#define SLOT_PAGES      1024
+
+static struct {
+	uint64_t key;
+	uint64_t pages[SLOT_PAGES];
+	uint32_t npages, page_size;
+	uint64_t used;          /* for LRU */
+} slot[SLOTS];
+static uint64_t slot_clock;
+
+int
+sweet_gpu_surface_slot(uint64_t key)
+{
+	for (int i = 0; i < SLOTS; i++) {
+		if (slot[i].key == key && slot[i].npages) {
+			slot[i].used = ++slot_clock;
+			return i;
+		}
+	}
+	return -1;
+}
+
+int
+sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	if (!gpu_ready || npages > SLOT_PAGES || (uint64_t)npages * page_size > SLOT_MAX) {
+		return -1;
+	}
+	int s = 0;
+	for (int i = 1; i < SLOTS; i++) {
+		if (slot[i].used < slot[s].used) {
+			s = i;
+		}
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	(void)present_wait_locked(0, "surface remap");
+	(void)present_wait_locked(1, "surface remap");
+	int rc = a6_map_pages(&gpu, SLOT_IOVA(s), pages, npages, page_size);
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	if (rc) {
+		slot[s].npages = 0;
+		return -1;
+	}
+	memcpy(slot[s].pages, pages, npages * sizeof(uint64_t));
+	slot[s].npages = npages;
+	slot[s].page_size = page_size;
+	slot[s].key = key;
+	slot[s].used = ++slot_clock;
+	a6_log("surface %llx -> slot %d (%u pages of %u)\n", key, s, npages, page_size);
+	return s;
+}
+
+#define IB_OFF          A6_OFF_FREE     /* the present IBs in the pool (two, PRESENT_IB) */
+#define PRESENT_IB(k)   (IB_OFF + 0x4000ULL * (k))
+
+static uint32_t present_fence[2];      /* of the present last queued from each IB slot */
+static uint32_t present_next;
+
+/* With sweet_gpu_lock: the present from IB slot k has landed (or the GPU was reset). 0, or -1 if reset. */
+static int
+present_wait_locked(uint32_t k, const char *why)
+{
+	while (present_fence[k] && !a6_fence_done(&gpu, present_fence[k])) {
+		if (gpu_hung_locked(500)) {
+			gpu_recover_locked(why);
+			return -1;
+		}
+		lck_mtx_unlock(&sweet_gpu_lock);
+		delay(20);
+		lck_mtx_lock(&sweet_gpu_lock);
+	}
+	return 0;
+}
+#if defined(SWEET_BOARD_BETALM)
+#define PANEL_W         SWEET_PANEL_W
+#define PANEL_H         SWEET_PANEL_H
+#else
+#define PANEL_W         1080
+#define PANEL_H         2280
+#endif
+#define DISPLAY_MASK_OFF        0x500000ULL     /* 2x2 corner mattes, one per corner */
+#define DISPLAY_MASK_SIDE       256u
+#define DISPLAY_MASK_DIM        (DISPLAY_MASK_SIDE * 2)
+#define DISPLAY_MASK_PITCH      (DISPLAY_MASK_DIM * 4)
+#define DISPLAY_STAGE_OFF       0x600000ULL     /* panel-sized; only the corner bands are used */
+
+static uint32_t display_mask_radius;
+
+static uint64_t stat_frames, stat_clean_abs, stat_gpu_abs;
+
+/* The four corner mattes: black, alpha = 1 - coverage of the image (SweetDisplayMask.h). */
+static void
+display_mask_build(uint32_t r, uint32_t ext)
+{
+	uint32_t *atlas = (uint32_t *)(pool_kva + DISPLAY_MASK_OFF);
+	uint8_t row[DISPLAY_MASK_SIDE];
+	uint32_t seg = 0;
+
+	for (uint32_t cy = 0; cy < ext; cy++) {
+		sweet_display_corner_row(r, ext, cy, &seg, row);
+		for (uint32_t corner = 0; corner < 4; corner++) {
+			/* Bit 0: right corner, bit 1: bottom; mirror the top-left one. */
+			uint32_t ty = (corner >> 1) * DISPLAY_MASK_SIDE + ((corner & 2) ? ext - 1 - cy : cy);
+			uint32_t *line = atlas + (size_t)ty * DISPLAY_MASK_DIM + (corner & 1) * DISPLAY_MASK_SIDE;
+			for (uint32_t cx = 0; cx < ext; cx++) {
+				line[(corner & 1) ? ext - 1 - cx : cx] = (uint32_t)(255 - row[cx]) << 24;
+			}
+		}
+	}
+	flush_dcache64((addr64_t)(uintptr_t)atlas, DISPLAY_MASK_PITCH * DISPLAY_MASK_DIM, FALSE);
+}
+
+/*
+ * Blit a mapped surface, scaled to fit and centred, into the panel memory
+ * (rows of fb_pitch bytes). With corner_radius, the image gets continuous
+ * corners: the rows they cover go to a staging image in the pool first (same
+ * blit, scissored), get the mattes blended over, and only then reach the
+ * panel, which scans out continuously. The CPU rendered the source through
+ * its cache: clean it through kva first (0: no clean). Waits for the GPU (a
+ * few ms).
+ */
+int
+sweet_gpu_present(int s, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
+	uint32_t fb_pitch, uint32_t corner_radius, uint32_t *out_dx, uint32_t *out_dy,
+	uint32_t *out_dw, uint32_t *out_dh)
+{
+	if (!gpu_ready || s < 0 || s >= SLOTS || !slot[s].npages || w == 0 || h == 0 ||
+	    (pitch & 63) || (fb_pitch & 63) || fb_pitch < PANEL_W * 4 ||
+	    DISPLAY_STAGE_OFF + (uint64_t)fb_pitch * PANEL_H > A6_POOL_SIZE) {
+		return -1;
+	}
+	uint64_t t0 = mach_absolute_time();
+	if (kva) {
+		clean_dcache64((addr64_t)kva, (unsigned)((uint64_t)pitch * h + offset), FALSE);
+	}
+	uint64_t t1 = mach_absolute_time();
+
+	struct a6_blit frame = {
+		.src_iova = SLOT_IOVA(s) + offset, .src_w = w, .src_h = h, .src_pitch = pitch,
+		.sw = w, .sh = h, .dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch, .filter = true,
+	};
+	/* Fit: full height unless the frame is relatively wider than the panel. */
+	if ((uint64_t)w * PANEL_H <= (uint64_t)PANEL_W * h) {
+		frame.dh = PANEL_H;
+		frame.dw = (uint32_t)(((uint64_t)w * PANEL_H + h / 2) / h);
+	} else {
+		frame.dw = PANEL_W;
+		frame.dh = (uint32_t)(((uint64_t)h * PANEL_W + w / 2) / w);
+	}
+	frame.dx = (PANEL_W - frame.dw) / 2;
+	frame.dy = (PANEL_H - frame.dh) / 2;
+	uint32_t ext = corner_radius ? sweet_display_corner_extent(corner_radius) : 0;
+	if (ext > DISPLAY_MASK_SIDE || 2 * ext >= frame.dw || 2 * ext >= frame.dh) {
+		ext = 0;
+	}
+	static uint32_t ib[10 * A6_BLIT_MAX_DW];
+	lck_mtx_lock(&sweet_gpu_lock);
+	uint32_t n = 0;
+	if (ext) {
+		if (display_mask_radius != corner_radius) {
+			display_mask_build(corner_radius, ext);
+			display_mask_radius = corner_radius;
+		}
+		uint32_t top = frame.dy, bottom = frame.dy + frame.dh - ext;
+		struct a6_blit b = frame;
+		b.clip = true;
+		b.cx0 = 0;
+		b.cx1 = PANEL_W - 1;
+		/* The rows between the corners straight to the panel ... */
+		b.cy0 = top + ext;
+		b.cy1 = bottom - 1;
+		n += a6_blit_ib(&gpu, &b, ib + n);
+		/* ... the corner rows to the stage ... */
+		b.dst_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF;
+		b.cy0 = top;
+		b.cy1 = top + ext - 1;
+		n += a6_blit_ib(&gpu, &b, ib + n);
+		b.cy0 = bottom;
+		b.cy1 = bottom + ext - 1;
+		n += a6_blit_ib(&gpu, &b, ib + n);
+		/* ... darkened by the mattes ... */
+		for (uint32_t corner = 0; corner < 4; corner++) {
+			struct a6_blit matte = {
+				.src_iova = A6_GVA_POOL + DISPLAY_MASK_OFF,
+				.src_w = DISPLAY_MASK_DIM, .src_h = DISPLAY_MASK_DIM, .src_pitch = DISPLAY_MASK_PITCH,
+				.sx = (corner & 1) * DISPLAY_MASK_SIDE, .sy = (corner >> 1) * DISPLAY_MASK_SIDE,
+				.sw = ext, .sh = ext,
+				.dst_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF, .dst_pitch = fb_pitch,
+				.dx = (corner & 1) ? frame.dx + frame.dw - ext : frame.dx,
+				.dy = (corner & 2) ? bottom : top,
+				.dw = ext, .dh = ext, .blend = true,
+			};
+			n += a6_blit_ib(&gpu, &matte, ib + n);
+		}
+		/* ... then copied to the panel. */
+		for (uint32_t band = 0; band < 2; band++) {
+			uint32_t y = band ? bottom : top;
+			struct a6_blit copy = {
+				.src_iova = A6_GVA_POOL + DISPLAY_STAGE_OFF,
+				.src_w = PANEL_W, .src_h = PANEL_H, .src_pitch = fb_pitch,
+				.sx = frame.dx, .sy = y, .sw = frame.dw, .sh = ext,
+				.dst_iova = A6_GVA_FB, .dst_pitch = fb_pitch,
+				.dx = frame.dx, .dy = y, .dw = frame.dw, .dh = ext,
+			};
+			n += a6_blit_ib(&gpu, &copy, ib + n);
+		}
+	} else {
+		n = a6_blit_ib(&gpu, &frame, ib);
+	}
+	/*
+	 * Not waited for: the vsync timer must not block behind the Metal clients' work queued ahead of it
+	 * (a waited present took 15-30 ms with metal2vulkan's frames in the ring, and the vsync notifications
+	 * CA paces on came late). Two IB slots: only the one two presents back must have landed.
+	 */
+	uint32_t k = present_next & 1;
+	int rc = present_wait_locked(k, "present");
+	if (rc == 0) {
+		a6_write(a6_pool_pa(&gpu, PRESENT_IB(k)), ib, 4ULL * n);
+		gpu_note_submit_locked();
+		present_fence[k] = a6_submit_ib_async(&gpu, a6_pool_va(PRESENT_IB(k)), n, 100);
+		gpu_owner_locked(present_fence[k], 0);
+		rc = present_fence[k] ? 0 : -1;
+		present_next++;
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	uint64_t t2 = mach_absolute_time();
+	stat_clean_abs += t1 - t0;
+	stat_gpu_abs += t2 - t1;
+	if ((++stat_frames % 300) == 0) {
+		uint64_t c, g;
+		absolutetime_to_nanoseconds(stat_clean_abs, &c);
+		absolutetime_to_nanoseconds(stat_gpu_abs, &g);
+		a6_log("present: %llu frames, avg cache clean %llu us, GPU blit %llu us\n", stat_frames,
+		    c / 1000 / 300, g / 1000 / 300);
+		stat_clean_abs = stat_gpu_abs = 0;
+	}
+	*out_dx = frame.dx;
+	*out_dy = frame.dy;
+	*out_dw = frame.dw;
+	*out_dh = frame.dh;
+	return rc;
+}
+
+/* ---- buffers and submissions for Metal (iokit/Kernel/arm/SweetAccelerator.cpp) ---- */
+
+#define USER_VA_BASE    0x200000000ULL  /* above the surface slots */
+#define USER_VA_END     0x1000000000ULL /* v1 clients; v2 windows above (sweet_gpu_window_alloc) */
+#define USER_VA_ALIGN   0x10000ULL
+
+static uint64_t user_va_next = USER_VA_BASE;
+
+/* Freed ranges, sorted by address and merged: reused first fit, so page tables are reused too. */
+#define USER_VA_FREE_MAX 1024
+static struct { uint64_t va, size; } user_va_free[USER_VA_FREE_MAX];
+static uint32_t user_va_nfree;
+
+static uint64_t
+user_va_alloc(uint64_t size)
+{
+	for (uint32_t i = 0; i < user_va_nfree; i++) {
+		if (user_va_free[i].size >= size) {
+			uint64_t va = user_va_free[i].va;
+			user_va_free[i].va += size;
+			user_va_free[i].size -= size;
+			if (user_va_free[i].size == 0) {
+				memmove(&user_va_free[i], &user_va_free[i + 1], (user_va_nfree - i - 1) * sizeof(user_va_free[0]));
+				user_va_nfree--;
+			}
+			return va;
+		}
+	}
+	if (user_va_next + size > USER_VA_END) {
+		return 0;
+	}
+	uint64_t va = user_va_next;
+	user_va_next += size;
+	return va;
+}
+
+static void
+user_va_release(uint64_t va, uint64_t size)
+{
+	uint32_t i = 0;
+	while (i < user_va_nfree && user_va_free[i].va < va) {
+		i++;
+	}
+	if (i > 0 && user_va_free[i - 1].va + user_va_free[i - 1].size == va) {
+		user_va_free[i - 1].size += size;
+		if (i < user_va_nfree && va + size == user_va_free[i].va) {
+			user_va_free[i - 1].size += user_va_free[i].size;
+			memmove(&user_va_free[i], &user_va_free[i + 1], (user_va_nfree - i - 1) * sizeof(user_va_free[0]));
+			user_va_nfree--;
+		}
+		return;
+	}
+	if (i < user_va_nfree && va + size == user_va_free[i].va) {
+		user_va_free[i].va = va;
+		user_va_free[i].size += size;
+		return;
+	}
+	if (user_va_nfree == USER_VA_FREE_MAX) {
+		return;         /* leaks the range */
+	}
+	memmove(&user_va_free[i + 1], &user_va_free[i], (user_va_nfree - i) * sizeof(user_va_free[0]));
+	user_va_free[i].va = va;
+	user_va_free[i].size = size;
+	user_va_nfree++;
+}
+
+/*
+ * Map pages at a free GPU VA (64 KB granules; freed ranges are reused, and
+ * with them the page tables, of which the arena has only ~250). The caller
+ * cleans the CPU caches through a virtual mapping: physical cache operations
+ * panic for RAM outside the physmap (kernel memory below 4 GB, "phystokv_range:
+ * illegal PA").
+ */
+int
+sweet_gpu_map_user(uint64_t *iova_out, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	if (!gpu_ready || npages == 0) {
+		return -1;
+	}
+	uint64_t size = ((uint64_t)npages * page_size + USER_VA_ALIGN - 1) & ~(USER_VA_ALIGN - 1);
+	lck_mtx_lock(&sweet_gpu_lock);
+	uint64_t iova = user_va_alloc(size);
+	if (iova == 0) {
+		lck_mtx_unlock(&sweet_gpu_lock);
+		return -1;
+	}
+	int rc = a6_map_pages(&gpu, iova, pages, npages, page_size);
+	if (rc) {
+		a6_unmap(&gpu, iova, size);
+		user_va_release(iova, size);
+	}
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	if (rc) {
+		return -1;
+	}
+	*iova_out = iova;
+	return 0;
+}
+
+/* Undo sweet_gpu_map_user. The caller makes sure no queued GPU work uses it (SweetAccelerator: the client's last fence). */
+void
+sweet_gpu_unmap_user(uint64_t iova, uint64_t len)
+{
+	uint64_t size = (len + USER_VA_ALIGN - 1) & ~(USER_VA_ALIGN - 1);
+	if (iova < USER_VA_BASE || size == 0) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (gpu_ready) {
+		a6_unmap(&gpu, iova, size);
+		a6_tlb_flush(&gpu);
+	}
+	user_va_release(iova, size);
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* Queue an IB (user GPU memory) without waiting: its fence, or 0 if the GPU is not usable. */
+uint32_t
+sweet_gpu_submit_user_async(uint64_t ib_iova, uint32_t dwords)
+{
+	if (!gpu_ready) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	gpu_note_submit_locked();
+	uint32_t fence = a6_submit_ib_async(&gpu, ib_iova, dwords, 1000);
+	gpu_owner_locked(fence, proc_selfpid());
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return fence;
+}
+
+/* Wait for a fence of sweet_gpu_submit_user_async: 0, or -1 after timeout_ms (the GPU is then recovered). */
+int
+sweet_gpu_wait_fence(uint32_t fence, uint32_t timeout_ms)
+{
+	for (unsigned i = 0; i < timeout_ms * 50; i++) {
+		if (!gpu_ready) {
+			return -1;
+		}
+		if (a6_fence_done(&gpu, fence)) {
+			return 0;
+		}
+		delay(20);
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_fence_done(&gpu, fence) ? 0 : -1;
+	if (rc) {
+		gpu_recover_locked("user fence");
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
+
+/* Run an IB (user GPU memory) and wait for it. 0, or -1 on a hang/fault (cleared, logged). */
+int
+sweet_gpu_submit_user(uint64_t ib_iova, uint32_t dwords, uint32_t timeout_ms, uint32_t *fence_out)
+{
+	if (!gpu_ready) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	gpu_note_submit_locked();
+	gpu_owner_locked(gpu.fence + 1, proc_selfpid());
+	int rc = a6_submit_ib(&gpu, ib_iova, dwords, timeout_ms ? timeout_ms : 1000);
+	if (rc) {
+		gpu_recover_locked("user submit");
+	}
+	*fence_out = gpu.fence;
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
+
+/*
+ * ---- v2 buffer memory: RAM that XNU does not manage ----
+ *
+ * SWEET has no PPL, so no __ARM_PTE_PHYSMAP__: the physmap maps all managed RAM with cacheable blocks,
+ * which pmap_set_cache_attributes cannot change per page. A write-combined view of a managed page is
+ * then a mismatched alias: writes got lost and reads came back stale (Turnip's command streams, phone
+ * test v2test). v2 buffers come from HLOS RAM below 4 GB that XNU never maps instead (the flame memory
+ * node is <0xc0000000 0x140000000>; XNU takes 4 GB up; the boot ramdisk at 0xc0000000 is dead once the
+ * shim has jumped; phone/wifi's radio uses 0xe0000000-0xe1000000). Units of 16 KB (a CPU page).
+ */
+#define GPOOL_UNIT      0x4000ULL
+#define GPOOL_FREE_MAX  4096
+static const struct { uint64_t pa, size; } gpool_ranges[] = {
+#if defined(SWEET_BOARD_BETALM)
+	/*
+	 * G8S: the last fixed carve-out below 4 GB (cdsp_sec_regions) ends at
+	 * 0xa8800000 and XNU takes RAM from 4 GB up (mkadt --highmem); ABL's
+	 * ramdisk and the shim are dead once XNU runs. Leave a margin.
+	 */
+	{ 0xb0000000ULL, 0x40000000ULL },       /* 1 GB */
+#else
+	{ 0xc4000000ULL, 0x1c000000ULL },       /* 448 MB (the first 64 MB left to ABL's ramdisk) */
+	{ 0xe1000000ULL, 0x1f000000ULL },       /* 496 MB */
+#endif
+};
+static struct { uint64_t pa, size; } gpool_free[GPOOL_FREE_MAX];       /* sorted by address, merged */
+static uint32_t gpool_nfree;
+static uint64_t gpool_used, gpool_peak;
+
+/* GPU pool bytes not in use (sweet_gpu_pool_alloc), for the per-client cap in SweetAccelerator */
+uint64_t sweet_gpu_pool_avail(void);
+uint64_t
+sweet_gpu_pool_avail(void)
+{
+	uint64_t total = 0;
+	for (unsigned i = 0; i < sizeof(gpool_ranges) / sizeof(gpool_ranges[0]); i++) {
+		total += gpool_ranges[i].size;
+	}
+	return total - gpool_used;
+}
+static bool gpool_ready;
+static LCK_MTX_DECLARE(sweet_gpool_lock, &sweet_gpu_grp);
+
+/* First fit: the physical address of `bytes` (rounded to 16 KB), zeroing is the caller's. 0 = ok. */
+int
+sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
+{
+	uint64_t size = (bytes + GPOOL_UNIT - 1) & ~(GPOOL_UNIT - 1);
+	int rc = -1;
+	lck_mtx_lock(&sweet_gpool_lock);
+	if (!gpool_ready) {
+		for (unsigned i = 0; i < sizeof(gpool_ranges) / sizeof(gpool_ranges[0]); i++) {
+			gpool_free[gpool_nfree].pa = gpool_ranges[i].pa;
+			gpool_free[gpool_nfree].size = gpool_ranges[i].size;
+			gpool_nfree++;
+		}
+		gpool_ready = true;
+	}
+	for (uint32_t i = 0; i < gpool_nfree; i++) {
+		if (gpool_free[i].size >= size) {
+			*pa = gpool_free[i].pa;
+			gpool_free[i].pa += size;
+			gpool_free[i].size -= size;
+			if (gpool_free[i].size == 0) {
+				memmove(&gpool_free[i], &gpool_free[i + 1], (gpool_nfree - i - 1) * sizeof(gpool_free[0]));
+				gpool_nfree--;
+			}
+			gpool_used += size;
+			if (gpool_used > gpool_peak) {
+				gpool_peak = gpool_used;
+			}
+			if ((gpool_used >> 25) != ((gpool_used - size) >> 25)) {
+				a6_log("pool: %llu MB in use (peak %llu)\n", gpool_used >> 20, gpool_peak >> 20);
+			}
+			rc = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&sweet_gpool_lock);
+	if (rc) {
+		a6_log("pool: no %llu bytes free (%llu MB in use)\n", size, gpool_used >> 20);
+	}
+	return rc;
+}
+
+void
+sweet_gpu_pool_free(uint64_t pa, uint64_t bytes)
+{
+	uint64_t size = (bytes + GPOOL_UNIT - 1) & ~(GPOOL_UNIT - 1);
+	lck_mtx_lock(&sweet_gpool_lock);
+	gpool_used -= size;
+	if ((gpool_used >> 25) != ((gpool_used + size) >> 25)) {
+		a6_log("pool: %llu MB in use (peak %llu)\n", gpool_used >> 20, gpool_peak >> 20);
+	}
+	uint32_t i = 0;
+	while (i < gpool_nfree && gpool_free[i].pa < pa) {
+		i++;
+	}
+	if (i > 0 && gpool_free[i - 1].pa + gpool_free[i - 1].size == pa) {
+		gpool_free[i - 1].size += size;
+		if (i < gpool_nfree && pa + size == gpool_free[i].pa) {
+			gpool_free[i - 1].size += gpool_free[i].size;
+			memmove(&gpool_free[i], &gpool_free[i + 1], (gpool_nfree - i - 1) * sizeof(gpool_free[0]));
+			gpool_nfree--;
+		}
+	} else if (i < gpool_nfree && pa + size == gpool_free[i].pa) {
+		gpool_free[i].pa = pa;
+		gpool_free[i].size += size;
+	} else if (gpool_nfree < GPOOL_FREE_MAX) {
+		memmove(&gpool_free[i + 1], &gpool_free[i], (gpool_nfree - i) * sizeof(gpool_free[0]));
+		gpool_free[i].pa = pa;
+		gpool_free[i].size = size;
+		gpool_nfree++;
+	} else {
+		a6_log("pool: free list full, %llu bytes at %llx leak\n", size, pa);
+	}
+	lck_mtx_unlock(&sweet_gpool_lock);
+}
+
+/*
+ * ---- v2 clients: Turnip's darwin backend (SweetAccelerator.cpp, NativeAdreno ABI) ----
+ *
+ * The client picks its GPU addresses (Turnip's own VMA heap), so each connection gets a window of
+ * the one GPU address space to itself: 4 GB windows from 64 GB up, above the v1 range.
+ */
+#define WIN_BASE        0x1000000000ULL
+#define WIN_SIZE        0x100000000ULL
+#define WIN_COUNT       64
+static uint64_t win_used;               /* bit n: window n taken */
+
+int
+sweet_gpu_window_alloc(uint64_t *base, uint64_t *size)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	for (unsigned n = 0; n < WIN_COUNT; n++) {
+		if (!(win_used & (1ULL << n))) {
+			win_used |= 1ULL << n;
+			lck_mtx_unlock(&sweet_gpu_lock);
+			*base = WIN_BASE + n * WIN_SIZE;
+			*size = WIN_SIZE;
+			return 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return -1;
+}
+
+void
+sweet_gpu_window_free(uint64_t base)
+{
+	if (base < WIN_BASE || base >= WIN_BASE + WIN_COUNT * WIN_SIZE) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	win_used &= ~(1ULL << ((base - WIN_BASE) / WIN_SIZE));
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* 4K pages at iova (inside the caller's window), then a TLB flush. */
+int
+sweet_gpu_map_at(uint64_t iova, const uint64_t *pages, uint32_t npages)
+{
+	if (!gpu_ready || npages == 0 || iova < WIN_BASE) {
+		return -1;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = a6_map_pages(&gpu, iova, pages, npages, 0x1000);
+	if (rc) {
+		a6_unmap(&gpu, iova, (uint64_t)npages << 12);
+	}
+	a6_tlb_flush(&gpu);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
+
+void
+sweet_gpu_unmap_at(uint64_t iova, uint64_t len)
+{
+	if (iova < WIN_BASE || len == 0) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (gpu_ready) {
+		a6_unmap(&gpu, iova, len);
+		a6_tlb_flush(&gpu);
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* Queue up to A6_SUBMIT_MAX IBs: the fence, 0 when the GPU is not usable, or 0 with *busy when the ring is full. */
+uint32_t
+sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
+{
+	*busy = false;
+	if (!gpu_ready) {
+		return 0;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	gpu_note_submit_locked();
+	uint32_t fence = a6_submit_ibs_async(&gpu, iova, dwords, n, 0);
+	gpu_owner_locked(fence, proc_selfpid());
+	lck_mtx_unlock(&sweet_gpu_lock);
+	*busy = fence == 0 && n > 0 && n <= A6_SUBMIT_MAX;
+	return fence;
+}
+
+bool
+sweet_gpu_fence_done(uint32_t fence)
+{
+	return !gpu_ready || a6_fence_done(&gpu, fence);
+}
+
+/*
+ * Wait up to timeout_ns (0: look once) for a fence: 0 done, 1 timeout. A GPU that makes no progress for
+ * a second is reset here (its queued work is lost; sweet_gpu_lost tells the clients).
+ */
+int
+sweet_gpu_wait_fence_ns(uint32_t fence, uint64_t timeout_ns)
+{
+	/* the hang check by time, not per call: Turnip's darwin backend waits in 1 ms slices */
+	static uint64_t last_check;
+	uint64_t t0 = mach_absolute_time(), ns = 0, check_abs;
+	nanoseconds_to_absolutetime(5000000, &check_abs);
+	for (;;) {
+		if (sweet_gpu_fence_done(fence)) {
+			return 0;
+		}
+		uint64_t now = mach_absolute_time();
+		if (now - last_check > check_abs) {
+			last_check = now;
+			lck_mtx_lock(&sweet_gpu_lock);
+			if (!a6_fence_done(&gpu, fence) && gpu_hung_locked(1000)) {
+				gpu_recover_locked("v2 fence wait");
+			}
+			lck_mtx_unlock(&sweet_gpu_lock);
+		}
+		absolutetime_to_nanoseconds(now - t0, &ns);
+		if (ns >= timeout_ns) {
+			return sweet_gpu_fence_done(fence) ? 0 : 1;
+		}
+		delay(20);
+	}
+}
+
+/*
+ * Did a reset since *epoch lose work of a client whose last fence is last_fence? Moves *epoch to now.
+ * (Fences are global and in submission order: the client lost work if its last one was in a lost range.)
+ */
+bool
+sweet_gpu_lost(uint64_t *epoch, uint32_t last_fence)
+{
+	bool hit = false;
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (recoveries - *epoch > LOST_RING) {
+		*epoch = recoveries - LOST_RING;
+	}
+	for (; *epoch < recoveries; (*epoch)++) {
+		uint32_t lo = lost[*epoch % LOST_RING].lo, hi = lost[*epoch % LOST_RING].hi;
+		if (last_fence && (int32_t)(last_fence - lo) > 0 && (int32_t)(hi - last_fence) >= 0) {
+			hit = true;
+		}
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return hit;
+}
+
+uint64_t
+sweet_gpu_recoveries(void)
+{
+	return recoveries;
+}
+
+uint64_t
+sweet_gpu_timestamp(void)
+{
+	return gpu_ready ? a6_timestamp(&gpu) : 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_pmem.c b/bsd/dev/sweet_pmem.c
new file mode 100644
index 0000000..d405964
--- /dev/null
+++ b/bsd/dev/sweet_pmem.c
@@ -0,0 +1,377 @@
+/*
+ * /dev/pmem: physical memory for userland hardware experiments (the GPU
+ * bring-up in work/userland/gpu runs on it over SSH, no reboot per try).
+ * Root only (0600); boot-arg sweetpmem=0 leaves the node out.
+ *
+ *   pread/pwrite at offset = physical address.
+ *     Managed DRAM goes through the physical aperture with the lines
+ *     cleaned+invalidated to the point of coherency before and after, so
+ *     data a device wrote is seen and CPU writes reach memory (IO is not
+ *     coherent here). Anything else (MMIO, carve-outs such as the panel
+ *     framebuffer) is mapped as device memory and accessed with 32-bit
+ *     loads/stores only: offset and length must be multiples of 4.
+ *     Reading an unclocked block hangs the SoC, as with poke scripts.
+ *   ioctl PMEM_ALLOC   {size, align} -> {pa}: zeroed, physically contiguous
+ *                      kernel memory (stays until PMEM_FREE, survives exit)
+ *   ioctl PMEM_FREE    {pa}
+ *   ioctl PMEM_SMC     x0..x7 in, x0..x3 out (SMCCC; e.g. SCM PAS calls)
+ *   ioctl PMEM_LIST    allocation table, for tools that lost their state
+ *   ioctl PMEM_RPMH    one RPMh active vote: resource name, 1-4 (offset, value) commands
+ *                      (ARC levels, VRM rails; bsd/dev/sweet_rpmh.c)
+ *
+ * Userland side: work/userland/gpu/pmem.h (same structs and numbers).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+void sweet_pmem_init(void);
+void sweet_smc(uint64_t x[8]);
+
+struct pmem_alloc {
+	uint64_t size;          /* in: bytes (rounded up to pages) */
+	uint64_t align;         /* in: bytes, power of 2, 0 = page */
+	uint64_t pa;            /* out */
+};
+struct pmem_smc {
+	uint64_t x[8];
+};
+#define PMEM_LIST_MAX   64
+struct pmem_list {
+	uint32_t count;
+	uint32_t pad;
+	struct {
+		uint64_t pa, size;
+	} ent[PMEM_LIST_MAX];
+};
+#define PMEM_ALLOC      _IOWR('P', 1, struct pmem_alloc)
+#define PMEM_FREE       _IOW('P', 2, uint64_t)
+#define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
+#define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name, e.g. "mss.lvl", "ldoa1" */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+#define PMEM_MAPS       16              /* 2 MB device windows, round robin */
+#define PMEM_WIN        0x200000ULL
+
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} pm_alloc[PMEM_LIST_MAX];
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} pm_map[PMEM_MAPS];
+static unsigned pm_map_next;
+static uint32_t pm_bounce[PAGE_SIZE / 4];
+
+static LCK_GRP_DECLARE(sweet_pmem_grp, "sweet_pmem");
+static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
+
+/*
+ * Device mapping of the 2 MB window holding pa, from a small round-robin
+ * cache. ml_io_map's mappings are permanent (unmapping one panics) and come
+ * from the small io_submap (a 2 MB one panicked "kmem_alloc failed"), so
+ * windows use ml_io_map_unmappable: kernel_map, freed by ml_io_unmap.
+ */
+static volatile uint32_t *
+pm_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(PMEM_WIN - 1);
+	for (unsigned i = 0; i < PMEM_MAPS; i++) {
+		if (pm_map[i].va && pm_map[i].win == win) {
+			return (volatile uint32_t *)(pm_map[i].va + (pa - win));
+		}
+	}
+	unsigned i = pm_map_next++ % PMEM_MAPS;
+	if (pm_map[i].va) {
+		ml_io_unmap(pm_map[i].va, PMEM_WIN);
+	}
+	pm_map[i].va = ml_io_map_unmappable((vm_offset_t)win, PMEM_WIN, VM_WIMG_IO);
+	pm_map[i].win = win;
+	return pm_map[i].va ? (volatile uint32_t *)(pm_map[i].va + (pa - win)) : NULL;
+}
+
+static int
+pm_rw(struct uio *uio, bool write)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	while (!err && uio_resid(uio) > 0) {
+		uint64_t pa = (uint64_t)uio_offset(uio);
+		uint64_t off = pa & PAGE_MASK;
+		unsigned n = (unsigned)MIN((user_ssize_t)(PAGE_SIZE - off), uio_resid(uio));
+		if (pmap_valid_address(pa)) {
+			caddr_t va = (caddr_t)phystokv(pa);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			err = uiomove(va, (int)n, uio);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			continue;
+		}
+		if ((pa | n) & 3) {
+			err = EINVAL;
+			break;
+		}
+		volatile uint32_t *r = pm_io(pa);
+		if (r == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		if (write) {
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			for (unsigned i = 0; !err && i < n / 4; i++) {
+				r[i] = pm_bounce[i];
+			}
+			__asm__ volatile ("dsb osh" ::: "memory");
+		} else {
+			for (unsigned i = 0; i < n / 4; i++) {
+				pm_bounce[i] = r[i];
+			}
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+		}
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static int
+pm_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, false);
+}
+
+static int
+pm_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, true);
+}
+
+static int
+pm_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+pm_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+pm_smc_once(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x[0] = x0;
+	x[1] = x1;
+	x[2] = x2;
+	x[3] = x3;
+	x[6] = x6;
+}
+
+/*
+ * Qualcomm TZ returns QCOM_SCM_INTERRUPTED (1) when a non-secure interrupt
+ * arrives during a call (the shim never saw it: interrupts off). Like
+ * Linux's __scm_smc_do_quirk: call again with x0 = 1, the same arguments
+ * and the x6 TZ handed back (ARM_SMCCC_QUIRK_QCOM_A6), on the same CPU,
+ * until a final result.
+ */
+#define QCOM_SCM_INTERRUPTED    1
+
+static void
+pm_smc(struct pmem_smc *s)
+{
+	uint64_t x[8], fn = s->x[0];
+	unsigned resumes = 0;
+	memcpy(x, s->x, sizeof(x));
+	_disable_preemption();
+	for (;;) {
+		pm_smc_once(x);
+		if (x[0] != QCOM_SCM_INTERRUPTED || resumes >= 100000) {
+			break;
+		}
+		uint64_t a6 = x[6];
+		memcpy(x, s->x, sizeof(x));
+		x[0] = QCOM_SCM_INTERRUPTED;
+		x[6] = a6;
+		resumes++;
+	}
+	_enable_preemption();
+	memcpy(s->x, x, 4 * sizeof(uint64_t));
+	if (resumes) {
+		printf("SWEET PMEM: smc %llx resumed %u times -> %llx\n", fn, resumes, x[0]);
+	}
+}
+
+/* For bsd/dev/sweet_gpu.c (zap shader): x0..x7 in, x0..x3 out. */
+void
+sweet_smc(uint64_t x[8])
+{
+	struct pmem_smc s;
+	memcpy(s.x, x, sizeof(s.x));
+	pm_smc(&s);
+	memcpy(x, s.x, 4 * sizeof(uint64_t));
+}
+
+static int
+pm_do_alloc(struct pmem_alloc *a)
+{
+	vm_size_t size = round_page(a->size);
+	uint64_t align = a->align > PAGE_SIZE ? a->align : PAGE_SIZE;
+	if (size == 0 || (align & (align - 1))) {
+		return EINVAL;
+	}
+	int slot = -1;
+	for (int i = 0; i < PMEM_LIST_MAX; i++) {
+		if (!pm_alloc[i].va) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		return ENOSPC;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, size, PAGE_MASK, 0, (ppnum_t)(atop_64(align) - 1),
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (!pn) {
+		kmem_free(kernel_map, va, size);
+		return ENOMEM;
+	}
+	a->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)a->pa, (unsigned)size, TRUE);
+	pm_alloc[slot].va = va;
+	pm_alloc[slot].pa = a->pa;
+	pm_alloc[slot].size = size;
+	printf("SWEET PMEM: alloc %llu bytes at 0x%llx (pid %d)\n", (uint64_t)size, a->pa, proc_selfpid());
+	return 0;
+}
+
+static int
+pm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	switch (cmd) {
+	case PMEM_ALLOC:
+		err = pm_do_alloc((struct pmem_alloc *)data);
+		break;
+	case PMEM_FREE: {
+		uint64_t pa = *(uint64_t *)data;
+		err = ENOENT;
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va && pm_alloc[i].pa == pa) {
+				kmem_free(kernel_map, pm_alloc[i].va, (vm_size_t)pm_alloc[i].size);
+				pm_alloc[i].va = 0;
+				err = 0;
+				break;
+			}
+		}
+		break;
+	}
+	case PMEM_SMC:
+		pm_smc((struct pmem_smc *)data);
+		break;
+	case PMEM_LIST: {
+		struct pmem_list *l = (struct pmem_list *)data;
+		bzero(l, sizeof(*l));
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va) {
+				l->ent[l->count].pa = pm_alloc[i].pa;
+				l->ent[l->count].size = pm_alloc[i].size;
+				l->count++;
+			}
+		}
+		break;
+	}
+	case PMEM_RPMH: {
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		lck_mtx_unlock(&sweet_pmem_lock);       /* waits up to 100 ms; not under our lock */
+		err = sweet_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("SWEET PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
+	default:
+		err = ENOTTY;
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static const struct cdevsw sweet_pmem_cdevsw = {
+	.d_open       = pm_open,
+	.d_close      = pm_close,
+	.d_read       = pm_read,
+	.d_write      = pm_write,
+	.d_ioctl      = pm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+sweet_pmem_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetpmem", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sweet_pmem_cdevsw);
+	if (major < 0) {
+		printf("SWEET PMEM: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "pmem");
+	printf("SWEET PMEM: /dev/pmem ready (major %d)\n", major);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
