diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..aa31121 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -17,6 +17,23 @@
 
 #define SWEET                     1
 
+/*
+ * Board: LG G8S ThinQ ("betalm", LM-G810, Qualcomm SM8150 / Snapdragon 855,
+ * Kryo 485 = 4x Cortex-A55 + 4x Cortex-A76, ARMv8.2, no PAC). The SoC shares
+ * sweet's GIC, UFS, SPMI arbiter, GCC and splash addresses; what differs is
+ * the panel (1080x2248 DSI command mode, kept refreshing by the shim through
+ * pingpong autorefresh), touch (Synaptics S3706 on QUP SE17), keys (PM8150
+ * GPIO6 for volume up) and the absent sweet USB PHY.
+ *
+ * Only the early consoles use these constants; the framebuffer driver takes
+ * the geometry the shim detected from boot_args.Video.
+ */
+#define SWEET_BOARD_BETALM        1
+#define SWEET_PANEL_W             1080
+#define SWEET_PANEL_H             2248
+#define SWEET_PANEL_STRIDE        (SWEET_PANEL_W * 4)
+#define SWEET_SPLASH_PA           0x9c000000
+
