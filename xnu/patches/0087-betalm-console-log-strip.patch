+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Log strip (boot-arg sweetfb_logrows=N, iokit/Kernel/arm/SweetFramebuffer.cpp):
+ * when the GUI first presents, the text console shrinks to the bottom N text
+ * rows of the panel and the GUI is not copied there, so the boot logo (and
+ * later the GUI) stays visible above a live log. The last N lines written so
+ * far move down into the strip. Only the console's view of the screen
+ * changes (base, height, rows); the mapping stays.
+ *
+ * Returns the first panel pixel row of the strip, or 0 if nothing changed.
+ */
+/*
+ * The console's framebuffer mapping is Device memory: no memmove/bzero
+ * there (bzero's DC ZVA and unaligned accesses fault: first strip boot
+ * panicked with an unaligned data abort in bzero). 32-bit volatile only.
+ */
+static void
+sweet_fb_move(unsigned long dst, unsigned long src, size_t bytes)
+{
+	volatile uint32_t *dp = (volatile uint32_t *)dst;
+	volatile uint32_t *sp = (volatile uint32_t *)src;
+	size_t n = bytes / 4;
+	if (dst > src) {                        /* overlapping, downwards on screen */
+		while (n--) {
+			dp[n] = sp[n];
+		}
+	} else {
+		for (size_t i = 0; i < n; ++i) {
+			dp[i] = sp[i];
+		}
+	}
+}
+
+static void
+sweet_fb_zero(unsigned long dst, size_t bytes)
+{
+	volatile uint32_t *d = (volatile uint32_t *)dst;
+	for (size_t i = 0; i < bytes / 4; ++i) {
+		d[i] = 0;
+	}
+}
+
+static struct {
+	boolean_t    active;
+	vm_offset_t  baseaddr;
+	unsigned int height, rows, buffer_rows, top_rows;
+} sweet_strip;
+
+unsigned int sweet_console_strip(unsigned int rows);
+void sweet_console_strip_panic(void);
+
+unsigned int
+sweet_console_strip(unsigned int rows)
+{
+	unsigned int total, n, src, top;
+
+	if (!gc_initialized) {
+		return 0;
+	}
+	VCPUTC_LOCK_LOCK();
+	total = vinfo.v_rows;
+	if (sweet_strip.active || rows == 0 || rows + 8 > total || vinfo.v_depth != 32 ||
+	    vinfo.v_baseaddr == 0) {
+		VCPUTC_LOCK_UNLOCK();
+		return 0;
+	}
+	top = total - rows;                     /* first text row of the strip */
+	n = rows < gc_y + 1 ? rows : gc_y + 1;               /* lines to keep: up to the cursor */
+	src = gc_y + 1 - n;
+
+	/* Pixels: whole text lines are contiguous (stride = v_rowbytes). */
+	size_t line = (size_t)ISO_CHAR_HEIGHT * vinfo.v_rowbytes;
+	unsigned long fb = vinfo.v_baseaddr;
+	sweet_fb_move(fb + (size_t)(total - n) * line, fb + (size_t)src * line, (size_t)n * line);
+	sweet_fb_zero(fb + (size_t)top * line, (size_t)(rows - n) * line);
+
+	/* Character buffer, so the strip scrolls with the right contents. */
+	if (gc_buffer_size && total <= gc_buffer_rows) {
+		size_t cols = gc_buffer_columns;
+		memmove(gc_buffer_attributes + (rows - n) * cols, gc_buffer_attributes + src * cols, n * cols);
+		memmove(gc_buffer_characters + (rows - n) * cols, gc_buffer_characters + src * cols, n * cols);
+		memmove(gc_buffer_colorcodes + (rows - n) * cols, gc_buffer_colorcodes + src * cols, n * cols);
+		memset(gc_buffer_attributes, ATTR_NONE, (rows - n) * cols);
+		memset(gc_buffer_characters, ' ', (rows - n) * cols);
+		memset(gc_buffer_colorcodes, COLOR_CODE_SET(0, COLOR_FOREGROUND, TRUE), (rows - n) * cols);
+	}
+
+	sweet_strip.baseaddr = vinfo.v_baseaddr;
+	sweet_strip.height = vinfo.v_height;
+	sweet_strip.rows = vinfo.v_rows;
+	sweet_strip.buffer_rows = gc_buffer_rows;
+	sweet_strip.top_rows = top;
+	sweet_strip.active = TRUE;
+
+	vinfo.v_baseaddr += (vm_offset_t)top * line;
+	vinfo.v_height = rows * ISO_CHAR_HEIGHT;
+	vinfo.v_rows = rows;
+	if (gc_buffer_size && gc_buffer_rows > rows) {
+		gc_buffer_rows = rows;
+	}
+	gc_y = rows - 1;
+	if (gc_savey > rows - 1) {
+		gc_savey = rows - 1;
+	}
+	gc_scrreg_top = 0;
+	gc_scrreg_bottom = rows;
+	VCPUTC_LOCK_UNLOCK();
+	return top * ISO_CHAR_HEIGHT;
+}
+
+/* A panic gets the whole screen back (no lock: the other CPUs are stopped). */
+void
+sweet_console_strip_panic(void)
+{
+	if (!sweet_strip.active) {
+		return;
+	}
+	sweet_strip.active = FALSE;
+	unsigned int rows = vinfo.v_rows, top = sweet_strip.top_rows;
+	/* The GUI part goes black, the strip's lines stay where they are. */
+	sweet_fb_zero(sweet_strip.baseaddr, (size_t)top * ISO_CHAR_HEIGHT * vinfo.v_rowbytes);
+	vinfo.v_baseaddr = sweet_strip.baseaddr;
+	vinfo.v_height = sweet_strip.height;
+	vinfo.v_rows = sweet_strip.rows;
+	if (gc_buffer_size && sweet_strip.buffer_rows >= top + rows) {
+		size_t cols = gc_buffer_columns;
+		memmove(gc_buffer_attributes + top * cols, gc_buffer_attributes, rows * cols);
+		memmove(gc_buffer_characters + top * cols, gc_buffer_characters, rows * cols);
+		memmove(gc_buffer_colorcodes + top * cols, gc_buffer_colorcodes, rows * cols);
+		memset(gc_buffer_attributes, ATTR_NONE, top * cols);
+		memset(gc_buffer_characters, ' ', top * cols);
+		memset(gc_buffer_colorcodes, COLOR_CODE_SET(0, COLOR_FOREGROUND, TRUE), top * cols);
+	}
+	gc_buffer_rows = sweet_strip.buffer_rows;
+	gc_y += sweet_strip.top_rows;
+	gc_savey += sweet_strip.top_rows;
+	gc_scrreg_top = 0;
+	gc_scrreg_bottom = vinfo.v_rows;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
