+	snprintf(bssid_s, sizeof(bssid_s), "%02x:%02x:%02x:%02x:%02x:%02x",
+	    net.wlan_bssid[0], net.wlan_bssid[1], net.wlan_bssid[2],
+	    net.wlan_bssid[3], net.wlan_bssid[4], net.wlan_bssid[5]);
+	sd_putf(&b, "  \"network\": {\n");
+	sd_putf(&b, "    \"wifi\": {\n");
+	sd_putf(&b, "      \"wland_open\": %s, \"radio_ready\": %s, \"link_up\": %s,\n",
