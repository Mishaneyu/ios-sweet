+	    (unsigned long long)en0_rx, (unsigned long long)en0_tx);
+	sd_putf(&b, "      \"mac\": \"%s\", \"ssid\": ", mac_s);
+	sd_put_json_str(&b, net.wlan_ssid);
+	sd_putf(&b, ", \"bssid\": \"%s\",\n", bssid_s);
+	sd_putf(&b, "      \"freq_mhz\": %u, \"rssi_dbm\": %d, \"bss_heard\": %u, \"tx_dropped\": %llu\n",
+	    (unsigned)net.wlan_freq_mhz, (int)net.wlan_rssi_dbm, net.wlan_bss_count,
+	    (unsigned long long)net.wlan_tx_dropped);
+	sd_putf(&b, "    },\n");
+	sd_putf(&b, "    \"usb\": {\n");
+	sd_putf(&b, "      \"ready\": %s, \"configured\": %s, \"ue0_up\": %s, \"ue0_ip\": ",
+	    net.usb_ready ? "true" : "false", net.usb_configured ? "true" : "false",
