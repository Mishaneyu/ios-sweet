+	out->direct_present = fDirectPresent;
+	out->force_cpu = fForceCPU;
+	out->gpu_ever = fGPU;
+	out->last_present_gpu = fLastPresentGPU;
+	out->panel_pa = fPhys;
+	out->panel_w = fWidth;
+	out->panel_h = fHeight;
+	out->panel_stride = fRowBytes;
+	out->logical_w = fLogicalW;
+	out->logical_h = fLogicalH;
+	out->fit_x = sweet_display_fit_x;
+	out->fit_y = sweet_display_fit_y;
+	out->fit_w = sweet_display_fit_w;
+	out->fit_h = sweet_display_fit_h;
+	out->corner_radius = fCornerRadius;
+	out->corner_ext = fCornerExt;
+	out->vsync_hz = fFlushTicks ? (uint32_t)(60u / fFlushTicks) : 60u;
+	out->vsync_count = fVsyncCount;
+	out->swaps_total = sweet_fb_swap_count;
+	out->presents_total = fTotalPresents;
+	out->gpu_presents = fGpuPresents;
+	out->cpu_presents = fCpuPresents;
+	out->fps_5s_x10 = fLast5sFpsX10;
+	out->last_5s_swaps = fLast5sSwaps;
+	out->last_5s_presents = fLast5sPresents;
+	out->avg_present_us = fLast5sAvgUs;
+	out->clients_count = fClients != NULL ? fClients->getCount() : 0;
+	out->last_surf_id = fLastSurfId;
+	out->last_surf_w = fLastSurfW;
+	out->last_surf_h = fLastSurfH;
+	out->last_surf_bpr = fLastSurfBpr;
+	out->last_surf_fmt = fLastSurfFmt;
+	out->last_layer_mask = fLastLayerMask;
