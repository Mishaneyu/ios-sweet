+		    (unsigned long long)c->sp, (unsigned long long)c->fp,
+		    (unsigned long long)c->far, (unsigned long long)c->slide,
+		    (unsigned long long)c->mh);
+		for (uint32_t j = 0; j < c->bt_count; j++) {
