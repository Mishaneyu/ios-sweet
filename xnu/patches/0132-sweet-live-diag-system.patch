diff --git a/EXTERNAL_HEADERS/sweet_diag.h b/EXTERNAL_HEADERS/sweet_diag.h
new file mode 100644
index 0000000..4e5ae30
--- /dev/null
+++ b/EXTERNAL_HEADERS/sweet_diag.h
@@ -0,0 +1,229 @@
+/*
+ * Live kernel telemetry, crash ring, and debug snapshot interface for booted
+ * iOS bring-up (bsd/dev/sweet_diag.c, /dev/sweet-diag, /dev/sweet-log, and
+ * TCP 2223 DIAG / KLOG / CMD).
+ */
+#ifndef _SWEET_DIAG_H_
+#define _SWEET_DIAG_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SWEET_DIAG_MAX_OWNERS   7
+#define SWEET_DIAG_MAX_CLIENTS  24
+#define SWEET_DIAG_MAX_CRASHES  16
+#define SWEET_DIAG_MAX_BT       8
+#define SWEET_DIAG_MAX_PRIVS    24
+
+struct sweet_diag_display {
+	bool     registered;
+	bool     power_on;
+	bool     direct_present;
+	bool     force_cpu;
+	bool     gpu_ever;
+	bool     last_present_gpu;
+	bool     backlight_registered;
+	uint64_t panel_pa;
+	uint32_t panel_w, panel_h, panel_stride;
+	uint32_t logical_w, logical_h;
+	int32_t  fit_x, fit_y, fit_w, fit_h;
+	uint32_t corner_radius, corner_ext;
+	uint32_t vsync_hz;
+	uint64_t vsync_count;
+	uint64_t swaps_total;
+	uint64_t presents_total;
+	uint64_t gpu_presents;
+	uint64_t cpu_presents;
+	uint32_t fps_1s_x10;
+	uint32_t fps_5s_x10;
+	uint64_t last_5s_swaps;
+	uint64_t last_5s_presents;
+	uint64_t avg_present_us;
+	uint32_t clients_count;
+	uint32_t last_surf_id;
+	uint32_t last_surf_w, last_surf_h, last_surf_bpr, last_surf_fmt;
+	uint32_t last_layer_mask;
+	uint64_t last_swap_age_ms;
+	uint32_t gpu_fallback_mask;
+	uint64_t gpu_fallback_count;
+	char     last_fallback_reason[48];
+	uint32_t millinits;
+	uint32_t raw_level;
+	uint32_t dim_alpha;
+};
+
+struct sweet_diag_gpu_owner {
+	int32_t  pid;
+	char     name[24];
+	uint32_t submits;
+	uint64_t busy_ms;
+};
+
+struct sweet_diag_gpu_client {
+	int32_t  pid;
+	char     name[32];
+	bool     v2;
+	bool     system;
+	bool     cap_refused;
+	uint64_t pool_bytes;
+	uint64_t pool_peak;
+	uint64_t submits;
+	uint64_t faults;
+};
+
+struct sweet_diag_gpu {
+	bool     enabled;
+	bool     ready;
+	bool     ddr_boost;
+	uint32_t perf_level;
+	uint32_t clock_mhz;
+	uint64_t recoveries;
+	uint32_t fence_submitted;
+	uint32_t fence_done;
+	uint64_t pool_total_bytes;
+	uint64_t pool_used_bytes;
+	uint64_t pool_peak_bytes;
+	uint64_t pool_alloc_failures;
+	uint32_t cap_mb;
+	uint32_t reserve_mb;
+	uint64_t clean_us;
+	uint64_t blit_us;
+	uint64_t present_frames;
+	uint64_t win_age_ms;
+	uint32_t win_submits;
+	uint32_t win_missed;
+	uint64_t win_busy_ms;
+	uint32_t win_busy_pct;
+	uint64_t win_longest_us;
+	uint64_t win_mean_us;
+	uint32_t owner_count;
+	struct sweet_diag_gpu_owner owners[SWEET_DIAG_MAX_OWNERS];
+	uint32_t client_count;
+	struct sweet_diag_gpu_client clients[SWEET_DIAG_MAX_CLIENTS];
+};
+
+struct sweet_diag_input {
+	char     driver[32];
+	bool     touch_ready;
+	uint32_t poll_ms;
+	uint64_t touch_errors;
+	uint64_t touch_events;
+	uint32_t fingers_mask;
+	int32_t  last_x, last_y;
+	uint64_t last_touch_age_ms;
+	uint64_t button_events;
+	uint32_t buttons_mask;
+};
+
+struct sweet_diag_net {
+	bool     wland_open;
+	bool     wlan_ready;
+	bool     wlan_link_up;
+	uint8_t  wlan_mac[6];
+	char     wlan_ssid[33];
+	uint8_t  wlan_bssid[6];
+	uint16_t wlan_freq_mhz;
+	int16_t  wlan_rssi_dbm;
+	uint32_t wlan_bss_count;
+	uint64_t wlan_tx_dropped;
+	bool     usb_ready;
+	bool     usb_configured;
+	uint64_t usb_rx_frames;
+	uint64_t usb_tx_frames;
+};
+
+struct sweet_diag_peripherals {
+	bool     bat_online;
+	bool     bat_ext;
+	bool     bat_charging;
+	bool     bat_full;
+	uint32_t bat_soc;
+	uint32_t bat_mv;
+	uint32_t bat_pack_mv;
+	int32_t  bat_ma;
+	int32_t  bat_temp_deci_c;
+	uint32_t bat_rem_mah;
+	uint32_t bat_fcc_mah;
+	uint32_t bat_cycles;
+	uint32_t bat_errors;
+
+	bool     audio_ready;
+	bool     audio_active;
+	bool     audio_muted;
+	uint64_t audio_frames_total;
+	uint64_t audio_frames_sound;
+	uint32_t audio_peak_pct;
+	int32_t  audio_vol_eighth_db;
+
+	bool     torch_ready;
+	bool     torch_fault;
+	uint32_t torch_level;
+
+	bool     haptic_ready;
+	uint32_t haptic_events;
+	uint32_t haptic_faults;
+};
+
+struct sweet_diag_crash {
+	uint64_t seq;
+	uint64_t uptime_ms;
+	int32_t  pid;
+	int32_t  sig;
+	char     name[20];
+	uint64_t code;
+	uint64_t subcode;
+	uint64_t pc;
+	uint64_t lr;
+	uint64_t sp;
+	uint64_t fp;
+	uint64_t far;
+	uint64_t slide;
+	uint64_t mh;
+	uint32_t bt_count;
+	uint64_t bt[SWEET_DIAG_MAX_BT];
+};
+
+struct sweet_diag_priv {
+	int32_t  priv;
+	char     name[20];
+};
+
+void sweet_diag_init(void);
+size_t sweet_diag_format_json(char *buf, size_t cap);
+
+void sweet_cpufreq_record(unsigned cluster, unsigned mhz);
+void sweet_wdt_record(bool enabled, int reboot_s, int elapsed_s);
+void sweet_touch_driver_record(const char *driver, bool ready, uint32_t poll_ms, uint64_t errors);
+void sweet_crash_record(const char *name, int pid, int sig, uint64_t code, uint64_t subcode,
+    uint64_t pc, uint64_t lr, uint64_t sp, uint64_t fp, uint64_t far,
+    uint64_t slide, uint64_t mh, const uint64_t *bt, uint32_t bt_count);
+
+void sweet_fb_diag_snapshot(struct sweet_diag_display *out);
+int  sweet_fb_set_mode(const char *mode);
+int  sweet_backlight_set_pct(uint32_t pct);
+
+void sweet_gpu_diag_snapshot(struct sweet_diag_gpu *out);
+void sweet_accel_diag_snapshot(struct sweet_diag_gpu *out);
+void sweet_hid_diag_snapshot(struct sweet_diag_input *out);
+void sweet_wlan_diag_snapshot(struct sweet_diag_net *out);
+void sweet_usb_diag_snapshot(struct sweet_diag_net *out);
+void sweet_usb_run_cmd(const char *cmd, size_t got, bool allow_reset);
+
+void rmx1931_battery_diag_snapshot(struct sweet_diag_peripherals *out);
+void rmx1931_audio_diag_snapshot(struct sweet_diag_peripherals *out);
+void rmx1931_torch_diag_snapshot(struct sweet_diag_peripherals *out);
+void rmx1931_haptic_diag_snapshot(struct sweet_diag_peripherals *out);
+
+void sweet_exec_inject_diag(char *out_conf, size_t cap, uint64_t *out_hits);
+uint32_t sweet_amfi_priv_diag(struct sweet_diag_priv *out, uint32_t max_entries, uint32_t *out_total);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _SWEET_DIAG_H_ */
