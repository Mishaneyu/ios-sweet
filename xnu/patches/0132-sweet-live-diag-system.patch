diff --git a/bsd/dev/sweet_diag.c b/bsd/dev/sweet_diag.c
new file mode 100644
index 0000000..52e4905
--- /dev/null
+++ b/bsd/dev/sweet_diag.c
@@ -0,0 +1,757 @@
+/*
+ * Live OS & hardware diagnostic hub for booted iOS bring-up:
+ *   - /dev/sweet-diag (0444): live JSON snapshot of display/FPS/present path,
+ *     Adreno 640 GPU + pool + per-process Metal/Turnip clients, touch/keys,
+ *     Wi-Fi/USB + interface IPs, battery/audio/torch/haptics, exec_inject,
+ *     denied sandbox privileges, and the last 16 userland crash backtraces.
+ *   - /dev/sweet-log  (0444): lossless read/tail access to XNU's 1 MiB
+ *     sweet_log_ring console buffer from userland or SSH.
+ *   - sysctl kern.sweet.*: lightweight live telemetry counters.
+ *   - sweet_diag_format_json(): shared with TCP 2223 "DIAG" in sweet_files.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
