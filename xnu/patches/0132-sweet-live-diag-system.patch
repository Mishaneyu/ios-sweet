+	}
+	IOLockLock(fLock);
+	if (!strncmp(mode, "direct", 6)) {
+		fDirectPresent = true;
+		fForceCPU = false;
+	} else if (!strncmp(mode, "vsync", 5)) {
+		fDirectPresent = false;
+		fForceCPU = false;
+	} else if (!strncmp(mode, "cpu", 3)) {
+		fForceCPU = true;
+	} else if (!strncmp(mode, "gpu", 3)) {
+		fForceCPU = false;
+	} else {
+		IOLockUnlock(fLock);
+		return -1;
+	}
+	if (fHasSwap && !fPowerOff) {
+		memcpy(fPending, fLastRec, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = true;
+	}
+	IOLockUnlock(fLock);
+	return 0;
