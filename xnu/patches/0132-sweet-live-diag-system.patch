+	uint32_t cap = (uint32_t)max_len;
+	char *buf = kalloc_data(cap, Z_WAITOK);
+	if (buf == NULL) {
+		sf_reply(so, ENOMEM, 0, false);
+		return;
+	}
+	uint64_t cursor = pos;
+	uint32_t got = sweet_log_copy(&cursor, buf, cap);
+	char hdr[64];
+	int hlen = snprintf(hdr, sizeof(hdr), "OK %llu %u\n", (unsigned long long)cursor, got);
+	if (sf_send(so, hdr, (size_t)hlen) == 0 && got > 0) {
+		(void)sf_send(so, buf, got);
+	}
+	kfree_data(buf, cap);
+}
+
+static void
+sf_cmd(socket_t so, const char *cmd)
+{
+	while (*cmd == ' ') {
+		cmd++;
+	}
+	size_t clen = strlen(cmd);
+	if (clen == 0) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	if (strncmp(cmd, "reboot", 6) == 0 && (cmd[6] == '\0' || cmd[6] == ' ')) {
+		int32_t rv = 0;
+		(void)sync(kernproc, NULL, &rv);
+		const char *msg = "SWEET CMD: synced; rebooting via PSCI SYSTEM_RESET\n";
+		size_t mlen = strlen(msg);
+		sf_reply(so, 0, (uint64_t)mlen, true);
+		(void)sf_send(so, msg, mlen);
+		(void)sock_shutdown(so, SHUT_WR);
+		sf_sleep_ms(800);
+		printf("SWEET CMD: rebooting (PSCI SYSTEM_RESET)\n");
+		sf_sleep_ms(300);
+		register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+		__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+		return;
+	}
+	uint64_t p0 = sweet_log_position();
+	sweet_usb_run_cmd(cmd, clen, false);
+	uint32_t cap = 16384u;
+	char *out = kalloc_data(cap, Z_WAITOK);
+	if (out == NULL) {
+		sf_reply(so, ENOMEM, 0, false);
+		return;
+	}
+	uint32_t got = sweet_log_copy(&p0, out, cap);
+	sf_reply(so, 0, (uint64_t)got, true);
+	if (got > 0) {
+		(void)sf_send(so, out, got);
+	}
+	kfree_data(out, cap);
+}
