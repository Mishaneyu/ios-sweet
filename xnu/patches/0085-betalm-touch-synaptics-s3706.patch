+} gsi;
+
+/*
+ * Bit-banged I2C on SE17's own pins, the default when the SE is GSI-only:
+ * the first GPI DMA attempt reset the SoC. The Poco F1 port (Bergamota,
+ * SDM845) met the same GSI-only QUP firmware and drives its touch bus this
+ * way. Open drain: a line is released (input; the board's pull-ups, plus
+ * the TLMM's weak ones, take it high) or driven low (output, latch 0).
+ * About 100 kHz; SCL stretching by the IC is honoured (up to 1 ms).
+ */
+#define BB_HALF_US      5u
+
+static bool bb_held;    /* a write with STOP_STRETCH left the bus ours */
+
+static void
+bb_set(unsigned pin, bool high)
+{
+	uint32_t cfg = TOUCH_GPIO_CFG(pin);
+	if (high) {
+		touch_wr(st.gpio, cfg, touch_rd(st.gpio, cfg) & ~0x200u);
+	} else {
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin), touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u);
+		touch_wr(st.gpio, cfg, touch_rd(st.gpio, cfg) | 0x200u);
+	}
+}
+
+static bool
+bb_in(unsigned pin)
+{
+	return touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u;
+}
+
+static bool
+bb_clock_high(void)
+{
+	bb_set(TOUCH_PIN_SCL, true);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (bb_in(TOUCH_PIN_SCL)) {
+			delay(BB_HALF_US);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+bb_start(void)
+{
+	/* (Repeated) START: SDA falls while SCL is high. */
+	bb_set(TOUCH_PIN_SDA, true);
+	delay(BB_HALF_US);
+	if (!bb_clock_high() || !bb_in(TOUCH_PIN_SDA)) {
+		return false;
+	}
+	bb_set(TOUCH_PIN_SDA, false);
+	delay(BB_HALF_US);
+	bb_set(TOUCH_PIN_SCL, false);
+	delay(BB_HALF_US);
+	return true;
+}
+
+static void
+bb_stop(void)
+{
+	bb_set(TOUCH_PIN_SDA, false);
+	delay(BB_HALF_US);
+	(void)bb_clock_high();
+	bb_set(TOUCH_PIN_SDA, true);
+	delay(BB_HALF_US);
+}
+
+static int
+bb_put(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; --bit) {
+		bb_set(TOUCH_PIN_SDA, (byte >> bit) & 1u);
+		delay(BB_HALF_US);
+		if (!bb_clock_high()) {
+			return ETIMEDOUT;
+		}
+		bb_set(TOUCH_PIN_SCL, false);
+	}
+	bb_set(TOUCH_PIN_SDA, true);            /* release for ACK */
+	delay(BB_HALF_US);
+	if (!bb_clock_high()) {
+		return ETIMEDOUT;
+	}
+	bool nack = bb_in(TOUCH_PIN_SDA);
+	bb_set(TOUCH_PIN_SCL, false);
+	delay(BB_HALF_US);
+	return nack ? ENXIO : 0;
+}
+
+static int
+bb_get(uint8_t *byte, bool ack)
+{
+	uint8_t v = 0;
+	bb_set(TOUCH_PIN_SDA, true);
+	for (int bit = 7; bit >= 0; --bit) {
+		delay(BB_HALF_US);
+		if (!bb_clock_high()) {
+			return ETIMEDOUT;
+		}
+		v |= (uint8_t)((bb_in(TOUCH_PIN_SDA) ? 1u : 0u) << bit);
+		bb_set(TOUCH_PIN_SCL, false);
+	}
+	bb_set(TOUCH_PIN_SDA, !ack);
+	delay(BB_HALF_US);
+	if (!bb_clock_high()) {
+		return ETIMEDOUT;
+	}
+	bb_set(TOUCH_PIN_SCL, false);
+	bb_set(TOUCH_PIN_SDA, true);
+	*byte = v;
+	return 0;
+}
+
+/* Same contract as touch_msg_run: one write or one read message; a write
+ * with stretch keeps the bus (no STOP) for the following read's START. */
+static int
+bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nr > TOUCH_RX_MAX || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	int err = bb_start() ? 0 : ETIMEDOUT;
+	bb_held = false;
+	if (!err) {
+		err = bb_put((uint8_t)((addr << 1) | (nr ? 1u : 0u)));
+	}
+	for (unsigned i = 0; !err && i < nt; ++i) {
+		err = bb_put(tx[i]);
+		st.sent = i + 1;
+	}
+	for (unsigned i = 0; !err && i < nr; ++i) {
+		err = bb_get(&rx[i], i + 1 < nr);
+		st.got = i + 1;
+	}
+	if (!err && stretch) {
+		bb_held = true;
+		return 0;
+	}
+	bb_stop();
+	if (err == ETIMEDOUT) {
+		printf("SWEET TOUCH: I2C bus stuck (sda=%d scl=%d)\n",
+		    bb_in(TOUCH_PIN_SDA), bb_in(TOUCH_PIN_SCL));
+	}
+	return err;
+}
+
+static inline uint32_t gsi_rd(uint32_t off) { return touch_rd(gsi.regs, off); }
+static inline void gsi_wr(uint32_t off, uint32_t v) { touch_wr(gsi.regs, off, v); }
+
+static uint64_t
+gsi_ring_pa(unsigned ch)
+{
+	return gsi.pa + (ch ? GPI_RX_RING : GPI_TX_RING);
+}
+
+static unsigned
+gsi_state(uint32_t cntxt)
+{
+	return (gsi_rd(cntxt + CX_CONFIG) >> 20) & 0xfu;
+}
+
+static bool
+gsi_cmd(uint32_t reg, uint32_t cmd, uint32_t cntxt, unsigned want)
+{
+	gsi_wr(reg, cmd);
+	for (unsigned i = 0; i < 250; ++i) {
+		if (gsi_state(cntxt) == want) {
+			gsi_wr(GPI_SRC_CH_IRQ_CLR(gsi.n), 3u);
+			gsi_wr(GPI_SRC_EV_IRQ_CLR(gsi.n), 1u);
+			return true;
+		}
+		delay(1000);
+	}
+	printf("SWEET TOUCH: GPI cmd %#x to %#x: state %u, wanted %u (glob=%#x gpii=%#x err=%#x)\n",
+	    cmd, reg, gsi_state(cntxt), want, gsi_rd(GPI_GLOB_STTS(gsi.n)),
+	    gsi_rd(GPI_GPII_STTS(gsi.n)), gsi_rd(GPI_ERROR_LOG(gsi.n)));
+	return false;
+}
+
+static void
+gsi_ch_program(unsigned ch)
+{
+	uint32_t cx = GPI_CH_CNTXT(gsi.n, ch);
+	uint64_t pa = gsi_ring_pa(ch);
+	/* el_size 16, event ring 0, direction (TX out = 1, RX in = 0), GPI */
+	gsi_wr(cx + CX_CONFIG, (GPI_EL << 24) | ((ch ? 0u : 1u) << 3) | 2u);
+	gsi_wr(cx + CX_LEN, GPI_CH_N * GPI_EL);
+	gsi_wr(cx + CX_BASE_LO, (uint32_t)pa);
+	gsi_wr(cx + CX_BASE_HI, (uint32_t)(pa >> 32));
+	gsi_wr(GPI_CH_DB(gsi.n, ch) + 4u, (uint32_t)(pa >> 32));
+	gsi_wr(GPI_CH_SCRATCH(gsi.n, ch, 0), ((ch ? 0u : 1u) << 16) | (GPI_PROTO_I2C << 4) | GPI_SEID);
+	gsi_wr(GPI_CH_SCRATCH(gsi.n, ch, 1), 0);
+	gsi_wr(GPI_CH_SCRATCH(gsi.n, ch, 2), 0);
+	gsi_wr(GPI_CH_SCRATCH(gsi.n, ch, 3), 0);
+	gsi_wr(GPI_CH_QOS(gsi.n, ch), 1);
+	gsi.wp[ch] = 0;
+}
+
+static bool
+gsi_ch_start(unsigned ch)
+{
+	return gsi_cmd(GPI_CH_CMD(gsi.n), (GPI_CMD_START << 24) | ch, GPI_CH_CNTXT(gsi.n, ch), 2u);
+}
+
+static void
+gsi_sync(void)
+{
+	flush_dcache64((addr64_t)gsi.pa, GPI_MEM, TRUE);
+}
+
+/* Consume every event the hardware wrote; hand them back to the ring. */
+static void
+gsi_ev_drain(void (*fn)(const uint32_t *ev))
+{
+	uint32_t rp = gsi_rd(GPI_EV_CNTXT(gsi.n) + CX_RP_LO);
+	uint32_t base = (uint32_t)(gsi.pa + GPI_EV_RING);
+	unsigned hw = (rp - base) / GPI_EL;
+	if (rp < base || hw >= GPI_EV_N) {
+		return;
+	}
+	if (hw == gsi.ev_rp) {
+		return;
+	}
+	gsi_sync();
+	while (gsi.ev_rp != hw) {
+		const uint32_t *ev = (const uint32_t *)(gsi.mem + GPI_EV_RING + gsi.ev_rp * GPI_EL);
+		if (fn) {
+			fn(ev);
+		}
+		gsi.ev_rp = (gsi.ev_rp + 1u) % GPI_EV_N;
+	}
+	/* Write pointer one element behind the read pointer: the whole ring
+	 * except one slot is available to the hardware again. */
+	unsigned wp = (gsi.ev_rp + GPI_EV_N - 1u) % GPI_EV_N;
+	gsi_wr(GPI_EV_DB(gsi.n), base + wp * GPI_EL);
+	gsi_wr(GPI_IEOB_CLR(gsi.n), 1u);
+}
+
+static bool
+gsi_reset_channels(void)
+{
+	for (unsigned ch = 0; ch < 2; ++ch) {
+		(void)gsi_cmd(GPI_CH_CMD(gsi.n), (GPI_CMD_STOP << 24) | ch, GPI_CH_CNTXT(gsi.n, ch), 3u);
+	}
+	for (unsigned ch = 0; ch < 2; ++ch) {
+		if (!gsi_cmd(GPI_CH_CMD(gsi.n), (GPI_CMD_RESET << 24) | ch, GPI_CH_CNTXT(gsi.n, ch), 1u)) {
+			return false;
+		}
+		gsi_ch_program(ch);
+	}
+	gsi_ev_drain(NULL); /* stale events of the aborted transfer */
+	for (unsigned ch = 0; ch < 2; ++ch) {
+		if (!gsi_ch_start(ch)) {
+			return false;
+		}
+	}
+	gsi.cfg_sent = false;
+	return true;
+}
+
+static bool
+touch_gsi_init(void)
+{
+	GSI_STEP("GPI step: map %#x\n", GPI_PA);
+	gsi.regs = ml_io_map(GPI_PA, GPI_SIZE);
+	if (!gsi.regs) {
+		printf("SWEET TOUCH: GPI mapping failed\n");
+		return false;
+	}
+	/* Only GPIIs given to HLOS: the others may be access-protected. */
+	gsi.n = GPI_MAX_GPII;
+	for (unsigned n = 0; n < GPI_MAX_GPII; ++n) {
+		if (!(GPI_GPII_MASK & (1u << n))) {
+			continue;
+		}
+		GSI_STEP("GPI step: read GPII %u contexts\n", n);
+		unsigned c0 = (touch_rd(gsi.regs, GPI_CH_CNTXT(n, 0)) >> 20) & 0xfu;
+		unsigned c1 = (touch_rd(gsi.regs, GPI_CH_CNTXT(n, 1)) >> 20) & 0xfu;
+		unsigned ev = (touch_rd(gsi.regs, GPI_EV_CNTXT(n)) >> 20) & 0xfu;
+		printf("SWEET TOUCH: GPII %u ch0=%u ch1=%u ev=%u\n", n, c0, c1, ev);
+		if (gsi.n == GPI_MAX_GPII && !c0 && !c1 && !ev) {
+			gsi.n = n;
+		}
+	}
+	if (gsi.n == GPI_MAX_GPII) {
+		printf("SWEET TOUCH: no free GPII\n");
+		return false;
+	}
+	if (kmem_alloc_contig(kernel_map, &gsi.mem, GPI_MEM, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET TOUCH: no contiguous memory for GPI rings\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)gsi.mem);
+	if (!pn) {
+		return false;
+	}
+	gsi.pa = ptoa_64(pn);
+	gsi_sync();
+
+	GSI_STEP("GPI step: SE to GSI mode\n");
+	/* SE side: GSI mode (geni_se_select_gsi_mode). */
+	touch_wr(st.se, 0xe1c, 0);                                      /* SE_IRQ_EN */
+	touch_wr(st.se, 0x644, touch_rd(st.se, 0x644) & ~1u);           /* S_IRQ_EN: no CMD_DONE */
+	touch_wr(st.se, 0x614, touch_rd(st.se, 0x614) & ~0x4c000001u);  /* M_IRQ_EN: no DONE/WM/LAST */
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, 0xc44, 0xffffffffu);                            /* DMA TX IRQ clear */
+	touch_wr(st.se, 0xd44, 0xffffffffu);                            /* DMA RX IRQ clear */
+	touch_wr(st.se, SE_DMA, touch_rd(st.se, SE_DMA) | 1u);          /* GENI_DMA_MODE_EN */
+	touch_wr(st.se, 0xe18, touch_rd(st.se, 0xe18) | 0xfu);          /* GSI events */
+
+	/* GPII interrupt setup as Linux (no GIC line is enabled here: polled). */
+	uint32_t n = gsi.n;
+	GSI_STEP("GPI step: GPII %u interrupt registers\n", n);
+	gsi_wr(GPI_TYPE_IRQ_MSK(n), 0x4f);
+	gsi_wr(GPI_SRC_IEOB_MSK(n), 1);
+	gsi_wr(GPI_SRC_CH_IRQ_MSK(n), 3);
+	gsi_wr(GPI_SRC_EV_IRQ_MSK(n), 1);
+	gsi_wr(GPI_GLOB_EN(n), 1);
+	gsi_wr(GPI_GPII_EN(n), 0xf);
+	gsi_wr(GPI_MSI_LSB(n), 0);
+	gsi_wr(GPI_MSI_MSB(n), 0);
+	gsi_wr(GPI_SCRATCH0(n), 0);
+	gsi_wr(GPI_SCRATCH1(n), 0);
+	gsi_wr(GPI_INTSET(n), 1);
+	gsi_wr(GPI_ERROR_LOG(n), 0);
+
+	/* Event ring. */
+	uint32_t ev = GPI_EV_CNTXT(n);
+	uint64_t evpa = gsi.pa + GPI_EV_RING;
+	GSI_STEP("GPI step: event ring allocate\n");
+	if (!gsi_cmd(GPI_EV_CMD(n), (GPI_CMD_ALLOCATE << 24), ev, 1u)) {
+		return false;
+	}
+	gsi_wr(ev + CX_CONFIG, (GPI_EL << 24) | (1u << 16) | 2u);
+	gsi_wr(ev + CX_LEN, GPI_EV_N * GPI_EL);
+	gsi_wr(ev + CX_BASE_LO, (uint32_t)evpa);
+	gsi_wr(ev + CX_BASE_HI, (uint32_t)(evpa >> 32));
+	gsi_wr(GPI_EV_DB(n) + 4u, (uint32_t)(evpa >> 32));
+	gsi_wr(ev + CX_INT_MOD, 0);
+	gsi_wr(ev + CX_MSI_LO, 0);
+	gsi_wr(ev + CX_MSI_HI, 0);
+	gsi_wr(ev + CX_RPUPD_LO, 0);
+	gsi_wr(ev + CX_RPUPD_HI, 0);
+	gsi.ev_rp = 0;
+	gsi_wr(GPI_EV_DB(n), (uint32_t)evpa + (GPI_EV_N - 1u) * GPI_EL);
+
+	/* Channels. */
+	GSI_STEP("GPI step: channels allocate/start\n");
+	for (unsigned ch = 0; ch < 2; ++ch) {
+		if (!gsi_cmd(GPI_CH_CMD(n), (GPI_CMD_ALLOCATE << 24) | ch, GPI_CH_CNTXT(n, ch), 1u)) {
+			return false;
+		}
+		gsi_ch_program(ch);
+	}
+	for (unsigned ch = 0; ch < 2; ++ch) {
+		if (!gsi_ch_start(ch)) {
+			return false;
+		}
+	}
+	gsi.on = true;
+	printf("SWEET TOUCH: GSI mode: GPII %u started, rings at %#llx\n", n, (unsigned long long)gsi.pa);
+	return true;
+}
+
+static void
+gsi_put(unsigned ch, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(gsi.mem + (ch ? GPI_RX_RING : GPI_TX_RING) +
+	    gsi.wp[ch] * GPI_EL);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	gsi.wp[ch] = (gsi.wp[ch] + 1u) % GPI_CH_N;
+}
+
+static struct {
+	bool done;
+	int err;
+	unsigned want_ch;
+	uint32_t status;
+} gsi_x;
+
+static void
+gsi_event(const uint32_t *ev)
+{
+	unsigned type = (ev[3] >> 16) & 0xffu, chid = ev[3] >> 24;
+	if (st.probing) {
+		printf("SWEET TOUCH: GPI event %08x %08x %08x %08x\n", ev[0], ev[1], ev[2], ev[3]);
+	}
+	if (type == 0x22u) {            /* transfer completion */
+		unsigned code = ev[2] >> 24;
+		uint32_t status = ev[3] & 0xffffu;
+		gsi_x.status = status;
+		if (code == 16u) {      /* unexpected error: GP_IRQ bits << 5 */
+			gsi_x.err = (status & (1u << 6)) ? ENXIO : EIO;
+			gsi_x.done = true;
+		} else if (code == 2u && chid == gsi_x.want_ch) {
+			gsi_x.done = true;
+		}
+	} else if (type == 0x31u) {     /* QUP notify: M_GP_IRQ_1 (bit 10) is NACK */
+		gsi_x.status = ev[0];
+		gsi_x.err = (ev[0] & (1u << 10)) ? ENXIO : EIO;
+		gsi_x.done = true;
+	}
+}
+
+static int
+touch_gsi_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (!gsi.on || st.dead || nt > 32 || nr > TOUCH_RX_MAX || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	unsigned tx_first = gsi.wp[0], rx_first = gsi.wp[1];
+	(void)tx_first;
+	(void)rx_first;
+	if (!gsi.cfg_sent) {
+		gsi_put(0, (3u << 24) | (GSI_T_CYCLE << 16) | (GSI_T_HIGH << 8) | GSI_T_LOW,
+		    0, GSI_CLK_DIV, (2u << 20) | (2u << 16) | 1u /* chain */);
+		gsi.cfg_sent = true;
+	}
+	uint32_t go0 = ((stretch ? 4u : 0u) << 24) | ((uint32_t)addr << 8) | (nr ? 2u : 1u);
+	if (nr) {
+		memset((void *)(gsi.mem + GPI_RX_BUF), 0, nr);
+		gsi_put(0, go0, 0, nr, (2u << 20) | (1u << 11) | (1u << 8));   /* link RX, IEOB */
+		uint64_t pa = gsi.pa + GPI_RX_BUF;
+		gsi_put(1, (uint32_t)pa, (uint32_t)(pa >> 32), nr, (1u << 20) | (1u << 9)); /* IEOT */
+	} else {
+		memcpy((void *)(gsi.mem + GPI_TX_BUF), tx, nt);
+		gsi_put(0, go0, 0, 0, (2u << 20) | 1u);                          /* chain */
+		uint64_t pa = gsi.pa + GPI_TX_BUF;
+		gsi_put(0, (uint32_t)pa, (uint32_t)(pa >> 32), nt, (1u << 20) | (1u << 9)); /* IEOT */
+	}
+	gsi_x.done = false;
+	gsi_x.err = 0;
+	gsi_x.status = 0;
+	gsi_x.want_ch = nr ? 1u : 0u;
+	if (gsi.xfers++ < 2) {
+		GSI_STEP("GPI step: first transfers (DMA from %#llx)\n", (unsigned long long)gsi.pa);
+	}
+	gsi_sync();
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (nr) {
+		gsi_wr(GPI_CH_DB(gsi.n, 1), (uint32_t)(gsi_ring_pa(1) + gsi.wp[1] * GPI_EL));
+	}
+	gsi_wr(GPI_CH_DB(gsi.n, 0), (uint32_t)(gsi_ring_pa(0) + gsi.wp[0] * GPI_EL));
+	for (unsigned i = 0; i < 100 && !gsi_x.done; ++i) {
+		gsi_ev_drain(gsi_event);
+		if (!gsi_x.done) {
+			delay(1000);
+		}
+	}
+	st.irq_last = gsi_x.status;
+	st.irq_status |= gsi_x.status;
+	if (!gsi_x.done) {
+		printf("SWEET TOUCH: GPI timeout addr=%#x %s: ch0 st=%u rp=%#x ch1 st=%u rp=%#x ev rp=%#x glob=%#x gpii=%#x err=%#x se-status=%#x\n",
+		    addr, nr ? "read" : "write",
+		    gsi_state(GPI_CH_CNTXT(gsi.n, 0)), gsi_rd(GPI_CH_CNTXT(gsi.n, 0) + CX_RP_LO),
+		    gsi_state(GPI_CH_CNTXT(gsi.n, 1)), gsi_rd(GPI_CH_CNTXT(gsi.n, 1) + CX_RP_LO),
+		    gsi_rd(GPI_EV_CNTXT(gsi.n) + CX_RP_LO), gsi_rd(GPI_GLOB_STTS(gsi.n)),
+		    gsi_rd(GPI_GPII_STTS(gsi.n)), gsi_rd(GPI_ERROR_LOG(gsi.n)),
+		    touch_rd(st.se, SE_STATUS));
+		gsi_x.err = ETIMEDOUT;
+	}
+	if (gsi_x.err) {
+		if (!gsi_reset_channels()) {
+			printf("SWEET TOUCH: GPI channel reset failed; stopping\n");
+			st.dead = true;
+		}
+		return gsi_x.err;
+	}
+	if (nr) {
+		gsi_sync();
+		memcpy(rx, (const void *)(gsi.mem + GPI_RX_BUF), nr);
+		st.got = nr;
+	} else {
+		st.sent = nt;
+	}
+	return 0;
+}
