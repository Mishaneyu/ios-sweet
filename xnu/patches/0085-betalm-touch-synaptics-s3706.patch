+	touch_gpio(TOUCH_PIN_IRQ, 0, 3, 0, false, false);   /* 2 mA, pull-up */
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 2, true, false);  /* 6 mA, pull-up */
+	touch_gpio(TOUCH_PIN_VDD, 0, 0, 0, true, true);
+	touch_gpio(TOUCH_PIN_VCL, 0, 0, 0, true, true);
