+		/* Plain GPIOs, released, weak pull-ups next to the board's. */
+		touch_gpio(TOUCH_PIN_SDA, 0, 3, 0, false, false);
+		touch_gpio(TOUCH_PIN_SCL, 0, 3, 0, false, false);
+		printf("SWEET TOUCH: bus idle sda=%d scl=%d\n", bb_in(TOUCH_PIN_SDA), bb_in(TOUCH_PIN_SCL));
+	} else {
+		/* qupv3_se17_i2c_active: function qup17, 2 mA, bias-disable */
+		touch_gpio(TOUCH_PIN_SDA, TOUCH_I2C_FUNC, 0, 0, false, false);
+		touch_gpio(TOUCH_PIN_SCL, TOUCH_I2C_FUNC, 0, 0, false, false);
+	}
+	touch_gpio(TOUCH_PIN_RESET, 0, 3, 2, true, true);
+	touch_wait(150); /* DT hw_reset_delay = 100 ms */
+	st.probing = true;
+	uint8_t pdt = 0, siw = 0;
+	int se = rmi_read(RMI_PDT_START + 5u, &pdt, 1); /* page 0 PDT: function id */
+	int we = touch_read(0x28, 0x00, false, &siw, 1);
+	st.probing = false;
+	printf("SWEET TOUCH: probe synaptics@0x20 err=%d first-fn=%#x, siw@0x28 err=%d\n",
+	    se, pdt, we);
+	if (se || st.dead) {
+		if (!we) {
+			printf("SWEET TOUCH: this G8S has the SiW SW42000 panel touch; not supported yet\n");
+		}
+		return false;
+	}
+	if (!rmi_setup()) {
+		return false;
+	}
+	st.kind = TOUCH_SYNAPTICS;
+	printf("SWEET TOUCH: selected Synaptics S3706, %ux%u, poll=10ms irq-hint=%d\n",
+	    SWEET_PANEL_W, SWEET_PANEL_H, st.irq_hint);
+	return true;
+}
