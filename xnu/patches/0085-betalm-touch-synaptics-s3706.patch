+/*
+ * GSI (GPI DMA) I2C for SM8150. LG's SE17 runs QUP firmware with the FIFO
+ * interface disabled (GENI_IF_DISABLE_RO bit 0), so every transfer goes
+ * through the QUP's GPI DMA engine, as LG's Linux does (i2c-qcom-geni.c
+ * GSI_ONLY + drivers/dma/qcom/gpi.c). Polled, no interrupts:
+ *   - one GPII (first free one HLOS may use, qcom,gpii-mask 0xfa), TX
+ *     channel 0 and RX channel 1, one event ring;
+ *   - write: [CONFIG0] GO(write) DMA(tx buf, IEOT) on TX, wait TX EOT;
+ *   - read:  [CONFIG0] GO(read, link-rx, IEOB) on TX + DMA(rx buf, IEOT)
+ *     on RX, wait RX EOT;
+ *   - errors (NACK...) arrive as a completion code 16 or a QUP notify
+ *     event; the channels are then stopped, reset, reprogrammed, started,
+ *     and the next transfer resends CONFIG0 (Linux terminate_all).
+ * Rings and buffers share one physically contiguous page, cleaned and
+ * invalidated by physical address around each transfer. Addresses are
+ * physical: the GPI stream (SID 0x7b6) is not attached to any SMMU context
+ * here, so it relies on bypass, like UFS does.
+ */
+#define GPI_PA          0x00c00000u
+#define GPI_SIZE        0x60000u
+#define GPI_GPII_MASK   0xfau
+#define GPI_MAX_GPII    13u
+#define GPI_SEID        0u      /* SE17 = QUP wrapper 2, SE 0 */
+#define GPI_PROTO_I2C   3u
+#define GPI_EL          16u
+#define GPI_CH_N        16u     /* TREs per transfer ring (256 B) */
+#define GPI_EV_N        64u     /* events (1 KiB) */
+#define GPI_TX_RING     0x000u
+#define GPI_RX_RING     0x100u
+#define GPI_EV_RING     0x400u
+#define GPI_TX_BUF      0x800u
+#define GPI_RX_BUF      0x900u
+#define GPI_MEM         0x1000u
+
+#define GPI_CH_CNTXT(n, k)      (0x20000u + 0x4000u * (n) + 0x80u * (k))
+#define GPI_EV_CNTXT(n)         (0x21000u + 0x4000u * (n))
+#define GPI_CH_DB(n, k)         (0x22000u + 0x4000u * (n) + 0x8u * (k))
+#define GPI_EV_DB(n)            (0x22100u + 0x4000u * (n))
+#define GPI_CH_CMD(n)           (0x23008u + 0x4000u * (n))
+#define GPI_EV_CMD(n)           (0x23010u + 0x4000u * (n))
+#define GPI_TYPE_IRQ_MSK(n)     (0x23088u + 0x4000u * (n))
+#define GPI_SRC_CH_IRQ_MSK(n)   (0x23098u + 0x4000u * (n))
+#define GPI_SRC_EV_IRQ_MSK(n)   (0x2309cu + 0x4000u * (n))
+#define GPI_SRC_IEOB_MSK(n)     (0x230b8u + 0x4000u * (n))
+#define GPI_SRC_CH_IRQ_CLR(n)   (0x230a0u + 0x4000u * (n))
+#define GPI_SRC_EV_IRQ_CLR(n)   (0x230a4u + 0x4000u * (n))
+#define GPI_IEOB_CLR(n)         (0x230c0u + 0x4000u * (n))
+#define GPI_GLOB_STTS(n)        (0x23100u + 0x4000u * (n))
+#define GPI_GLOB_EN(n)          (0x23108u + 0x4000u * (n))
+#define GPI_GPII_STTS(n)        (0x23118u + 0x4000u * (n))
+#define GPI_GPII_EN(n)          (0x23120u + 0x4000u * (n))
+#define GPI_INTSET(n)           (0x23180u + 0x4000u * (n))
+#define GPI_MSI_LSB(n)          (0x23188u + 0x4000u * (n))
+#define GPI_MSI_MSB(n)          (0x2318cu + 0x4000u * (n))
+#define GPI_SCRATCH0(n)         (0x23400u + 0x4000u * (n))
+#define GPI_SCRATCH1(n)         (0x23404u + 0x4000u * (n))
+#define GPI_ERROR_LOG(n)        (0x23200u + 0x4000u * (n))
+#define GPI_CH_SCRATCH(n, k, i) (0x20060u + 0x4000u * (n) + 0x80u * (k) + 4u * (i))
+#define GPI_CH_QOS(n, k)        (0x2005cu + 0x4000u * (n) + 0x80u * (k))
+
+/* Context registers (channel and event ring). */
+#define CX_CONFIG       0x00u
+#define CX_LEN          0x04u
+#define CX_BASE_LO      0x08u
+#define CX_BASE_HI      0x0cu
+#define CX_RP_LO        0x10u
+#define CX_INT_MOD      0x20u
+#define CX_MSI_LO       0x28u
+#define CX_MSI_HI       0x2cu
+#define CX_RPUPD_LO     0x30u
+#define CX_RPUPD_HI     0x34u
+
+#define GPI_CMD_ALLOCATE 0u
+#define GPI_CMD_START   1u
+#define GPI_CMD_STOP    2u
+#define GPI_CMD_RESET   9u
+
+/* 100 kHz from 19.2 MHz: Linux geni_i2c_clk_map {100k, 7, 10, 11, 26}. */
+#define GSI_CLK_DIV     7u
+#define GSI_T_HIGH      10u
+#define GSI_T_LOW       11u
+#define GSI_T_CYCLE     26u
+
+static struct {
+	vm_offset_t regs, mem;
+	uint64_t pa;
+	unsigned n;                     /* GPII */
+	unsigned wp[2], ev_rp;          /* ring indices */
+	bool on, cfg_sent;
