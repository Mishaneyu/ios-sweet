+	    touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_PIN_IRQ)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_PIN_VDD)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(TOUCH_PIN_VCL)));
