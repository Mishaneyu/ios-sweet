+#if defined(SWEET_BOARD_BETALM)
+/*
+ * Synaptics RMI4 over I2C (S3706 on the LG G8S). The register space is
+ * paged: register 0xff selects the page, then one-byte addresses. Functions
+ * are found through the Page Description Table at 0xe9 downwards in each
+ * page. F01 is device control, F12 the 2D sensor; F12's data registers are
+ * described by register descriptors (query 7-9) whose layout follows
+ * Linux drivers/input/rmi4/rmi_driver.c (rmi_read_register_desc). Touch is
+ * polled: the F12 data block is read every 10 ms and F01's interrupt status
+ * is read to release ATTN. Only writes: page select, F01 control 0 (normal
+ * mode, configured, no sleep) and F01 interrupt enable.
+ */
+#define RMI_ADDR         0x20u
+#define RMI_PAGE_REG     0xffu
+#define RMI_PDT_START    0xe9u
+#define RMI_PDT_END      0x0au
+#define RMI_PAGES        5u
+
+static struct {
+	int page;
+	uint16_t f01_query, f01_ctrl, f01_data;
+	uint16_t f12_query, f12_ctrl, f12_data;
+	unsigned irq_count;
+	unsigned data_len, data1_off, data1_len, fingers;
+	int flip; /* sweettouchflip: bit0 mirror x, bit1 mirror y, bit2 swap */
+} rmi = { .page = -1 };
+
+static int
+rmi_set_page(unsigned page)
+{
+	if (rmi.page == (int)page) {
+		return 0;
+	}
+	const uint8_t w[2] = {RMI_PAGE_REG, (uint8_t)page};
+	int err = touch_msg(RMI_ADDR, w, 2, NULL, 0, false);
+	rmi.page = err ? -1 : (int)page;
+	return err;
+}
+
+static int
+rmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	int err = rmi_set_page(addr >> 8);
+	if (err) {
+		return err;
+	}
+	return touch_read(RMI_ADDR, addr & 0xffu, false, buf, len);
+}
+
+static int
+rmi_write(uint16_t addr, uint8_t val)
+{
+	int err = rmi_set_page(addr >> 8);
+	if (err) {
+		return err;
+	}
+	const uint8_t w[2] = {(uint8_t)addr, val};
+	return touch_msg(RMI_ADDR, w, 2, NULL, 0, false);
+}
+
+static bool
+rmi_scan_pdt(void)
+{
+	bool any = false;
+	for (unsigned page = 0; page < RMI_PAGES; ++page) {
+		bool page_has = false;
+		for (unsigned a = RMI_PDT_START; a >= RMI_PDT_END; a -= 6u) {
+			uint8_t e[6];
+			uint16_t at = (uint16_t)((page << 8) | a);
+			if (rmi_read(at, e, sizeof(e))) {
+				return any;
+			}
+			if (e[5] == 0 || e[5] == 0xff) {
+				break; /* end of this page's table */
+			}
+			page_has = any = true;
+			uint16_t base = (uint16_t)(page << 8);
+			printf("SWEET TOUCH: rmi F%02x page %u query=%#x ctrl=%#x data=%#x irqs=%u ver=%u\n",
+			    e[5], page, base | e[0], base | e[2], base | e[3], e[4] & 7u, (e[4] >> 5) & 3u);
+			if (e[5] == 0x01) {
+				rmi.f01_query = base | e[0];
+				rmi.f01_ctrl = base | e[2];
+				rmi.f01_data = base | e[3];
+			} else if (e[5] == 0x12) {
+				rmi.f12_query = base | e[0];
+				rmi.f12_ctrl = base | e[2];
+				rmi.f12_data = base | e[3];
+			}
+			rmi.irq_count += e[4] & 7u;
+		}
+		if (!page_has && page > 0) {
+			break;
+		}
+	}
+	return any;
+}
+
+/*
+ * Register descriptor at query address 'addr' (presence size, presence map,
+ * structure). Returns the byte offset and size of register 'want' within the
+ * function's data block, and the total size of all present registers.
+ */
+static bool
+rmi_reg_desc(uint16_t addr, unsigned want, unsigned *off, unsigned *len,
+    unsigned *subpackets, unsigned *total)
+{
+	uint8_t psize = 0, pres[36], sbuf[128];
+	*off = *len = *subpackets = *total = 0;
+	if (rmi_read(addr, &psize, 1) || psize == 0 || psize > sizeof(pres)) {
+		return false;
+	}
+	if (rmi_read(addr + 1u, pres, psize)) {
+		return false;
+	}
+	unsigned map_start = 1, ssize = pres[0];
+	if (ssize == 0) {
+		if (psize < 3) {
+			return false;
+		}
+		ssize = pres[1] | ((unsigned)pres[2] << 8);
+		map_start = 3;
+	}
+	if (ssize == 0 || ssize > sizeof(sbuf) || rmi_read(addr + 2u, sbuf, ssize)) {
+		printf("SWEET TOUCH: rmi descriptor %#x struct size %u unsupported\n", addr, ssize);
+		return false;
+	}
+	unsigned at = 0;
+	bool found = false;
+	for (unsigned i = map_start; i < psize; ++i) {
+		for (unsigned b = 0; b < 8; ++b) {
+			if (!(pres[i] & (1u << b))) {
+				continue;
+			}
+			unsigned reg = (i - map_start) * 8u + b;
+			if (at >= ssize) {
+				return false;
+			}
+			unsigned size = sbuf[at++];
+			if (size == 0 && at + 2 <= ssize) {
+				size = sbuf[at] | ((unsigned)sbuf[at + 1] << 8);
+				at += 2;
+			}
+			if (size == 0 && at + 4 <= ssize) {
+				size = sbuf[at] | ((unsigned)sbuf[at + 1] << 8) |
+				    ((unsigned)sbuf[at + 2] << 16) | ((unsigned)sbuf[at + 3] << 24);
+				at += 4;
+			}
+			unsigned subs = 0;
+			do {
+				if (at >= ssize) {
+					return false;
+				}
+				subs += __builtin_popcount(sbuf[at] & 0x7fu);
+			} while (sbuf[at++] & 0x80u);
+			if (reg == want) {
+				*off = *total;
+				*len = size;
+				*subpackets = subs;
+				found = true;
+			}
+			*total += size;
+		}
+	}
+	return found;
+}
+
+static bool
+rmi_setup(void)
+{
+	rmi.page = -1;
+	(void)PE_parse_boot_argn("sweettouchflip", &rmi.flip, sizeof(rmi.flip));
+	if (!rmi_scan_pdt() || !rmi.f01_ctrl || !rmi.f12_data) {
+		printf("SWEET TOUCH: rmi PDT has no F01/F12 (bootloader mode?)\n");
+		return false;
+	}
+	uint8_t status = 0, ctrl0 = 0, prod[11] = {0};
+	(void)rmi_read(rmi.f01_data, &status, 1);
+	(void)rmi_read(rmi.f01_query + 11u, prod, 10);
+	printf("SWEET TOUCH: rmi F01 status=%#x product=\"%s\"\n", status, (const char *)prod);
+	if (status & 0x40u) {
+		printf("SWEET TOUCH: rmi device is in its bootloader; no firmware to report touches\n");
+		return false;
+	}
+	/* F01 control 0: sleep mode normal (bits 1:0 = 0), nosleep (bit 2),
+	 * configured (bit 7). Then enable every function's interrupt source. */
+	if (!rmi_read(rmi.f01_ctrl, &ctrl0, 1)) {
+		(void)rmi_write(rmi.f01_ctrl, (uint8_t)((ctrl0 & ~3u) | 0x84u));
+	}
+	(void)rmi_write(rmi.f01_ctrl + 1u, 0xff);
+	unsigned subs = 0;
+	if (!rmi_reg_desc(rmi.f12_query + 7u, 1, &rmi.data1_off, &rmi.data1_len,
+	    &subs, &rmi.data_len)) {
+		printf("SWEET TOUCH: rmi F12 data descriptor has no data1; assuming data1 at 0\n");
+		rmi.data1_off = 0;
+		rmi.data1_len = TOUCH_MAX * 8u;
+		subs = TOUCH_MAX;
+	}
+	rmi.fingers = subs ? subs : rmi.data1_len / 8u;
+	if (rmi.fingers > TOUCH_MAX) {
+		rmi.fingers = TOUCH_MAX;
+	}
+	if (rmi.data1_off + rmi.fingers * 8u > TOUCH_RX_MAX) {
+		printf("SWEET TOUCH: rmi F12 data1 at %u+%u does not fit one read\n",
+		    rmi.data1_off, rmi.fingers * 8u);
+		return false;
+	}
+	printf("SWEET TOUCH: rmi F12 ctrl0=%#x data block %u bytes, data1 at %u len %u, %u objects, irqs=%u flip=%d\n",
+	    ctrl0, rmi.data_len, rmi.data1_off, rmi.data1_len, rmi.fingers, rmi.irq_count, rmi.flip);
+	return true;
+}
+
+static int
+touch_synaptics(void)
+{
+	uint8_t buf[TOUCH_RX_MAX], irq[2];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	/* Reading F01's interrupt status releases ATTN; the value is not needed. */
+	(void)rmi_read(rmi.f01_data + 1u, irq, (rmi.irq_count + 7u) / 8u ? (rmi.irq_count + 7u) / 8u : 1u);
+	unsigned n = rmi.data1_off + rmi.fingers * 8u;
+	int err = rmi_read(rmi.f12_data, buf, n);
+	if (err) {
+		rmi.page = -1; /* re-select the page after any bus error */
+		return err;
+	}
+	for (unsigned i = 0; i < rmi.fingers; ++i) {
+		const uint8_t *o = buf + rmi.data1_off + 8u * i;
+		/* Object type: 1 finger, 2 stylus, 6 glove, 7 narrow, 0x0d small. */
+		if (o[0] != 1 && o[0] != 2 && o[0] != 6 && o[0] != 7 && o[0] != 0x0d) {
+			continue;
+		}
+		int px = (int)(o[1] | ((unsigned)o[2] << 8));
+		int py = (int)(o[3] | ((unsigned)o[4] << 8));
+		if (rmi.flip & 4) {
+			int t = px; px = py; py = t;
+		}
+		if (rmi.flip & 1) {
+			px = SWEET_PANEL_W - 1 - px;
+		}
+		if (rmi.flip & 2) {
+			py = SWEET_PANEL_H - 1 - py;
+		}
+		if (px < 0 || py < 0 || px >= SWEET_PANEL_W || py >= SWEET_PANEL_H) {
+			continue;
+		}
+		mask |= 1u << i;
+		x[i] = px;
+		y[i] = py;
+	}
+	if (mask && !st.active) {
+		/* Log the first point of each touch to verify orientation. */
+		unsigned i = (unsigned)__builtin_ctz(mask);
+		printf("SWEET TOUCH: down x=%d y=%d\n", x[i], y[i]);
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
