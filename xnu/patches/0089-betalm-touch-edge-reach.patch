 #define SWEET_TOUCH_EDGE_PX 48
+
+/*
+ * Panel coordinate -> presented coordinate. The presented display is
+ * cropped to the panel (offset off on each side), so a plain offset leaves
+ * the outer off pixels unreachable: on the G8S (2248 of 2436 rows) the
+ * bottom 94 rows, where the iPhone X home gesture starts. Within band
+ * pixels of each panel edge, stretch so the panel edge reaches the
+ * display edge; elsewhere it stays exact (what you touch is what you see).
+ */
+static int
+sweet_touch_axis(int v, int panel, int off)
+{
+	const int band = 120;
+	if (off <= 0 || panel < 4 * band) {
+		return v + off;
+	}
+	if (v < band) {
+		return v * (band + off) / band;
+	}
+	if (v >= panel - band) {
+		int d = v - (panel - band);
+		return panel - band + off + d * (band + off) / band;
+	}
+	return v + off;
+}
