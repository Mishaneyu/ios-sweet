+void
+SweetBattery::publishBoard(const struct rmx1931_battery_state &st)
+{
+	fHasBoardGauge = true;
+	setBatteryInstalled(st.present);
+	/* Publish SOC directly as 0..100 of 100 so powerd matches fuel-gauge % exactly. */
+	setCurrentCapacity(st.soc);
+	setMaxCapacity(100);
+	setExternalConnected(st.external_connected);
+	setExternalChargeCapable(st.charge_capable);
+	setIsCharging(st.charging);
+	setAtWarnLevel(!st.external_connected && st.soc <= 20);
+	setAtCriticalLevel(false);
+	setVoltage(st.voltage_mv);
+	setAmperage(st.current_ma);
+	setTimeRemaining(-1);
+	setCycleCount(st.cycle_count);
+	putBool("FullyCharged", st.full);
+	putBool("AppleRawExternalConnected", st.external_connected);
+	putNumber("AppleRawCurrentCapacity", st.rem_mah);
+	putNumber("AppleRawMaxCapacity", st.fcc_mah);
+	putNumber("NominalChargeCapacity", st.fcc_mah);
+	putNumber("DesignCapacity", st.design_mah);
+	putNumber("InstantAmperage", (UInt32)st.current_ma);
+	/* iOS battery convention: centidegrees C (e.g. 28.5 C -> 2850). */
+	putNumber("Temperature", (UInt32)(st.temp_deci_c * 10));
+	putBool("SweetBatteryHardwareSampleValid", true);
+	putBool("SweetBatteryCurrentValid", true);
+	putBool("SweetBatterySOCEstimated", false);
+	putBool("SweetBatteryTemperatureEstimated", false);
+	putBool("SweetBatteryFallback", false);
+	putNumber("SweetBatteryPercent", st.soc);
+
+	if (st.external_connected) {
+		OSDictionary *adapter = OSDictionary::withCapacity(4);
+		if (adapter) {
+			OSNumber *watts = OSNumber::withNumber(15u, 32);
+			OSNumber *curr = OSNumber::withNumber(3000u, 32);
+			OSNumber *volt = OSNumber::withNumber(5000u, 32);
+			if (watts) adapter->setObject("Watts", watts);
+			if (curr) adapter->setObject("Current", curr);
+			if (volt) adapter->setObject("Voltage", volt);
+			adapter->setObject("IsWireless", kOSBooleanFalse);
+			OSSafeReleaseNULL(watts);
+			OSSafeReleaseNULL(curr);
+			OSSafeReleaseNULL(volt);
+			setAdapterInfo(0);
+			const OSSymbol *adSym = OSSymbol::withCString("AdapterDetails");
+			if (adSym) {
+				setPSProperty(adSym, adapter);
+				adSym->release();
+			}
+			adapter->release();
+		}
+	}
+
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {st.soc, 100u, st.voltage_mv, (UInt32)st.current_ma,
+		    st.cycle_count,
+		    (UInt32)((st.present ? kIOBatteryInstalled : 0) |
+		    (st.external_connected ? kIOBatteryChargerConnect : 0) |
+		    (st.charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus();
+	if (fLastMode != 2) {
+		IOLog("SWEET BATTERY: RMX1931 BQ gauge active, %u%% %umV (pack %umV) external=%d charging=%d\n",
+		    st.soc, st.voltage_mv, st.pack_voltage_mv, st.external_connected, st.charging);
+		fLastMode = 2;
+	}
+}
+
+void
+SweetBattery::submitBoardState(const struct rmx1931_battery_state *st)
+{
+	if (fLoop && st) {
+		struct rmx1931_battery_state copy = *st;
+		(void)fLoop->runAction(&SweetBattery::reportAction, this,
+		    &copy, NULL, NULL, NULL);
+	}
+}
+
+IOReturn
+SweetBattery::reportAction(OSObject *owner, void *arg0, void *, void *, void *)
+{
+	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
+	const struct rmx1931_battery_state *st = (const struct rmx1931_battery_state *)arg0;
+	if (!self || !st) {
+		return kIOReturnBadArgument;
+	}
+	self->publishBoard(*st);
+	return kIOReturnSuccess;
+}
