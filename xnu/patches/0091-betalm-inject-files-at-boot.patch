diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 90e68bb..35bac68 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -14579,3 +14579,37 @@ fs_snapshot(__unused proc_t p, struct fs_snapshot_args *uap,
 
 	return error;
 }
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: kernel-path mkdir/symlink/unlink for bsd/dev/sweet_inject.c,
+ * which installs payload files into the root volume before launchd.
+ */
+int sweet_kern_mkdir(const char *path, int mode);
+int sweet_kern_symlink(const char *target, const char *path);
+int sweet_kern_unlink(const char *path);
+
+int
+sweet_kern_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+
+int
+sweet_kern_symlink(const char *target, const char *path)
+{
+	return symlinkat_internal(vfs_context_kernel(), CAST_USER_ADDR_T(target), AT_FDCWD,
+	           CAST_USER_ADDR_T(path), UIO_SYSSPACE);
+}
+
+int
+sweet_kern_unlink(const char *path)
+{
+	return unlinkat_internal(vfs_context_kernel(), AT_FDCWD, NULLVP, CAST_USER_ADDR_T(path),
+	           UIO_SYSSPACE, 0);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
