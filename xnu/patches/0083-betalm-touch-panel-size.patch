--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -368,6 +368,7 @@ protected:
 private:
 	IOLock *fLock;
 	int fLogicalW, fLogicalH, fOffX, fOffY;
+	int fPanelW, fPanelH;    /* touch = panel pixels (boot_args.Video) */
 	bool fDown[SWEET_TOUCH_FINGERS];
 	bool fEdge[SWEET_TOUCH_FINGERS];
 	IOFixed fX[SWEET_TOUCH_FINGERS];
@@ -434,14 +435,29 @@ SweetHIDTouch::start(IOService *provider)
 	}
 	int native = 0;
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
-	fLogicalW = native ? 1080 : 1125;
-	fLogicalH = native ? 2400 : 2436;
-	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	/*
+	 * Touch coordinates are panel pixels. Take the panel size from the
+	 * boot framebuffer the shim detected (1080x2400 on sweet, 1080x2248 on
+	 * betalm), with the same presentation rule as AppleCLCD::start.
+	 */
+	PE_Video video;
+	PE_current_console(&video);
+	fPanelW = video.v_width ? (int)video.v_width : 1080;
+	fPanelH = video.v_height ? (int)video.v_height : 2400;
+	fLogicalW = fPanelW;
+	fLogicalH = fPanelH;
+	if (!native && fPanelW <= 1125 && fPanelH <= 2436) {
+		fLogicalW = 1125;
+		fLogicalH = 2436;
+	}
+	fOffX = (fLogicalW - fPanelW) / 2;
+	fOffY = (fLogicalH - fPanelH) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
-	setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
+	/* sweet 6.67": 151 mm; betalm 6.21" 1080x2248: 142 mm */
+	setProperty("SurfaceHeight", (unsigned long long)((fPanelH < 2300 ? 142 : 151) << 16), 32);
+	IOLog("SWEET HID: touch panel %dx%d presented as %dx%d\n", fPanelW, fPanelH, fLogicalW, fLogicalH);
 	gSweetTouch = this;
 	registerService();
 	IOLog("SWEET HID: touch registered\n");
@@ -458,8 +474,8 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	if (finger < 0 || finger >= SWEET_TOUCH_FINGERS) {
 		return;
 	}
-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+	x = x < 0 ? 0 : (x > fPanelW - 1 ? fPanelW - 1 : x);
+	y = y < 0 ? 0 : (y > fPanelH - 1 ? fPanelH - 1 : y);
 
 	IOLockLock(fLock);
 	bool was = fDown[finger];
@@ -472,8 +488,8 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 		return;
 	}
 	if (!was && down) {
-		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
-		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_PX;
+		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > fPanelW - 1 - SWEET_TOUCH_EDGE_PX ||
+		    y < SWEET_TOUCH_EDGE_PX || y > fPanelH - 1 - SWEET_TOUCH_EDGE_PX;
 	}
 
 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
