+void
+AppleCLCD::refreshBrightness(void)
+{
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	bool direct = false;
+	uint64_t now = mach_absolute_time();
+	IOLockLock(fLock);
+	if (fHasSwap && !fPowerOff) {
