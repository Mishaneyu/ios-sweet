+/*
+ * AppleARMBacklight matching IODeviceTree:/backlight for CoreBrightness / BacklightServices.
+ * Converts linear Q16.16 brightness-nits (D22AP user max = 625 nits = 40960000) into an sRGB
+ * gamma-2.0 perceptual scale via integer square root, driving tear-free Adreno 640 2D dimming.
+ */
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+	IOLock  *fLock;
+	uint32_t fMillinits;
+	uint32_t fRawLevel;
+	uint32_t fLogCount;
+
+	static OSDictionary *makeRange(uint32_t mn, uint32_t mx, uint32_t val);
+	void publishDisplayParams(void);
+	void applyNitsQ16(uint32_t rawQ16);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static uint32_t
+sweet_isqrt32(uint32_t n)
+{
+	uint32_t res = 0;
+	uint32_t bit = 1u << 30;
+	while (bit > n) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (n >= res + bit) {
+			n -= res + bit;
+			res = (res >> 1) + bit;
+		} else {
+			res >>= 1;
+		}
+		bit >>= 2;
+	}
+	return res;
+}
+
+OSDictionary *
+AppleARMBacklight::makeRange(uint32_t mn, uint32_t mx, uint32_t val)
+{
+	OSDictionary *d = OSDictionary::withCapacity(3);
+	if (d == NULL) {
+		return NULL;
+	}
+	OSNumber *nMin = OSNumber::withNumber((uint64_t)mn, 32);
+	OSNumber *nMax = OSNumber::withNumber((uint64_t)mx, 32);
+	OSNumber *nVal = OSNumber::withNumber((uint64_t)val, 32);
+	if (nMin != NULL) {
+		d->setObject("min", nMin);
+		nMin->release();
+	}
+	if (nMax != NULL) {
+		d->setObject("max", nMax);
+		nMax->release();
+	}
+	if (nVal != NULL) {
+		d->setObject("value", nVal);
+		nVal->release();
+	}
+	return d;
+}
+
+void
+AppleARMBacklight::publishDisplayParams(void)
+{
+	OSDictionary *params = OSDictionary::withCapacity(3);
+	if (params == NULL) {
+		return;
+	}
+	OSDictionary *dBri = makeRange(6, 2047, fRawLevel);
+	OSDictionary *dNits = makeRange(2000, 625000, fMillinits);
+	OSDictionary *dAmps = makeRange(0, 100000, 25000);
+	if (dBri != NULL) {
+		params->setObject("brightness", dBri);
+		dBri->release();
+	}
+	if (dNits != NULL) {
+		params->setObject("BrightnessMilliNits", dNits);
+		dNits->release();
+	}
+	if (dAmps != NULL) {
+		params->setObject("BrightnessMicroAmps", dAmps);
+		dAmps->release();
+	}
+	setProperty("IODisplayParameters", params);
+	params->release();
+}
+
+void
+AppleARMBacklight::applyNitsQ16(uint32_t rawQ16)
+{
+	const uint64_t maxQ16 = 625ULL * 65536ULL;
+	uint64_t clamped = rawQ16 > maxQ16 ? maxQ16 : (uint64_t)rawQ16;
+	uint32_t ratioQ16 = (uint32_t)((clamped * 65536ULL) / maxQ16);
+	uint32_t scale256 = sweet_isqrt32(ratioQ16);	/* 0..256 perceptual sRGB scale */
+	if (rawQ16 > 0 && scale256 < 20) {
+		scale256 = 20;				/* ~8% minimum readable floor */
+	}
+	uint32_t alpha = scale256 >= 256 ? 0 : (256u - scale256);
+	if (alpha > 236) {
+		alpha = 236;
+	}
+	fMillinits = (uint32_t)((clamped * 1000ULL) >> 16);
+	if (fMillinits < 2000 && rawQ16 > 0) {
+		fMillinits = 2000;
+	}
+	fRawLevel = (uint32_t)(6u + ((uint64_t)scale256 * 2041ULL) / 256ULL);
+	if (fRawLevel > 2047) {
+		fRawLevel = 2047;
+	}
+	uint32_t prev = sweet_backlight_alpha;
+	sweet_backlight_alpha = alpha;
+	setProperty("brightness-nits", (uint64_t)rawQ16, 32);
+	publishDisplayParams();
+	if (fLogCount < 8) {
+		fLogCount++;
+		IOLog("SWEET BL: nits_q16=%u (%u mNits) -> sRGB %u/256 dim_alpha=%u\n",
+		    rawQ16, fMillinits, scale256, alpha);
+	}
+	if (alpha != prev && gMainFB != NULL) {
+		gMainFB->refreshBrightness();
+	}
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	if (fLock == NULL) {
+		return false;
+	}
+	fMillinits = 625000;
+	fRawLevel = 2047;
+	fLogCount = 0;
+	sweet_backlight_alpha = 0;
+	setProperty("backlight-control", kOSBooleanTrue);
+	setProperty("BuiltIn", kOSBooleanTrue);
+	setProperty("brightness-nits", (uint64_t)(625ULL * 65536ULL), 32);
+	publishDisplayParams();
+	registerService();
+	IOLog("SWEET BL: AppleARMBacklight registered on /backlight (max 625 nits)\n");
+	return true;
+}
+
+static bool
+sweet_extract_u32(OSObject *obj, uint32_t *out)
+{
+	OSNumber *num = OSDynamicCast(OSNumber, obj);
+	if (num != NULL) {
+		*out = num->unsigned32BitValue();
+		return true;
+	}
+	OSDictionary *d = OSDynamicCast(OSDictionary, obj);
+	if (d != NULL) {
+		OSNumber *v = OSDynamicCast(OSNumber, d->getObject("value"));
+		if (v != NULL) {
+			*out = v->unsigned32BitValue();
+			return true;
+		}
+	}
+	return false;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	uint32_t v = 0;
+	if (sweet_extract_u32(dict->getObject("brightness-nits"), &v)) {
+		applyNitsQ16(v);
+	} else if (sweet_extract_u32(dict->getObject("BrightnessMilliNits"), &v)) {
+		applyNitsQ16((uint32_t)(((uint64_t)v << 16) / 1000ULL));
+	} else if (sweet_extract_u32(dict->getObject("brightness"), &v)) {
+		uint32_t lvl = v > 2047 ? 2047 : v;
+		uint64_t lin = ((uint64_t)lvl * (uint64_t)lvl * 625ULL * 65536ULL) / (2047ULL * 2047ULL);
+		applyNitsQ16((uint32_t)lin);
+	} else {
+		OSDictionary *dp = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+		if (dp != NULL) {
+			if (sweet_extract_u32(dp->getObject("BrightnessMilliNits"), &v)) {
+				applyNitsQ16((uint32_t)(((uint64_t)v << 16) / 1000ULL));
+			} else if (sweet_extract_u32(dp->getObject("brightness"), &v)) {
+				uint32_t lvl = v > 2047 ? 2047 : v;
+				uint64_t lin = ((uint64_t)lvl * (uint64_t)lvl * 625ULL * 65536ULL) / (2047ULL * 2047ULL);
+				applyNitsQ16((uint32_t)lin);
+			}
+		}
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
 #endif /* SWEET */
