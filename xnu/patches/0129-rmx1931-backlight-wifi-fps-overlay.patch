+		if (sweet_gpu_ready()) {
+			if (now - fLastSwapAbs >= minGap) {
+				fLastSwapAbs = now;
+				memcpy(rec, fLastRec, sizeof(rec));
+				direct = true;
+			}
+		} else {
+			memcpy(fPending, fLastRec, sizeof(fPending));
+			fDirty = true;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (direct) {
+		IOLockLock(fPresentLock);
+		uint64_t t0 = mach_absolute_time();
+		present(rec);
+		uint64_t dt = mach_absolute_time() - t0;
+		IOLockUnlock(fPresentLock);
+		IOLockLock(fLock);
+		fStatPresentAbs += dt;
+		fStatPresents++;
+		IOLockUnlock(fLock);
+	}
+}
