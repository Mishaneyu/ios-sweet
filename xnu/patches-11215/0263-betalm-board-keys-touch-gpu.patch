+#define RMI_PAGE_REG     0xffu
+#define RMI_PDT_START    0xe9u
+#define RMI_PDT_END      0x0au
+#define RMI_PAGES        5u
+#define RMI_RX_MAX       255u
+#define RMI_CHUNK        64u     /* FIFO messages hold at most 90 bytes */
+#define BETALM_VDD_GPIO  152u    /* DT vdd-gpio (TLMM enable, no regulator) */
+#define BETALM_VCL_GPIO  59u     /* DT vcl-gpio */
