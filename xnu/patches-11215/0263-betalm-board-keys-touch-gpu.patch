+/* betalm: power, reset and probe the Synaptics S3706 (LGE sm8150-beta DT). */
+static bool
+touch_betalm_start(void)
+{
+	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd152=%#x vcl59=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(BETALM_VDD_GPIO)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(BETALM_VCL_GPIO)));
+	/* Hold reset while the rails come up; ATTN stays an input with pull-up. */
+	touch_gpio(tb->irq, 0, 3, 0, false, false);   /* 2 mA, pull-up */
+	touch_gpio(tb->rst, 0, 3, 2, true, false);    /* 6 mA, pull-up */
+	touch_gpio(BETALM_VDD_GPIO, 0, 0, 0, true, true);
+	touch_gpio(BETALM_VCL_GPIO, 0, 0, 0, true, true);
+	touch_wait(10);
+	if (st.bitbang) {
+		/* GPIO function, released; ATTN (active low) latched on both edges
+		 * in the TLMM status bit without routing it to the GIC. */
+		touch_gpio(tb->sda, 0, 3, 0, false, false);
+		touch_gpio(tb->scl, 0, 3, 0, false, false);
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->irq) + 8u, (1u << 4) | (3u << 2) | (1u << 1));
+		touch_wr(st.gpio, TOUCH_GPIO_CFG(tb->irq) + 0xcu, 0);
+	} else {
+		/* qupv3_se17_i2c_active: function qup17, 2 mA, bias-disable */
+		touch_gpio(tb->sda, tb->mux, 0, 0, false, false);
+		touch_gpio(tb->scl, tb->mux, 0, 0, false, false);
+	}
+	touch_gpio(tb->rst, 0, 3, 2, true, true);
+	touch_wait(150); /* DT hw_reset_delay = 100 ms */
+	st.probing = true;
+	uint8_t pdt = 0, siw = 0;
+	int se = rmi_read(RMI_PDT_START + 5u, &pdt, 1); /* page 0 PDT: function id */
+	int we = se ? touch_read(0x28, 0x00, false, &siw, 1) : -1;
+	st.probing = false;
+	printf("SWEET TOUCH: probe synaptics@0x20 err=%d first-fn=%#x, siw@0x28 err=%d\n", se, pdt, we);
+	if (se || st.dead) {
+		if (we == 0) {
+			printf("SWEET TOUCH: this G8S has the SiW SW42000 panel touch; not supported yet\n");
+		}
+		return false;
+	}
+	if (!rmi_setup()) {
+		return false;
+	}
+	st.kind = TOUCH_SYNAPTICS;
+	return true;
+}
