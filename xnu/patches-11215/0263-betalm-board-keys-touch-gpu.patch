+ * function 1, reset 54, ATTN 122, all in the SOUTH tile (through gpio152).
+ * gcc-sm8150.c vote 0x52014 bits 0-4: wrap2 core, s_ahb, m_ahb, core_2x, s0
+ * (as ios-sweet betalm 0085, verified on the phone); RCG 0x1e148, branch
+ * 0x1e144. LG's QUP firmware runs SE17 GSI-only, so this board bit-bangs.
+ */
+static const struct touch_board touch_betalm = {
+	"SE17", 0x00c80000u, 0x1e148u, 0x1fu, 0x1e144u,
+	55, 56, 1, 122, 54, 1080, 2248, false,
+	0x52014u, 0x03d00000u, 0x99000u, {0x1e004u, 0x1e008u}, 2u,
